  <POU Name="FB_ROB" Id="{7ce28b50-28f8-4d4c-bb25-1006bf064637}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ROB EXTENDS FB_Base IMPLEMENTS ITF_1_Robot

// VAR_IN_OUT
// 	Skills: ARRAY[1..3] OF FB_Skill;
// END_VAR
VAR_INPUT
	ComConfig: ST_CommunicationConfig;
END_VAR


VAR_OUTPUT
	_inCollision: BOOL;
END_VAR
VAR
	_enabled: BOOL;
	_mode: eMode;
	_locked: BOOL;
	
	velovr: BOOL;
	velfact: REAL;
	
	DBClient: FB_PostgreSQLClient;
	

END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[//State Machine

DBClient();]]></ST>
    </Implementation>
