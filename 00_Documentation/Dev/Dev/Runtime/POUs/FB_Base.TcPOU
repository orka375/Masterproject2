<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Base" Id="{ccfcc891-ed7a-48a9-bb43-020f08aa1f30}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'} 
FUNCTION_BLOCK ABSTRACT FB_Base EXTENDS  FB_SkillHandler  IMPLEMENTS ITF_0_BaseComponent
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	{attribute 'instance-path'} 
    {attribute 'noinit'} 
    sPath : STRING; 
	{attribute 'instance-name'}
	{attribute 'noinit'} 
	sInstanceName: STRING;
	_autoboot: BOOL:=TRUE;		//If True, StateMachine trys automatic to reach State "ACTIV" otherwise each transition must be called manually
	
	transitionresult: eResult;
	_state: eState :=eState.Unconfigured;
	

	dummy: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[StateMachine();]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{bcaabc90-8311-4d61-b63c-66c13d25292f}" />
    <Method Name="M_activate" Id="{8d29e9eb-3e7c-4311-8303-d07f52bcf283}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD M_activate : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF P_State=eState.Inactive THEN
	P_State:=eState.Activating;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_cleanup" Id="{c4819076-2442-41bd-8aa1-fe9bd8639fb5}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD M_cleanup : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF P_State=eState.Inactive THEN
	P_State:=eState.CleaningUp;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_configure" Id="{e049feb0-d020-4b0d-9355-74a020722637}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD M_configure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF P_State=eState.Unconfigured THEN
	P_State:=eState.Configuring;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_deactivate" Id="{4dfdb93c-87ba-4697-9eee-0c2811499a1b}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD M_deactivate : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF P_State=eState.Active THEN
	P_State:=eState.Deactivating;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_destroy" Id="{84232af5-24cf-43e3-b44a-0f85cd0c58bf}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD M_destroy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF P_State=eState.Finalized THEN
	P_State:=eState.Unconfigured;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_shutdown" Id="{a12b67df-13c4-4acd-81a2-259afa6359fe}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD M_shutdown : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF P_State=eState.Inactive OR P_State=eState.Unconfigured OR P_State=eState.Active THEN
	P_State:=eState.ShuttingDown;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onActivate" Id="{9da44456-9079-48c4-a422-180073049c7f}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD onActivate : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ---- Init ----
transitionresult:=eResult.None;



// ---- Change ----



// ---- Check ----
transitionresult := eResult.SUCCESS;


// ---- Change State ----
IF transitionresult= eResult.SUCCESS THEN
	P_State:=eState.Active;
ELSIF transitionresult= eResult.FAILURE THEN
	P_State:=eState.Inactive;
ELSIF transitionresult= eResult.ERROR THEN
	P_State:=eState.ErrorProcessing;
ELSE
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onActivate is None','');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onCleanup" Id="{1cbf57cd-f144-4499-ac40-e58b878ddcfc}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD onCleanup : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ---- Init ----
transitionresult:=eResult.None;



// ---- Change ----



// ---- Check ----
transitionresult := eResult.SUCCESS;


// ---- Change State ----
IF transitionresult= eResult.SUCCESS THEN
	P_State:=eState.Unconfigured;
ELSIF transitionresult= eResult.FAILURE THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onCleanup is FAILURE ','');
ELSIF transitionresult= eResult.ERROR THEN
	P_State:=eState.ErrorProcessing;
ELSE
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onCleanup is NONE','');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onConfigure" Id="{c7df3a26-6fc2-40b8-b279-df837148749a}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD onConfigure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ---- Init ----
transitionresult:=eResult.None;



// ---- Change ----




// ---- Check ----
transitionresult := eResult.SUCCESS;


// ---- Change State ----
IF transitionresult= eResult.SUCCESS THEN
	P_State:=eState.Inactive;
ELSIF transitionresult= eResult.FAILURE THEN
	P_State:=eState.Unconfigured;
ELSIF transitionresult= eResult.ERROR THEN
	P_State:=eState.ErrorProcessing;
ELSE
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onConfigure is None','');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onDeactivate" Id="{46dc1863-bc20-4aa6-822e-d746ed6280bd}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD onDeactivate : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ---- Init ----
transitionresult:=eResult.None;



// ---- Change ----



// ---- Check ----
transitionresult := eResult.SUCCESS;


// ---- Change State ----
IF transitionresult= eResult.SUCCESS THEN
	P_State:=eState.Inactive;
ELSIF transitionresult= eResult.FAILURE THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onDeactivate is FAILURE','');
ELSIF transitionresult= eResult.ERROR THEN
	P_State:=eState.ErrorProcessing;
ELSE
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onDeactivate is None','');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onError" Id="{c4fcde18-52a6-416e-9375-25c35d4fb566}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD onError : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ---- Init ----
transitionresult:=eResult.None;



// ---- Change ----




// ---- Check ----
transitionresult := eResult.SUCCESS;


// ---- Change State ----
IF transitionresult= eResult.SUCCESS THEN
	P_State:=eState.Unconfigured;
ELSIF transitionresult= eResult.FAILURE THEN
	P_State:=eState.Finalized;
ELSIF transitionresult= eResult.ERROR THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onError is Error','');
ELSE
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onError is None','');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onShutdown" Id="{05a5db8e-a9c0-4764-9498-22b8037c7c75}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD onShutdown : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ---- Init ----
transitionresult:=eResult.None;



// ---- Change ----



// ---- Check ----
transitionresult := eResult.SUCCESS;


// ---- Change State ----
IF transitionresult= eResult.SUCCESS THEN
	P_State:=eState.Finalized;
ELSIF transitionresult= eResult.FAILURE THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onShutdown is FAILURE','');
ELSIF transitionresult= eResult.ERROR THEN
	P_State:=eState.ErrorProcessing;
ELSE
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Transitionresult from onShutdown is None','');
END_IF]]></ST>
      </Implementation>
    </Method>
