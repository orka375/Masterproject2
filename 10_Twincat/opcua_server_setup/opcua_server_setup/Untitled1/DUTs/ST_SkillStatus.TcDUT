<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_SkillStatus" Id="{66db3fe8-3949-42e4-8d15-d5cb7cd19d5b}">
    <Declaration><![CDATA[{attribute 'OPC.UA.DA.StructuredType':=1}
TYPE ST_SkillStatus :
STRUCT
    Ready               : BOOL := FALSE;
    Busy                : BOOL := FALSE;
    Done                : BOOL := FALSE;
    Success             : BOOL := FALSE;

    State               : E_SkillState := E_SkillState.Idle;
    Progress            : REAL := 0.0;

    ActiveRequestId     : UDINT := 0;
    ResultRequestId     : UDINT := 0;

    Error               : BOOL := FALSE;
    ErrorCode           : UDINT := 0;
    ErrorMessage        : STRING(255) := '';

    LastExecutionTimeMs : UDINT := 0;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>