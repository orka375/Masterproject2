<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TcpIpClient" Id="{9D76C607-93AB-4D6B-8D1B-0F2F7A5B7C41}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TcpIpClient
VAR_INPUT
    // Master enable. TRUE = keep the TCP connection alive.
    bEnable             : BOOL;

    // Reset latched local errors and allow a reconnect attempt.
    bReset              : BOOL;

    // Remote endpoint.
    sRemoteHost         : T_IPv4Addr;
    nRemotePort         : UDINT;

    // TRUE = continuously issue asynchronous receive requests.
    bReceiveEnable      : BOOL := TRUE;

    // Rising edge starts one send operation.
    bSend               : BOOL;
    pSendData           : PVOID;
    nSendSize           : UDINT;
END_VAR

VAR_OUTPUT
    // Connection status.
    bConnected          : BOOL;
    bReadyForSend       : BOOL;

    // Send status.
    bSendBusy           : BOOL;
    bSendDone           : BOOL;

    // Receive output. bRxNewData is a one-cycle pulse.
    bRxNewData          : BOOL;
    nRxBytes            : UDINT;
    aRxData             : ARRAY[0..2047] OF BYTE;

    // Error information.
    bError              : BOOL;
    nErrorId            : UDINT;
    sError              : STRING(80);
END_VAR

VAR
    // Beckhoff socket function blocks.
    fbSocketConnect     : FB_SocketConnect;
    fbSocketClose       : FB_SocketClose;
    fbSocketSend        : FB_SocketSend;
    fbSocketReceive     : FB_SocketReceive;
    fbReconnectDelay    : TON;

    hSocket             : T_HSOCKET;

    // Main state machine.
    nState              : USINT := 0;

    // Execute pulses for Beckhoff FBs.
    bConnectExecute     : BOOL;
    bCloseExecute       : BOOL;
    bSendExecute        : BOOL;
    bReceiveExecute     : BOOL;

    // Connection operation tracking.
    bConnectStarted     : BOOL;
    bCloseStarted       : BOOL;
    bReconnectAfterClose : BOOL;

    // Send operation tracking.
    bSendOld            : BOOL;
    bSendRise           : BOOL;
    bSendActive         : BOOL;
    bSendStarted        : BOOL;
    nActiveSendSize     : UDINT;
    aTxBuffer           : ARRAY[0..2047] OF BYTE;

    // Receive operation tracking.
    bReceiveActive      : BOOL;
    bReceiveStarted     : BOOL;
    nSocketRxBytes      : UDINT;
END_VAR

VAR CONSTANT
    C_STATE_DISCONNECTED    : USINT := 0;
    C_STATE_CONNECTING      : USINT := 10;
    C_STATE_CONNECTED       : USINT := 20;
    C_STATE_DISCONNECTING   : USINT := 30;
    C_STATE_ERROR_WAIT      : USINT := 90;

    C_BUFFER_SIZE           : UDINT := 2048;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// ============================================================================
// FB_TcpIpClient
// Simple generic TCP/IP client for TwinCAT 3.
//
// Responsibilities:
//   - Connect / disconnect
//   - Automatic reconnect after communication errors
//   - Send one raw byte buffer on a rising edge of bSend
//   - Continuously receive raw TCP chunks when bReceiveEnable = TRUE
//
// Important:
//   This FB intentionally does NOT interpret application protocols.
//   TCP is a byte stream. Protocol framing (for example UR RTDE frames) must be
//   implemented by the higher-level FB using aRxData/nRxBytes.
// ============================================================================


// ----------------------------------------------------------------------------
// Call Beckhoff socket FBs every PLC cycle.
// Execute signals below are one-cycle pulses.
// ----------------------------------------------------------------------------
fbSocketConnect(
    sSrvNetId   := '',
    sRemoteHost := sRemoteHost,
    nRemotePort := nRemotePort,
    tTimeout    := T#5S,
    bExecute    := bConnectExecute,
    hSocket     => hSocket
);

fbSocketClose(
    sSrvNetId   := '',
    tTimeout    := T#5S,
    hSocket     := hSocket,
    bExecute    := bCloseExecute
);

fbSocketSend(
    sSrvNetId   := '',
    tTimeout    := T#5S,
    hSocket     := hSocket,
    bExecute    := bSendExecute,
    cbLen       := nActiveSendSize,
    pSrc        := ADR(aTxBuffer)
);

fbSocketReceive(
    sSrvNetId   := '',
    tTimeout    := T#5S,
    hSocket     := hSocket,
    bExecute    := bReceiveExecute,
    cbLen       := SIZEOF(aRxData),
    pDest       := ADR(aRxData),
    nRecBytes   => nSocketRxBytes
);

fbReconnectDelay(
    IN := (nState = C_STATE_ERROR_WAIT) AND bEnable,
    PT := T#1S
);


// ----------------------------------------------------------------------------
// Default pulse outputs / execute inputs.
// Any execute set later in this scan is seen by the socket FB on the next scan.
// ----------------------------------------------------------------------------
bConnectExecute := FALSE;
bCloseExecute := FALSE;
bSendExecute := FALSE;
bReceiveExecute := FALSE;

bSendDone := FALSE;
bRxNewData := FALSE;
nRxBytes := 0;


// ----------------------------------------------------------------------------
// Rising-edge detection for send command.
// ----------------------------------------------------------------------------
bSendRise := bSend AND NOT bSendOld;
bSendOld := bSend;


// ----------------------------------------------------------------------------
// Reset local error information.
// ----------------------------------------------------------------------------
IF bReset THEN
    bError := FALSE;
    nErrorId := 0;
    sError := '';

    IF nState = C_STATE_ERROR_WAIT THEN
        nState := C_STATE_DISCONNECTED;
    END_IF
END_IF


// ============================================================================
// Main TCP state machine
// ============================================================================
CASE nState OF

    // ------------------------------------------------------------------------
    // DISCONNECTED
    // ------------------------------------------------------------------------
    C_STATE_DISCONNECTED:

        bSendActive := FALSE;
        bSendStarted := FALSE;
        bReceiveActive := FALSE;
        bReceiveStarted := FALSE;
        bConnectStarted := FALSE;
        bCloseStarted := FALSE;

        IF bEnable THEN
            bConnectExecute := TRUE;
            nState := C_STATE_CONNECTING;
        END_IF


    // ------------------------------------------------------------------------
    // CONNECTING
    // ------------------------------------------------------------------------
    C_STATE_CONNECTING:

        IF NOT bEnable THEN
            nState := C_STATE_DISCONNECTED;

        ELSE
            IF fbSocketConnect.bBusy THEN
                bConnectStarted := TRUE;
            END_IF

            IF fbSocketConnect.bError THEN
                bError := TRUE;
                nErrorId := fbSocketConnect.nErrId;
                sError := 'TCP connect error';

                bReconnectAfterClose := FALSE;
                nState := C_STATE_ERROR_WAIT;

            ELSIF bConnectStarted AND NOT fbSocketConnect.bBusy THEN
                bConnectStarted := FALSE;

                // The Beckhoff socket FB has completed successfully.
                bError := FALSE;
                nErrorId := 0;
                sError := '';
                nState := C_STATE_CONNECTED;
            END_IF
        END_IF


    // ------------------------------------------------------------------------
    // CONNECTED
    // ------------------------------------------------------------------------
    C_STATE_CONNECTED:

        // Disable requested -> close the socket cleanly.
        IF NOT bEnable THEN
            bReconnectAfterClose := FALSE;
            bCloseStarted := FALSE;
            bCloseExecute := TRUE;
            nState := C_STATE_DISCONNECTING;

        ELSE

            // ================================================================
            // SEND
            // ================================================================
            IF bSendActive THEN

                IF fbSocketSend.bBusy THEN
                    bSendStarted := TRUE;
                END_IF

                IF fbSocketSend.bError THEN
                    bSendActive := FALSE;
                    bSendStarted := FALSE;

                    bError := TRUE;
                    nErrorId := fbSocketSend.nErrId;
                    sError := 'TCP send error';

                    // Close first, then reconnect after a short delay.
                    bReconnectAfterClose := TRUE;
                    bCloseStarted := FALSE;
                    bCloseExecute := TRUE;
                    nState := C_STATE_DISCONNECTING;

                ELSIF bSendStarted AND NOT fbSocketSend.bBusy THEN
                    bSendActive := FALSE;
                    bSendStarted := FALSE;
                    bSendDone := TRUE;
                END_IF

            ELSIF bSendRise THEN

                // Validate caller buffer before dereferencing the pointer.
                IF (nSendSize = 0) OR
                   (nSendSize > C_BUFFER_SIZE) OR
                   (pSendData = 0)
                THEN
                    bError := TRUE;
                    nErrorId := 16#F002;
                    sError := 'Invalid TCP send buffer';

                ELSE
                    // Copy ONLY the requested bytes into our own stable buffer.
                    // This avoids the old 10,001-byte pointer/array copy pattern.
                    MEMCPY(
                        destAddr := ADR(aTxBuffer),
                        srcAddr := pSendData,
                        n := nSendSize
                    );

                    nActiveSendSize := nSendSize;
                    bSendActive := TRUE;
                    bSendStarted := FALSE;
                    bSendExecute := TRUE;
                END_IF
            END_IF


            // ================================================================
            // RECEIVE
            // ================================================================
            IF bReceiveActive THEN

                IF fbSocketReceive.bBusy THEN
                    bReceiveStarted := TRUE;
                END_IF

                IF fbSocketReceive.bError THEN
                    bReceiveActive := FALSE;
                    bReceiveStarted := FALSE;

                    bError := TRUE;
                    nErrorId := fbSocketReceive.nErrId;
                    sError := 'TCP receive error';

                    // Close first, then reconnect after a short delay.
                    bReconnectAfterClose := TRUE;
                    bCloseStarted := FALSE;
                    bCloseExecute := TRUE;
                    nState := C_STATE_DISCONNECTING;

                ELSIF bReceiveStarted AND NOT fbSocketReceive.bBusy THEN
                    bReceiveActive := FALSE;
                    bReceiveStarted := FALSE;

                    IF nSocketRxBytes > 0 THEN
                        nRxBytes := nSocketRxBytes;
                        bRxNewData := TRUE;
                    END_IF
                END_IF

            ELSIF bReceiveEnable THEN
                nSocketRxBytes := 0;
                bReceiveActive := TRUE;
                bReceiveStarted := FALSE;
                bReceiveExecute := TRUE;
            END_IF

        END_IF


    // ------------------------------------------------------------------------
    // DISCONNECTING
    // ------------------------------------------------------------------------
    C_STATE_DISCONNECTING:

        IF fbSocketClose.bBusy THEN
            bCloseStarted := TRUE;
        END_IF

        IF fbSocketClose.bError THEN
            // The connection is considered unusable even if close itself failed.
            bCloseStarted := FALSE;

            IF bReconnectAfterClose AND bEnable THEN
                nState := C_STATE_ERROR_WAIT;
            ELSE
                bError := TRUE;
                nErrorId := fbSocketClose.nErrId;
                sError := 'TCP close error';
                nState := C_STATE_DISCONNECTED;
            END_IF

        ELSIF bCloseStarted AND NOT fbSocketClose.bBusy THEN
            bCloseStarted := FALSE;

            IF bReconnectAfterClose AND bEnable THEN
                nState := C_STATE_ERROR_WAIT;
            ELSE
                nState := C_STATE_DISCONNECTED;
            END_IF
        END_IF


    // ------------------------------------------------------------------------
    // ERROR WAIT / AUTOMATIC RECONNECT
    // ------------------------------------------------------------------------
    C_STATE_ERROR_WAIT:

        bSendActive := FALSE;
        bSendStarted := FALSE;
        bReceiveActive := FALSE;
        bReceiveStarted := FALSE;

        IF NOT bEnable THEN
            bError := FALSE;
            nErrorId := 0;
            sError := '';
            nState := C_STATE_DISCONNECTED;

        ELSIF bReset OR fbReconnectDelay.Q THEN
            // Keep the previous error visible during the delay, then retry.
            bError := FALSE;
            nErrorId := 0;
            sError := '';
            nState := C_STATE_DISCONNECTED;
        END_IF


    // ------------------------------------------------------------------------
    // Unknown/corrupt state -> safe reset.
    // ------------------------------------------------------------------------
    ELSE
        bError := TRUE;
        nErrorId := 16#F0FF;
        sError := 'Invalid TCP state';
        nState := C_STATE_ERROR_WAIT;

END_CASE


// ----------------------------------------------------------------------------
// Public status outputs
// ----------------------------------------------------------------------------
bConnected := (nState = C_STATE_CONNECTED);

bSendBusy :=
    bSendActive OR
    fbSocketSend.bBusy;

bReadyForSend :=
    bConnected AND
    NOT bSendBusy AND
    NOT bError;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
