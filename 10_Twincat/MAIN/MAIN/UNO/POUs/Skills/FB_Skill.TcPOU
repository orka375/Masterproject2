    <Property Name="Busy" Id="{59c0b902-0e96-4aa6-80c4-17e0cd6c8a94}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{f0fed57d-7011-4c26-a36d-51ead2ced228}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF eStatus=eState.Active THEN
	Busy:=TRUE;
ELSE
	Busy:=FALSE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="DeactivateSkill" Id="{10338084-d473-478a-aa27-fc35b9873599}" FolderPath="Public\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD DeactivateSkill : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stop();
_owner^.ActivSkill:= 0;]]></ST>
      </Implementation>
    </Method>
