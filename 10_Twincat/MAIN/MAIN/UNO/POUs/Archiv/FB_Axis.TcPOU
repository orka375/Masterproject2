    <Folder Name="Activities" Id="{06120b37-9249-40c4-9170-129c2634ed82}" />
    <Method Name="onActivate" Id="{dff9d669-6f40-4f00-90d9-3787e79ba4a4}" FolderPath="Activities\">
      <Declaration><![CDATA[METHOD PROTECTED onActivate : eResult
VAR_INPUT
END_VAR
  VAR
    bParentOk : BOOL;
    eParentResult : eResult;
  END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.onActivate();
  bParentOk := eParentResult = eResult.SUCCESS;
  IF NOT bParentOk THEN
    ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_Axis.onActivate: parent onActivate failed', '');
    onActivate := eParentResult;
    RETURN;
  END_IF

  onActivate := eResult.SUCCESS;]]></ST>
      </Implementation>
    </Method>
