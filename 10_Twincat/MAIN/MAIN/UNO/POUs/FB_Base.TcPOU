      </Set>
    </Property>
    <Method Name="StateMachine" Id="{2f358a4c-c272-4679-b042-e935cc28a3dc}">
      <Declaration><![CDATA[METHOD StateMachine : eState
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _initialized THEN
    sInstanceName := GetInstanceName();
    _initialized := TRUE;
END_IF


CASE _state OF
	eState.Unconfigured:
		IF _autoconfigure THEN
			Configure();
		END_IF
	eState.Inactive:		//IDLE
// 		IF _autoboot THEN
// 			M_activate();
// 		END_IF
	eState.Active:
		dummy:=1;
	eState.Finalized:
		Destroy();
	
	
	//Transitions States
	eState.Configuring:
		onConfigure();
	eState.Activating:
		onActivate();
	eState.Deactivating:
		onDeactivate();
	eState.ErrorProcessing:
		onError();
	eState.CleaningUp:
		onCleanup();
	eState.ShuttingDown:
		onShutdown();
		
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>