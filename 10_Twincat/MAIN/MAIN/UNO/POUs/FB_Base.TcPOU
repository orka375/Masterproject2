    <Method Name="Shutdown" Id="{a12b67df-13c4-4acd-81a2-259afa6359fe}" FolderPath="StateControl\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Shutdown : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF State=eState.Inactive OR State=eState.Unconfigured OR State=eState.Active THEN
	State:=eState.ShuttingDown;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{186f624f-e691-4cfe-9392-dd87366cedc2}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY State : eState
]]></Declaration>
      <Get Name="Get" Id="{8c20bc39-5e17-48de-81e9-f86cdcf5978c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[State:=eStatus;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f2b0cb44-bade-4a8a-80d6-a1f37ebc07e9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eStatus:=State;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="StateMachine" Id="{2f358a4c-c272-4679-b042-e935cc28a3dc}">
      <Declaration><![CDATA[METHOD StateMachine : eState
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _initialized THEN
    sInstanceName := GetInstanceName();
    _initialized := TRUE;
END_IF

CASE eStatus OF
    eState.Unconfigured:
        IF bAutoConfigure THEN
            Configure();
        END_IF

    eState.Inactive:
        ;

    eState.Active:
        ;
    eState.Finalized:
        Destroy();

    eState.Configuring:
        _transitionresult := OnConfigure();
        CASE _transitionresult OF
            eResult.SUCCESS:
                eStatus := eState.Inactive;
            eResult.FAILURE:
                eStatus := eState.Unconfigured;
            eResult.ERROR:
                eStatus := eState.ErrorProcessing;
        END_CASE;

    eState.Activating:
        _transitionresult := OnActivate();
        CASE _transitionresult OF
            eResult.SUCCESS:
                eStatus := eState.Active;
            eResult.FAILURE:
                eStatus := eState.Inactive;
            eResult.ERROR:
                eStatus := eState.ErrorProcessing;
        END_CASE;

    eState.Deactivating:
        _transitionresult := OnDeactivate();
        CASE _transitionresult OF
            eResult.SUCCESS:
                eStatus := eState.Inactive;
            eResult.FAILURE:
                eStatus := eState.Inactive;
            eResult.ERROR:
                eStatus := eState.ErrorProcessing;
        END_CASE;

    eState.ErrorProcessing:
        _transitionresult := OnError();
        CASE _transitionresult OF
            eResult.SUCCESS:
                eStatus := eState.Unconfigured;
            eResult.FAILURE:
                eStatus := eState.Finalized;
            eResult.ERROR:
                eStatus := eState.ErrorProcessing;
        END_CASE;

    eState.CleaningUp:
        _transitionresult := OnCleanup();
        CASE _transitionresult OF
            eResult.SUCCESS:
                eStatus := eState.Unconfigured;
            eResult.FAILURE:
                eStatus := eState.Unconfigured;
            eResult.ERROR:
                eStatus := eState.ErrorProcessing;
        END_CASE;

    eState.ShuttingDown:
        _transitionresult := OnShutdown();
        CASE _transitionresult OF
            eResult.SUCCESS:
                eStatus := eState.Finalized;
            eResult.FAILURE:
                eStatus := eState.Finalized;
            eResult.ERROR:
                eStatus := eState.ErrorProcessing;
        END_CASE;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>