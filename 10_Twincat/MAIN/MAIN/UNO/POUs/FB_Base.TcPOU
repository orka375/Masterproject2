  <POU Name="FB_Base" Id="{ccfcc891-ed7a-48a9-bb43-020f08aa1f30}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'} 
FUNCTION_BLOCK ABSTRACT FB_Base EXTENDS  FB_SkillHandler  IMPLEMENTS ITF_0_BaseComponent
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	{attribute 'instance-path'} 
    {attribute 'noinit'} 
    sPath : STRING(255); 
	{attribute 'instance-name'}
	{attribute 'noinit'} 
	sInstanceName: STRING;
	_autoconfigure: BOOL:=TRUE;		//If True, StateMachine trys automatic to reach State "ACTIV" otherwise each transition must be called manually
	
	transitionresult: eResult;
	_state: eState :=eState.Unconfigured;
	Error: BOOL;
	ErrorId: UDINT;

	dummy: INT;
	_initialized: BOOL;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[StateMachine();]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{bcaabc90-8311-4d61-b63c-66c13d25292f}" />
    <Method Name="Activate" Id="{8d29e9eb-3e7c-4311-8303-d07f52bcf283}" FolderPath="StateControl\">
      <Declaration><![CDATA[// {warning 'Add method implementation '}
METHOD Activate : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF State=eState.Inactive THEN
	State:=eState.Activating;
ELSE
	ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_WARN,
    msgFmtStr   := 'Activate failed in: %s',
    strArg      := sPath
);
END_IF]]></ST>
      </Implementation>
    </Method>
