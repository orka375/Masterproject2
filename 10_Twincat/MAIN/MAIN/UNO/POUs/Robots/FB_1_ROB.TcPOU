    <Method Name="SetSpeedOverride" Id="{a5e39256-a687-447d-8a2a-a95ea9e40d2e}" FolderPath="Generic Motion Settings\">
      <Declaration><![CDATA[METHOD SetSpeedOverride : BOOL
VAR_INPUT
    factor : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (factor < 0.001) OR (factor > 100.0) THEN
    SetSpeedOverride := FALSE;
    RETURN;
END_IF
_speedOverride := factor;
SetSpeedOverride := TRUE;]]></ST>
      </Implementation>
    </Method>
