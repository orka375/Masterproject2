    <Action Name="CYCLIC_ROB" Id="{ebf16c89-c511-406b-9426-1ade99c4f730}">
      <Implementation>
        <ST><![CDATA[CYCLIC_BASE();

FOR index := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[index] <> 0 THEN
        pA_Skills[index]^.StateMachine();
    END_IF
END_FOR


PM();]]></ST>
      </Implementation>
    </Action>
    <Method Name="DisableRobot" Id="{bbb8a1cb-19df-48a2-aa34-15efcd08818d}" FolderPath="Generic Control\">
      <Declaration><![CDATA[METHOD DisableRobot : BOOL]]></Declaration>
      <Implementation>
