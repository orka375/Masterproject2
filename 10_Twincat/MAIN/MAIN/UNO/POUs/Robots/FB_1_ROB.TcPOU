    <Declaration><![CDATA[FUNCTION_BLOCK FB_1_ROB EXTENDS FB_0_Base IMPLEMENTS ITF_1_Robot

VAR_INPUT
	nErrorId : UINT; //FIX BUG
	PM: FB_PointManager;
// 	FILESERVER: FB_FileServer;
END_VAR


VAR_OUTPUT
    bCommunicationReady : BOOL;
    bReady : BOOL;
    bEnabled : BOOL;
    bMoving : BOOL;
    bBusy : BOOL;
    bInCollision : BOOL;
    eModus : eMode;
    
END_VAR

VAR
	_speedOverride : LREAL := 100.0;
	index: INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
