    <Method Name="OnActivate" Id="{92a2cf27-c6ee-447f-b5b4-e372093c0834}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
    VAR
      bParentOk: BOOL;
      eParentResult: eResult;
    END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
    bParentOk := eParentResult = eResult.SUCCESS;

    IF NOT bParentOk THEN
      ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_ROB.OnActivate: parent OnActivate failed', '');
      OnActivate := eParentResult;
      RETURN;
    END_IF

eModus := eMode.Automatic;
OnActivate := eResult.SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{b8d25f1a-bd56-4d52-bf77-294e7c965601}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
    VAR
      bParentOk: BOOL;
      eParentResult: eResult;
    END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnCleanup();
    bParentOk := eParentResult = eResult.SUCCESS;

    IF NOT bParentOk THEN
      ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_ROB.OnCleanup: parent OnCleanup failed', '');
      OnCleanup := eParentResult;
      RETURN;
    END_IF

    OnCleanup := eResult.SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{fb57d4c1-8d73-4b61-a93c-ea33b423e3bc}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
    VAR
      bParentOk: BOOL;
      eParentResult: eResult;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
    bParentOk := eParentResult = eResult.SUCCESS;

    IF NOT bParentOk THEN
      ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_ROB.OnConfigure: parent OnConfigure failed', '');
      OnConfigure := eParentResult;
      RETURN;
    END_IF

    // ---- Init ----
_transitionresult := eParentResult;

// ---- Change ----
eModus := eMode.Manual;


// ---- Check ----
IF bError THEN
    _transitionresult := eResult.ERROR;
END_IF

IF _transitionresult <>eResult.SUCCESS THEN
	bAutoConfigure:=FALSE;
END_IF
// ---- Change State ----
OnConfigure := _transitionresult;]]></ST>
      </Implementation>
    </Method>
