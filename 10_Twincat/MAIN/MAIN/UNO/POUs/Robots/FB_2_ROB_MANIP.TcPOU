    <Method Name="RequestCommand" Id="{95ca8f57-9d21-483f-b4d1-93f5a12f3e5c}">
      <Declaration><![CDATA[METHOD PROTECTED RequestCommand : BOOL
VAR_INPUT
	eCommand : E_RobotCommand;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestCommand := FALSE;

CASE _commandState OF
	E_RobotCommandState.Idle,
	E_RobotCommandState.Done,
	E_RobotCommandState.Aborted,
	E_RobotCommandState.Error:
		_command.Command := eCommand;
		_command.ExecuteId := _nextExecuteId;
		_nextExecuteId := _nextExecuteId + 1;
		_commandErrorId := 0;
		_commandState := E_RobotCommandState.Requested;
		RequestCommand := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
