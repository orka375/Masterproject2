    <Method Name="OnActivate" Id="{9316e65a-0316-4500-ae6c-6cb94521b4a3}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
  VAR
    bParentOk : BOOL;
    eParentResult : eResult;
  END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
  bParentOk := eParentResult = eResult.SUCCESS;
  IF NOT bParentOk THEN
    ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_ROB_MANIP.OnActivate: parent OnActivate failed', '');
    OnActivate := eParentResult;
    RETURN;
  END_IF

  eModus := eMode.Automatic;
OnActivate := eResult.SUCCESS;]]></ST>
      </Implementation>
    </Method>
