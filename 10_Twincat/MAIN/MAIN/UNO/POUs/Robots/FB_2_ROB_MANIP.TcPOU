    <Method Name="SetDO" Id="{1b1484e8-2eba-4b5a-9bc9-3e9f0cf73af2}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD SetDO : BOOL
VAR_INPUT
    nOutput : UINT;
    bValue : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetDO := RequestCommand(eCommand := E_RobotCommand.SetDigitalOutput);

IF SetDO THEN
    _command.DigitalOutput := nOutput;
    _command.DigitalOutputValue := bValue;
END_IF]]></ST>
