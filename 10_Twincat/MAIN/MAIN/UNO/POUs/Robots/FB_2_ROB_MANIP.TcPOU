    <Method Name="SetSpeedOverride" Id="{d7e8f9a0-b1c2-4d3e-8f4a-5b6c7d8e9f0a}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD SetSpeedOverride : BOOL
VAR_INPUT
    factor : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetSpeedOverride := FALSE;

IF (factor < 0.001) OR (factor > 100.0) THEN
    RETURN;
END_IF

SetSpeedOverride := RequestCommand(eCommand := E_RobotCommand.SetSpeedOverride);
IF SetSpeedOverride THEN
    _command.SpeedOverride := factor;
END_IF]]></ST>
      </Implementation>
    </Method>
