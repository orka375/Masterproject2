<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ROB" Id="{7ce28b50-28f8-4d4c-bb25-1006bf064637}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ROB EXTENDS FB_Base IMPLEMENTS ITF_1_Robot, ITF_CommunicationModul

VAR_INPUT
	pA_Skills : ARRAY[1..4] OF POINTER TO FB_Base_Skill;
	pTool: POINTER TO FB_TOOL; //only of Manipulator
	
END_VAR

VAR_INPUT
	ComConfig: ST_CommunicationConfig;

END_VAR


VAR_OUTPUT
	_inCollision: BOOL;
	 eConnectionState : eCommunicationState :=
        eCommunicationState.DISCONNECTED;
END_VAR
VAR
	    // ============================================================
    // Internal state
    // ============================================================

    _Connected : BOOL;
    _Busy : BOOL;


    _Command : STRING(1023);
    _CommandPending : BOOL;

    _ReconnectTimer : TON;
    _TimeoutTimer : TON;


    // Rising-edge detection
	
    _ExecuteConnect : BOOL;
    _ExecuteDisconnect : BOOL;
    _ExecuteCommand : BOOL;

    _LastCommand : STRING(1023);
	
	
	_enabled: BOOL;
	_mode: eMode;
	_locked: BOOL;
	
	velovr: BOOL;
	velfact: REAL;
	
// 	DBClient: FB_PostgreSQLClient;
	

END_VAR


VAR
    // =========================================================
    // Communication state
    // =========================================================

   

    xConnectRequest : BOOL := FALSE;
    xDisconnectRequest : BOOL := FALSE;

    // One-shot execute signals
    xSocketConnectExecute : BOOL := FALSE;
    xSocketCloseExecute : BOOL := FALSE;


    fbSocketConnect : FB_SocketConnect;
    fbSocketClose : FB_SocketClose;

    hSocket : T_HSOCKET;


    SocketErrorId : UDINT := 0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// --- CALL AGAIN IN FINAL INSTANCE ---
StateMachine();
ComMachine();
RunSkillStateMachines();

// DBClient();]]></ST>
    </Implementation>
