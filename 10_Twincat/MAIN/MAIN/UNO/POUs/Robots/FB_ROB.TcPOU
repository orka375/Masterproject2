    <Method Name="RunSkillStateMachines" Id="{ab7481c6-37ce-4d03-b209-9a2671ab3d76}">
      <Declaration><![CDATA[METHOD RunSkillStateMachines : BOOL
VAR_INPUT
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := TO_INT(LOWER_BOUND(pA_Skills, 1))
        TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO

    IF pA_Skills[i] <> 0 THEN
        pA_Skills[i]^.StateMachine();
    END_IF

END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateMachine" Id="{7c548c85-6556-4878-b6cb-3d316e797b43}">
      <Declaration><![CDATA[METHOD StateMachine : eState
VAR_INPUT
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _initialized THEN
    sInstanceName := GetInstanceName();
    _initialized := TRUE;
END_IF

CASE _state OF
	eState.Unconfigured:
		IF _autoconfigure THEN
			Configure();
		END_IF
	eState.Inactive:		//IDLE
// 		IF _autoboot THEN
// 			M_activate();
// 		END_IF
	eState.Active:
		dummy:=1;
		
	eState.Finalized:
		Destroy();
	
	
	//Transitions States
	eState.Configuring:
		onConfigure();
	eState.Activating:
		onActivate();
	eState.Deactivating:
		onDeactivate();
	eState.ErrorProcessing:
		onError();
	eState.CleaningUp:
		onCleanup();
	eState.ShuttingDown:
		onShutdown();
		
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>