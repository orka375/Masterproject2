    <Method Name="PrepareInputRequest" Id="{ab4e7b30-bc35-43e3-bcc7-4835698bb97e}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE PrepareInputRequest
VAR
  sInputNames : STRING(400) := 'input_int_register_24,input_int_register_25,input_int_register_26,input_int_register_27,input_int_register_28,input_double_register_24,input_double_register_25,input_double_register_26,input_double_register_27,input_double_register_28,input_double_register_29,input_double_register_30,input_double_register_31';
  nInputNameLength : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nInputNameLength := LEN(sInputNames);
        aRtdeTx[0] := UINT_TO_BYTE(SHR(nInputNameLength + 3, 8));
        aRtdeTx[1] := UINT_TO_BYTE(nInputNameLength + 3);
aRtdeTx[2] := C_RTDE_SETUP_INPUTS;
MEMCPY(destAddr := ADR(aRtdeTx[3]), srcAddr := ADR(sInputNames), n := nInputNameLength);
nRtdeTxSize := nInputNameLength + 3;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PrepareOutputRequest" Id="{2c8514a0-fdf5-42b6-a0a1-5a20654eb416}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE PrepareOutputRequest
VAR
  sOutputNames : STRING(255) := 'actual_TCP_pose,actual_q,output_int_register_24,output_int_register_25,output_int_register_26,output_int_register_27';
  nOutputNameLength : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nOutputNameLength := LEN(sOutputNames);

aRtdeTx[0] := UINT_TO_BYTE(SHR(nOutputNameLength + 11, 8));
aRtdeTx[1] := UINT_TO_BYTE(nOutputNameLength + 11);
aRtdeTx[2] := C_RTDE_SETUP_OUTPUTS;
WriteNetworkLReal(nStartIndex := 3, lrValue := C_RTDE_OUTPUT_FREQUENCY);
MEMCPY(
  destAddr := ADR(aRtdeTx[11]),
  srcAddr := ADR(sOutputNames),
  n := nOutputNameLength
);
nRtdeTxSize := nOutputNameLength + 11;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PrepareProtocolRequest" Id="{26ca3ba7-1940-4c76-a828-54092b2e4811}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE PrepareProtocolRequest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[aRtdeTx[0] := 0;
aRtdeTx[1] := 5;
aRtdeTx[2] := C_RTDE_REQUEST_PROTOCOL_VERSION;
aRtdeTx[3] := 0;
aRtdeTx[4] := 2;
nRtdeTxSize := 5;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PrepareStartRequest" Id="{062e85eb-4b11-4249-bfdd-40cfb3f0dabb}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE PrepareStartRequest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[aRtdeTx[0] := 0;
aRtdeTx[1] := 3;
aRtdeTx[2] := C_RTDE_START;
nRtdeTxSize := 3;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPrimaryReceive" Id="{9dc75a93-105d-4c39-b2e5-f5b4f3e21583}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ProcessPrimaryReceive
VAR
  nOffset : UINT;
  nFrameLength : UDINT;
  nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF COMM_Primary.bRxNewData THEN
  IF (UINT_TO_UDINT(nPrimaryRxBytes) + COMM_Primary.nRxBytes) > UINT_TO_UDINT(SIZEOF(aPrimaryRx)) THEN
    bPrimaryError := TRUE;
    nPrimaryErrorId := 16#E632;
    sPrimaryError := 'Primary receive buffer overflow';
    nPrimaryRxBytes := 0;
    RETURN;
  END_IF

  MEMCPY(
    destAddr := ADR(aPrimaryRx[nPrimaryRxBytes]),
    srcAddr := COMM_Primary.RxData,
    n := COMM_Primary.nRxBytes
  );
  nPrimaryRxBytes := UDINT_TO_UINT(UINT_TO_UDINT(nPrimaryRxBytes) + COMM_Primary.nRxBytes);
END_IF

nOffset := 0;
WHILE (nPrimaryRxBytes - nOffset) >= 5 DO
  nFrameLength := ReadBigEndianUDInt(nStartIndex := nOffset);

  IF nFrameLength < 5 THEN
    bPrimaryError := TRUE;
    nPrimaryErrorId := 16#E633;
    sPrimaryError := 'Invalid Primary frame length';
    nPrimaryRxBytes := 0;
    RETURN;
  END_IF

  IF nFrameLength > SIZEOF(aPrimaryRx) THEN
    bPrimaryError := TRUE;
    nPrimaryErrorId := 16#E634;
    sPrimaryError := 'Primary frame exceeds buffer';
    nPrimaryRxBytes := 0;
    RETURN;
  END_IF

  IF UINT_TO_UDINT(nPrimaryRxBytes - nOffset) < nFrameLength THEN
    EXIT;
  END_IF

  IF aPrimaryRx[nOffset + 4] = C_PRIMARY_ROBOT_STATE THEN
    ProcessPrimaryRobotState(
      nStartIndex := nOffset,
      nFrameLength := nFrameLength
    );
  END_IF

  nOffset := nOffset + UDINT_TO_UINT(nFrameLength);
END_WHILE

IF nOffset = nPrimaryRxBytes THEN
  nPrimaryRxBytes := 0;
ELSIF nOffset > 0 THEN
  FOR nIndex := nOffset TO nPrimaryRxBytes - 1 DO
    aPrimaryRx[nIndex - nOffset] := aPrimaryRx[nIndex];
  END_FOR
  nPrimaryRxBytes := nPrimaryRxBytes - nOffset;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPrimaryRobotState" Id="{713b9e12-d68e-46a5-94fe-4a0d30a4bc5f}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ProcessPrimaryRobotState
VAR_INPUT
  nStartIndex : UINT;
  nFrameLength : UDINT;
END_VAR
VAR
  nSubOffset : UINT;
  nSubLength : UDINT;
  nFrameEnd : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nSubOffset := nStartIndex + 5;
nFrameEnd := UINT_TO_UDINT(nStartIndex) + nFrameLength;

WHILE (nSubOffset + 5) <= nFrameEnd DO
  nSubLength := ReadBigEndianUDInt(nStartIndex := nSubOffset);

  IF (nSubLength < 5) OR ((nSubOffset + nSubLength) > nFrameEnd) THEN
    bPrimaryError := TRUE;
    nPrimaryErrorId := 16#E635;
    sPrimaryError := 'Invalid Primary sub-package';
    RETURN;
  END_IF

  CASE aPrimaryRx[nSubOffset + 4] OF
    C_PRIMARY_ROBOT_MODE_DATA:
      IF nSubLength >= 26 THEN
        xPrimaryRobotConnected := aPrimaryRx[nSubOffset + 13] <> 0;
        xPrimaryRobotEnabled := aPrimaryRx[nSubOffset + 14] <> 0;
        xPrimaryRobotPowerOn := aPrimaryRx[nSubOffset + 15] <> 0;
        xPrimaryEmergencyStopped := aPrimaryRx[nSubOffset + 16] <> 0;
        xPrimaryProtectiveStopped := aPrimaryRx[nSubOffset + 17] <> 0;
        xPrimaryProgramRunning := aPrimaryRx[nSubOffset + 18] <> 0;
      END_IF

    C_PRIMARY_CARTESIAN_INFO:
      IF nSubLength >= 53 THEN
        _tcppos.x := ReadBigEndianLReal(nStartIndex := nSubOffset + 5)*1000;
        _tcppos.y := ReadBigEndianLReal(nStartIndex := nSubOffset + 13)*1000;
        _tcppos.z := ReadBigEndianLReal(nStartIndex := nSubOffset + 21)*1000;
        _tcppos.rx := ReadBigEndianLReal(nStartIndex := nSubOffset + 29);
        _tcppos.ry := ReadBigEndianLReal(nStartIndex := nSubOffset + 37);
        _tcppos.rz := ReadBigEndianLReal(nStartIndex := nSubOffset + 45);
      END_IF
  END_CASE

  nSubOffset := nSubOffset + UDINT_TO_UINT(nSubLength);
END_WHILE

bPrimaryStateSeen := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessRtdeReceive" Id="{afe956db-ec85-4884-b83f-95345a80b4ae}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ProcessRtdeReceive
VAR
  nOffset : UINT;
  nFrameLength : UINT;
  nIndex : UINT;
  sExpectedOutputTypes : STRING(80) := 'VECTOR6D,VECTOR6D,INT32,INT32,INT32,INT32';
  sExpectedInputTypes : STRING(120) := 'INT32,INT32,INT32,INT32,INT32,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE';
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRtdeDataReceived := FALSE;

IF COMM_Rtde.bRxNewData THEN
        IF (UINT_TO_UDINT(nRtdeRxBytes) + COMM_Rtde.nRxBytes) > UINT_TO_UDINT(SIZEOF(aRtdeRx)) THEN
    bRtdeError := TRUE;
    nRtdeErrorId := 16#E620;
    sRtdeError := 'RTDE receive buffer overflow';
    nRtdeRxBytes := 0;
    RETURN;
  END_IF

  MEMCPY(
    destAddr := ADR(aRtdeRx[nRtdeRxBytes]),
    srcAddr := COMM_Rtde.RxData,
    n := COMM_Rtde.nRxBytes
  );
  nRtdeRxBytes := UDINT_TO_UINT(UINT_TO_UDINT(nRtdeRxBytes) + COMM_Rtde.nRxBytes);
END_IF

nOffset := 0;
WHILE (nRtdeRxBytes - nOffset) >= 3 DO
  nFrameLength := SHL(BYTE_TO_UINT(aRtdeRx[nOffset]), 8) + BYTE_TO_UINT(aRtdeRx[nOffset + 1]);

  IF nFrameLength < 3 THEN
    bRtdeError := TRUE;
    nRtdeErrorId := 16#E621;
    sRtdeError := 'Invalid RTDE frame length';
    nRtdeRxBytes := 0;
    RETURN;
  END_IF

  IF nFrameLength > SIZEOF(aRtdeRx) THEN
    bRtdeError := TRUE;
    nRtdeErrorId := 16#E626;
    sRtdeError := 'RTDE frame exceeds buffer';
    nRtdeRxBytes := 0;
    RETURN;
  END_IF

  IF (nRtdeRxBytes - nOffset) < nFrameLength THEN
    EXIT;
  END_IF

  CASE aRtdeRx[nOffset + 2] OF
    C_RTDE_REQUEST_PROTOCOL_VERSION:
      IF ((nRtdeState = C_RTDE_SEND_PROTOCOL) OR (nRtdeState = C_RTDE_WAIT_PROTOCOL))
         AND (nFrameLength = 4) AND (aRtdeRx[nOffset + 3] = 1) THEN
        bRtdeProtocolAccepted := TRUE;
      ELSE
        bRtdeError := TRUE;
        nRtdeErrorId := 16#E622;
        sRtdeError := 'RTDE protocol version rejected';
      END_IF

    C_RTDE_SETUP_OUTPUTS:
      IF ((nRtdeState = C_RTDE_SEND_OUTPUTS) OR (nRtdeState = C_RTDE_WAIT_OUTPUTS))
         AND (nFrameLength = LEN(sExpectedOutputTypes) + 4)
         AND (aRtdeRx[nOffset + 3] <> 0)
         AND RtdePayloadMatches(
           nStartIndex := nOffset + 4,
           pExpected := ADR(sExpectedOutputTypes),
           nExpectedLength := LEN(sExpectedOutputTypes)
         ) THEN
        bRtdeOutputConfigured := TRUE;
        nRtdeOutputRecipeId := aRtdeRx[nOffset + 3];
      ELSE
        bRtdeError := TRUE;
        nRtdeErrorId := 16#E623;
        sRtdeError := 'RTDE output recipe rejected';
      END_IF

    C_RTDE_SETUP_INPUTS:
      IF ((nRtdeState = C_RTDE_SEND_INPUTS) OR (nRtdeState = C_RTDE_WAIT_INPUTS))
         AND (nFrameLength = LEN(sExpectedInputTypes) + 4)
         AND (aRtdeRx[nOffset + 3] <> 0)
         AND RtdePayloadMatches(
           nStartIndex := nOffset + 4,
           pExpected := ADR(sExpectedInputTypes),
           nExpectedLength := LEN(sExpectedInputTypes)
         ) THEN
        bRtdeInputConfigured := TRUE;
        nRtdeInputRecipeId := aRtdeRx[nOffset + 3];
      ELSE
        bRtdeError := TRUE;
        nRtdeErrorId := 16#E625;
        sRtdeError := 'RTDE input recipe rejected';
      END_IF

    C_RTDE_START:
      IF ((nRtdeState = C_RTDE_SEND_START) OR (nRtdeState = C_RTDE_WAIT_START))
         AND (nFrameLength = 4) AND (aRtdeRx[nOffset + 3] = 1) THEN
        bRtdeStarted := TRUE;
        nRtdeState := C_RTDE_STREAMING;
      ELSE
        bRtdeError := TRUE;
        nRtdeErrorId := 16#E624;
        sRtdeError := 'RTDE start rejected';
      END_IF

    C_RTDE_DATA_PACKAGE:
      IF (nRtdeState = C_RTDE_STREAMING)
         AND (nFrameLength = C_RTDE_DATA_FRAME_SIZE)
         AND (aRtdeRx[nOffset + 3] = nRtdeOutputRecipeId) THEN
        bRtdeDataReceived := TRUE;
        _tcppos.x := ReadNetworkLReal(nStartIndex := nOffset + 4)*1000;
        _tcppos.y := ReadNetworkLReal(nStartIndex := nOffset + 12)*1000;
        _tcppos.z := ReadNetworkLReal(nStartIndex := nOffset + 20)*1000;
        _tcppos.rx := ReadNetworkLReal(nStartIndex := nOffset + 28);
        _tcppos.ry := ReadNetworkLReal(nStartIndex := nOffset + 36);
        _tcppos.rz := ReadNetworkLReal(nStartIndex := nOffset + 44);
        _jointpos.joint1 := ReadNetworkLReal(nStartIndex := nOffset + 52);
        _jointpos.joint2 := ReadNetworkLReal(nStartIndex := nOffset + 60);
        _jointpos.joint3 := ReadNetworkLReal(nStartIndex := nOffset + 68);
        _jointpos.joint4 := ReadNetworkLReal(nStartIndex := nOffset + 76);
        _jointpos.joint5 := ReadNetworkLReal(nStartIndex := nOffset + 84);
        _jointpos.joint6 := ReadNetworkLReal(nStartIndex := nOffset + 92);
        nRtdeAcceptedId := ReadNetworkUDInt(nStartIndex := nOffset + 100);
        nRtdeCompletedId := ReadNetworkUDInt(nStartIndex := nOffset + 104);
        nRtdeCommandError := ReadNetworkUDInt(nStartIndex := nOffset + 108);
        xRtdeCommandExecuting := ReadNetworkUDInt(nStartIndex := nOffset + 112) <> 0;
      ELSIF nRtdeState = C_RTDE_STREAMING THEN
        bRtdeError := TRUE;
        nRtdeErrorId := 16#E627;
        sRtdeError := 'Invalid RTDE data recipe';
      END_IF
  END_CASE

  nOffset := nOffset + nFrameLength;
END_WHILE

IF nOffset = nRtdeRxBytes THEN
  nRtdeRxBytes := 0;
ELSIF nOffset > 0 THEN
  FOR nIndex := nOffset TO nRtdeRxBytes - 1 DO
    aRtdeRx[nIndex - nOffset] := aRtdeRx[nIndex];
  END_FOR
  nRtdeRxBytes := nRtdeRxBytes - nOffset;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadBigEndianLReal" Id="{22c3c9b1-e163-4ebd-9f5c-901f5fcbfeaf}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ReadBigEndianLReal : LREAL
VAR_INPUT
  nStartIndex : UINT;
END_VAR
VAR
  aValueBytes : ARRAY[0..7] OF BYTE;
  nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// UR doubles arrive MSB first; TwinCAT LREAL memory is little-endian.
FOR nIndex := 0 TO 7 DO
  aValueBytes[nIndex] := aPrimaryRx[nStartIndex + 7 - nIndex];
END_FOR

MEMCPY(
  destAddr := ADR(ReadBigEndianLReal),
  srcAddr := ADR(aValueBytes),
  n := SIZEOF(ReadBigEndianLReal)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadBigEndianUDInt" Id="{769a3c7c-c5a6-4577-b797-81545908b483}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ReadBigEndianUDInt : UDINT
VAR_INPUT
  nStartIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// UR length fields are network byte order: MSB first.
ReadBigEndianUDInt :=
  SHL(BYTE_TO_UDINT(aPrimaryRx[nStartIndex]), 24) +
  SHL(BYTE_TO_UDINT(aPrimaryRx[nStartIndex + 1]), 16) +
  SHL(BYTE_TO_UDINT(aPrimaryRx[nStartIndex + 2]), 8) +
  BYTE_TO_UDINT(aPrimaryRx[nStartIndex + 3]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadNetworkLReal" Id="{137a1ad2-5cd1-4438-bb34-efc5870942ca}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ReadNetworkLReal : LREAL
VAR_INPUT
  nStartIndex : UINT;
END_VAR
VAR
  aValueBytes : ARRAY[0..7] OF BYTE;
  nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR nIndex := 0 TO 7 DO
  aValueBytes[nIndex] := aRtdeRx[nStartIndex + 7 - nIndex];
END_FOR

MEMCPY(
  destAddr := ADR(ReadNetworkLReal),
  srcAddr := ADR(aValueBytes),
  n := SIZEOF(ReadNetworkLReal)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadNetworkUDInt" Id="{a67dc41d-cab7-4e2b-9f07-ec8ff7bb4c3c}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ReadNetworkUDInt : UDINT
VAR_INPUT
  nStartIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReadNetworkUDInt :=
  SHL(BYTE_TO_UDINT(aRtdeRx[nStartIndex]), 24) +
  SHL(BYTE_TO_UDINT(aRtdeRx[nStartIndex + 1]), 16) +
  SHL(BYTE_TO_UDINT(aRtdeRx[nStartIndex + 2]), 8) +
  BYTE_TO_UDINT(aRtdeRx[nStartIndex + 3]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetConnection" Id="{ab760c43-0912-46a9-8200-3ef0d14f05e9}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD ResetConnection : BOOL
    <Method Name="ResetConnection" Id="{ab760c43-0912-46a9-8200-3ef0d14f05e9}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD ResetConnection : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_resetCommunication := TRUE;
    ResetConnection := TRUE;]]></ST>
        <ST><![CDATA[_resetCommunication := TRUE;
    ResetConnection := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetPrimarySession" Id="{899aef5b-5b2f-4853-97d0-cbc527440a1e}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ResetPrimarySession
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nPrimaryRxBytes := 0;
bPrimaryStateSeen := FALSE;
xPrimaryRobotConnected := FALSE;
xPrimaryRobotEnabled := FALSE;
xPrimaryRobotPowerOn := FALSE;
xPrimaryEmergencyStopped := FALSE;
xPrimaryProtectiveStopped := FALSE;
xPrimaryProgramRunning := FALSE;
bPrimaryError := FALSE;
nPrimaryErrorId := 0;
sPrimaryError := '';]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetRtdeSession" Id="{b6b8e1e9-eb93-46c9-bec0-437629bc0a43}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE ResetRtdeSession
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nRtdeState := C_RTDE_WAIT_TCP;
nRtdeTxSize := 0;
nRtdeRxBytes := 0;
      bRtdeRequestPending := FALSE;
      bRtdeDataReceived := FALSE;
bRtdeProtocolAccepted := FALSE;
bRtdeOutputConfigured := FALSE;
bRtdeInputConfigured := FALSE;
bRtdeStarted := FALSE;
bRtdeError := FALSE;
nRtdeErrorId := 0;
nRtdeOutputRecipeId := 0;
nRtdeInputRecipeId := 0;
nRtdeAcceptedId := 0;
nRtdeCompletedId := 0;
nRtdeCommandError := 0;
xRtdeCommandExecuting := FALSE;
sRtdeError := '';]]></ST>
      </Implementation>
    </Method>
    <Method Name="RtdePayloadMatches" Id="{f16e1321-8d8f-4fa7-91f5-3ea4dc94cc6f}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE RtdePayloadMatches : BOOL
VAR_INPUT
  nStartIndex : UINT;
  pExpected : POINTER TO BYTE;
  nExpectedLength : UINT;
END_VAR
VAR
  nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RtdePayloadMatches := FALSE;

IF (pExpected = 0)
   OR ((UINT_TO_UDINT(nStartIndex) + UINT_TO_UDINT(nExpectedLength)) > SIZEOF(aRtdeRx)) THEN
  RETURN;
END_IF

FOR nIndex := 0 TO nExpectedLength - 1 DO
  IF aRtdeRx[nStartIndex + nIndex] <> pExpected[nIndex] THEN
    RETURN;
  END_IF
END_FOR

RtdePayloadMatches := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteNetworkLReal" Id="{a9e9d18d-8892-43db-a3be-d5f9ff15ef3a}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE WriteNetworkLReal
VAR_INPUT
  nStartIndex : UINT;
  lrValue : LREAL;
END_VAR
VAR
  aValueBytes : ARRAY[0..7] OF BYTE;
  nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMCPY(destAddr := ADR(aValueBytes), srcAddr := ADR(lrValue), n := SIZEOF(lrValue));
FOR nIndex := 0 TO 7 DO
  aRtdeTx[nStartIndex + nIndex] := aValueBytes[7 - nIndex];
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteNetworkUDInt" Id="{cd0841aa-7fd6-44e5-93f6-0962aafc87c7}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD PRIVATE WriteNetworkUDInt
VAR_INPUT
  nStartIndex : UINT;
  nValue : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[aRtdeTx[nStartIndex] := UDINT_TO_BYTE(SHR(nValue, 24));
aRtdeTx[nStartIndex + 1] := UDINT_TO_BYTE(SHR(nValue, 16));
aRtdeTx[nStartIndex + 2] := UDINT_TO_BYTE(SHR(nValue, 8));
aRtdeTx[nStartIndex + 3] := UDINT_TO_BYTE(nValue);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>