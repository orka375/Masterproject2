    <Method Name="OnError" Id="{74c0a508-94ea-4785-a0ea-1af2639ff5e5}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
    VAR
      bParentOk : BOOL;
      eParentResult : eResult;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();
      bParentOk := eParentResult = eResult.SUCCESS;
      IF NOT bParentOk THEN
        ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_OmronLD90.OnError: parent OnError failed', '');
        OnError := eParentResult;
        RETURN;
      END_IF

      OnError := eResult.SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{f496723a-9c1c-413c-b4ed-4d78c56c0863}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
    VAR
      bParentOk : BOOL;
      eParentResult : eResult;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();
      bParentOk := eParentResult = eResult.SUCCESS;
      IF NOT bParentOk THEN
        ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_OmronLD90.OnShutdown: parent OnShutdown failed', '');
        OnShutdown := eParentResult;
        RETURN;
      END_IF

      Disconnect();

    IF eConnectionState <> eCommunicationState.DISCONNECTED THEN
      OnShutdown := eResult.None;
    ELSIF bError THEN
      OnShutdown := eResult.ERROR;
    ELSE
      OnShutdown := eResult.SUCCESS;
    END_IF]]></ST>
      </Implementation>
    </Method>
