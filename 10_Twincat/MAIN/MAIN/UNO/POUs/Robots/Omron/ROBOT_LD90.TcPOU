    <Method Name="OnActivate" Id="{7fa92802-2ede-4193-9973-ad7754d17239}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
    VAR
      bParentOk : BOOL;
      eParentResult : eResult;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
bParentOk := eParentResult = eResult.SUCCESS;
IF NOT bParentOk THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_OmronLD90.OnActivate: parent OnActivate failed', '');
	OnActivate := eParentResult;
	RETURN;
END_IF

      IF bError THEN
    OnActivate := eResult.ERROR;
    ELSIF Connected THEN
      OnActivate := eResult.SUCCESS;
ELSE
      OnActivate := eResult.None;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{7747948a-f8e1-4cdb-8a20-610ab536a0ef}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
    VAR
      bParentOk : BOOL;
      eParentResult : eResult;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnCleanup();
      bParentOk := eParentResult = eResult.SUCCESS;
      IF NOT bParentOk THEN
        ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_OmronLD90.OnCleanup: parent OnCleanup failed', '');
        OnCleanup := eParentResult;
        RETURN;
      END_IF

      Disconnect();

    IF eConnectionState <> eCommunicationState.DISCONNECTED THEN
      OnCleanup := eResult.None;
    ELSE
      OnCleanup := eResult.SUCCESS;
    END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{c568c508-6321-435c-b7c4-683ad73a8f42}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
    VAR
      bParentOk : BOOL;
      eParentResult : eResult;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
      bParentOk := eParentResult = eResult.SUCCESS;
      IF NOT bParentOk THEN
        ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'FB_OmronLD90.OnConfigure: parent OnConfigure failed', '');
        OnConfigure := eParentResult;
        RETURN;
      END_IF

      Connect();

    IF bError THEN
      OnConfigure := eResult.ERROR;
    ELSIF Connected THEN
      OnConfigure := eResult.SUCCESS;
    ELSE
      OnConfigure := eResult.None;
    END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{57ce1156-6b80-40b7-8fff-100660e6e779}" FolderPath="StateControl\">
