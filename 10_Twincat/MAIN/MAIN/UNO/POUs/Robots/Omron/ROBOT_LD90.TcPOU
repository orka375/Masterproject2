<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="ROBOT_LD90" Id="{fac74160-c2b3-4f77-bd69-eddf1970c653}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ROBOT_LD90 EXTENDS FB_2_ROB_AMR IMPLEMENTS ITF_CommunicationModul
VAR_INPUT
	


	sLoadDeliverReturn: Skill_LoadDeliverReturn;
	sEyes: Skill_ROS2_Eyes;
	ComConfig: ST_CommunicationConfig;
END_VAR
VAR_OUTPUT
  SocketErrorId: UDINT;
END_VAR
VAR
	MissionIndex: INT;
	oldMissionIndex: INT;
	waitTimer: TON;
  fbSocketConnect: FB_SocketConnect;
  fbSocketClose: FB_SocketClose;
  hSocket: T_HSOCKET;
  eConnectionState: eCommunicationState := eCommunicationState.DISCONNECTED;
  _connected: BOOL;
  xConnectRequest: BOOL;
  xDisconnectRequest: BOOL;
  xSocketConnectExecute: BOOL;
  xSocketCloseExecute: BOOL;
  xSocketConnectStarted: BOOL;
  xSocketCloseStarted: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_AMR();

ComMachine();

//-------- SKILL SETUP ---------


pA_Skills[1]:=ADR(sLoadDeliverReturn);
pA_Skills[2]:=ADR(sEyes);

sEyes();
sLoadDeliverReturn(Rob:=ADR(THIS^));


//------------------------------------

IF MissionIndex<>oldMissionIndex THEN
	waitTimer(IN:=TRUE, PT:=T#4S);
	oldMissionIndex:=MissionIndex;
END_IF
waitTimer();
IF waitTimer.Q THEN
	waitTimer(IN:=FALSE);
	TargetReached:=TRUE;
	ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_HINT,
    msgFmtStr   := 'Simulated target reached!',
    strArg      := ''
);
	
END_IF]]></ST>
    </Implementation>
    <Folder Name="Communication" Id="{2a9c337e-719c-4121-a5a9-4ddfd8584a43}" />
    <Folder Name="MotionControl" Id="{94b27a46-e651-4eff-a38f-a2a3d5ee10b5}" />
    <Folder Name="StateControl" Id="{67994def-610e-4a0b-a6c8-85df31e22884}" />
    <Method Name="ComMachine" Id="{040d86b8-c78e-42d4-a5c1-25c0270b6e14}" FolderPath="Communication\">
      <Declaration><![CDATA[METHOD ComMachine : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eConnectionState OF


    // =========================================================
    // DISCONNECTED
    // =========================================================

    eCommunicationState.DISCONNECTED:

       _connected := FALSE;


        // Make sure socket handle is cleared
//         hSocket


        // -----------------------------------------------------
        // Connect requested
        // -----------------------------------------------------

        IF xConnectRequest THEN

            xConnectRequest := FALSE;

            // Clear previous errors
            bError := FALSE;
            nErrorId := 0;
            SocketErrorId := 0;

            // Start FB_SocketConnect
            xSocketConnectExecute := TRUE;
            xSocketConnectStarted := TRUE;

            eConnectionState :=
                eCommunicationState.CONNECTING;

        END_IF;


    // =========================================================
    // CONNECTING
    // =========================================================

    eCommunicationState.CONNECTING:

        _connected := FALSE;
        


        // -----------------------------------------------------
        // Execute FB_SocketConnect
        // -----------------------------------------------------

        fbSocketConnect(
            sSrvNetId := '',
            sRemoteHost := ComConfig.sIpAddress,
            nRemotePort := ComConfig.nPort,
            bExecute := xSocketConnectExecute,
            tTimeout := ComConfig.tTimeout
        );


        // Execute must only be TRUE for one cycle
        xSocketConnectExecute := FALSE;


        // -----------------------------------------------------
        // Connection successful
        // -----------------------------------------------------

        IF xSocketConnectStarted
          AND NOT fbSocketConnect.bBusy
            AND NOT fbSocketConnect.bError
//             AND (fbSocketConnect.hSocket <> 0)
        THEN

            hSocket :=
                fbSocketConnect.hSocket;

            _connected := TRUE;
            xSocketConnectStarted := FALSE;
    

            bError := FALSE;
            nErrorId := 0;
            SocketErrorId := 0;

            eConnectionState :=
                eCommunicationState.CONNECTED;

        END_IF;


        // -----------------------------------------------------
        // Connection failed
        // -----------------------------------------------------

        IF NOT fbSocketConnect.bBusy
            AND fbSocketConnect.bError
        THEN

            _connected := FALSE;
          xSocketConnectStarted := FALSE;

            bError := TRUE;

            SocketErrorId :=
                fbSocketConnect.nErrId;

            nErrorId :=
                TO_UINT(fbSocketConnect.nErrId);

//             hSocket := 0;

            eConnectionState :=
                eCommunicationState.ERROR;

        END_IF;


    // =========================================================
    // CONNECTED
    // =========================================================

    eCommunicationState.CONNECTED:

        _connected := TRUE;



        // -----------------------------------------------------
        // Disconnect requested
        // -----------------------------------------------------

        IF xDisconnectRequest THEN

            xDisconnectRequest := FALSE;


            // Start socket close
            xSocketCloseExecute := TRUE;
            xSocketCloseStarted := TRUE;

            eConnectionState :=
                eCommunicationState.DISCONNECTING;

        END_IF;


    // =========================================================
    // DISCONNECTING
    // =========================================================

    eCommunicationState.DISCONNECTING:

        _connected := FALSE;


        // -----------------------------------------------------
        // Execute FB_SocketClose
        // -----------------------------------------------------

        fbSocketClose(
            sSrvNetId := '',
            hSocket := hSocket,
            bExecute := xSocketCloseExecute,
            tTimeout := ComConfig.tTimeout
        );


        // Execute only for one cycle
        xSocketCloseExecute := FALSE;


        // -----------------------------------------------------
        // Socket closed successfully
        // -----------------------------------------------------

        IF xSocketCloseStarted
          AND NOT fbSocketClose.bBusy
            AND NOT fbSocketClose.bError
        THEN

            _connected := FALSE;


            xSocketCloseStarted := FALSE;

            eConnectionState :=
                eCommunicationState.DISCONNECTED;

        END_IF;


        // -----------------------------------------------------
        // Socket close failed
        // -----------------------------------------------------

        IF NOT fbSocketClose.bBusy
            AND fbSocketClose.bError
        THEN

            _connected := FALSE;
          xSocketCloseStarted := FALSE;


            bError := TRUE;

            SocketErrorId :=
                fbSocketClose.nErrId;

            nErrorId :=
                TO_UINT(fbSocketClose.nErrId);

            // The socket should no longer be used
//             hSocket := 0;

            eConnectionState :=
                eCommunicationState.ERROR;

        END_IF;


    // =========================================================
    // ERROR
    // =========================================================

    eCommunicationState.ERROR:

        _connected := FALSE;
        // -----------------------------------------------------
        // Do not attempt to use the socket after an error
        // -----------------------------------------------------

//         hSocket := 0;


        // -----------------------------------------------------
        // A new connection request can recover from the error
        // -----------------------------------------------------

        IF xConnectRequest THEN

            xConnectRequest := FALSE;

            bError := FALSE;
            nErrorId := 0;
            SocketErrorId := 0;

            xSocketConnectExecute := TRUE;
            xSocketConnectStarted := TRUE;

            eConnectionState :=
                eCommunicationState.CONNECTING;

        END_IF;


END_CASE;

CommunicationReady := _connected;
ComMachine := NOT bError;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Connect" Id="{70fa978a-67c6-43be-99fb-d03c8689cf07}" FolderPath="Communication\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Connect : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
Connect := FALSE;

// Already connected
IF eConnectionState = eCommunicationState.CONNECTED THEN
    Connect := TRUE;
    RETURN;
END_IF;

// Already trying to connect
IF eConnectionState = eCommunicationState.CONNECTING THEN
    Connect := TRUE;
    RETURN;
END_IF;

// Don't accept a new connection while disconnecting
IF eConnectionState = eCommunicationState.DISCONNECTING THEN
    RETURN;
END_IF;

// Validate address
IF LEN(ComConfig.sIpAddress) = 0 THEN
    bError := TRUE;
//     ErrorId := 16#1001;
    RETURN;
END_IF;

// Validate port
IF ComConfig.nPort = 0 THEN
    bError := TRUE;
//     ErrorId := 16#1002;
    RETURN;
END_IF;

// Clear previous error
bError := FALSE;
nErrorId := 0;

// Request connection
xConnectRequest := TRUE;

Connect := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Connected" Id="{e71d8962-d52b-46f4-b79d-88e001b39f65}" FolderPath="Communication\">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY Connected : BOOL
]]></Declaration>
      <Get Name="Get" Id="{1724321d-02c7-40cd-942a-414eba41ba06}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Connected:=_connected;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Disconnect" Id="{c75c2374-9ebb-4dd8-a5bc-f61f0a69c931}" FolderPath="Communication\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Disconnect : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eConnectionState = eCommunicationState.DISCONNECTED THEN
      Disconnect := TRUE;
      RETURN;
    END_IF

    xConnectRequest := FALSE;
    xDisconnectRequest := TRUE;
    Disconnect := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Dock" Id="{ed889dfa-89d4-4c82-aa20-11f1706e94ee}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD Dock : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Dock := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="NavigateToGoal" Id="{bbbc983d-cf30-4dcf-8a44-55f25ea52986}" FolderPath="MotionControl\">
      <Declaration><![CDATA[
  METHOD NavigateToGoal : BOOL
VAR_INPUT
    goal : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[NavigateToGoal := FALSE;

  ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_HINT,
    msgFmtStr   := 'Goes to goal %s',
    strArg      := goal
);

TargetReached:=FALSE;
MissionIndex:=MissionIndex+1;
  NavigateToGoal := TRUE;
]]></ST>
      </Implementation>
    </Method>
