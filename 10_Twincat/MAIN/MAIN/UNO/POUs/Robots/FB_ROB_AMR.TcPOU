    <Method Name="OnActivate" Id="{87bcfeb5-637b-4246-b013-c7747d0d3053}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bError THEN
    OnActivate := eResult.ERROR;
    ELSIF CommunicationReady THEN
      OnActivate := eResult.SUCCESS;
ELSE
      OnActivate := eResult.None;
END_IF]]></ST>
      </Implementation>
    </Method>
