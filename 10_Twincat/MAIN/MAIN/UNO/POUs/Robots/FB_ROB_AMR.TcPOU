    <Action Name="CYCLIC_AMR" Id="{ebcfe1a2-a428-4cd0-a9d1-512be0cd10b6}">
      <Implementation>
        <ST><![CDATA[CYCLIC_ROB();

visStatus.State:=eStatus;
visStatus.Mode:=eModus;
visStatus.isMoving:=RobotMoving;
visStatus.isReady:=RobotReady;
visStatus.isConnected:=CommunicationReady;
// 	isLocked: BOOL;
// visStatus.isBusy:=;
visStatus.isInCollision:=Collision;
visStatus.hasError:=bError;
visStatus.TCPPosition:=ActualTcpPose;

visStatus.isDocked:=IsDocked;
visStatus.TargetReached:=TargetReached;]]></ST>
      </Implementation>
    </Action>
