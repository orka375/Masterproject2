    <Method Name="OnError" Id="{7a846a43-e5f1-4e60-b878-bf1f3c5633d0}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

Messenger.AddWarn(eMessageCategories.Undefined, sSender:=Name, sMessage:= 'OnError executing: resetting connection');
succ := Reset();
IF succ THEN
	myResult:=NONE;
ELSE
	myResult:=FAILURE;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnError := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{2f41cb60-ac89-4bad-950e-538f034a5d15}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

    VAR
    	eParentResult: eResult;
    	myResult: ERESULT;
    END_VAR

    VAR //YOUR CODE
    	succ : BOOL;
    END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();
    //--------------------------------------------------
    myResult:=NONE;
    // ----- YOUR CODE HERE (incl. Alarms) -------------

    succ := Disconnect();
    IF succ THEN
    	myResult:=NONE;
    ELSE
    	myResult:=FAILURE;
    END_IF

    // ----- END YOUR CODE -----------------------------
    //--------------------------------------------------
    OnShutdown := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
