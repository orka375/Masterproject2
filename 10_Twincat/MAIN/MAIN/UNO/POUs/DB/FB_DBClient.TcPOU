<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_DBClient" Id="{03dd5829-1fb0-409d-8c46-5038977b4180}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DBClient
// VAR_INPUT
// 	    sDriver : STRING := 'PostgreSQL Unicode(x64)';
//         sServer : STRING := '192.168.250.102';
// 		sDatabaseServerNetID : STRING := '192.168.250.100.1.1';
//         nPort : UINT:= 5432;
//         sDatabase : STRING := 'robotdata';
//         sUser : STRING := 'admin';
//         sPassword : STRING := '1';
// 		
// 		
// END_VAR
// 
// VAR_OUTPUT
//     bBusy       : BOOL;
//     bDone       : BOOL;
//     bError      : BOOL;
//     bConnected  : BOOL;
//     bConfigured : BOOL;
// 
//     // Database ID generated by TF6420
//     hDBID       : UDINT;
// 
//     // Tc2_Database ADS/configuration errors.
//     // SQL Expert API errors are available through ipTcResult.
//     nErrorID    : UDINT;
// 
//     sLastOperation : STRING(80);
// END_VAR
// 
// VAR
//     // ---------------------------------------------------------
//     // Tc2_Database
//     // Dynamic ODBC configuration
//     // ---------------------------------------------------------
//     fbOdbcAdd :
//         FB_DBOdbcConnectionAdd;
// 
//     fbReloadConfig :
//         FB_DBReloadConfig;
// 
// 
//     // ---------------------------------------------------------
//     // Tc3_Database
//     // SQL Expert API
//     // ---------------------------------------------------------
//     fbSqlDatabase :
//         FB_SQLDatabaseEvt(
//             sNetID := '',
//             tTimeout := T#10S
//         );
// 
//     fbSqlCommand :
//         FB_SQLCommandEvt(
//             sNetID := '',
//             tTimeout := T#10S
//         );
// 
//     fbSqlResult :
//         FB_SQLResultEvt(
//             sNetID := '',
//             tTimeout := T#10S
//         );
// 
// 
//     // ---------------------------------------------------------
//     // State machine
//     // ---------------------------------------------------------
//     eState : E_DBClientState := E_DBClientState.DBCLIENT_IDLE;
// 
// 
//     // ---------------------------------------------------------
//     // Latched ODBC configuration
//     // ---------------------------------------------------------
//     sCfgDriver   : STRING(255);
//     sCfgNetID    : STRING(23);
//     sCfgServer   : STRING(255);
//     sCfgDatabase : STRING(255);
//     nCfgPort     : UDINT;
// 
//     sCfgUser     : STRING(255);
//     sCfgPassword : STRING(255);
//     sCfgSchema   : STRING(255);
// 
// 
//     // ---------------------------------------------------------
//     // SQL working buffer
//     // ---------------------------------------------------------
//     sSqlWork : STRING(4095);
// 
// 
//     // ---------------------------------------------------------
//     // Generic query destination
//     // ---------------------------------------------------------
//     pReadData        : POINTER TO BYTE;
//     cbReadData       : UDINT;
//     nReadStartIndex  : UDINT;
//     nReadRecordCount : UDINT;
// END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// // bDone is a one-cycle pulse
// bDone := FALSE;
// 
// 
// CASE eState OF
// 
// 
// // =============================================================
// // IDLE
// // =============================================================
// E_DBClientState.DBCLIENT_IDLE:
// 
//     bBusy := FALSE;
// 
// 
// // =============================================================
// // CREATE ODBC POSTGRESQL CONFIGURATION
// // =============================================================
// E_DBClientState.DBCLIENT_ODBC_START:
// 
//     bBusy := TRUE;
//     ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: create ODBC configuration', '');
// 
//     fbOdbcAdd(
//         sNetID        := sCfgNetID,
// 
//         eDBType       := eDBType_ODBC_PostgreSQL,
//         eDBValueType  := eDBValue_Bytes,
// 
//         sDBDriver     := sCfgDriver,
//         sDBServer     := sCfgServer,
//         sDBDatabase   := sCfgDatabase,
//         nDBPort       := nCfgPort,
// 
//         sDBProtocol   := 'TCPIP',
// 
//         sDBUserId     := sCfgUser,
//         sDBPassword   := sCfgPassword,
// 
//         sDBScheme     := sCfgSchema,
// 
//         // PostgreSQL does not use these
//         sDBSequence   := '',
//         sDBClientDll  := '',
// 
//         // Not required for SQL Expert mode
//         sDBTable      := '',
// 
//         bExecute      := TRUE,
//         tTimeout      := T#15S
//     );
// 
//     eState := E_DBClientState.DBCLIENT_ODBC_WAIT;
// 
// 
// // -------------------------------------------------------------
// E_DBClientState.DBCLIENT_ODBC_WAIT:
// 
//     // Keep calling the FB cyclically while the request is active
//     fbOdbcAdd(
//         bExecute := TRUE
//     );
// 
//     IF NOT fbOdbcAdd.bBusy THEN
// 
//         IF fbOdbcAdd.bError THEN
// 
//             bError := TRUE;
// 
//             // Yes, Beckhoff actually names this output bErrID
//             // in FB_DBOdbcConnectionAdd.
//             nErrorID := fbOdbcAdd.nErrID;
// 
//             bBusy := FALSE;
//             sLastOperation := 'ODBC configuration failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: ODBC configuration failed, error %s', UDINT_TO_STRING(nErrorID));
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             // Save dynamically generated database ID
//             hDBID := fbOdbcAdd.hDBID;
//             ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: ODBC configuration created, hDBID %s', UDINT_TO_STRING(hDBID));
// 
//             eState := E_DBClientState.DBCLIENT_ODBC_RESET;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // -------------------------------------------------------------
// E_DBClientState.DBCLIENT_ODBC_RESET:
// 
//     // Reset rising-edge input
//     fbOdbcAdd(
//         bExecute := FALSE
//     );
// 
//     // The XML configuration changed, therefore reload it.
//     eState := E_DBClientState.DBCLIENT_RELOAD_START;
// 
// 
// // =============================================================
// // RELOAD DATABASE SERVER CONFIGURATION
// // =============================================================
// E_DBClientState.DBCLIENT_RELOAD_START:
// 
//     ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: reload Database Server configuration', '');
//     fbReloadConfig(
//         sNetID   := '',
//         bExecute := TRUE,
//         tTimeout := T#15S
//     );
// 
//     eState := E_DBClientState.DBCLIENT_RELOAD_WAIT;
// 
// 
// // -------------------------------------------------------------
// E_DBClientState.DBCLIENT_RELOAD_WAIT:
// 
//     fbReloadConfig(
//         bExecute := TRUE
//     );
// 
//     IF NOT fbReloadConfig.bBusy THEN
// 
//         IF fbReloadConfig.bError THEN
// 
//             bError := TRUE;
//             nErrorID := fbReloadConfig.nErrID;
// 
//             bBusy := FALSE;
//             sLastOperation := 'Database configuration reload failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: configuration reload failed, error %s', UDINT_TO_STRING(nErrorID));
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             eState := E_DBClientState.DBCLIENT_RELOAD_RESET;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // -------------------------------------------------------------
// E_DBClientState.DBCLIENT_RELOAD_RESET:
// 
//     fbReloadConfig(
//         bExecute := FALSE
//     );
// 
//     bConfigured := TRUE;
// 
//     bBusy := FALSE;
//     bDone := TRUE;
// 
//     sLastOperation := 'ODBC configuration created';
//     ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: Database Server configuration reloaded', '');
// 
//     eState := E_DBClientState.DBCLIENT_IDLE;
// 
// 
// // =============================================================
// // CONNECT
// // =============================================================
// E_DBClientState.DBCLIENT_CONNECT:
// 
//     bBusy := TRUE;
// 
//     // Connect() is asynchronous.
//     // It returns TRUE once execution has finished.
//     IF fbSqlDatabase.Connect(hDBID) THEN
// 
//         IF fbSqlDatabase.bError THEN
// 
//             bError := TRUE;
//             nErrorID := 0;
// 
//             bBusy := FALSE;
//             bConnected := FALSE;
// 
//             sLastOperation := 'SQL Connect failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: SQL Connect failed for hDBID %s', UDINT_TO_STRING(hDBID));
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             eState := E_DBClientState.DBCLIENT_CREATE_COMMAND;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // =============================================================
// // CREATE SQL COMMAND OBJECT
// // =============================================================
// E_DBClientState.DBCLIENT_CREATE_COMMAND:
// 
//     // CreateCmd() attaches fbSqlCommand to the connection.
//     // Beckhoff documents this as completing in the same PLC cycle.
//     IF fbSqlDatabase.CreateCmd(
//         ADR(fbSqlCommand)
//     ) THEN
// 
//         IF fbSqlDatabase.bError THEN
// 
//             bError := TRUE;
// 
//             bBusy := FALSE;
//             bConnected := FALSE;
// 
//             sLastOperation := 'CreateCmd failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: CreateCmd failed', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             bConnected := TRUE;
// 
//             bBusy := FALSE;
//             bDone := TRUE;
// 
//             sLastOperation := 'Connected';
//             ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: SQL connection established', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // =============================================================
// // EXECUTE SQL
// //
// // INSERT
// // UPDATE
// // DELETE
// // CREATE
// // ALTER
// // etc.
// // =============================================================
// E_DBClientState.DBCLIENT_EXECUTE:
// 
//     bBusy := TRUE;
// 
//     IF fbSqlCommand.Execute(
//         pSQLCmd  := ADR(sSqlWork),
//         cbSQLCmd := SIZEOF(sSqlWork)
//     ) THEN
// 
//         IF fbSqlCommand.bError THEN
// 
//             bError := TRUE;
//             nErrorID := 0;
// 
//             bBusy := FALSE;
// 
//             sLastOperation := 'SQL Execute failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: SQL execution failed', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             bBusy := FALSE;
//             bDone := TRUE;
// 
//             sLastOperation := 'SQL Execute completed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: SQL execution completed', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // =============================================================
// // EXECUTE SELECT QUERY
// // =============================================================
// E_DBClientState.DBCLIENT_QUERY_EXECUTE:
// 
//     bBusy := TRUE;
// 
//     IF fbSqlCommand.ExecuteDataReturn(
//         pSQLCmd      := ADR(sSqlWork),
//         cbSQLCmd     := SIZEOF(sSqlWork),
//         pSQLDBResult := ADR(fbSqlResult)
//     ) THEN
// 
//         IF fbSqlCommand.bError THEN
// 
//             bError := TRUE;
//             nErrorID := 0;
// 
//             bBusy := FALSE;
// 
//             sLastOperation := 'SQL Query failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: SQL query failed', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             // Result is now cached inside the Database Server.
//             eState := E_DBClientState.DBCLIENT_QUERY_READ;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // =============================================================
// // COPY QUERY RESULT TO PLC MEMORY
// // =============================================================
// E_DBClientState.DBCLIENT_QUERY_READ:
// 
//     IF fbSqlResult.Read(
//         nStartIndex    := nReadStartIndex,
//         nRecordCount   := nReadRecordCount,
// 
//         pData          := pReadData,
//         cbData         := cbReadData,
// 
//         bWithVerifying := FALSE,
// 
//         // Release cached result when finished
//         bDataRelease   := TRUE
//     ) THEN
// 
//         IF fbSqlResult.bError THEN
// 
//             bError := TRUE;
//             nErrorID := 0;
// 
//             bBusy := FALSE;
// 
//             sLastOperation := 'SQL Result read failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: SQL result read failed', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         ELSE
// 
//             bBusy := FALSE;
//             bDone := TRUE;
// 
//             sLastOperation := 'Query completed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: SQL query completed', '');
// 
//             eState := E_DBClientState.DBCLIENT_IDLE;
// 
//         END_IF
// 
//     END_IF
// 
// 
// // =============================================================
// // DISCONNECT
// // =============================================================
// E_DBClientState.DBCLIENT_DISCONNECT:
// 
//     bBusy := TRUE;
// 
//     IF fbSqlDatabase.Disconnect() THEN
// 
//         IF fbSqlDatabase.bError THEN
// 
//             bError := TRUE;
//             nErrorID := 0;
// 
//             sLastOperation := 'Disconnect failed';
//             ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'DBClient: Disconnect failed', '');
// 
//         ELSE
// 
//             bConnected := FALSE;
// 
//             bDone := TRUE;
// 
//             sLastOperation := 'Disconnected';
//             ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient: disconnected', '');
// 
//         END_IF
// 
//         bBusy := FALSE;
// 
//         eState := E_DBClientState.DBCLIENT_IDLE;
// 
//     END_IF
// 
// 
// END_CASE]]></ST>
    </Implementation>
    <Method Name="ConfigurePostgreSQL" Id="{6f82ee04-c4cf-43c2-8161-8755e490eb5b}">
      <Declaration><![CDATA[METHOD PUBLIC ConfigurePostgreSQL : BOOL
VAR_INPUT
    sDriver   : STRING(255);
    sDatabaseServerNetID : STRING(23);
    sServer   : STRING(255);
    nPort     : UDINT;

    sDatabase : STRING(255);

    sUser     : STRING(255);
    sPassword : STRING(255);

    sSchema   : STRING(255);
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[
ConfigurePostgreSQL := FALSE;


// Only accept a new operation while idle
IF (eState = E_DBClientState.DBCLIENT_IDLE)
AND NOT bBusy
AND NOT bConnected THEN

    // Latch the parameters because the actual operation
    // takes multiple PLC cycles.
    sCfgDriver   := sDriver;
    sCfgNetID    := sDatabaseServerNetID;
    sCfgServer   := sServer;
    nCfgPort     := nPort;

    sCfgDatabase := sDatabase;

    sCfgUser     := sUser;
    sCfgPassword := sPassword;

    sCfgSchema   := sSchema;


    bError := FALSE;
    nErrorID := 0;

    bConfigured := FALSE;
    bBusy := TRUE;

    sLastOperation := 'Configure PostgreSQL';
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.ConfigurePostgreSQL accepted for %s', sCfgDatabase);

    eState := DBCLIENT_ODBC_START;

    // TRUE means request was accepted.
    ConfigurePostgreSQL := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Connect" Id="{b0b511e3-5640-45f7-9818-3279f71d3f7f}">
      <Declaration><![CDATA[METHOD Connect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
Connect := FALSE;


IF (eState = DBCLIENT_IDLE)
AND NOT bBusy
AND NOT bError
AND NOT bConnected
AND (hDBID <> 0) THEN

    bBusy := TRUE;

    sLastOperation := 'Connect';
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.Connect accepted, hDBID %s', UDINT_TO_STRING(hDBID));

    eState := DBCLIENT_CONNECT;

    // Request accepted
    Connect := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Disconnect" Id="{4f6ff8e1-230a-499d-9fcd-71a71259b85b}">
      <Declaration><![CDATA[METHOD Disconnect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Disconnect := FALSE;


IF (eState = DBCLIENT_IDLE)
AND NOT bBusy
AND bConnected THEN

    bBusy := TRUE;

    sLastOperation := 'Disconnect';
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.Disconnect accepted', '');

    eState := DBCLIENT_DISCONNECT;

    Disconnect := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{30c24034-7f43-4220-9c59-706f6a308f03}">
      <Declaration><![CDATA[METHOD PUBLIC Execute : BOOL
VAR_INPUT
    sSQL : STRING(4095);
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[
Execute := FALSE;


IF (eState = DBCLIENT_IDLE)
AND NOT bBusy
AND NOT bError
AND bConnected THEN

    sSqlWork := sSQL;

    bBusy := TRUE;

    sLastOperation := 'Execute';
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.Execute accepted', '');

    eState := DBCLIENT_EXECUTE;

    // Request accepted
    Execute := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Query" Id="{cd40e696-4c50-4138-8e7f-940cb2201023}">
      <Declaration><![CDATA[METHOD PUBLIC Query : BOOL
VAR_INPUT
    sSQL : STRING(4095);

    // Destination PLC structure/array
    pData  : POINTER TO BYTE;
    cbData : UDINT;

    // Result range
    nStartIndex  : UDINT;
    nRecordCount : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

Query := FALSE;


IF (eState = DBCLIENT_IDLE)
AND NOT bBusy
AND NOT bError
AND bConnected
AND (pData <> 0)
AND (cbData > 0)
AND (nRecordCount > 0) THEN

    // Latch SQL
    sSqlWork := sSQL;


    // Latch target memory
    pReadData := pData;
    cbReadData := cbData;

    nReadStartIndex := nStartIndex;
    nReadRecordCount := nRecordCount;


    bBusy := TRUE;

    sLastOperation := 'Query';
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.Query accepted', '');

    eState := DBCLIENT_QUERY_EXECUTE;

    // Request accepted
    Query := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetError" Id="{74e36ae8-7ce1-4be3-bddc-76548051a048}">
      <Declaration><![CDATA[METHOD ResetError : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetError := FALSE;


IF NOT bBusy THEN

    bError := FALSE;
    nErrorID := 0;

    sLastOperation := '';
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.ResetError accepted', '');

    ResetError := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="UseExistingDbId" Id="{3ba0d51a-60be-499e-8c26-2e0abdfb9c60}">
      <Declaration><![CDATA[METHOD PUBLIC UseExistingDbId : BOOL
VAR_INPUT
    nDBID : UDINT;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[UseExistingDbId := FALSE;


IF (eState = DBCLIENT_IDLE)
AND NOT bBusy
AND NOT bConnected
AND (nDBID <> 0) THEN

    hDBID := nDBID;

    bConfigured := TRUE;
    ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'DBClient.UseExistingDbId accepted, hDBID %s', UDINT_TO_STRING(hDBID));

    UseExistingDbId := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>