	<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[{"event":"%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onInitialized","actions":[{"objectType":"JavaScript","active":true,"sourceLines":["var owner = TcHmi.Controls.get('%ctx%owner::Id%/ctx%');","var root = owner ? owner.getElement() : null;","var body = root ? root.find('[id$=\"JogBodyGrid\"]') : null;","function getControl(idSuffix) {","  var element = root ? root.find('[id$=\"' + idSuffix + '\"]') : null;","  return element \u0026\u0026 element.length ? TcHmi.Controls.get(element.attr('id')) : null;","}","function setText(idSuffix, text) {","  var control = getControl(idSuffix);","  if (control) { control.setText(text); }","}","function watchValue(expression, update) {","  var symbol = new TcHmi.Symbol(expression);","  symbol.watch(function (data) { update(data ? data.value : null); });","}","function boolText(label, value) {","  return label + ': ' + (value === null || value === undefined ? '--' : (value ? 'TRUE' : 'FALSE'));","}","watchValue('%pp%J::bEnable%/pp%', function (value) {","  if (body \u0026\u0026 body.length) { body.css('opacity', value ? '1' : '0.35'); }","});","watchValue('%pp%R::bReady%/pp%', function (value) { setText('JogReadyStatus', boolText('Ready', value)); });","watchValue('%pp%R::bMoving%/pp%', function (value) { setText('JogMovingStatus', boolText('Moving', value)); });","watchValue('%pp%R::bEStop%/pp%', function (value) { setText('JogEStopStatus', boolText('E-Stop', value)); });","watchValue('%pp%R::bInCollision%/pp%', function (value) { setText('JogCollisionStatus', boolText('Collision', value)); });","watchValue('%pp%R::eModus%/pp%', function (value) { setText('JogModeStatus', 'Mode: ' + (value === null || value === undefined ? '--' : String(value))); });"]}]}]</script>
