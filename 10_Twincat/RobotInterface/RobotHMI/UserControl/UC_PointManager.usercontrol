    <!-- Edit actions -->
    <div id="PointManagerDeleteButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="0"
         data-tchmi-grid-row-index="6"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="DELETE"
         data-tchmi-state-symbol="%pp%PM::bCmdDelete%/pp%">
    </div>

    <div id="PointManagerRetouchButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="2"
         data-tchmi-grid-row-index="6"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="RETOUCH FROM ROBOT"
         data-tchmi-state-symbol="%pp%PM::bCmdTeach%/pp%">
    </div>

    <div id="PointManagerSavePointButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="8"
         data-tchmi-grid-row-index="6"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="SAVE POINT"
         data-tchmi-state-symbol="%pp%PM::bCmdSave%/pp%">
    </div>

    <!-- Bottom status + file save -->
    <div id="PointManagerStatusLabel"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
         data-tchmi-grid-column-index="0"
         data-tchmi-grid-row-index="8"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="Status"
         data-tchmi-text-horizontal-alignment="Center"
         data-tchmi-text-vertical-alignment="Center">
    </div>

    <div id="PointManagerStatus"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
         data-tchmi-grid-column-index="2"
         data-tchmi-grid-row-index="8"
         data-tchmi-grid-column-span="5"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="%pp%PM::sLastOperation%/pp%"
         data-tchmi-text-horizontal-alignment="Left"
         data-tchmi-text-vertical-alignment="Center">
    </div>

    <div id="PointManagerSaveAllButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="8"
         data-tchmi-grid-row-index="8"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="SAVE TO FILE"
         data-tchmi-state-symbol="%pp%PM::bCmdSaveFile%/pp%">
    </div>

  </div>
</div>
