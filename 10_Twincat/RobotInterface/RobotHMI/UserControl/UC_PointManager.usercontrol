  <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[{"event":"%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onInitialized","actions":[{"objectType":"JavaScript","active":true,"sourceLines":["var owner = TcHmi.Controls.get('%ctx%owner::Id%/ctx%');","var root = owner ? owner.getElement() : null;","var element = root ? root.find('[id$=\"PointManagerPointSelector\"]') : null;","var selector = element \u0026\u0026 element.length ? TcHmi.Controls.get(element.attr('id')) : null;","var names = [];","var count = 0;","function updateItems() {","  if (!selector) { return; }","  selector.setSrcData(names.slice(0, count).filter(function (name) { return name !== ''; }));","}","new TcHmi.Symbol('%pp%PM::aPointNames%/pp%').watch(function (data) {","  names = data \u0026\u0026 Array.isArray(data.value) ? data.value : [];","  updateItems();","});","new TcHmi.Symbol('%pp%PM::nPointNameCount%/pp%').watch(function (data) {","  count = data ? Number(data.value) : 0;","  updateItems();","});"]}]}]</script>

