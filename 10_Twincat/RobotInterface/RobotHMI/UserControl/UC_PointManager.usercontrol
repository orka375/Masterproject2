<div id="UC_PointManager"
     data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl"
     data-tchmi-top="0"
     data-tchmi-left="0"
     data-tchmi-width="100"
     data-tchmi-height="100"
     data-tchmi-width-unit="%"
     data-tchmi-height-unit="%"
     data-tchmi-creator-viewport-width="1200"
     data-tchmi-creator-viewport-height="800">

     <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
          [{"event":"%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onInitialized","actions":[{"objectType":"JavaScript","active":true,"sourceLines":["PointManager.bind('%ctx%owner::Id%/ctx%', '%pp%PM::aPointList%/pp%');"]}]}]
     </script>

  <script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
    ["usercontrol-surface", "background-container"]
  </script>

  <div id="PointManagerGrid"
       data-tchmi-type="TcHmi.Controls.System.TcHmiGrid"
       data-tchmi-left="-1"
       data-tchmi-top="-1"
       data-tchmi-right="1"
       data-tchmi-bottom="0"
       data-tchmi-grid-row-index="2">

    <script data-tchmi-target-attribute="data-tchmi-column-options" type="application/json">
[
  {
    "width": 1.0,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 0.1,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 3.0,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 0.1,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 1.5,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 0.1,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 1.5,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 0.1,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 1.5,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "width": 0.1,
    "widthMode": "Value",
    "widthUnit": "factor"
  }
]
</script>

    <script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
    [
      { "height": 0.0, "heightMode": "Value", "heightUnit": "px" },
      { "height": 0.0, "heightMode": "Value", "heightUnit": "px" },
      { "height": 0.8, "heightMode": "Value", "heightUnit": "factor" },
      { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
      { "height": 4.2, "heightMode": "Value", "heightUnit": "factor" },
      { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
      { "height": 0.8, "heightMode": "Value", "heightUnit": "factor" },
      { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
      { "height": 0.8, "heightMode": "Value", "heightUnit": "factor" }
    ]
    </script>

    <!-- Top row: select/load/create/file-read -->
    <div id="PointManagerPointSelectorLabel"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
         data-tchmi-grid-column-index="0"
         data-tchmi-grid-row-index="2"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="Stored points"
         data-tchmi-text-horizontal-alignment="Center"
         data-tchmi-text-vertical-alignment="Center">
    </div>

    <div id="PointManagerPointSelector"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiCombobox"
         data-tchmi-grid-column-index="2"
         data-tchmi-grid-row-index="2"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
               data-tchmi-selected-id="%pp%PM::nSelectedPointId|BindingMode=TwoWay%/pp%" data-tchmi-src-data="%pp%PM::aPointList%/pp%">
          
    </div>

    <div id="PointManagerCreateButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="4"
         data-tchmi-grid-row-index="2"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="CREATE"
         data-tchmi-state-symbol="%pp%PM::bCmdNew%/pp%">
    </div>

    <div id="PointManagerLoadFileButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="6"
         data-tchmi-grid-row-index="2"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="READ FILE"
         data-tchmi-state-symbol="%pp%PM::bCmdLoadFile%/pp%">
    </div>

    <div id="PointManagerLoadPointButton"
         data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
         data-tchmi-grid-column-index="8"
         data-tchmi-grid-row-index="2"
         data-tchmi-left="0"
         data-tchmi-top="0"
         data-tchmi-right="0"
         data-tchmi-bottom="0"
         data-tchmi-text="LOAD / DISCARD EDITS"
         data-tchmi-state-symbol="%pp%PM::bCmdLoad%/pp%">
    </div>

    <!-- Main comparison grid: edited point vs stored RAM-array point -->
    <div id="PointManagerPointGrid"
         data-tchmi-type="TcHmi.Controls.System.TcHmiGrid"
         data-tchmi-grid-column-index="2"
         data-tchmi-grid-row-index="4"
         data-tchmi-grid-column-span="7"
         data-tchmi-left="0"
         data-tchmi-top="-1"
         data-tchmi-right="-20"
         data-tchmi-bottom="1">

      <script data-tchmi-target-attribute="data-tchmi-column-options" type="application/json">
      [
        { "width": 0.4, "widthMode": "Value", "widthUnit": "factor" },
        { "width": 1.0, "widthMode": "Value", "widthUnit": "factor" },
        { "width": 1.0, "widthMode": "Value", "widthUnit": "factor" }
      ]
      </script>

      <script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
      [
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 0.1, "heightMode": "Value", "heightUnit": "factor" },
        { "height": 1.0, "heightMode": "Value", "heightUnit": "factor" }
      ]
      </script>

      <div id="PointManagerEditedHeader"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="1"
           data-tchmi-grid-row-index="0"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="Edited"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>

      <div id="PointManagerStoredHeader"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="2"
           data-tchmi-grid-row-index="0"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="Stored (RAM array)"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>

      <!-- ID: display only on both sides; never editable -->
      <div id="PointManagerIdLabel"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="0"
           data-tchmi-grid-row-index="2"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="ID"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>
      <div id="PointManagerIdEdited"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="1"
           data-tchmi-grid-row-index="2"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="%pp%PM::editedPoint::id%/pp%"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>
      <div id="PointManagerIdStored"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
