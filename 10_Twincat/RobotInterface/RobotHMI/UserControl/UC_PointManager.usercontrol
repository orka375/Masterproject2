           data-tchmi-grid-row-index="2"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="%pp%PM::loadedPoint::id%/pp%"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>

      <!-- Name: only editedPoint.name is writable -->
      <div id="PointManagerNameLabel"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="0"
           data-tchmi-grid-row-index="4"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="Name"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>
      <div id="PointManagerNameInput"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiInput"
           data-tchmi-grid-column-index="1"
           data-tchmi-grid-row-index="4"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="%pp%PM::editedPoint::name|BindingMode=TwoWay%/pp%"
           data-tchmi-input-processing-point="InteractionFinished">
      </div>
      <div id="PointManagerNameStored"
           data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="2"
           data-tchmi-grid-row-index="4"
           data-tchmi-left="0"
           data-tchmi-top="0"
           data-tchmi-right="0"
           data-tchmi-bottom="0"
           data-tchmi-text="%pp%PM::loadedPoint::name%/pp%"
           data-tchmi-text-horizontal-alignment="Center"
           data-tchmi-text-vertical-alignment="Center">
      </div>

      <!-- X -->
      <div id="PointManagerXLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="6"
           data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0"
           data-tchmi-text="X" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Center"></div>
            <div id="PointManagerXStored" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
           data-tchmi-grid-column-index="2" data-tchmi-grid-row-index="6"
