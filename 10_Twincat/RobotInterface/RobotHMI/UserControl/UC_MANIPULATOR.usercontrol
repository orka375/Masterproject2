		<div id="UCManipulatorSkillsButton" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-grid-row-index="8" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-text="select">
			<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">["status-action"]</script>
			<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%SelectedIndex%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/Number",
          "symbolExpression": "%pp%RobotIndex%/pp%"
        },
        "asyncWait": true
      }
    ]
  }
]
</script>
