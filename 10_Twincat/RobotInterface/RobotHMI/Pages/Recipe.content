<div id="SkillRecipes" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-height="100" data-tchmi-height-unit="%">
  <div id="TcHmiGrid_1" class="skill-recipes-grid" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-right="0" data-tchmi-bottom="0">

<script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
[
  {
    "height": 0.8,
    "heightMode": "Value",
    "heightUnit": "factor",
    "overflow": false
  },
  {
    "height": 1.2,
    "heightMode": "Value",
    "heightUnit": "factor"
  },
  {
    "height": 6.0,
    "heightMode": "Value",
    "heightUnit": "factor"
  }
]
</script>
<div id="TopBar_RobotSelection_Host" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-target-user-control="UserControl/TopBar_RobotSelection.usercontrol" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0"></div>
<div id="TcHmiRecipeSelect_1" class="skill-recipe-select" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRecipeSelect" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="1" data-tchmi-left="12" data-tchmi-left-unit="px" data-tchmi-server-domain="TcHmiRecipeManagement" data-tchmi-server-interval="1000" data-tchmi-top="8" data-tchmi-top-unit="px" data-tchmi-right="12" data-tchmi-bottom="8">
<script data-tchmi-target-attribute="data-tchmi-allowed-recipe-types" type="application/json">
[
  "PickPlace"
]
</script>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onRecipeActivated",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.SETUP.bApplyRecipe%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiRecipeEdit_1" class="skill-recipe-edit" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRecipeEdit" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="2" data-tchmi-left="10" data-tchmi-left-unit="px" data-tchmi-server-domain="TcHmiRecipeManagement" data-tchmi-preselected-recipe-type="PickPlace" data-tchmi-top="10" data-tchmi-top-unit="px" data-tchmi-right="14" data-tchmi-bottom="10">
<script data-tchmi-target-attribute="data-tchmi-allowed-recipe-types" type="application/json">
[
  "PickPlace"
]
</script>
</div>
</div>
