<div id="RobotMove" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-creator-visibility="Visible" data-tchmi-right="0" data-tchmi-bottom="0">
  <!--
    Reusable teach-pendant page. All robot values are resolved by
    Scripts/RobotHmi.js against the selected robot (GVL_Cell.aRobot[n]).
    The raw HTML lives inside a TcHmiContainer so the framework gives it
    a concrete size (absolute/flex children then render correctly).
  -->
  <div id="RM_Host" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0">
  <div class="rm-root">

    <!-- ============ HEADER STATUS STRIP ============ -->
    <div class="rm-header robot-panel-dark">
      <select class="robot-select" data-robot-selector>
        <option value="1">UR5-01</option>
        <option value="2">UR5-02</option>
      </select>
      <span class="rm-title" data-robot-name>UR5-01</span>
      <span class="rm-stat"><span class="rm-lbl">Ready</span><span data-robot-bind="HMI_ROB.bReady" data-robot-format="bool" data-robot-status="ok">--</span></span>
      <span class="rm-stat"><span class="rm-lbl">Moving</span><span data-robot-bind="HMI_ROB.bMoving" data-robot-format="bool" data-robot-status="warn">--</span></span>
      <span class="rm-stat"><span class="rm-lbl">E-Stop</span><span data-robot-bind="HMI_ROB.bEStop" data-robot-format="bool" data-robot-status="fault">--</span></span>
      <span class="rm-stat"><span class="rm-lbl">Collision</span><span data-robot-bind="HMI_ROB.bInCollision" data-robot-format="bool" data-robot-status="fault">--</span></span>
      <span class="rm-stat"><span class="rm-lbl">Mode</span><span data-robot-bind="HMI_ROB.eModus" data-robot-format="mode">--</span></span>
    </div>

    <!-- ============ BODY: 3 COLUMNS ============ -->
    <div class="rm-body">

      <!-- LEFT: JOINT JOG -->
      <div class="rm-col robot-panel">
        <div class="robot-section-title">JOINT JOG</div>
        <div class="jog-row"><span class="jog-btn-label">J1</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint1Minus">&#8722;</button><span class="jog-readout" data-robot-bind="HMI_ROB._jointpos.joint1" data-robot-format="deg">--</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint1Plus">+</button></div>
      <div class="jog-row"><span class="jog-btn-label">J2</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint2Minus">&#8722;</button><span class="jog-readout" data-robot-bind="HMI_ROB._jointpos.joint2" data-robot-format="deg">--</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint2Plus">+</button></div>
      <div class="jog-row"><span class="jog-btn-label">J3</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint3Minus">&#8722;</button><span class="jog-readout" data-robot-bind="HMI_ROB._jointpos.joint3" data-robot-format="deg">--</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint3Plus">+</button></div>
      <div class="jog-row"><span class="jog-btn-label">J4</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint4Minus">&#8722;</button><span class="jog-readout" data-robot-bind="HMI_ROB._jointpos.joint4" data-robot-format="deg">--</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint4Plus">+</button></div>
      <div class="jog-row"><span class="jog-btn-label">J5</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint5Minus">&#8722;</button><span class="jog-readout" data-robot-bind="HMI_ROB._jointpos.joint5" data-robot-format="deg">--</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint5Plus">+</button></div>
      <div class="jog-row"><span class="jog-btn-label">J6</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint6Minus">&#8722;</button><span class="jog-readout" data-robot-bind="HMI_ROB._jointpos.joint6" data-robot-format="deg">--</span><button type="button" class="jog-btn" data-jog-symbol="JOG.bJogJoint6Plus">+</button></div>
      </div>

      <!-- CENTER: TCP JOG -->
      <div class="rm-col rm-col-center robot-panel">
        <div class="robot-section-title">TCP JOG - TRANSLATION [mm]</div>
        <div class="tcp-cross">
          <button type="button" class="jog-btn tcp-yp" data-jog-symbol="JOG.bJogYPlus">Y+</button>
          <button type="button" class="jog-btn tcp-xm" data-jog-symbol="JOG.bJogXMinus">X&#8722;</button>
          <button type="button" class="jog-btn tcp-xp" data-jog-symbol="JOG.bJogXPlus">X+</button>
          <button type="button" class="jog-btn tcp-ym" data-jog-symbol="JOG.bJogYMinus">Y&#8722;</button>
          <button type="button" class="jog-btn tcp-zp" data-jog-symbol="JOG.bJogZPlus">Z+</button>
          <button type="button" class="jog-btn tcp-zm" data-jog-symbol="JOG.bJogZMinus">Z&#8722;</button>
        </div>

        <div class="robot-section-title">TCP JOG - ORIENTATION [deg]</div>
        <div class="tcp-rot">
          <button type="button" class="jog-btn" data-jog-symbol="JOG.bJogRxMinus">Rx&#8722;</button>
          <button type="button" class="jog-btn" data-jog-symbol="JOG.bJogRxPlus">Rx+</button>
          <button type="button" class="jog-btn" data-jog-symbol="JOG.bJogRyMinus">Ry&#8722;</button>
          <button type="button" class="jog-btn" data-jog-symbol="JOG.bJogRyPlus">Ry+</button>
          <button type="button" class="jog-btn" data-jog-symbol="JOG.bJogRzMinus">Rz&#8722;</button>
          <button type="button" class="jog-btn" data-jog-symbol="JOG.bJogRzPlus">Rz+</button>
        </div>
      </div>

      <!-- RIGHT: TCP POSITION + JOG ENABLE -->
      <div class="rm-col robot-panel">
        <div class="robot-section-title">TCP POSITION</div>
        <div class="pos-row"><span class="jog-btn-label">X</span><span class="jog-readout" data-robot-bind="HMI_ROB._tcppos.x" data-robot-format="mm">--</span><span class="pos-unit">mm</span></div>
        <div class="pos-row"><span class="jog-btn-label">Y</span><span class="jog-readout" data-robot-bind="HMI_ROB._tcppos.y" data-robot-format="mm">--</span><span class="pos-unit">mm</span></div>
        <div class="pos-row"><span class="jog-btn-label">Z</span><span class="jog-readout" data-robot-bind="HMI_ROB._tcppos.z" data-robot-format="mm">--</span><span class="pos-unit">mm</span></div>
        <div class="pos-row"><span class="jog-btn-label">Rx</span><span class="jog-readout" data-robot-bind="HMI_ROB._tcppos.rx" data-robot-format="deg">--</span><span class="pos-unit">deg</span></div>
        <div class="pos-row"><span class="jog-btn-label">Ry</span><span class="jog-readout" data-robot-bind="HMI_ROB._tcppos.ry" data-robot-format="deg">--</span><span class="pos-unit">deg</span></div>
        <div class="pos-row"><span class="jog-btn-label">Rz</span><span class="jog-readout" data-robot-bind="HMI_ROB._tcppos.rz" data-robot-format="deg">--</span><span class="pos-unit">deg</span></div>

        <div class="rm-enable">
          <span class="jog-btn-label">Jog enable</span>
          <label class="robot-switch">
            <input type="checkbox" data-robot-bind="JOG.bEnable" data-robot-write="JOG.bEnable" data-robot-type="bool" />
            <span class="robot-switch-slider"></span>
          </label>
        </div>
      </div>

    </div>

    <!-- ============ FOOTER: SPEED + STOP ============ -->
    <div class="rm-footer robot-panel-dark">
      <span class="rm-lbl">Jog speed</span>
      <input type="range" class="robot-range" min="0" max="0.5" step="0.01" data-robot-bind="JOG.fLinearVelocity" data-robot-write="JOG.fLinearVelocity" />
      <span class="rm-lbl">Speed override</span>
      <input type="range" class="robot-range" min="0" max="100" step="1" data-robot-bind="HMI_ROB._speedOverride" data-robot-write="HMI_ROB._speedOverride" />
      <span class="rm-readout-dark" data-robot-bind="HMI_ROB._speedOverride" data-robot-format="raw">--</span>
      <button type="button" class="jog-btn stop-btn" data-robot-stop>STOP</button>
    </div>

  </div>
  </div>
</div>
