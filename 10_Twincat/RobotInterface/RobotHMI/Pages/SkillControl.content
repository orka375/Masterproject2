<div id="SkillControl" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-right="0" data-tchmi-bottom="0">
	<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[{"event":"%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onInitialized","actions":[{"objectType":"JavaScript","active":true,"sourceLines":["var robot1 = TcHmi.Controls.get('SkillControlR1');","var robot2 = TcHmi.Controls.get('SkillControlR2');","var unavailable = TcHmi.Controls.get('SkillControlUnavailable');","var selectedRobot = new TcHmi.Symbol('%i%SelectedRobot%/i%');","selectedRobot.watch(function (data) {","  var selected = data ? Number(data.value) : 0;","  var valid = selected === 1 || selected === 2;","  if (robot1) { robot1.setVisibility(selected === 1 ? 'Visible' : 'Collapsed'); }","  if (robot2) { robot2.setVisibility(selected === 2 ? 'Visible' : 'Collapsed'); }","  if (unavailable) { unavailable.setVisibility(valid ? 'Collapsed' : 'Visible'); }","});"]}]}]</script>
	<div id="SkillControlPageGrid" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0">
		<script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">[{"height":64,"heightMode":"Value","heightUnit":"px"},{"height":10,"heightMode":"Value","heightUnit":"px"},{"height":1,"heightMode":"Value","heightUnit":"factor"}]</script>
		<div id="SkillControlRobotSelection" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-row-index="0" data-tchmi-left="10" data-tchmi-top="0" data-tchmi-bottom="0" data-tchmi-width="30" data-tchmi-width-unit="%" data-tchmi-target-user-control="UserControl/TopBar_RobotSelection.usercontrol"></div>
		<div id="SkillControlHostGrid" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-grid-row-index="2" data-tchmi-left="10" data-tchmi-top="0" data-tchmi-right="10" data-tchmi-bottom="10">
			<script data-tchmi-target-attribute="data-tchmi-column-options" type="application/json">[{"width":0.1,"widthMode":"Value","widthUnit":"factor"},{"width":1,"widthMode":"Value","widthUnit":"factor"},{"width":0.1,"widthMode":"Value","widthUnit":"factor"}]</script>
			<div id="SkillControlR1" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="1" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-target-user-control="UserControl/UC_SkillControl.usercontrol" data-tchmi-b="%s%ADS.PLC1.SETUP.R1_PP.HMI_BASE%/s%" data-tchmi-p="%s%ADS.PLC1.SETUP.R1_PP.Param%/s%" data-tchmi-r="%s%R1.HMI_ROB%/s%" data-tchmi-rb="%s%R1.HMI_BASE%/s%" data-tchmi-result="%s%ADS.PLC1.SETUP.R1_PP.ExecutionResult%/s%" data-tchmi-execute="%s%ADS.PLC1.SETUP.R1_PP.bExecute%/s%" data-tchmi-stop="%s%ADS.PLC1.SETUP.R1_PP.bStop%/s%" data-tchmi-reset="%s%ADS.PLC1.SETUP.R1_PP.bReset%/s%"></div>
			<div id="SkillControlR2" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="1" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-target-user-control="UserControl/UC_SkillControl.usercontrol" data-tchmi-b="%s%ADS.PLC1.SETUP.R2_PP.HMI_BASE%/s%" data-tchmi-p="%s%ADS.PLC1.SETUP.R2_PP.Param%/s%" data-tchmi-r="%s%R2.HMI_ROB%/s%" data-tchmi-rb="%s%R2.HMI_BASE%/s%" data-tchmi-result="%s%ADS.PLC1.SETUP.R2_PP.ExecutionResult%/s%" data-tchmi-execute="%s%ADS.PLC1.SETUP.R2_PP.bExecute%/s%" data-tchmi-stop="%s%ADS.PLC1.SETUP.R2_PP.bStop%/s%" data-tchmi-reset="%s%ADS.PLC1.SETUP.R2_PP.bReset%/s%" data-tchmi-visibility="Collapsed"></div>
			<div id="SkillControlUnavailable" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-grid-column-index="1" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-text="No robot selected" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Center" data-tchmi-visibility="Collapsed"></div>
		</div>
	</div>
</div>