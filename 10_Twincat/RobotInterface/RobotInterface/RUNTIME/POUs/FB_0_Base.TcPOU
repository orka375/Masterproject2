    <Property Name="Busy" Id="{9cc952da-997b-48e1-bc3f-e76175b74970}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{19a4579d-a5c4-4a8f-b588-1cda29eef266}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy:=FALSE;
FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		IF pA_Skills[j]^.State = eState.Active THEN
			Busy:=TRUE;
			EXIT;
		END_IF
	END_IF
END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cleanup" Id="{c4819076-2442-41bd-8aa1-fe9bd8639fb5}" FolderPath="Transitions\">
      <Declaration><![CDATA[// {warning 'Add method implementation '}
{attribute 'TcRpcEnable':='1'}
METHOD Cleanup : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Cleanup;
_transitionresult:= NONE;

IF State=eState.Inactive THEN
	State:=eState.CleaningUp;
	
	FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
		IF pA_Skills[j]<>0 THEN
			pA_Skills[j]^.Cleanup();
		END_IF
	END_FOR
ELSE
	ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_WARN,
    msgFmtStr   := 'Cleanup failed in: %s',
    strArg      := Path
);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{e049feb0-d020-4b0d-9355-74a020722637}" FolderPath="Transitions\">
      <Declaration><![CDATA[// {warning 'Add method implementation '}
{attribute 'TcRpcEnable':='1'}
METHOD Configure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Configure;
_transitionresult:= NONE;

IF State=eState.Unconfigured THEN
	State:=eState.Configuring;
ELSE
	ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_WARN,
    msgFmtStr   := 'Configure failed in: %s',
    strArg      := Path
);
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Action Name="CYCLIC_BASE" Id="{77b136d9-dc44-439e-b8b2-7b3315db320c}">
      <Implementation>
        <ST><![CDATA[StateMachine();
MESSENGER();
// xCurrentMessage:=MESSENGER.HasActivError();
MyHeartBeat:=HeartBeat();


FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		pA_Skills[j]^();
	END_IF
END_FOR


IF MESSENGER.HasActivError THEN
	MyHealth:= eHealth.Dead;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="Deactivate" Id="{4dfdb93c-87ba-4697-9eee-0c2811499a1b}" FolderPath="Transitions\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
{attribute 'TcRpcEnable':='1'}
METHOD Deactivate

VAR
	skillsIo: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Deactivate;
_transitionresult:= NONE;

skillsIo:=TRUE;





IF State=eState.Active THEN
	State:=eState.Deactivating;
END_IF
	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Destroy" Id="{84232af5-24cf-43e3-b44a-0f85cd0c58bf}" FolderPath="Transitions\">
      <Declaration><![CDATA[// {warning 'Add method implementation '}
{attribute 'TcRpcEnable':='1'}
METHOD Destroy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Destroy;
_transitionresult:= NONE;

IF State=eState.Finalized THEN
	State:=eState.Unconfigured;
ELSE
	ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_WARN,
    msgFmtStr   := 'Destroy failed in: %s',
