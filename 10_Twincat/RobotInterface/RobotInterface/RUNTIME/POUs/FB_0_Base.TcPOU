    <Method Name="OnDeactivate" Id="{d4f5f9b3-96c4-4d53-92d3-200d86bcd1c0}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	myResult: ERESULT;
	notready: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

notready:=FALSE;
FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		IF pa_Skills[j]^.State > eState.Inactive THEN
			pA_Skills[j]^.Deactivate();
			
			IF pA_Skills[j]^.LastTransitionType = eTransitions.Deactivate THEN
				IF pA_Skills[j]^.LastTransitionResult = NONE THEN
					notready:=TRUE;
				ELSIF pA_Skills[j]^.LastTransitionResult <> FAILURE THEN
					OnDeactivate:=FAILURE;
					RETURN;

				END_IF
			END_IF

		END_IF
		
	END_IF
END_FOR

IF NOT notready THEN
	myResult:=SUCCESS;
END_IF


// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := myResult;

]]></ST>
      </Implementation>
    </Method>
