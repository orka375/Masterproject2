<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_0_Base" Id="{ccfcc891-ed7a-48a9-bb43-020f08aa1f30}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'} 
FUNCTION_BLOCK ABSTRACT FB_0_Base EXTENDS FB_Utilities  
// IMPLEMENTS ITF_0_BaseComponent

VAR_INPUT
	DEBUG_S : DEBUG_STATE;
	{attribute 'OPC.UA.DA.StructuredType':=1}
	{attribute 'OPC.UA.DA' := '1'}
	pA_Skills : ARRAY[1..8] OF POINTER TO FB_1_Skill;
	bAutoConfigure: BOOL:=TRUE;		//If True, StateMachine trys automatic to reach State "INACTIV" otherwise each transition must be called manually
	MESSENGER: FB_Messenger;
END_VAR

VAR_OUTPUT
	{attribute 'instance-path'} 
    {attribute 'noinit'} 
    sPath : STRING(255); 
	{attribute 'instance-name'}
	{attribute 'noinit'} 
	sInstanceName: STRING;
	{attribute 'OPC.UA.DA' := '1'}
	eStatus: eState :=eState.Unconfigured;
	{attribute 'OPC.UA.DA' := '1'}
	MyHealth: eHealth := eHealth.Unkown;
	{attribute 'OPC.UA.DA' := '1'}
	MyHeartBeat: BOOL;
	{attribute 'OPC.UA.DA' := '1'}
	bBusy : BOOL;
END_VAR
	
VAR
	_transitionresult: eResult;
	_lasttransition: ETRANSITIONS;
	_initialized: BOOL;
	_activSkill: POINTER TO FB_1_Skill;
	_finished: BOOL;
	_automaticReset,_manualResetCalled: BOOL;
	tonBlink: TON;
	blinkToggle: BOOL;
	LastFail: TIME;
	LastError: TIME;
	j: INT;
	
	_id: UINT;
	prevFail: TIME;
	FailDif: TIME;
	TimeStateMachine: RS;
	SlowDownTimer: TON;
	prevStatus: ESTATE;
	prevError: TIME;
	ErrDif: TIME;
	_ShutOffStateMachine: BOOL;
	_lsfs: eState;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
