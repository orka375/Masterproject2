<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.2.0.0" ProductVersion="3.1.4026.18">
  <POU Name="FB_0_Base" Id="{ccfcc891-ed7a-48a9-bb43-020f08aa1f30}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'} 
{attribute 'hide_all_locals'}
FUNCTION_BLOCK ABSTRACT FB_0_Base EXTENDS FB_Utilities  
// IMPLEMENTS ITF_0_BaseComponent

VAR_INPUT
	DEBUG_S : DEBUG_STATE;
	{attribute 'OPC.UA.DA.StructuredType':=1}
	{attribute 'OPC.UA.DA' := '1'}
	pA_Skills : ARRAY[1..MaxNrofSkills] OF POINTER TO FB_1_Skill;
	bAutoConfigure: BOOL:=FALSE;		//If True, StateMachine trys automatic to reach State "INACTIV" otherwise each transition must be called manually
	nMaxAutoRecoveryAttempts : UINT := 3; // 0 disables automatic ErrorProcessing recovery
	MESSENGER: FB_Messenger;
END_VAR

VAR_OUTPUT
	{attribute 'instance-path'} 
    {attribute 'noinit'} 
    sPath : STRING(255); 
	MyHeartBeat: BOOL;
	{attribute 'OPC.UA.DA' := '1'}
	HMI_BASE: stHMI_BASE;
	rtStateChange: R_TRIG;
END_VAR
	
VAR
	_transitionresult: eResult;
	_lasttransition: ETRANSITIONS;
	_initialized: BOOL;
	_activSkill: POINTER TO FB_1_Skill;
	_finished: BOOL;
	_manualResetCalled: BOOL;
	_recoveryMode : eRecoveryMode := eRecoveryMode.AcknowledgeRequired;
	_recoveryModeAssigned : BOOL;
	_recoveryPending : BOOL;
	_recoveryAttempt : UINT;
	tonBlink: TON;
	blinkToggle: BOOL;
	LastFail: TIME;
	LastError: TIME;
	j: INT;
	
	_id: UINT;
	prevFail: TIME;
	FailDif: TIME;
	TimeStateMachine: RS;
	SlowDownTimer: TON;
	prevStatus: ESTATE;
	prevError: TIME;
	ErrDif: TIME;
	_ShutOffStateMachine: BOOL;
	_lsfs: eState;
	_once: BOOL;
	i: INT;
	OldState: ESTATE;
	bStateChange: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Error" Id="{aec3c44c-e508-420a-a8f0-d9172161c829}" />
    <Folder Name="Skill" Id="{850d4606-90d8-4980-b7f3-1269c79d7d36}" />
    <Folder Name="StateControl" Id="{bcaabc90-8311-4d61-b63c-66c13d25292f}" />
