    <Property Name="Busy" Id="{9cc952da-997b-48e1-bc3f-e76175b74970}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{19a4579d-a5c4-4a8f-b588-1cda29eef266}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy:=FALSE;
FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		IF pA_Skills[j]^.State = eState.Active THEN
			Busy:=TRUE;
			EXIT;
		END_IF
	END_IF
END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cleanup" Id="{c4819076-2442-41bd-8aa1-fe9bd8639fb5}" FolderPath="Transitions\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Cleanup : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Cleanup;
_transitionresult:= NONE;

IF State=eState.Inactive THEN
	State:=eState.CleaningUp;
ELSE
	_transitionresult:= FAILURE;
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'Cleanup failed');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{e049feb0-d020-4b0d-9355-74a020722637}" FolderPath="Transitions\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Configure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Configure;
_transitionresult:= NONE;

IF State=eState.Unconfigured THEN
	State:=eState.Configuring;
ELSE
	_transitionresult:= FAILURE;
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'Configure failed');
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Action Name="CYCLIC_BASE" Id="{77b136d9-dc44-439e-b8b2-7b3315db320c}">
      <Implementation>
        <ST><![CDATA[RUN_DEBUG_STATE();

StateMachine();
MESSENGER();
// xCurrentMessage:=MESSENGER.HasActivError();
MyHeartBeat:=HeartBeat();
SlowDownTimer();

FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		pA_Skills[j]^();
	END_IF
END_FOR


IF MESSENGER.HasActivError THEN
	MyHealth:= eHealth.Dead;
END_IF

IF prevFail<>lastFail THEN //Reset by Success
	
	FailDif:= lastFail - prevFail;
	
	IF FailDif < T#100MS THEN
		//Slow Down
		TimeStateMachine.SET:=TRUE;
		SlowDownTimer(IN:=TRUE,PT:=T#5S);
		Messenger.AddWarn(eMessageCategories.StateMachine,Path,'Loop of Failure..slowing Statemachine');
		
	END_IF
	prevFail := lastFail;
END_IF


IF prevError<>lastError THEN //Reset by User
	
	ErrDif:= lastError - prevError;
	
	IF ErrDif < T#400MS THEN
		//Slow Down
	
		Messenger.AddError(eMessageCategories.StateMachine,Path,'DeathLoop of Error detected..shutting StateMachine down');
		_ShutOffStateMachine:=TRUE;
	END_IF
	prevFail := lastFail;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="Deactivate" Id="{4dfdb93c-87ba-4697-9eee-0c2811499a1b}" FolderPath="Transitions\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Deactivate : BOOL

VAR
	skillsIo: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Deactivate;
_transitionresult:= NONE;


IF State=eState.Active THEN
	State:=eState.Deactivating;
ELSE
	_transitionresult:= FAILURE;
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'Deactivate failed');
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="Destroy" Id="{84232af5-24cf-43e3-b44a-0f85cd0c58bf}" FolderPath="Transitions\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Destroy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Destroy;
_transitionresult:= NONE;

IF State=eState.Finalized THEN
	State:=eState.Unconfigured;
ELSE
	_transitionresult:= FAILURE;
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'Destroy failed');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="fb_init" Id="{b4b95520-3a0a-4150-91ef-320993523f81}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_id:= SETUP.next_ID;
SETUP.next_ID:=SETUP.next_ID+1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetInstanceName" Id="{c1f8f8ea-ec47-4367-ae51-64fda65ac886}">
      <Declaration><![CDATA[METHOD GetInstanceName : STRING
VAR
    i    : DINT;
    nLen : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[nLen := LEN(sPath);
GetInstanceName := sPath;

FOR i := nLen TO 1 BY -1 DO
    IF sPath[i] = 46 THEN //46 = '.' in ASCII
        GetInstanceName := RIGHT(sPath, TO_INT(nLen - i-1));
        RETURN;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="HeartBeat" Id="{fe4341a9-3799-4b03-9aac-3a4efb429415}">
      <Declaration><![CDATA[METHOD HeartBeat : BOOL
VAR_INPUT
END_VAR

VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonBlink(IN := TRUE, PT := T#1S);

// When timer is done, toggle the bit and reset the timer
IF tonBlink.Q THEN
    blinkToggle := NOT blinkToggle; // Flip TRUE ↔ FALSE
    tonBlink(IN := FALSE);          // Stop timer to reset it
ELSE
    tonBlink(IN := TRUE);           // Keep running timer
END_IF


IF blinkToggle THEN
	HeartBeat:=TRUE;
ELSE
	HeartBeat:=FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
