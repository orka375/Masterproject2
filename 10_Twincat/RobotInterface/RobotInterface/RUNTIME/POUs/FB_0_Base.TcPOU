    <Method Name="OnCleanup" Id="{c53ec4e7-ff8a-4f5b-9f71-a4f6d4368c1b}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
VAR_INPUT
END_VAR

VAR
	myResult: eResult;
	notready: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------
notready:=FALSE;
FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		IF pA_Skills[j]^.State = eState.Inactive THEN
			pA_Skills[j]^.Cleanup();
		ELSIF pA_Skills[j]^.State > eState.Inactive THEN
			pA_Skills[j]^.Deactivate();
		ELSIF pA_Skills[j]^.State < eState.Inactive THEN
			Messenger.AddWarn(eMessageCategories.StateMachine,Path,'OnCleanup failed, too low state');
			myResult:=FAILURE;
		END_IF
	
		IF pA_Skills[j]^.LastSuccessfullState <> eState.CleaningUp  THEN
				notready:=TRUE;
			
		END_IF
	END_IF
END_FOR

IF NOT notready THEN
	myResult:=SUCCESS;
END_IF



// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnCleanup := myResult;

]]></ST>
      </Implementation>
    </Method>
