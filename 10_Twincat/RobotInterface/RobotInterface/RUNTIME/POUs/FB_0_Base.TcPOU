    <Method Name="OnShutdown" Id="{baf0cda2-305c-4fe2-9dcb-4d0d08ee6a48}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

VAR
	myResult: eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN
		IF pA_Skills[j]^.LastTransitionType = eTransitions.Shutdown THEN
			IF pA_Skills[j]^.LastTransitionResult <> SUCCESS THEN
				myResult:=SUCCESS;
			END_IF
		END_IF
	END_IF
END_FOR




// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnShutdown := myResult;

]]></ST>
      </Implementation>
