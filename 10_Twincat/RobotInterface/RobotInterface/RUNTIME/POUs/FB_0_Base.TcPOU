    <Action Name="RUN_DEBUG_STATE" Id="{b07d0bc2-302c-40e5-a93e-cde3a635746e}">
      <Implementation>
        <ST><![CDATA[IF DEBUG_S.bActivate THEN
	Activate();
	DEBUG_S.bActivate := FALSE;
END_IF

IF DEBUG_S.bCleanup THEN
	Cleanup();
	DEBUG_S.bCleanup := FALSE;
END_IF

IF DEBUG_S.bConfigure THEN
	Configure();
	DEBUG_S.bConfigure := FALSE;
END_IF

IF DEBUG_S.bDeactivate THEN
	Deactivate();
	DEBUG_S.bDeactivate := FALSE;
END_IF

IF DEBUG_S.bDestroy THEN
	Destroy();
	DEBUG_S.bDestroy := FALSE;
END_IF

IF DEBUG_S.bShutdown THEN
	Shutdown();
	DEBUG_S.bShutdown := FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="Shutdown" Id="{a12b67df-13c4-4acd-81a2-259afa6359fe}" FolderPath="Transitions\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Shutdown : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Shutdown;
_transitionresult:= NONE;

IF State=eState.Inactive OR State=eState.Unconfigured OR State=eState.Active THEN
	State:=eState.ShuttingDown;

ELSE
	_transitionresult:= FAILURE;
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'Shutdown failed');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{186f624f-e691-4cfe-9392-dd87366cedc2}">
      <Declaration><![CDATA[PROPERTY State : eState
]]></Declaration>
      <Get Name="Get" Id="{8c20bc39-5e17-48de-81e9-f86cdcf5978c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[State:=eStatus;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f2b0cb44-bade-4a8a-80d6-a1f37ebc07e9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eStatus:=State;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="StateMachine" Id="{2f358a4c-c272-4679-b042-e935cc28a3dc}">
      <Declaration><![CDATA[METHOD StateMachine : eState
VAR_INPUT
END_VAR

VAR
	

	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _initialized THEN
    sInstanceName := GetInstanceName();
    _initialized := TRUE;
END_IF

IF NOT Messenger.HasActivError AND NOT _ShutOffStateMachine THEN
	
	//RUN STATEMACHINE
	IF NOT TimeStateMachine.Q1 OR SlowDownTimer.Q THEN
		SlowDownTimer(IN:=FALSE);
		SlowDownTimer(IN:=TRUE);
	
		CASE eStatus OF
			eState.Unconfigured:
				IF bAutoConfigure THEN
					Configure();
				END_IF
		
			eState.Inactive:
				;
		
			eState.Active:
				;
			eState.Finalized:
				Destroy();
		
		
		
			eState.Configuring:
				_transitionresult := OnConfigure();
				CASE _transitionresult OF
					NONE:
						;
					SUCCESS:
						LastSuccessfullState:= eState.Configuring;
						TimeStateMachine.RESET1:=TRUE;
						eStatus := eState.Inactive;
					FAILURE:
						LastFail := Now();
						eStatus := eState.Unconfigured;
					ERROR:
						LastError := Now();
						prevStatus := eState.Configuring;
						eStatus := eState.ErrorProcessing;
				END_CASE;
		
		
		
		
			eState.Activating:
				_transitionresult := OnActivate();
				CASE _transitionresult OF
					SUCCESS:
						LastSuccessfullState:= eState.Activating;
						TimeStateMachine.RESET1:=TRUE;
						eStatus := eState.Active;
					FAILURE:
						LastFail := Now();
						eStatus := eState.Inactive;
					ERROR:
						LastError := Now();
						prevStatus := eState.Activating;
						eStatus := eState.ErrorProcessing;
				END_CASE;
		
		
		
			eState.Deactivating:
				_transitionresult := OnDeactivate();
				CASE _transitionresult OF
					SUCCESS:
						LastSuccessfullState:= eState.Deactivating;
						TimeStateMachine.RESET1:=TRUE;
						eStatus := eState.Inactive;
					FAILURE:
						LastFail := Now();
						eStatus := eState.Inactive;
					ERROR:
						LastError := Now();
						prevStatus := eState.Deactivating;
						eStatus := eState.ErrorProcessing;
				END_CASE;
		
		
		
			eState.ErrorProcessing:
				IF _automaticReset THEN
					_transitionresult := OnError();
				ELSIF _manualResetCalled THEN
					_transitionresult := OnError();
					
				END_IF
				
				CASE _transitionresult OF
					SUCCESS:
						LastSuccessfullState:= eState.ErrorProcessing;
						TimeStateMachine.RESET1:=TRUE;
						eStatus := eState.Unconfigured;
					FAILURE:
						LastFail := Now();
						eStatus := eState.Finalized;
					ERROR:
						LastError := Now();
						prevStatus := eState.ErrorProcessing;
						eStatus := eState.ErrorProcessing;
				END_CASE;
		
		
		
			eState.CleaningUp:
				_transitionresult := OnCleanup();
				CASE _transitionresult OF
					SUCCESS:
						LastSuccessfullState:= eState.CleaningUp;
						TimeStateMachine.RESET1:=TRUE;
						eStatus := eState.Unconfigured;
					FAILURE:
						LastFail := Now();
						eStatus := eState.Unconfigured;
					ERROR:
						LastError := Now();
						prevStatus := eState.CleaningUp;
						eStatus := eState.ErrorProcessing;
				END_CASE;
		
		
		
			eState.ShuttingDown:
				_transitionresult := OnShutdown();
				CASE _transitionresult OF
					SUCCESS:
						LastSuccessfullState:= eState.ShuttingDown;
						TimeStateMachine.RESET1:=TRUE;
						eStatus := eState.Finalized;
					FAILURE:
						LastFail := Now();
						eStatus := eState.Finalized;
					ERROR:
						LastError := Now();
						prevStatus := eState.ShuttingDown;
						eStatus := eState.ErrorProcessing;
				END_CASE;
		END_CASE
	END_IF
ELSE
	MyHealth := eHealth.Dead;
	//IF bError
	//Hold StateMachine, await Reset of Error
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>