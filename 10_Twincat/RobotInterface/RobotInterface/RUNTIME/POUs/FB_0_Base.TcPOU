    <Method Name="Activate" Id="{8d29e9eb-3e7c-4311-8303-d07f52bcf283}" FolderPath="Transitions\">
      <Declaration><![CDATA[// {warning 'Add method implementation '}
{attribute 'TcRpcEnable':='1'}
METHOD Activate : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition:=eTransitions.Activate;
_transitionresult:= NONE;

IF State=eState.Inactive THEN
	State:=eState.Activating;
ELSE
	ADSLOGSTR(
    msgCtrlMask := ADSLOG_MSGTYPE_WARN,
    msgFmtStr   := 'Activate failed in: %s',
    strArg      := sPath
);
END_IF]]></ST>
      </Implementation>
    </Method>
