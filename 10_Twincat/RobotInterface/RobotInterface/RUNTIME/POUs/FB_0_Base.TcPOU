    <Method Name="OnActivate" Id="{24d6886a-9f1d-4c0e-8d8e-f6dd1ec5f0d5}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR


VAR
	myResult: ERESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//--------------------------------------------------
myResult:=SUCCESS;		//!!
// ----- YOUR CODE HERE (incl. Alarms) -------------





// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := myResult;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{c53ec4e7-ff8a-4f5b-9f71-a4f6d4368c1b}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
VAR_INPUT
END_VAR

VAR
	myResult: eResult;
	notready: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[myResult := SUCCESS;

FOR j := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[j] <> 0 THEN
        CASE pA_Skills[j]^.State OF
            eState.Active:
                pA_Skills[j]^.Stop();
                myResult := NONE;

            eState.Activating, eState.Deactivating:
                myResult := NONE;

            eState.Inactive:
                pA_Skills[j]^.Cleanup();
                myResult := NONE;

            eState.CleaningUp, eState.Configuring, eState.ShuttingDown:
                myResult := NONE;

            eState.ErrorProcessing:
                SetRecoveryMode(Mode := pA_Skills[j]^.RecoveryMode);
                myResult := ERROR;

            ELSE
                ;
        END_CASE
    END_IF
END_FOR

OnCleanup := myResult;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{3309e05d-b0f8-4780-a3c5-9d432f8faea3}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
VAR_INPUT
END_VAR

VAR
	myResult: eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[myResult := SUCCESS;

// Framework configuration: child skills are brought to a configured, neutral state.
FOR j := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[j] <> 0 THEN
        CASE pA_Skills[j]^.State OF
            eState.Unconfigured:
                pA_Skills[j]^.Configure();
                myResult := NONE;

            eState.Configuring:
                myResult := NONE;

            eState.Inactive:
                ;

            eState.Finalized:
                pA_Skills[j]^.Destroy();
                myResult := NONE;

            eState.ErrorProcessing:
                SetRecoveryMode(Mode := pA_Skills[j]^.RecoveryMode);
                myResult := ERROR;

            ELSE
                // A process child must never remain active while its owner is being configured.
                pA_Skills[j]^.Shutdown();
                myResult := NONE;
        END_CASE
    END_IF
END_FOR

OnConfigure := myResult;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{d4f5f9b3-96c4-4d53-92d3-200d86bcd1c0}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	myResult: ERESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[myResult := SUCCESS;

FOR j := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[j] <> 0 THEN
        CASE pA_Skills[j]^.State OF
            eState.Active:
                pA_Skills[j]^.Stop();
                myResult := NONE;

            eState.Activating, eState.Deactivating, eState.Configuring,
            eState.CleaningUp, eState.ShuttingDown:
                myResult := NONE;

            eState.ErrorProcessing:
                SetRecoveryMode(Mode := pA_Skills[j]^.RecoveryMode);
                myResult := ERROR;

            ELSE
                ;
        END_CASE
    END_IF
END_FOR

OnDeactivate := myResult;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{9d8c13be-0b23-41d4-93f7-5ea06689f4d4}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	myResult: eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[myResult := SUCCESS;

// Framework recovery never repairs hardware. It only makes process children neutral.
FOR j := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[j] <> 0 THEN
        CASE pA_Skills[j]^.State OF
            eState.Active:
                pA_Skills[j]^.Stop();
                myResult := NONE;

            eState.Activating, eState.Configuring, eState.Deactivating,
            eState.CleaningUp, eState.ShuttingDown:
                pA_Skills[j]^.Shutdown();
                myResult := NONE;

            eState.ErrorProcessing:
                // Child recovery policy is authoritative and propagates upward.
                SetRecoveryMode(Mode := pA_Skills[j]^.RecoveryMode);
                myResult := NONE;

            ELSE
                ;
        END_CASE
    END_IF
END_FOR

IF _ShutOffStateMachine THEN
    myResult := NONE;
END_IF

OnError := myResult;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{baf0cda2-305c-4fe2-9dcb-4d0d08ee6a48}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

VAR
	myResult: eResult;
	noskill: BOOL;
	notready: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[myResult := SUCCESS;

// Best effort shutdown: all child skills are asked to terminate, including children
// that were previously in ErrorProcessing. Existing alarms do not prevent shutdown.
FOR j := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[j] <> 0 THEN
        CASE pA_Skills[j]^.State OF
            eState.Finalized, eState.Unconfigured:
                ;

            eState.ShuttingDown:
                myResult := NONE;

            ELSE
                pA_Skills[j]^.Shutdown();
                myResult := NONE;
        END_CASE
    END_IF
END_FOR

OnShutdown := myResult;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Path" Id="{459f7f21-cbfe-4701-91b3-a410fc19512e}">
      <Declaration><![CDATA[PROPERTY Path : STRING
]]></Declaration>
      <Get Name="Get" Id="{2daa2808-fefd-47e5-b0e8-8c13e9ff4c08}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Path:=CONCAT(CONCAT(sPath,'.'),Name);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RecoveryAttempt" Id="{0b30b8c4-9d8d-445d-a798-4f812063d93a}" FolderPath="Error\">
      <Declaration><![CDATA[PROPERTY RecoveryAttempt : UINT]]></Declaration>
      <Get Name="Get" Id="{e21a21aa-5da8-4c99-9f42-0a04a57a49ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RecoveryAttempt := _recoveryAttempt;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RecoveryMode" Id="{5d086c55-9ca3-440c-97d6-cb8e1c8bbf07}" FolderPath="Error\">
      <Declaration><![CDATA[PROPERTY RecoveryMode : eRecoveryMode]]></Declaration>
      <Get Name="Get" Id="{113837b4-5f34-409a-aa48-929e64005ce4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RecoveryMode := _recoveryMode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RecoveryPending" Id="{72f9f967-ec27-442a-9608-82345e94dba2}" FolderPath="Error\">
      <Declaration><![CDATA[PROPERTY RecoveryPending : BOOL]]></Declaration>
      <Get Name="Get" Id="{1eeac78c-16cb-4f76-82ef-07b9a762c52f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RecoveryPending := _recoveryPending OR (State = eState.ErrorProcessing);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RequireNewAcknowledgement" Id="{a92d4a99-4291-4b19-80d7-f11f7e8a0365}" FolderPath="Error\">
      <Declaration><![CDATA[METHOD PROTECTED RequireNewAcknowledgement : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Consume a too-early acknowledgement. The user must acknowledge again
// after the physical/external blocking condition has disappeared.
_manualResetCalled := FALSE;
RequireNewAcknowledgement := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{b87a48b5-252c-4f97-99c7-b52cedc4931c}" FolderPath="Error\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD PUBLIC Reset : eResult
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := SUCCESS;

// Reset is an acknowledgement/permission to attempt recovery. It does NOT
// acknowledge Messenger errors and does NOT claim that the cause disappeared.
IF State = eState.ErrorProcessing THEN
    _manualResetCalled := TRUE;
    _ShutOffStateMachine := FALSE;

    // Start a fresh loop-detection window for the requested recovery attempt.
    prevError := LastError;
    prevFail := LastFail;
    SlowDownTimer(IN := FALSE);
END_IF

// Cascade the acknowledgement only to children that are themselves recovering.
FOR j := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[j] <> 0 THEN
		IF pA_Skills[j]^.State = eState.ErrorProcessing THEN
        	pA_Skills[j]^.Reset();
		END_IF
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Action Name="RUN_DEBUG_STATE" Id="{b07d0bc2-302c-40e5-a93e-cde3a635746e}">
      <Implementation>
        <ST><![CDATA[IF DEBUG_S.bActivate THEN
	Activate();
	DEBUG_S.bActivate := FALSE;
END_IF

IF DEBUG_S.bCleanup THEN
	Cleanup();
	DEBUG_S.bCleanup := FALSE;
END_IF

IF DEBUG_S.bConfigure THEN
	Configure();
	DEBUG_S.bConfigure := FALSE;
END_IF

IF DEBUG_S.bDeactivate THEN
	Deactivate();
	DEBUG_S.bDeactivate := FALSE;
END_IF

IF DEBUG_S.bDestroy THEN
	Destroy();
	DEBUG_S.bDestroy := FALSE;
END_IF

IF DEBUG_S.bShutdown THEN
	Shutdown();
	DEBUG_S.bShutdown := FALSE;
END_IF

IF DEBUG_S.bReset THEN
	Reset();
	DEBUG_S.bReset := FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="SetRecoveryMode" Id="{01243a50-1e70-4f78-bb95-c2d64e9b014b}" FolderPath="Error\">
      <Declaration><![CDATA[METHOD PROTECTED SetRecoveryMode : BOOL
VAR_INPUT
    Mode : eRecoveryMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _recoveryModeAssigned THEN
    _recoveryMode := Mode;
    _recoveryModeAssigned := TRUE;
ELSIF TO_INT(Mode) > TO_INT(_recoveryMode) THEN
    // During one fault context recovery may only become more restrictive.
    _recoveryMode := Mode;
END_IF
SetRecoveryMode := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Action Name="SETUP_BASE" Id="{82f4cfae-8451-4824-9463-c5c5b9849031}">
      <Implementation>
        <ST><![CDATA[HMI_BASE.sInstanceName := GetInstanceName();

FOR i := 1 TO TO_INT(UPPER_BOUND(pA_Skills,1)) DO
	IF pA_Skills[i]<>0 THEN
		HMI_BASE.aNameOfSkills[i]:= pA_Skills[i]^.Name;
	END_IF
END_FOR



]]></ST>
      </Implementation>
    </Action>
    <Method Name="Shutdown" Id="{a12b67df-13c4-4acd-81a2-259afa6359fe}" FolderPath="Transitions\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Shutdown : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_lasttransition := eTransitions.Shutdown;
_transitionresult := NONE;

// Shutdown is best effort and may be requested from any non-final lifecycle state,
// including ErrorProcessing and intermediate transitions.
IF State = eState.Finalized THEN
    _transitionresult := SUCCESS;
ELSIF State = eState.ShuttingDown THEN
    ;
ELSE
    State := eState.ShuttingDown;
END_IF

Shutdown := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{186f624f-e691-4cfe-9392-dd87366cedc2}">
      <Declaration><![CDATA[PROPERTY State : eState
]]></Declaration>
      <Get Name="Get" Id="{8c20bc39-5e17-48de-81e9-f86cdcf5978c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[State:=HMI_BASE.eStatus;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f2b0cb44-bade-4a8a-80d6-a1f37ebc07e9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HMI_BASE.eStatus:=State;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="StateMachine" Id="{2f358a4c-c272-4679-b042-e935cc28a3dc}">
      <Declaration><![CDATA[METHOD StateMachine : eState
VAR_INPUT
END_VAR

VAR
	

	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// Runtime faults enter ErrorProcessing deterministically. During ShuttingDown an
// already active error is tolerated so best-effort shutdown can finish.
IF (Messenger.HasActivError OR _ShutOffStateMachine)
    AND HMI_BASE.eStatus <> eState.ErrorProcessing
    AND HMI_BASE.eStatus <> eState.Finalized
    AND HMI_BASE.eStatus <> eState.ShuttingDown THEN

    IF _ShutOffStateMachine THEN
        SetRecoveryMode(Mode := eRecoveryMode.AcknowledgeRequired);
    END_IF
    EnterErrorProcessing(FromState := HMI_BASE.eStatus);
END_IF

IF NOT TimeStateMachine.Q1 OR SlowDownTimer.Q THEN
    SlowDownTimer(IN := FALSE);
    SlowDownTimer(IN := TRUE);

    CASE HMI_BASE.eStatus OF
        eState.Unconfigured:
            IF bAutoConfigure THEN Configure(); END_IF

        eState.Inactive:
            ;

        eState.Active:
            ;

        eState.Finalized:
            Destroy();

        eState.Configuring:
            _transitionresult := OnConfigure();
            CASE _transitionresult OF
                NONE: ;
                SUCCESS:
                    LastSuccessfullState := eState.Configuring;
                    TimeStateMachine.RESET1 := TRUE;
                    HMI_BASE.eStatus := eState.Inactive;
                    // A successful complete reconfiguration closes the previous recovery context.
                    _recoveryPending := FALSE;
                    _manualResetCalled := FALSE;
                    _recoveryAttempt := 0;
                    _recoveryModeAssigned := FALSE;
                    _recoveryMode := eRecoveryMode.AcknowledgeRequired;
                FAILURE:
                    LastFail := Now();
                    HMI_BASE.eStatus := eState.Unconfigured;
                ERROR:
                    LastError := Now();
                    EnterErrorProcessing(FromState := eState.Configuring);
            END_CASE

        eState.Activating:
            _transitionresult := OnActivate();
            CASE _transitionresult OF
                NONE: ;
                SUCCESS:
                    LastSuccessfullState := eState.Activating;
                    TimeStateMachine.RESET1 := TRUE;
                    HMI_BASE.eStatus := eState.Active;
                FAILURE:
                    LastFail := Now();
                    HMI_BASE.eStatus := eState.Inactive;
                ERROR:
                    LastError := Now();
                    EnterErrorProcessing(FromState := eState.Activating);
            END_CASE

        eState.Deactivating:
            _transitionresult := OnDeactivate();
            CASE _transitionresult OF
                NONE: ;
                SUCCESS:
                    LastSuccessfullState := eState.Deactivating;
                    TimeStateMachine.RESET1 := TRUE;
                    HMI_BASE.eStatus := eState.Inactive;
                FAILURE:
                    LastFail := Now();
                    HMI_BASE.eStatus := eState.Inactive;
                ERROR:
                    LastError := Now();
                    EnterErrorProcessing(FromState := eState.Deactivating);
            END_CASE

        eState.ErrorProcessing:
            _transitionresult := NONE;

            IF (_recoveryMode = eRecoveryMode.Automatic) OR _manualResetCalled THEN
                _transitionresult := OnError();
            END_IF

            CASE _transitionresult OF
                NONE:
                    ;

                SUCCESS:
                    // Technical recovery is complete. Only now may latched diagnostic
                    // errors be acknowledged. Stay in ErrorProcessing until they are gone.
                    IF Messenger.HasActivError THEN
                        IF Messenger.PointerActivError <> 0 THEN
                            Messenger.PointerActivError^.bQuit := TRUE;
                        END_IF
                    ELSE
                        LastSuccessfullState := eState.ErrorProcessing;
                        TimeStateMachine.RESET1 := TRUE;
                        _recoveryPending := FALSE;
                        _manualResetCalled := FALSE;
                        _ShutOffStateMachine := FALSE;
                        HMI_BASE.eStatus := eState.Unconfigured;
                    END_IF

                FAILURE:
                    // Recovery did not complete, but the component is still defined.
                    // Never retry such a result automatically in a tight loop.
                    LastFail := Now();
                    SetRecoveryMode(Mode := eRecoveryMode.AcknowledgeRequired);
                    _manualResetCalled := FALSE;

                ERROR:
                    // Recovery itself failed: remain in ErrorProcessing and require a
                    // deliberate acknowledgement before another attempt.
                    LastError := Now();
                    SetRecoveryMode(Mode := eRecoveryMode.AcknowledgeRequired);
                    _manualResetCalled := FALSE;
            END_CASE

        eState.CleaningUp:
            _transitionresult := OnCleanup();
            CASE _transitionresult OF
                NONE: ;
                SUCCESS:
                    LastSuccessfullState := eState.CleaningUp;
                    TimeStateMachine.RESET1 := TRUE;
                    HMI_BASE.eStatus := eState.Unconfigured;
                FAILURE:
                    LastFail := Now();
                    HMI_BASE.eStatus := eState.Unconfigured;
                ERROR:
                    LastError := Now();
                    EnterErrorProcessing(FromState := eState.CleaningUp);
            END_CASE

        eState.ShuttingDown:
            _transitionresult := OnShutdown();
            CASE _transitionresult OF
                NONE: ;
                SUCCESS:
                    LastSuccessfullState := eState.ShuttingDown;
                    TimeStateMachine.RESET1 := TRUE;
                    HMI_BASE.eStatus := eState.Finalized;
                FAILURE:
                    LastFail := Now();
                    HMI_BASE.eStatus := eState.Finalized;
                ERROR:
                    LastError := Now();
                    EnterErrorProcessing(FromState := eState.ShuttingDown);
            END_CASE
    END_CASE
END_IF

StateMachine := HMI_BASE.eStatus;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>