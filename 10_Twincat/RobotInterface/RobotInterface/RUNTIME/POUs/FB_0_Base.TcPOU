]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{d4f5f9b3-96c4-4d53-92d3-200d86bcd1c0}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	myResult: ERESULT;
	notready: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

notready:=FALSE;

FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
	IF pA_Skills[j]<>0 THEN

		IF pA_Skills[j]^.State > eState.Inactive THEN
			pA_Skills[j]^.Deactivate();
		ELSIF pA_Skills[j]^.State <= eState.Inactive THEN
			Messenger.AddWarn(eMessageCategories.StateMachine,Path,'OnDeactivate failed, too low state');
			myResult:=FAILURE;
		END_IF
	
		IF pA_Skills[j]^.LastSuccessfullState <> eState.Deactivating  THEN
				notready:=TRUE;
			
		END_IF
	END_IF
END_FOR

IF NOT notready THEN
	myResult:=SUCCESS;
END_IF





// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := myResult;

]]></ST>
      </Implementation>
    </Method>
