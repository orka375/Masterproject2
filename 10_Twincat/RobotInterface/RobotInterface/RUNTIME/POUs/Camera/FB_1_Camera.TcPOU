<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_1_Camera" Id="{10e561f6-05fb-48b7-85cc-15c4d0c3c4c8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_1_Camera EXTENDS FB_0_Base
VAR_INPUT
	SET_CAM : stSettings_Camera;
	CAM: FB_VN_GevCameraControl;
	VisionSkills : ARRAY[1..SETUP.MaxNrofSkillsperUnit] OF POINTER TO FB_2_VisionSkills;
	
END_VAR
VAR_OUTPUT
	aCameraMatrixLocal : TcVnMatrix3x3_LREAL;
    aDistortionCoefficientsLocal : TcVnArray8_LREAL;
END_VAR
VAR
	_INIT_CAM: BOOL;
	_requestReadParamsFile: BOOL;
	res: eResult;
END_VAR

VAR	//READPARAMSFILE
    fbJson : FB_JsonDomParser;

    jsonRoot     : SJsonValue;
    jsonMatrix   : SJsonValue;
    jsonRow      : SJsonValue;
    jsonValue    : SJsonValue;
    jsonDist     : SJsonValue;

    bLoad : BOOL;
    bLoaded : BOOL;

    nState : UINT := 0;

 

    rTrig : R_TRIG;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_CAM();]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{8be19e11-1543-44f0-9365-207353e3479f}" />
    <Action Name="CYCLIC_CAM" Id="{7413976a-14f3-4f89-a2cb-2c4befe116b4}">
      <Implementation>
        <ST><![CDATA[// ------ CALL CYCLIC -----------------
IF NOT _INIT_CAM THEN
	_INIT_CAM:=TRUE;
	SETUP_CAM();
END_IF

CYCLIC_BASE();


// ------ WRITE HMI -------------------
		// NO HMI STRUCT

// ------ READ FROM HMI ---------------
		// NO HMI STRUCT
	


// ------ WRITE PROPS/METHODS ---------
	//Operational := ??
	
	
// ----- CALL POUS AND ERROR SURVEILLANCE ----------


// ----- REST --------------------

IF _requestReadParamsFile THEN
	res := ReadParamsFile();
	
	IF SUCCESS = res THEN
		_requestReadParamsFile := FALSE;
	ELSIF FAILURE = res THEN
		//Using Params from Settings
		aCameraMatrixLocal := SET_CAM.aCameraMatrix;
    	aDistortionCoefficientsLocal := SET_CAM.aDistortionCoefficients;
		_requestReadParamsFile := FALSE;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="onActivate" Id="{ecf82beb-28a8-4731-bac1-44ceabff9dcc}" FolderPath="StateControl\">
