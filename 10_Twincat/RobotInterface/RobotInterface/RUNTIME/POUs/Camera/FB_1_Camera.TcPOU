    <Method Name="ReadParamsFile" Id="{a022e4cd-9428-4c98-b173-3dd260cf9668}">
      <Declaration><![CDATA[METHOD ReadParamsFile : eResult
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[


CASE nState OF

	0:
		bLoad:=TRUE;
		nState:=10;
		
		
    // -----------------------------------------------------
    // Load JSON file
    // -----------------------------------------------------
    10:
		
        bLoaded := fbJson.LoadDocumentFromFile(
            sFile := SET_CAM.sFilePath,
            bExec := bLoad,
        );

        // LoadDocumentFromFile resets bLoad when finished
        IF NOT bLoad THEN
            IF bLoaded THEN
                nState := 20;
            ELSE
                Messenger.AddWarn(eMessageCategories.MissingData,Path,'Could not load Camera Params File');
				ReadParamsFile := FAILURE;
            END_IF

        END_IF


    // -----------------------------------------------------
    // Parse camera matrix
    // -----------------------------------------------------
    20:
        jsonRoot := fbJson.GetDocumentRoot();

        IF jsonRoot = 0 THEN
            nState := 100;
        ELSE
            jsonMatrix := fbJson.FindMember(
                jsonRoot,
                'CameraMatrix'
            );

            IF jsonMatrix = 0 THEN
                nState := 100;
            ELSE
				//Found
                FOR i := 0 TO 2 DO
					jsonRow := fbJson.GetArrayValueByIdx(jsonMatrix,i);
		
					IF jsonRow = 0 THEN
						nState := 100;
						RETURN;
					END_IF
		
					FOR j := 0 TO 2 DO
						jsonValue := fbJson.GetArrayValueByIdx(jsonRow,j);
		
						IF jsonValue = 0 THEN
							nState := 100;
							RETURN;
						END_IF
		
						aCameraMatrixLocal[i, j] := fbJson.GetDouble(jsonValue);
					END_FOR
				END_FOR
		
				nState := 30;
            END_IF
        END_IF



    // -----------------------------------------------------
    // Find distortion coefficients
    // -----------------------------------------------------
    30:
        jsonDist := fbJson.FindMember(
            jsonRoot,
            'DistortionCoefficients'
        );

        IF jsonDist = 0 THEN
            nState := 100;
        ELSE
            FOR i := 0 TO 7 DO
				jsonValue := fbJson.GetArrayValueByIdx(jsonDist,i);
	
				IF jsonValue = 0 THEN
					nState := 100;
					RETURN;
				END_IF
				aDistortionCoefficientsLocal[i] :=fbJson.GetDouble(jsonValue);
			END_FOR
        nState := 40;
        END_IF

    40:
        ReadParamsFile := SUCCESS;
        nState := 0;


    // -----------------------------------------------------
    // Error
    // -----------------------------------------------------
    100:
        ReadParamsFile := FAILURE;
        nState := 0;

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Action Name="SETUP_CAM" Id="{7d3ec5aa-481b-46e2-8949-8e856cba5d9b}">
      <Implementation>
        <ST><![CDATA[IF SET_CAM.UseParamFile THEN
	_requestReadParamsFile:=TRUE;
END_IF

j:=0;
FOR i := 1 TO TO_INT(UPPER_BOUND(VisionSkills,1)) DO
	IF VisionSkills[i]<>0 THEN
		VisionSkills[i]^.pOwnerCam:=THIS;
		WHILE Skills[j+1]<> 0 DO
			j := j+1;
		END_WHILE
		
		IF j+1 < SETUP.MaxNrofSkillsPerUnit THEN //fill
			Skills[j+1] := VisionSkills[i];

	END_IF
	ELSE
		RETURN;
	END_IF
	
	
	
	
END_FOR]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>