<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{85d06b9d-6930-4657-baf8-8d40974ee2d3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	

    _state_LD90 : eState;
    _state_LD90_sLDR : eState;
    _state_LD90_sEyes : eState;

	i: INT;
	testcreate: BOOL;

	// Cell robot loop index.
	iRobot : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ----------------------------------------------------------
// Cell robots (UR5-01 / UR5-02). Each ROBOT_UR call runs its
// own communication + CYCLIC_MANIP (incl. JOG) internally.
// ----------------------------------------------------------
FOR iRobot := 1 TO GVL_Cell.nRobotCount DO
    // Attach each robot's PickPlace skill instance (HMI binds to it).
    GVL_Cell.aRobot[iRobot].pA_Skills[1] := ADR(GVL_Cell.aSkillPickPlace[iRobot]);
    GVL_Cell.aRobot[iRobot]();
END_FOR

// Cell communication summary: connected/ready only when every
// robot link is up (authoritative comm state stays in the PLC).
GVL_Cell.Comm._CommunicationConnected := TRUE;
GVL_Cell.Comm._CommunicationReady := TRUE;
FOR iRobot := 1 TO GVL_Cell.nRobotCount DO
    IF GVL_Cell.aRobot[iRobot].COMM = 0 THEN
        GVL_Cell.Comm._CommunicationConnected := FALSE;
        GVL_Cell.Comm._CommunicationReady := FALSE;
    ELSIF NOT GVL_Cell.aRobot[iRobot].COMM^.Connected THEN
        GVL_Cell.Comm._CommunicationConnected := FALSE;
        GVL_Cell.Comm._CommunicationReady := FALSE;
    END_IF
END_FOR

