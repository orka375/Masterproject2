<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_1_CommunicationModul" Id="{5dfb62c0-2d47-4b53-bfa8-e561c40cbe14}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_1_CommunicationModul EXTENDS FB_0_BASE 
// IMPLEMENTS ITF_1_Communication

VAR_INPUT
    DEBUG_COMM : DEBUG_COMM;

    tConnectTimeout    : TIME := T#10S;
    tDisconnectTimeout : TIME := T#5S;
    tReconnectDelay    : TIME := T#2S;
END_VAR


VAR_OUTPUT
END_VAR
VAR
    // Desired state from Robot / lifecycle
    _ConnectionRequested : BOOL;

    // Request sent toward the child communication implementation
    bRequestConnection : BOOL;

    // Feedback supplied by the child communication implementation
    _CommunicationConnected : BOOL;
    _CommunicationReady     : BOOL;

    // Reconnect sequencing
    _ReconnectRequested : BOOL;

    // Communication state
    _eCommState : E_CommState := E_CommState.eDisconnected;

    // Timers
    _tonConnectTimeout    : TON;
    _tonDisconnectTimeout : TON;
    _tonReconnectDelay    : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Child" Id="{97165f57-2a6b-45d0-8208-1f95b60b5b3e}" />
    <Folder Name="StateControl" Id="{ee8ac4a0-f0cf-40ca-b53b-7b5d8eb3bef1}" />
    <Property Name="CommunicationReady" Id="{cd2541e9-c446-41df-86d3-5e7de551597b}">
      <Declaration><![CDATA[PROPERTY CommunicationReady : BOOL]]></Declaration>
      <Get Name="Get" Id="{8777da96-80fa-4c82-8f5c-130cb7162c26}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF DEBUG_COMM.bSimConnected THEN
    CommunicationReady := _ConnectionRequested;
ELSE
    CommunicationReady := _CommunicationReady;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Connect" Id="{48cddc0e-90b0-47e7-b3f4-033f55fc4faf}">
      <Declaration><![CDATA[METHOD Connect : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
_ConnectionRequested := TRUE;

Connect := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Connected" Id="{c0375131-429a-4439-8004-b40c8cb4ab30}">
      <Declaration><![CDATA[PROPERTY Connected : BOOL]]></Declaration>
      <Get Name="Get" Id="{30ad663f-1783-49a6-80f0-e1c1f8749cbd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF DEBUG_COMM.bSimConnected THEN
    Connected := _ConnectionRequested;
ELSE
    Connected := _CommunicationConnected;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Action Name="CYCLIC_COMM" Id="{db736a65-6184-4548-9d87-5644861796c2}">
      <Implementation>
        <ST><![CDATA[CYCLIC_BASE();


Busy :=
    (_eCommState = E_CommState.eConnecting)
    OR
    (_eCommState = E_CommState.eDisconnecting)
    OR
    (_eCommState = E_CommState.eReconnectWait);
	
	
	


// --------------------------------------------------
// Timers
// --------------------------------------------------

_tonConnectTimeout(
    IN := _eCommState = E_CommState.eConnecting,
    PT := tConnectTimeout
);

_tonDisconnectTimeout(
    IN := _eCommState = E_CommState.eDisconnecting,
    PT := tDisconnectTimeout
);

_tonReconnectDelay(
    IN := _eCommState = E_CommState.eReconnectWait,
    PT := tReconnectDelay
);


// --------------------------------------------------
// Simulation
// --------------------------------------------------

IF DEBUG_COMM.bSimConnected THEN

    // Never open real communication in simulation.
    bRequestConnection := FALSE;

    IF _ConnectionRequested THEN
        _eCommState := E_CommState.eConnected;
    ELSE
        _eCommState := E_CommState.eDisconnected;
    END_IF

    RETURN;

END_IF


// --------------------------------------------------
// Communication state machine
// --------------------------------------------------

CASE _eCommState OF


    // ==============================================
    // DISCONNECTED
    // ==============================================
    E_CommState.eDisconnected:

        bRequestConnection := FALSE;

        IF _ReconnectRequested
           AND _ConnectionRequested THEN

            _eCommState := E_CommState.eReconnectWait;

        ELSIF _ConnectionRequested THEN

            bRequestConnection := TRUE;
            _eCommState := E_CommState.eConnecting;

        END_IF


    // ==============================================
    // CONNECTING
    // ==============================================
    E_CommState.eConnecting:

        bRequestConnection := TRUE;


        // User cancelled connection request
        IF NOT _ConnectionRequested THEN

            bRequestConnection := FALSE;
            _eCommState := E_CommState.eDisconnecting;


        // Communication fully initialized
        ELSIF _CommunicationReady THEN

            _ReconnectRequested := FALSE;
            _eCommState := E_CommState.eConnected;


        // Timeout
        ELSIF _tonConnectTimeout.Q THEN

            // TODO USER:
            // Messenger.AddError(... connection timeout ...);

            bRequestConnection := FALSE;

            IF _ConnectionRequested THEN
                _ReconnectRequested := TRUE;
            END_IF

            _eCommState := E_CommState.eDisconnecting;

        END_IF


    // ==============================================
    // CONNECTED
    // ==============================================
    E_CommState.eConnected:

        bRequestConnection := TRUE;


        // Explicit reconnect
        IF _ReconnectRequested THEN

            bRequestConnection := FALSE;
            _eCommState := E_CommState.eDisconnecting;


        // Explicit disconnect
        ELSIF NOT _ConnectionRequested THEN

            bRequestConnection := FALSE;
            _eCommState := E_CommState.eDisconnecting;


        // Unexpected loss of communication
        ELSIF NOT _CommunicationConnected THEN

            // TODO USER:
            // Messenger.AddError(... communication lost ...);

            bRequestConnection := FALSE;
            _ReconnectRequested := TRUE;

            _eCommState := E_CommState.eDisconnecting;

        END_IF


    // ==============================================
    // DISCONNECTING
    // ==============================================
    E_CommState.eDisconnecting:

        bRequestConnection := FALSE;


        IF NOT _CommunicationConnected THEN

            IF _ReconnectRequested
               AND _ConnectionRequested THEN

                _eCommState := E_CommState.eReconnectWait;

            ELSE

                _ReconnectRequested := FALSE;
                _eCommState := E_CommState.eDisconnected;

            END_IF


        ELSIF _tonDisconnectTimeout.Q THEN

            // TODO USER:
            // Messenger.AddError(... disconnect timeout ...);

            // Stay in Disconnecting.
            // Do NOT falsely report Disconnected.

        END_IF


    // ==============================================
    // RECONNECT DELAY
    // ==============================================
    E_CommState.eReconnectWait:

        bRequestConnection := FALSE;


        // Reconnect cancelled
        IF NOT _ConnectionRequested THEN

            _ReconnectRequested := FALSE;
            _eCommState := E_CommState.eDisconnected;


        // Delay complete
        ELSIF _tonReconnectDelay.Q THEN

            _ReconnectRequested := FALSE;

            bRequestConnection := TRUE;
            _eCommState := E_CommState.eConnecting;

        END_IF


END_CASE]]></ST>
      </Implementation>
    </Action>
    <Method Name="Disconnect" Id="{a755e2b5-5cce-4c7d-9a87-13d3a2190f4b}">
      <Declaration><![CDATA[METHOD Disconnect : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ConnectionRequested := FALSE;
_ReconnectRequested := FALSE;

Disconnect := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnActivate" Id="{eb2d4e14-3804-493f-9198-3fada3407113}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------


myResult:=SUCCESS;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{271627c0-185a-4b33-a1e0-976d0eff2623}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnCleanup();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

Disconnect();
IF NOT Connected THEN
	myResult:=SUCCESS;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnCleanup := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{63e968d4-d2d9-4a1c-932d-33a8095bfc02}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

Connect();
IF CommunicationReady  THEN
	myResult:=SUCCESS;
END_IF


// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnConfigure := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{19a862e8-d2b8-47e0-b989-f999b1ab2adc}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnDeactivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

myResult:=SUCCESS;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{7a846a43-e5f1-4e60-b878-bf1f3c5633d0}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();

myResult := NONE;

// ----- YOUR CODE HERE -----------------------------

Reconnect();

IF CommunicationReady THEN
    myResult := SUCCESS;
END_IF

// ----- END YOUR CODE ------------------------------

OnError := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{2f41cb60-ac89-4bad-950e-538f034a5d15}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

    VAR
    	eParentResult: eResult;
    	myResult: ERESULT;
    END_VAR

    VAR //YOUR CODE
    	succ : BOOL;
    END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();
    //--------------------------------------------------
    myResult:=NONE;
    // ----- YOUR CODE HERE (incl. Alarms) -------------

Disconnect();
IF NOT Connected THEN
	myResult:=SUCCESS;
END_IF

    // ----- END YOUR CODE -----------------------------
    //--------------------------------------------------
    OnShutdown := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reconnect" Id="{94c5b353-24b4-46a6-80f3-2f9bcf7be971}">
      <Declaration><![CDATA[METHOD Reconnect : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ConnectionRequested := TRUE;
_ReconnectRequested := TRUE;

Reconnect := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>