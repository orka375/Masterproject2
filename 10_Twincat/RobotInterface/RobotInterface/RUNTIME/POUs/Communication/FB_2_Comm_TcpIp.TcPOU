END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnDeactivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

Update();
    myResult:=NONE;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{cbca3eb3-1f59-4132-8cb6-1ba90593b065}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

Update();
    myResult:=NONE;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnError := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{f085909e-b37c-4b4c-a9a3-f41132b1f91f}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

Update();

IF fbClient.bConnected THEN
      myResult := None;
ELSE
      myResult := SUCCESS;
    END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnShutdown := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="RxData" Id="{4a0d0f2c-27c2-4f4a-a7cf-4b0f6d7f5a11}">
      <Declaration><![CDATA[// Start of the receive buffer, valid for nRxBytes bytes while bRxNewData is set.
PROPERTY RxData : POINTER TO BYTE]]></Declaration>
      <Get Name="Get" Id="{8f8a5b5e-1f22-4d2f-9b60-51f7ec7c6d22}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RxData := ADR(fbClient.aRxData);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Send" Id="{ef48ac7a-3006-4248-b9fc-337133a074ce}">
      <Declaration><![CDATA[METHOD Send : BOOL
VAR_INPUT
    pData : PVOID;
    nDataSize : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Send := FALSE;

IF (pData = 0) OR (nDataSize = 0) OR (nDataSize > C_BUFFER_SIZE) OR _sendRequest OR bSendBusy THEN
    RETURN;
END_IF

// Copy into an own buffer so the caller may reuse its data immediately.
MEMCPY(destAddr := ADR(_txBuffer), srcAddr := pData, n := nDataSize);
_txSize := nDataSize;
_sendRequest := TRUE;
Send := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{1f329bb1-c1b5-4d91-9d17-ceb7bfae8aee}">
      <Declaration><![CDATA[METHOD Update : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[// A reconnect drops the link first and lets the client reopen it.
IF _ReconnectRequested AND NOT fbClient.bConnected THEN
    _ReconnectRequested := FALSE;
END_IF

fbClient(
    bEnable := _CommEnabled AND NOT _ReconnectRequested,
    bReset := _resetRequest,
    Config := Config,
    bReceiveEnable := bReceiveEnable,
    bSend := _sendRequest,
    pSendData := ADR(_txBuffer),
    nSendSize := _txSize
);

_resetRequest := FALSE;
_sendRequest := FALSE;

bReadyForSend := fbClient.bReadyForSend;
bSendBusy := fbClient.bSendBusy;
bSendDone := fbClient.bSendDone;
bRxNewData := fbClient.bRxNewData;
nRxBytes := fbClient.nRxBytes;
bError := fbClient.bError;
nErrorId := fbClient.nErrorId;
sError := fbClient.sError;

Update := NOT bError;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>