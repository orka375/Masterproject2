  <POU Name="FB_1_Skill" Id="{2b9ea1ae-8caf-40cf-8b0f-b3a375666762}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_1_Skill EXTENDS FB_0_Base 
// IMPLEMENTS ITF_1_Skill
VAR_INPUT
	pROB: POINTER TO FB_1_ROB;
	_runExternal : BOOL := FALSE;
END_VAR

VAR_INPUT
	{attribute 'OPC.UA.DA.StructuredType':=1}
	{attribute 'OPC.UA.DA' := '1'}
    Status    : stExternalStatus;
END_VAR

VAR_OUTPUT
	{attribute 'OPC.UA.DA.StructuredType':=1}
	{attribute 'OPC.UA.DA' := '1'}
    Command   : stExternalCommand;

 
    bDone       : BOOL;



END_VAR

VAR
	aHandler: FB_ExternalHandshake;
	rtAbort: R_TRIG;
	rtStop: R_TRIG;
	rtRestart: R_TRIG;
	
	
    eFbState    : E_FB_SkillState := E_FB_SkillState.Idle;

    nSequence   : UDINT;

    bStartOld   : BOOL;
    bStopOld    : BOOL;
    bAbortOld   : BOOL;
    bRestartOld : BOOL;

    bStartRise   : BOOL;
    bStopRise    : BOOL;
    bAbortRise   : BOOL;
    bRestartRise : BOOL;

    tonTimeout  : TON;
	_activateDeploy: BOOL;
	extSkillRes: eResult;
	_emergency: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{96dbd9e8-6c39-4ccb-8b32-e843cad33cc5}" />
    <Folder Name="Public" Id="{8eeb3120-c4f5-4dff-98ca-2143f9392787}" />
