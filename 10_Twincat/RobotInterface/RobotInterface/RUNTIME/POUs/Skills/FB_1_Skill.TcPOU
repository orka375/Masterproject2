    </Method>
    <Method Name="onActivate" Id="{46f7f3ef-55a8-4a46-bd3a-f25fd3c3df9b}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED onActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;

END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.onActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------


IF State>=eState.Inactive AND State<>eState.Active THEN
	IF HMI_SKILL.ExternalImplementation THEN
		myResult:= ExternalStart();
	ELSE
		myResult:=_M_Start();
	END_IF
	
ELSE
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'OnActivate hat nichts gebracht, weil nicht >Inactive');
	myResult:=FAILURE;
END_IF


IF pOwner^.State <>eState.Active AND pOwner^.State <>eState.Activating  THEN
	MEssenger.AddWarn(eMessageCategories.StateMachine,Path,'On_XX not possible because _owner/pRob is not ready');
	myResult:=FAILURE;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
onActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
