    <Action Name="RUN_DEBUG_SKILL" Id="{1fa16960-2e47-40ed-acf7-3e974bec9e31}">
      <Implementation>
        <ST><![CDATA[IF DEBUG_Skill.bExecute THEN
	Execute();
	DEBUG_Skill.bExecute := FALSE;
END_IF

IF DEBUG_Skill.bStop THEN
	Stop();
	DEBUG_Skill.bStop := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="Stop" Id="{d1f535cb-92d0-408d-90d6-a0632cef04b6}" FolderPath="Public\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Stop : eResult
VAR_INPUT
// 	pSkill : POINTER TO FB_SKILL;
// 	name: STRING := '';
END_VAR

VAR
	toolready: BOOL;
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pOwner^.ActivSkill:= 0;

IF State = eState.Active THEN
	Deactivate();
	Messenger.AddHint(eMessageCategories.StateMachine,Path,'Stoping Skill');
END_IF


IF LastTransitionType=eTransitions.Deactivate THEN //TODO CHECK
	Stop:=LastTransitionResult; 
 END_IF
 ]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>