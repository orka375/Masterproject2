	config_succ: BOOL:=TRUE;
	act_succ: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

//or custom which gets overriden like SFCINIt 
 
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Stop" Id="{a9d4d73b-7482-4200-8810-5606d9f030a9}" FolderPath="Internal\">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD INTERNAL _M_Stop : eResult
]]></Declaration>
