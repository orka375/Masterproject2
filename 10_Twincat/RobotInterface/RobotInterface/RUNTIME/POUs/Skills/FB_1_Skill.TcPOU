]]></Declaration>
      <Get Name="Get" Id="{0242fbae-76a5-4aa2-b856-2127b50bb2bd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecutionDone:=_executionDone;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{529cb888-374f-485e-9cad-52c4576c3c84}">
        <Declaration><![CDATA[
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_executionDone:= ExecutionDone;]]></ST>
        </Implementation>
      </Set>
    </Property>
