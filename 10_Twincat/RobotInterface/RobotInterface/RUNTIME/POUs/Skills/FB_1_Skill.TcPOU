      <Get Name="Get" Id="{87cf7e11-94de-4e33-927e-651c51178484}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecutionResult:=_execuctionresult;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d5feb4b8-bc52-41e2-a133-4d096f38bf41}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_execuctionresult := ExecutionResult;]]></ST>
        </Implementation>
      </Set>
    </Property>
