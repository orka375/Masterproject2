myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

myResult:=SUCCESS;

IF pOwner^.State <>eState.Inactive AND pOwner^.State <>eState.Configuring  THEN
	MEssenger.AddWarn(eMessageCategories.StateMachine,Path,'On_XX not possible because _owner/pRob is not ready');
	myResult:=None;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
onConfigure := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="onDeactivate" Id="{f7f8a601-0da1-401a-b4ff-c5f00f6c24ff}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED onDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.onDeactivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------


IF State>=eState.Deactivating THEN
	IF HMI_SKILL.ExternalImplementation THEN
		myResult:= ExternalStop();
	ELSE
		myResult:= _M_Stop();
	END_IF
// ELSIF State=eState.Deactivating	THEN
// 	myResult:=SUCCESS;
// 	
ELSE
	Messenger.AddWarn(eMessageCategories.StateMachine,Path,'OnDeactivate hat nichts gebracht, weil nicht >Inactive');
	myResult:=FAILURE;
END_IF





// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
onDeactivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
