]]></ST>
      </Implementation>
    </Method>
    <Action Name="CYCLIC_SKILL" Id="{9ca32eb4-b06c-4bf7-9875-7dec22454c33}">
      <Implementation>
        <ST><![CDATA[
CYCLIC_BASE();
RUN_DEBUG_SKILL();
aHandler(Cmd:=ADR(HMI_SKILL.Command),Stat:=ADR(HMI_SKILL.Status));

// HMI command bits. Start is latched and driven until the skill is
// Active (the state machine needs several cycles to progress);
// Stop/Reset act on the rising edge.
_rExec(CLK := HMI_SKILL.bExecute);
_rStopCmd(CLK := HMI_SKILL.bStop);
_rReset(CLK := HMI_SKILL.bReset);

IF _rExec.Q THEN
	_startReq := TRUE;
END_IF
IF _rStopCmd.Q THEN
	_startReq := FALSE;
	Stop();
END_IF
IF _rReset.Q THEN
	_startReq := FALSE;
	Reset();
END_IF

IF _startReq THEN
	IF (State = eState.Active) OR (State = eState.ErrorProcessing) THEN
		_startReq := FALSE;
	ELSE
		Execute();
	END_IF
END_IF


IF HMI_SKILL.ExternalImplementation THEN
	ExecutionDone:=HMI_SKILL.Status.ExecutionDone;
	Busy:=HMI_SKILL.Status.ExecutionBusy;
	ExecutionResult:= HMI_SKILL.Status.ExecutionResult;
	
	IF ExecutionResult = ERROR THEN
		MEssenger.AddError(eMessageCategories.External,Path,'External Execution failed');
	END_IF
END_IF


CASE State OF
	eState.Inactive:
		 HMI_BASE.bBusy := FALSE;
   		 _executionDone := FALSE;
	
	eState.Active:
		// ExecutionDone/Busy are fed from Status when running external, so both paths share one completion check.
		IF ExecutionDone AND NOT Busy THEN
			Deactivate();
		END_IF

END_CASE


  ]]></ST>
      </Implementation>
    </Action>
    <Method Name="Execute" Id="{14e74aad-f700-47b9-8be4-6ab604c1de8c}" FolderPath="Public\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Execute : eResult
VAR_INPUT
// 	pSkill : POINTER TO FB_SKILL;
// 	name: STRING := '';
END_VAR

VAR
	toolready: BOOL;
	i: INT;
	config_res: eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[


pOwner^.ActivSkill:= THIS;

IF State = eState.Unconfigured THEN
	Configure();
	Messenger.AddHint(eMessageCategories.StateMachine,Path,'Autoconfiguring Skill %s because Start was called an State = unconfigured');
END_IF
IF (LastTransitionType=eTransitions.Configure AND LastTransitionResult<=SUCCESS) OR State = eState.Inactive THEN
	Activate();
END_IF


IF (LastTransitionType=eTransitions.Activate AND LastTransitionResult<=SUCCESS)  THEN
	Execute:=SUCCESS; 
	Messenger.AddHint(eMessageCategories.Positiv,Path,'Starting Skill');
 
 END_IF
 
 ]]></ST>
      </Implementation>
    </Method>
