  <POU Name="FB_1_Skill" Id="{2b9ea1ae-8caf-40cf-8b0f-b3a375666762}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_1_Skill EXTENDS FB_0_Base 
// IMPLEMENTS ITF_1_Skill
VAR_INPUT
	DEBUG_SKILL: DEBUG_SKILL;
	pOwner: POINTER TO FB_0_BASE;
	
	
END_VAR

VAR_INPUT
	
END_VAR

VAR_OUTPUT
	HMI_SKILL : stHMI_SKILL;
	

 	



END_VAR

VAR
	aHandler: FB_ExternalHandshake;
	rtAbort: R_TRIG;
	rtStop: R_TRIG;
	rtRestart: R_TRIG;
	_rExec: R_TRIG;
	_rStopCmd: R_TRIG;
	_rReset: R_TRIG;
	_startReq: BOOL;
	    _executionDone       : BOOL;
	_execuctionresult: eResult;
	


    nSequence   : UDINT;

    tonTimeout  : TON;
	_activateDeploy: BOOL;
	_emergency: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{96dbd9e8-6c39-4ccb-8b32-e843cad33cc5}" />
