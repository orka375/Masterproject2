    <Method Name="FB_Init" Id="{69f9f497-1b72-4d80-aee2-459cc303c27d}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
  VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
  END_VAR
  VAR
    iSkill : UINT;
  END_VAR]]></Declaration>
      <Implementation>
      <ST><![CDATA[SUPER^.FB_Init(bInitRetains := bInitRetains, bInCopyCode := bInCopyCode);

  FOR iSkill := 1 TO SETUP.nSkillCount DO
    IF SETUP.apSkill[iSkill] = THIS THEN
      FB_Init := TRUE;
      RETURN;
    END_IF
  END_FOR

  IF SETUP.nSkillCount < SETUP.MaxNrofSkills THEN
    SETUP.nSkillCount := SETUP.nSkillCount + 1;
    SETUP.apSkill[SETUP.nSkillCount] := THIS;
    FB_Init := TRUE;
  END_IF]]></ST>
      </Implementation>
    </Method>
