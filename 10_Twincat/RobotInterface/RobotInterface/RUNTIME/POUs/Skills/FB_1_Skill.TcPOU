    <Method Name="Stop" Id="{d1f535cb-92d0-408d-90d6-a0632cef04b6}" FolderPath="Public\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD Stop : eResult
VAR_INPUT
// 	pSkill : POINTER TO FB_SKILL;
// 	name: STRING := '';
END_VAR

VAR
	toolready: BOOL;
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pROB^.ActivSkill:= 0;

IF State = eState.Active THEN
	Deactivate();
	Messenger.AddHint(eMessageCategories.StateMachine,Path,'Stoping Skill');
END_IF


IF LastTransitionType=eTransitions.Deactivate THEN //TODO CHECK
	Stop:=LastTransitionResult; 
 END_IF
 ]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>