<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="stParam_PickPlace" Id="{ab4d2358-cf6f-47ea-b510-aa1d3f4fa553}">
    <Declaration><![CDATA[TYPE stParam_PickPlace :
STRUCT
	WrittenFor: STRING := '';
	
	
	PickPositionName: STRING := 'Pick';
	PickPositionOffset: ST_Pose;
	
	PlacePositionName: STRING := 'Place';
	PlacePositionOffset: ST_Pose;
	
	PickApproachDirection: eDirections := eDirections.Zplus;
	PickApproachOffset: REAL := 0.01; 			//m
	
	PlaceApproachDirection: eDirections := eDirections.Zplus;
	PlaceApproachOffset: REAL := 0.01; 			//m
	
	bPassTroughMiddlePoint: BOOL := FALSE;
	MiddlePointName: STRING;
	
	FastVelocity: REAL:= 0.01;			//m/s
	SlowVelocity: REAL:= 0.01;			//m/s
	
END_STRUCT
END_TYPE

]]></Declaration>
  </DUT>
