<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="stParam_PickPlace" Id="{ab4d2358-cf6f-47ea-b510-aa1d3f4fa553}">
    <Declaration><![CDATA[TYPE stParam_PickPlace :
STRUCT
	WrittenFor: STRING := '';
	
	
	PickPositionName: STRING;
	PickPositionOffset: stPoseGeneral;
	
	PlacePositionName: STRING;
	PlacePositionOffset: stPoseGeneral;
	
	PickApproachDirection: STRING := '+Z';
	PickApproachOffset: REAL := 20; 			//mm
	
	PlaceApproachDirection: STRING := '+Z';
	PlaceApproachOffset: REAL := 20; 			//mm
	
	Velocity: REAL:= 10;			//mm/s
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>