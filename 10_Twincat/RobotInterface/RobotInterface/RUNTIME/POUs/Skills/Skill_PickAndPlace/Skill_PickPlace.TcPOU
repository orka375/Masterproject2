    <Action Name="MoveL_RetractPlace_exit" Id="{5c7fa900-9614-4520-a58b-fa98fb8c9bc2}">
      <Implementation>
        <ST><![CDATA[nCalledMoveID:=0;
bMoveInProcess:=FALSE;
bRetractPlaceDone := FALSE;
]]></ST>
      </Implementation>
    </Action>
      <Method Name="HandleMoveStart" Id="{57dbf99b-ec72-47c9-a087-a8267dfa732e}">
        <Declaration><![CDATA[METHOD HandleMoveStart : BOOL
  ]]></Declaration>
        <Implementation>
          <ST><![CDATA[HandleMoveStart := nCalledMoveID <> 0;

  IF NOT HandleMoveStart THEN
      ExecutionDone := TRUE;
      ExecutionResult := FAILURE;
      Messenger.AddWarn(eMessageCategories.ParentFailed, Path, 'Robot rejected move');
      SFCInit := TRUE;
  END_IF
  ]]></ST>
        </Implementation>
      </Method>
      <Method Name="PollRobotMove" Id="{78fd90e9-ae41-49ae-a2ac-70ab9188a9db}">
        <Declaration><![CDATA[METHOD PollRobotMove : BOOL
    VAR_IN_OUT
      DoneFlag : BOOL;
    END_VAR
    ]]></Declaration>
        <Implementation>
        <ST><![CDATA[PollRobotMove := FALSE;

    IF pRob = 0 THEN
      ExecutionDone := TRUE;
      ExecutionResult := ERROR;
      Messenger.AddError(eMessageCategories.MissingData, Path, 'Robot is not assigned');
      SFCInit := TRUE;
      RETURN;
    END_IF

    IF (nCalledMoveID = 0) OR (pRob^.CommandID <> nCalledMoveID) THEN
      RETURN;
    END_IF

    bMoveInProcess := TRUE;

    CASE pRob^.CommandState OF
      INIT, ACKNOWLEDGE, RUNNING:
        PollRobotMove := FALSE;

      FINALIZED:
        IF pRob^.CommandResult = SUCCESS THEN
          DoneFlag := TRUE;
          PollRobotMove := TRUE;
        ELSE
          ExecutionDone := TRUE;
          IF pRob^.CommandResult = NONE THEN
            ExecutionResult := ERROR;
          ELSE
            ExecutionResult := pRob^.CommandResult;
          END_IF
          Messenger.AddWarn(eMessageCategories.ParentFailed, Path, 'Robot move failed');
          SFCInit := TRUE;
        END_IF

      ABORTED:
        ExecutionDone := TRUE;
        ExecutionResult := FAILURE;
        Messenger.AddWarn(eMessageCategories.ParentFailed, Path, 'Robot move aborted');
        SFCInit := TRUE;
    END_CASE
    ]]></ST>
        </Implementation>
      </Method>
    <Method Name="OnActivate" Id="{fe361160-cff6-4374-b8d5-b6aa8065f810}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

