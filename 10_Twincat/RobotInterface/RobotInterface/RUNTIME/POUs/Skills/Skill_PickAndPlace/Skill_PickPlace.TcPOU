    <Folder Name="StateControl" Id="{b8625484-5b9d-403b-b98f-c4de5899beed}" />
    <Action Name="_aCalc_Approach_active" Id="{37dfacd0-5ddb-427e-a6d5-ffb024477c13}">
      <Implementation>
        <ST><![CDATA[// TODO: Resolve Param.PickPositionName / Param.PlacePositionName to base poses.
// Apply PickPositionOffset / PlacePositionOffset and calculate approachpick / approachplace
// from PickApproachDirection / PlaceApproachDirection and the configured offsets.
// Set bCalcApproachDone := TRUE when both poses are valid.

IF phase = 0 THEN
	IF Param^.PickPositionName<>'' THEN
		res := pRob^.PM.Load(Param^.PickPositionName);
		
		IF res=SUCCESS THEN
			T_Point  := FromPose(pRob^.PM.LoadedPoint);
			T_Offset := FromPose(Param^.PickPositionOffset);
			
			T_Result := Multiply(
				A := T_Point,
				B := T_Offset
			);
			
			pickpos := ToPose(T_Result);
			phase := 10;
		ELSE
			ExecutionDone:=TRUE;
			ExecutionResult:=FAILURE;
			Deactivate();
			Messenger.AddError(eMessageCategories.MissingData,Path,'Pick Position is not defined in PM');
			SFCInit:=TRUE;
			
		END_IF
	END_IF
END_IF


IF phase = 10 THEN
	IF Param^.PlacePositionName<>'' THEN
		res := pRob^.PM.Load(Param^.PlacePositionName);
		
		IF res=SUCCESS THEN
      placepos := pROB^.PM.LoadedPoint;
      placepos.x := placepos.x + Param^.PlacePositionOffset.x;
      placepos.y := placepos.y + Param^.PlacePositionOffset.y;
      placepos.z := placepos.z + Param^.PlacePositionOffset.z;
      placepos.roll := placepos.roll + Param^.PlacePositionOffset.roll;
      placepos.pitch := placepos.pitch + Param^.PlacePositionOffset.pitch;
      placepos.yaw := placepos.yaw + Param^.PlacePositionOffset.yaw;
			phase := 20;
		ELSE
			ExecutionDone:=TRUE;
			ExecutionResult:=FAILURE;
			Deactivate();
			Messenger.AddError(eMessageCategories.MissingData,Path,'Place Position is not defined in PM');
			SFCInit:=TRUE;
			
		END_IF
	END_IF
END_IF



IF phase = 20 THEN
	approachpick := F_CalcOffsetPose(pickpos,Param^.PickApproachDirection,Param^.PickApproachOffset);
	approachplace := F_CalcOffsetPose(placepos,Param^.PlaceApproachDirection,Param^.PlaceApproachOffset);
	bCalcApproachDone := TRUE;
END_IF



]]></ST>
      </Implementation>
    </Action>
    <Action Name="_aDone_active" Id="{e89f9719-0119-4542-a78a-a5b9a7f93659}">
      <Implementation>
