  <POU Name="FB_ROS2Skill" Id="{f54a0cc5-85be-4eb3-9699-29c2da44a5f4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ROS2Skill EXTENDS FB_Skill
VAR_INPUT
	{attribute 'OPC.UA.DA.StructuredType':=1}
	{attribute 'OPC.UA.DA' := '1'}
	Control     : ST_SkillControl;
	{attribute 'OPC.UA.DA.StructuredType':=1}
	{attribute 'OPC.UA.DA' := '1'}
    Status      : stExternalStatus;

//     Specific    : ST_RobotMoveSpecific;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{ea849ada-aae1-4710-81d2-9291ab7ea1d6}" />
    <Property Name="Busy" Id="{09e5b3c9-ee64-44a2-abd8-5d4d03bc4b38}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{b2f257ba-29de-49be-8325-f1b3106f7d1e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _state=eState.Active THEN
	Busy:=TRUE;
ELSE
	Busy:=FALSE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
