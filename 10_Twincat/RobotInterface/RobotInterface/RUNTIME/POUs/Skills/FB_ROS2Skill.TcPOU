    <Method Name="Restart" Id="{e4adb370-5ab1-4ddd-867f-399f400037c2}">
      <Declaration><![CDATA[METHOD Restart : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stop();
Start();]]></ST>
