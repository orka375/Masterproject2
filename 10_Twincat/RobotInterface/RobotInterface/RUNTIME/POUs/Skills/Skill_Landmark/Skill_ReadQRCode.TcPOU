<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Skill_ReadQRCode" Id="{29f5a9c6-117b-4db2-964a-513390c6853e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Skill_ReadQRCode EXTENDS FB_1_Skill
(*
    Continuously scans images from a configured GigE Vision camera.

    Completion:
      - SUCCESS only after a QR code was detected and its payload exported.
      - FAILURE after tTimeout (default T#10S).
      - FAILURE when bExternalStop is TRUE.

    The camera stays in continuous acquisition. A valid image without a QR
    code is not an error; the skill simply requests and processes the next
    image until detection, timeout, or external abort.

    Required:
      - TwinCAT 3.1.4024.59 or newer
      - PLC library Tc3_Vision
      - Licenses TC3 Vision Base and TC3 Vision Code Reading (TF7250)
      - pCamera points to an FB_VN_GevCameraControl instance linked to the
        camera TcCOM object under Symbol Initialization.
*)

VAR_INPUT
    pCamera          : POINTER TO FB_VN_GevCameraControl;
    bSoftwareTrigger : BOOL := TRUE; // Retained for interface compatibility.
    nWatchdogTimeUs  : DINT := 2000000;
    tTimeout         : TIME := T#10S;
    bExternalStop    : BOOL;
    SFCInit           : BOOL;
END_VAR

VAR_OUTPUT
    ipImageDisp  : ITcVnDisplayableImage;
    bQRCodeFound : BOOL;
    sQRCode      : STRING(255);
    hrLastError  : HRESULT;
    bTimedOut    : BOOL;
    bAborted     : BOOL;

    bCornersValid  : BOOL;
    aQRCodeCorners : ARRAY[0..3] OF TcVnPoint2_DINT;
END_VAR

VAR
    // 0 Init, 10 Camera/acquire, 20 Decode, 30 Export, 100 Done, 900 Stopped.
    phase              : INT;
    eCameraState       : ETcVnCameraState;
    ipImage            : ITcVnImage;
    ipDecodedData      : ITcVnContainer;
    ipContours         : ITcVnContainer;
    hr                 : HRESULT;
    hrDisplay          : HRESULT;
    hrWatchdog         : HRESULT;
    tWatchdogRemaining : DINT;
    bRunDone           : BOOL;
    fbTimeout          : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_SKILL();

// Optional compatibility reset. Clear the request immediately so initialization
// is performed once instead of on every PLC cycle.
IF SFCInit THEN
    phase := 0;
    SFCInit := FALSE;
END_IF

IF State = eState.Active THEN
    // The execution timeout covers camera start-up, acquisition and decoding.
    fbTimeout(
        IN := NOT ExecutionDone,
        PT := tTimeout);

    // External abort has priority over timeout and image processing.
    IF bExternalStop AND NOT ExecutionDone THEN
        bAborted := TRUE;
        bQRCodeFound := FALSE;
        sQRCode := '';
        hrLastError := S_FALSE;
        ExecutionResult := FAILURE;
        ExecutionDone := TRUE;
        phase := 900;
        fbTimeout(IN := FALSE, PT := tTimeout);
        Messenger.AddHint(
            eMessageCategories.StateMachine,
            Path,
            'QR code scan aborted by external stop');

    ELSIF fbTimeout.Q AND NOT ExecutionDone THEN
        bTimedOut := TRUE;
        FailSkill(
            hrError := E_FAIL,
            sMessage := 'QR code scan timed out');

    ELSE
        CASE phase OF
            // ---------------------------------------------------------------
            // 0 - Initialize one scan execution
            // ---------------------------------------------------------------
            0:
                bQRCodeFound := FALSE;
                bCornersValid := FALSE;
                bTimedOut := FALSE;
                bAborted := FALSE;
                sQRCode := '';
                hr := S_OK;
                hrDisplay := S_OK;
                hrLastError := S_OK;
                hrWatchdog := S_OK;
                bRunDone := FALSE;
                ipImage := 0;
                ipDecodedData := 0;
                ipContours := 0;
                ExecutionDone := FALSE;
                ExecutionResult := NONE;

                IF pCamera = 0 THEN
                    FailSkill(
                        hrError := E_FAIL,
                        sMessage := 'GigE camera controller is not assigned');
                ELSIF nWatchdogTimeUs <= 0 THEN
                    FailSkill(
                        hrError := E_FAIL,
                        sMessage := 'Vision watchdog time must be greater than zero');
                ELSIF tTimeout <= T#0S THEN
                    FailSkill(
                        hrError := E_FAIL,
                        sMessage := 'QR scan timeout must be greater than zero');
                ELSE
                    phase := 10;
                END_IF

            // ---------------------------------------------------------------
            // 10 - Keep the camera acquiring and request the current image
            // ---------------------------------------------------------------
            10:
                eCameraState := pCamera^.GetState();

                CASE eCameraState OF
                    TCVN_CS_ERROR:
                        hr := pCamera^.Reset();
                        IF FAILED(hr) THEN
                            FailSkill(
                                hrError := hr,
                                sMessage := 'Could not reset GigE camera');
                        END_IF

                    TCVN_CS_INITIAL,
                    TCVN_CS_INITIALIZING,
                    TCVN_CS_INITIALIZED,
                    TCVN_CS_OPENING,
                    TCVN_CS_OPENED,
                    TCVN_CS_STARTACQUISITION:
                        hr := pCamera^.StartAcquisition();
                        IF FAILED(hr) THEN
                            FailSkill(
                                hrError := hr,
                                sMessage := 'Could not start camera acquisition');
                        END_IF

                    TCVN_CS_ACQUIRING:
                        ipImage := 0;
                        hr := pCamera^.GetCurrentImage(ipImage);

                        IF FAILED(hr) THEN
                            FailSkill(
                                hrError := hr,
                                sMessage := 'Could not acquire camera image');
                        ELSIF SUCCEEDED(hr) AND (ipImage <> 0) THEN
                            // Display conversion is diagnostic only and must not
                            // stop scanning when it is unavailable.
                            hrDisplay := F_VN_TransformIntoDisplayableImage(
                                ipSrcImage  := ipImage,
                                ipDestImage := ipImageDisp,
                                hrPrev      := S_OK);
                            phase := 20;
                        END_IF
                END_CASE

            // ---------------------------------------------------------------
            // 20 - Try to decode one image
            // ---------------------------------------------------------------
            20:
                IF ipImage = 0 THEN
                    // No usable image: return to acquisition without failing.
                    phase := 10;
                ELSE
                    ipDecodedData := 0;
                    ipContours := 0;

                    hrWatchdog := F_VN_StartRelWatchdog(
                        nWatchdogTimeUs,
                        S_OK);

                    IF FAILED(hrWatchdog) THEN
                        FailSkill(
                            hrError := hrWatchdog,
                            sMessage := 'Could not start Vision watchdog');
                    ELSE
                        hr := F_VN_ReadQRCodeExp(
                            ipSrcImage      := ipImage,
                            ipDecodedData   := ipDecodedData,
                            ipContours      := ipContours,
                            nCodeNumber     := 1,
                            eSearchStrategy := TCVN_CSS_DEFAULT,
                            hrPrev          := S_OK);

                        hrWatchdog := F_VN_StopWatchdog(
                            hrStartWatchdog := hrWatchdog,
                            tRest           => tWatchdogRemaining);

                        IF hr = S_OK THEN
                            bQRCodeFound := TRUE;
                            phase := 30;

                        ELSIF hr = S_FALSE THEN
                            // Valid image but no QR code: keep scanning.
                            bQRCodeFound := FALSE;
                            bCornersValid := FALSE;
                            sQRCode := '';
                            ipImage := 0;
                            ipDecodedData := 0;
                            ipContours := 0;
                            phase := 10;

                        ELSE
                            FailSkill(
                                hrError := hr,
                                sMessage := 'QR code reading failed');
                        END_IF
                    END_IF
                END_IF

            // ---------------------------------------------------------------
            // 30 - Export the detected QR payload
            // ---------------------------------------------------------------
            30:
                IF ipDecodedData = 0 THEN
                    FailSkill(
                        hrError := E_FAIL,
                        sMessage := 'QR decoded data container is invalid');
                ELSE
                    hr := F_VN_ExportSubContainer_String(
                        ipContainer := ipDecodedData,
                        nIndex      := 0,
                        sText       := sQRCode,
                        nMaxLength  := 255,
                        hrPrev      := S_OK);

                    IF FAILED(hr) THEN
                        FailSkill(
                            hrError := hr,
                            sMessage := 'Could not export QR payload');
                    ELSE
                        phase := 100;
                    END_IF
                END_IF

            // ---------------------------------------------------------------
            // 100 - Successful completion
            // ---------------------------------------------------------------
            100:
                IF NOT bRunDone THEN
                    bQRCodeFound := TRUE;
                    ExecutionResult := SUCCESS;
                    ExecutionDone := TRUE;
                    bRunDone := TRUE;
                    fbTimeout(IN := FALSE, PT := tTimeout);
                END_IF

            // 900 - Aborted, timed out or failed; wait for base deactivation.
            900:
                fbTimeout(IN := FALSE, PT := tTimeout);
        END_CASE
    END_IF
ELSE
    fbTimeout(IN := FALSE, PT := tTimeout);
END_IF]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{6553d82c-833e-40e5-a849-b9061c767792}" />
    <Folder Name="StateControl" Id="{78f66f39-33d4-43c5-adc9-d819ee5a7735}" />
    <Method Name="FailSkill" Id="{ebec29b2-c68b-4bc5-a98c-3052b50c43e0}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PRIVATE FailSkill
VAR_INPUT
    hrError  : HRESULT;
    sMessage : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hrLastError := hrError;
bQRCodeFound := FALSE;
ExecutionDone := TRUE;
ExecutionResult := FAILURE;
phase := 900;
fbTimeout(IN := FALSE, PT := tTimeout);
Messenger.AddError(eMessageCategories.Undefined, Path, sMessage);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnActivate" Id="{20e02ee2-d5a7-4ea2-a227-7228b0891a5a}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR
    eParentResult : eResult;
    myResult      : eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();

phase := 0;
SFCInit := FALSE;
bRunDone := FALSE;
bQRCodeFound := FALSE;
bCornersValid := FALSE;
bTimedOut := FALSE;
bAborted := FALSE;
sQRCode := '';
hrLastError := S_OK;
ipImage := 0;
ipDecodedData := 0;
ipContours := 0;
ExecutionDone := FALSE;
ExecutionResult := NONE;
fbTimeout(IN := FALSE, PT := tTimeout);
myResult := SUCCESS;

OnActivate := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{17e6b80e-e6a7-491c-a956-8fbe970466c5}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR
    eParentResult : eResult;
    myResult      : eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnDeactivate();

phase := 0;
SFCInit := FALSE;
bRunDone := FALSE;
ipImage := 0;
ipDecodedData := 0;
ipContours := 0;
fbTimeout(IN := FALSE, PT := tTimeout);
myResult := SUCCESS;

OnDeactivate := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{0b1e989f-a741-40b7-a2e2-8deafdb5d268}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR
    eParentResult : eResult;
    myResult      : eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();

phase := 900;
SFCInit := FALSE;
bRunDone := FALSE;
ipImage := 0;
ipDecodedData := 0;
ipContours := 0;
fbTimeout(IN := FALSE, PT := tTimeout);
myResult := SUCCESS;

OnError := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{1b50b699-2d82-4922-b709-d5c6953bad9f}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR
    eParentResult : eResult;
    myResult      : eResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();

phase := 900;
SFCInit := FALSE;
bRunDone := FALSE;
ipImage := 0;
ipDecodedData := 0;
ipContours := 0;
fbTimeout(IN := FALSE, PT := tTimeout);
myResult := SUCCESS;

OnShutdown := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>