<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Jog_Manipulator" Id="{6d60359c-0319-4c14-b950-966760f5080c}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_Jog_Manipulator EXTENDS FB_Jog_Base
VAR_INPUT
    // Existing manipulator abstraction. The jog FB only calls
    // MotionControl methods from FB_2_ROB_MANIP.
    pRobot : POINTER TO FB_2_ROB_MANIP;
END_VAR

VAR
    // HMI rising-edge detection: one press = one jog step.
    _rXPlus       : R_TRIG;
    _rXMinus      : R_TRIG;
    _rYPlus       : R_TRIG;
    _rYMinus      : R_TRIG;
    _rZPlus       : R_TRIG;
    _rZMinus      : R_TRIG;

    _rRxPlus      : R_TRIG;
    _rRxMinus     : R_TRIG;
    _rRyPlus      : R_TRIG;
    _rRyMinus     : R_TRIG;
    _rRzPlus      : R_TRIG;
    _rRzMinus     : R_TRIG;

    _offsetLocal  : stPoseGeneral;
    _offsetBase   : stPoseGeneral;
    _framePose    : stPoseGeneral;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_JOG_MANIP();]]></ST>
    </Implementation>
    <Folder Name="JogControl" Id="{1c021ab3-4c12-4486-8807-370f307ce83d}" />
    <Action Name="CYCLIC_JOG_MANIP" Id="{bf95fbc2-1e1a-4222-953f-b510186d86b9}">
      <Implementation>
        <ST><![CDATA[// ----------------------------------------------------------
// Capabilities / behavior for HMI
// ----------------------------------------------------------
bSupportsX := TRUE;
bSupportsY := TRUE;
bSupportsZ := TRUE;
bSupportsRx := TRUE;
bSupportsRy := TRUE;
bSupportsRz := TRUE;

bStepJog := TRUE;
bContinuousJog := FALSE;

bCommandIssued := FALSE;

// ----------------------------------------------------------
// Direct HMI BOOLs -> one-shot step requests
// ----------------------------------------------------------
_rXPlus(CLK := bJogXPlus);
_rXMinus(CLK := bJogXMinus);
_rYPlus(CLK := bJogYPlus);
_rYMinus(CLK := bJogYMinus);
_rZPlus(CLK := bJogZPlus);
_rZMinus(CLK := bJogZMinus);

_rRxPlus(CLK := bJogRxPlus);
_rRxMinus(CLK := bJogRxMinus);
_rRyPlus(CLK := bJogRyPlus);
_rRyMinus(CLK := bJogRyMinus);
_rRzPlus(CLK := bJogRzPlus);
_rRzMinus(CLK := bJogRzMinus);

IF _rXPlus.Q THEN _reqXPlus := TRUE; END_IF
IF _rXMinus.Q THEN _reqXMinus := TRUE; END_IF
IF _rYPlus.Q THEN _reqYPlus := TRUE; END_IF
IF _rYMinus.Q THEN _reqYMinus := TRUE; END_IF
IF _rZPlus.Q THEN _reqZPlus := TRUE; END_IF
IF _rZMinus.Q THEN _reqZMinus := TRUE; END_IF

IF _rRxPlus.Q THEN _reqRxPlus := TRUE; END_IF
IF _rRxMinus.Q THEN _reqRxMinus := TRUE; END_IF
IF _rRyPlus.Q THEN _reqRyPlus := TRUE; END_IF
IF _rRyMinus.Q THEN _reqRyMinus := TRUE; END_IF
IF _rRzPlus.Q THEN _reqRzPlus := TRUE; END_IF
IF _rRzMinus.Q THEN _reqRzMinus := TRUE; END_IF

bPending :=
    _reqXPlus OR _reqXMinus OR
    _reqYPlus OR _reqYMinus OR
    _reqZPlus OR _reqZMinus OR
    _reqRxPlus OR _reqRxMinus OR
    _reqRyPlus OR _reqRyMinus OR
    _reqRzPlus OR _reqRzMinus;

// ----------------------------------------------------------
// Robot status
// ----------------------------------------------------------
bReady := FALSE;
bMoving := FALSE;

IF pRobot <> 0 THEN
    ActualPose := pRobot^.ActualTcpPose;
    bMoving := pRobot^.IsMoving;
    bReady := bEnable AND pRobot^.IsReady AND NOT bMoving;

    // Selected frame visible for HMI / diagnostics.
    CASE nFrame OF
        0: // Base
            _framePose.X := 0.0;
            _framePose.Y := 0.0;
            _framePose.Z := 0.0;
            _framePose.Rx := 0.0;
            _framePose.Ry := 0.0;
            _framePose.Rz := 0.0;

        1: // Tool / local TCP
            _framePose := ActualPose;

        2: // Custom
            _framePose := CustomFrame;

        ELSE
            // Invalid HMI value: safe fallback to Base.
            _framePose.X := 0.0;
            _framePose.Y := 0.0;
            _framePose.Z := 0.0;
            _framePose.Rx := 0.0;
            _framePose.Ry := 0.0;
            _framePose.Rz := 0.0;
    END_CASE

    ActiveFramePose := _framePose;

    // Execute maximum one queued step.
    IF bReady AND bPending THEN
        _offsetLocal.X := 0.0;
        _offsetLocal.Y := 0.0;
        _offsetLocal.Z := 0.0;
        _offsetLocal.Rx := 0.0;
        _offsetLocal.Ry := 0.0;
        _offsetLocal.Rz := 0.0;

        IF _reqXPlus THEN
            _reqXPlus := FALSE;
            _offsetLocal.X := ABS(fLinearStep);

        ELSIF _reqXMinus THEN
            _reqXMinus := FALSE;
            _offsetLocal.X := -ABS(fLinearStep);

        ELSIF _reqYPlus THEN
            _reqYPlus := FALSE;
            _offsetLocal.Y := ABS(fLinearStep);

        ELSIF _reqYMinus THEN
            _reqYMinus := FALSE;
            _offsetLocal.Y := -ABS(fLinearStep);

        ELSIF _reqZPlus THEN
            _reqZPlus := FALSE;
            _offsetLocal.Z := ABS(fLinearStep);

        ELSIF _reqZMinus THEN
            _reqZMinus := FALSE;
            _offsetLocal.Z := -ABS(fLinearStep);

        ELSIF _reqRxPlus THEN
            _reqRxPlus := FALSE;
            _offsetLocal.Rx := ABS(fAngularStep);

        ELSIF _reqRxMinus THEN
            _reqRxMinus := FALSE;
            _offsetLocal.Rx := -ABS(fAngularStep);

        ELSIF _reqRyPlus THEN
            _reqRyPlus := FALSE;
            _offsetLocal.Ry := ABS(fAngularStep);

        ELSIF _reqRyMinus THEN
            _reqRyMinus := FALSE;
            _offsetLocal.Ry := -ABS(fAngularStep);

        ELSIF _reqRzPlus THEN
            _reqRzPlus := FALSE;
            _offsetLocal.Rz := ABS(fAngularStep);

        ELSIF _reqRzMinus THEN
            _reqRzMinus := FALSE;
            _offsetLocal.Rz := -ABS(fAngularStep);
        END_IF

        CASE nFrame OF
            0: // Base
                _offsetBase := _offsetLocal;

            1, 2: // Tool or Custom
                _offsetBase := TransformJogOffset(
                    LocalOffset := _offsetLocal,
                    FramePose := _framePose
                );

            ELSE
                _offsetBase := _offsetLocal;
        END_CASE

        // Existing MotionControl method from FB_2_ROB_MANIP.
        nLastCommandID := pRobot^.MoveLinearRelative(
            Offset := _offsetBase,
            Velocity := fLinearVelocity
        );

        bCommandIssued := TRUE;
    END_IF
END_IF

// Refresh after a request may have been consumed.
bPending :=
    _reqXPlus OR _reqXMinus OR
    _reqYPlus OR _reqYMinus OR
    _reqZPlus OR _reqZMinus OR
    _reqRxPlus OR _reqRxMinus OR
    _reqRyPlus OR _reqRyMinus OR
    _reqRzPlus OR _reqRzMinus;]]></ST>
      </Implementation>
    </Action>
    <Method Name="TransformJogOffset" Id="{3dd819c1-b83a-4a1f-b40e-d2fa2498e4e5}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PRIVATE TransformJogOffset : stPoseGeneral
VAR_INPUT
    LocalOffset : stPoseGeneral;
    FramePose   : stPoseGeneral;
END_VAR
VAR
    theta  : LREAL;
    kx     : LREAL;
    ky     : LREAL;
    kz     : LREAL;
    c      : LREAL;
    si      : LREAL;
    oneC   : LREAL;

    vx     : LREAL;
    vy     : LREAL;
    vz     : LREAL;
    dot    : LREAL;
    crossX : LREAL;
    crossY : LREAL;
    crossZ : LREAL;

    Result : stPoseGeneral;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// FramePose.Rx/Ry/Rz is treated as an axis-angle rotation vector.
// Rodrigues' formula rotates both translational and incremental
// rotational jog vectors from the selected frame into Base axes.

Result.X := 0.0;
Result.Y := 0.0;
Result.Z := 0.0;
Result.Rx := 0.0;
Result.Ry := 0.0;
Result.Rz := 0.0;

theta := SQRT(
    FramePose.Rx * FramePose.Rx +
    FramePose.Ry * FramePose.Ry +
    FramePose.Rz * FramePose.Rz
);

IF theta < 0.000000001 THEN
    Result := LocalOffset;
ELSE
    kx := FramePose.Rx / theta;
    ky := FramePose.Ry / theta;
    kz := FramePose.Rz / theta;

    c := COS(theta);
    si := SIN(theta);
    oneC := 1.0 - c;

    // Translation
    vx := LocalOffset.X;
    vy := LocalOffset.Y;
    vz := LocalOffset.Z;

    crossX := ky * vz - kz * vy;
    crossY := kz * vx - kx * vz;
    crossZ := kx * vy - ky * vx;
    dot := kx * vx + ky * vy + kz * vz;

    Result.X := vx * c + crossX * si + kx * dot * oneC;
    Result.Y := vy * c + crossY * si + ky * dot * oneC;
    Result.Z := vz * c + crossZ * si + kz * dot * oneC;

    // Incremental rotation axis
    vx := LocalOffset.Rx;
    vy := LocalOffset.Ry;
    vz := LocalOffset.Rz;

    crossX := ky * vz - kz * vy;
    crossY := kz * vx - kx * vz;
    crossZ := kx * vy - ky * vx;
    dot := kx * vx + ky * vy + kz * vz;

    Result.Rx := vx * c + crossX * si + kx * dot * oneC;
    Result.Ry := vy * c + crossY * si + ky * dot * oneC;
    Result.Rz := vz * c + crossZ * si + kz * dot * oneC;
END_IF

TransformJogOffset := Result;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>