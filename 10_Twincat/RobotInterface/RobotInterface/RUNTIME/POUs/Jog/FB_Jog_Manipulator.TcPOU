<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Jog_Manipulator" Id="{6d60359c-0319-4c14-b950-966760f5080c}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_Jog_Manipulator EXTENDS FB_Jog_Base
VAR_INPUT
    // Existing manipulator abstraction. The jog FB only calls
    // MotionControl methods from FB_2_ROB_MANIP.
    pRobot : POINTER TO FB_2_ROB_MANIP;
END_VAR

VAR
    // Hold-to-run: buttons are read directly every cycle. No edge
    // detection - a held button keeps jogging, release stops.
    _offsetLocal  : stPoseGeneral;
    _offsetBase   : stPoseGeneral;
    _framePose    : stPoseGeneral;
    _jointTarget  : stJoint6;

    _nActiveTcp   : INT;
    _nActiveJoint : INT;
    _bAnyTcp      : BOOL;
    _bAnyJoint    : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_JOG_MANIP();]]></ST>
    </Implementation>
    <Folder Name="JogControl" Id="{1c021ab3-4c12-4486-8807-370f307ce83d}" />
    <Action Name="CYCLIC_JOG_MANIP" Id="{bf95fbc2-1e1a-4222-953f-b510186d86b9}">
      <Implementation>
        <ST><![CDATA[// ----------------------------------------------------------
// Capabilities / behavior for HMI
// ----------------------------------------------------------
bSupportsX := TRUE;
bSupportsY := TRUE;
bSupportsZ := TRUE;
bSupportsRx := TRUE;
bSupportsRy := TRUE;
bSupportsRz := TRUE;
bSupportsJoint := TRUE;

// Hold-to-run: a button held TRUE keeps jogging, release stops.
bStepJog := FALSE;
bContinuousJog := TRUE;

bCommandIssued := FALSE;

// ----------------------------------------------------------
// Count active direction buttons. Jogging is only allowed when
// EXACTLY ONE direction (TCP or joint) is held, so the HMI can
// never drive multiple axes simultaneously.
// ----------------------------------------------------------
_nActiveTcp := 0;
IF bJogXPlus  THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogXMinus THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogYPlus  THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogYMinus THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogZPlus  THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogZMinus THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogRxPlus  THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogRxMinus THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogRyPlus  THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogRyMinus THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogRzPlus  THEN _nActiveTcp := _nActiveTcp + 1; END_IF
IF bJogRzMinus THEN _nActiveTcp := _nActiveTcp + 1; END_IF

_nActiveJoint := 0;
IF bJogJoint1Plus  THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint1Minus THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint2Plus  THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint2Minus THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint3Plus  THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint3Minus THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint4Plus  THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint4Minus THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint5Plus  THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint5Minus THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint6Plus  THEN _nActiveJoint := _nActiveJoint + 1; END_IF
IF bJogJoint6Minus THEN _nActiveJoint := _nActiveJoint + 1; END_IF

_bAnyTcp := _nActiveTcp > 0;
_bAnyJoint := _nActiveJoint > 0;
bPending := _bAnyTcp OR _bAnyJoint;

// ----------------------------------------------------------
// Robot status
// ----------------------------------------------------------
bReady := FALSE;
bMoving := FALSE;

IF pRobot <> 0 THEN
    ActualPose := pRobot^.ActualTcpPose;
    bMoving := pRobot^.IsMoving;
    bReady := bEnable AND pRobot^.IsReady AND NOT bMoving;

    // Selected frame visible for HMI / diagnostics.
    CASE nFrame OF
        0: // Base
            _framePose.x := 0.0;
            _framePose.y := 0.0;
            _framePose.z := 0.0;
            _framePose.rx := 0.0;
            _framePose.ry := 0.0;
            _framePose.rz := 0.0;

        1: // Tool / local TCP
            _framePose := ActualPose;

        2: // Custom
            _framePose := CustomFrame;

        ELSE
            // Invalid HMI value: safe fallback to Base.
            _framePose.x := 0.0;
            _framePose.y := 0.0;
            _framePose.z := 0.0;
            _framePose.rx := 0.0;
            _framePose.ry := 0.0;
            _framePose.rz := 0.0;
    END_CASE

    ActiveFramePose := _framePose;

    // ------------------------------------------------------
    // Hold-to-run motion.
    // Issue the next motion increment only when the robot is
    // ready and exactly one direction is held. The underlying
    // UR motion is blocking, so the next increment is issued
    // once the previous one finishes - continuous motion while
    // held, immediate stop on release (no latched command).
    // ------------------------------------------------------
    IF bReady AND ((_nActiveTcp + _nActiveJoint) = 1) THEN

        IF _bAnyJoint THEN
            // ----- Joint jog: absolute target = actual + step -----
            _jointTarget := pRobot^.ActualJointPosition;

            IF bJogJoint1Plus THEN
                _jointTarget.joint1 := _jointTarget.joint1 + ABS(fJointStep);
            ELSIF bJogJoint1Minus THEN
                _jointTarget.joint1 := _jointTarget.joint1 - ABS(fJointStep);
            ELSIF bJogJoint2Plus THEN
                _jointTarget.joint2 := _jointTarget.joint2 + ABS(fJointStep);
            ELSIF bJogJoint2Minus THEN
                _jointTarget.joint2 := _jointTarget.joint2 - ABS(fJointStep);
            ELSIF bJogJoint3Plus THEN
                _jointTarget.joint3 := _jointTarget.joint3 + ABS(fJointStep);
            ELSIF bJogJoint3Minus THEN
                _jointTarget.joint3 := _jointTarget.joint3 - ABS(fJointStep);
            ELSIF bJogJoint4Plus THEN
                _jointTarget.joint4 := _jointTarget.joint4 + ABS(fJointStep);
            ELSIF bJogJoint4Minus THEN
                _jointTarget.joint4 := _jointTarget.joint4 - ABS(fJointStep);
            ELSIF bJogJoint5Plus THEN
                _jointTarget.joint5 := _jointTarget.joint5 + ABS(fJointStep);
            ELSIF bJogJoint5Minus THEN
                _jointTarget.joint5 := _jointTarget.joint5 - ABS(fJointStep);
            ELSIF bJogJoint6Plus THEN
                _jointTarget.joint6 := _jointTarget.joint6 + ABS(fJointStep);
            ELSIF bJogJoint6Minus THEN
                _jointTarget.joint6 := _jointTarget.joint6 - ABS(fJointStep);
            END_IF

            nLastCommandID := pRobot^.MoveJointAbsolute(
                Joints := _jointTarget,
                Velocity := fJointVelocity
            );
            bCommandIssued := TRUE;

        ELSE
            // ----- TCP jog: single-axis local offset -----
            _offsetLocal.x := 0.0;
            _offsetLocal.y := 0.0;
            _offsetLocal.z := 0.0;
            _offsetLocal.rx := 0.0;
            _offsetLocal.ry := 0.0;
            _offsetLocal.rz := 0.0;

            IF bJogXPlus THEN
                _offsetLocal.x := ABS(fLinearStep);
            ELSIF bJogXMinus THEN
                _offsetLocal.x := -ABS(fLinearStep);
            ELSIF bJogYPlus THEN
                _offsetLocal.y := ABS(fLinearStep);
            ELSIF bJogYMinus THEN
                _offsetLocal.y := -ABS(fLinearStep);
            ELSIF bJogZPlus THEN
                _offsetLocal.z := ABS(fLinearStep);
            ELSIF bJogZMinus THEN
                _offsetLocal.z := -ABS(fLinearStep);
            ELSIF bJogRxPlus THEN
                _offsetLocal.rx := ABS(fAngularStep);
            ELSIF bJogRxMinus THEN
                _offsetLocal.rx := -ABS(fAngularStep);
            ELSIF bJogRyPlus THEN
                _offsetLocal.ry := ABS(fAngularStep);
            ELSIF bJogRyMinus THEN
                _offsetLocal.ry := -ABS(fAngularStep);
            ELSIF bJogRzPlus THEN
                _offsetLocal.rz := ABS(fAngularStep);
            ELSIF bJogRzMinus THEN
                _offsetLocal.rz := -ABS(fAngularStep);
            END_IF

            CASE nFrame OF
                0: // Base
                    _offsetBase := _offsetLocal;

                1, 2: // Tool or Custom
                    _offsetBase := TransformJogOffset(
                        LocalOffset := _offsetLocal,
                        FramePose := _framePose
                    );

                ELSE
                    _offsetBase := _offsetLocal;
            END_CASE

            nLastCommandID := pRobot^.MoveLinearRelative(
                Offset := _offsetBase,
                Velocity := fLinearVelocity
            );
            bCommandIssued := TRUE;
        END_IF
    END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="TransformJogOffset" Id="{3dd819c1-b83a-4a1f-b40e-d2fa2498e4e5}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PRIVATE TransformJogOffset : stPoseGeneral
VAR_INPUT
    LocalOffset : stPoseGeneral;
    FramePose   : stPoseGeneral;
END_VAR
VAR
    theta  : LREAL;
    kx     : LREAL;
    ky     : LREAL;
    kz     : LREAL;
    c      : LREAL;
    si      : LREAL;
    oneC   : LREAL;

    vx     : LREAL;
    vy     : LREAL;
    vz     : LREAL;
    dot    : LREAL;
    crossX : LREAL;
    crossY : LREAL;
    crossZ : LREAL;

    Result : stPoseGeneral;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// FramePose.Rx/Ry/Rz is treated as an axis-angle rotation vector.
// Rodrigues' formula rotates both translational and incremental
// rotational jog vectors from the selected frame into Base axes.

Result.X := 0.0;
Result.Y := 0.0;
Result.Z := 0.0;
Result.Rx := 0.0;
Result.Ry := 0.0;
Result.Rz := 0.0;

theta := SQRT(
    FramePose.Rx * FramePose.Rx +
    FramePose.Ry * FramePose.Ry +
    FramePose.Rz * FramePose.Rz
);

IF theta < 0.000000001 THEN
    Result := LocalOffset;
ELSE
    kx := FramePose.Rx / theta;
    ky := FramePose.Ry / theta;
    kz := FramePose.Rz / theta;

    c := COS(theta);
    si := SIN(theta);
    oneC := 1.0 - c;

    // Translation
    vx := LocalOffset.X;
    vy := LocalOffset.Y;
    vz := LocalOffset.Z;

    crossX := ky * vz - kz * vy;
    crossY := kz * vx - kx * vz;
    crossZ := kx * vy - ky * vx;
    dot := kx * vx + ky * vy + kz * vz;

    Result.X := vx * c + crossX * si + kx * dot * oneC;
    Result.Y := vy * c + crossY * si + ky * dot * oneC;
    Result.Z := vz * c + crossZ * si + kz * dot * oneC;

    // Incremental rotation axis
    vx := LocalOffset.Rx;
    vy := LocalOffset.Ry;
    vz := LocalOffset.Rz;

    crossX := ky * vz - kz * vy;
    crossY := kz * vx - kx * vz;
    crossZ := kx * vy - ky * vx;
    dot := kx * vx + ky * vy + kz * vz;

    Result.Rx := vx * c + crossX * si + kx * dot * oneC;
    Result.Ry := vy * c + crossY * si + ky * dot * oneC;
    Result.Rz := vz * c + crossZ * si + kz * dot * oneC;
END_IF

TransformJogOffset := Result;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>