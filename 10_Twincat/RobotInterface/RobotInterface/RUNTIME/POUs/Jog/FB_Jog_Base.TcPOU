      </Implementation>
    </Method>
    <Method Name="JogXMinus" Id="{9cd6111c-62e0-403d-bfc0-7ca2dafc9774}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PUBLIC JogXMinus : BOOL]]></Declaration>
      <Implementation>
