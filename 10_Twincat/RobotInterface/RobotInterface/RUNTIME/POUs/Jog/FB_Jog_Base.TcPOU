      </Implementation>
    </Method>
    <Method Name="SetAngularStep" Id="{84a56170-4029-4cfb-afa4-08b5c93ef8fd}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD PUBLIC SetAngularStep : BOOL
VAR_INPUT
    fValue : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fValue > 0.0 THEN
    fAngularStep := fValue;
    SetAngularStep := TRUE;
ELSE
    SetAngularStep := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAngularVelocity" Id="{c6348151-94f0-4b5e-a29e-41615ce90bee}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD PUBLIC SetAngularVelocity : BOOL
VAR_INPUT
    fValue : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fValue > 0.0 THEN
    fAngularVelocity := fValue;
    SetAngularVelocity := TRUE;
ELSE
    SetAngularVelocity := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetCustomFrame" Id="{e8d0868c-cc69-482a-a293-e92a06f0bd47}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD PUBLIC SetCustomFrame : BOOL
VAR_INPUT
    Frame : stPoseGeneral;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CustomFrame := Frame;
SetCustomFrame := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetFrame" Id="{6afaa23b-088d-47d0-b258-1bfc2c824540}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD PUBLIC SetFrame : BOOL
VAR_INPUT
    nValue : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nValue <= 2 THEN
    nFrame := nValue;
    SetFrame := TRUE;
ELSE
    SetFrame := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetLinearStep" Id="{d677e68d-e354-4bc6-9cb4-7fbb9eb1e97a}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD PUBLIC SetLinearStep : BOOL
VAR_INPUT
    fValue : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fValue > 0.0 THEN
    fLinearStep := fValue;
    SetLinearStep := TRUE;
ELSE
    SetLinearStep := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetLinearVelocity" Id="{6538d128-3263-44b0-9619-f63a274e14be}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD PUBLIC SetLinearVelocity : BOOL
VAR_INPUT
    fValue : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fValue > 0.0 THEN
    fLinearVelocity := fValue;
    SetLinearVelocity := TRUE;
ELSE
    SetLinearVelocity := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopJog" Id="{275159c4-fdb9-47b2-a70b-1c291e3b6d7e}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PUBLIC StopJog : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_reqXPlus := FALSE;
_reqXMinus := FALSE;
_reqYPlus := FALSE;
_reqYMinus := FALSE;
_reqZPlus := FALSE;
_reqZMinus := FALSE;

_reqRxPlus := FALSE;
_reqRxMinus := FALSE;
_reqRyPlus := FALSE;
_reqRyMinus := FALSE;
_reqRzPlus := FALSE;
_reqRzMinus := FALSE;

StopJog := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>