<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Jog_Base" Id="{07510ab4-87e0-41b7-8fcd-b7762a6b0059}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_Jog_Base
VAR_INPUT
    // ==========================================================
    // HMI / COMMON JOG SETTINGS
    // These are VAR_INPUT so they can be written directly from
    // PLC code or TwinCAT HMI without accessing local FB data.
    // ==========================================================
    bEnable             : BOOL := TRUE;

    // Frame convention used by both derived jog FBs:
    // 0 = Base / Map / World
    // 1 = Local / Tool / Robot
    // 2 = Custom
    nFrame              : USINT := 0;

    // Step values are used by the manipulator jog.
    // SI recommendation:
    // fLinearStep  [m]
    // fAngularStep [rad]
    fLinearStep         : REAL := 0.001;
    fAngularStep        : REAL := 0.0174532925;

    // Velocity values are shared settings.
    // fLinearVelocity  [m/s]
    // fAngularVelocity [rad/s]
    fLinearVelocity     : REAL := 0.05;
    fAngularVelocity    : REAL := 0.25;

    // Orientation is used for Custom-frame jogging.
    // Manipulator: Rx/Ry/Rz is a rotation vector.
    // AMR: Rz is interpreted as planar yaw.
    CustomFrame         : stPoseGeneral;

    // ==========================================================
    // HMI DIRECTION BUTTONS
    // Manipulator: rising edge = one step.
    // AMR: TRUE = continuous dead-man velocity command.
    // ==========================================================
    bJogXPlus           : BOOL;
    bJogXMinus          : BOOL;
    bJogYPlus           : BOOL;
    bJogYMinus          : BOOL;
    bJogZPlus           : BOOL;
    bJogZMinus          : BOOL;

    bJogRxPlus          : BOOL;
    bJogRxMinus         : BOOL;
    bJogRyPlus          : BOOL;
    bJogRyMinus         : BOOL;
    bJogRzPlus          : BOOL;
    bJogRzMinus         : BOOL;
END_VAR

VAR_OUTPUT
    // Common status for HMI.
    bReady              : BOOL;
    bMoving             : BOOL;
    bPending            : BOOL;
    bCommandIssued      : BOOL;
    nLastCommandID      : UINT;

    ActualPose          : stPoseGeneral;
    ActiveFramePose     : stPoseGeneral;

    // HMI can use these to show/hide unsupported axes.
    bSupportsX          : BOOL;
    bSupportsY          : BOOL;
    bSupportsZ          : BOOL;
    bSupportsRx         : BOOL;
    bSupportsRy         : BOOL;
    bSupportsRz         : BOOL;

    // Indicates the intended button behavior.
    bStepJog            : BOOL;
    bContinuousJog      : BOOL;
END_VAR

VAR
    // Method-generated requests.
    // Derived FBs decide whether a request is consumed as a single
    // step (manipulator) or remains active until StopJog() (AMR).
    _reqXPlus           : BOOL;
    _reqXMinus          : BOOL;
    _reqYPlus           : BOOL;
    _reqYMinus          : BOOL;
    _reqZPlus           : BOOL;
    _reqZMinus          : BOOL;

    _reqRxPlus          : BOOL;
    _reqRxMinus         : BOOL;
    _reqRyPlus          : BOOL;
    _reqRyMinus         : BOOL;
    _reqRzPlus          : BOOL;
    _reqRzMinus         : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Shared interface / request storage only.
// Robot-specific cyclic behavior is implemented by:
//   FB_Jog_Manipulator
//   FB_Jog_AMR
]]></ST>
    </Implementation>
    <Folder Name="JogControl" Id="{0bb8744c-dd3e-4f73-af01-358647a64a2d}" />
    <Folder Name="Settings" Id="{cf64427a-c3e1-4c53-98a0-3f6895990465}" />
    <Method Name="JogRxMinus" Id="{e2d6aa2d-55ce-4228-9225-2c8ab22b7e11}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PUBLIC JogRxMinus : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bEnable THEN
    _reqRxMinus := TRUE;
    JogRxMinus := TRUE;
ELSE
    JogRxMinus := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="JogRxPlus" Id="{02dc0800-06ee-4f4b-92a7-598e413979fe}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PUBLIC JogRxPlus : BOOL]]></Declaration>
      <Implementation>
