END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="JogXPlus" Id="{ff8ad49e-a227-41c5-837a-40e6c4432341}" FolderPath="JogControl\">
      <Declaration><![CDATA[METHOD PUBLIC JogXPlus : BOOL]]></Declaration>
