    nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Retouch3D := FALSE;
nIndex := FindIndex(sName := sCurrentName);

IF nIndex = 0 THEN
    bError := TRUE;
