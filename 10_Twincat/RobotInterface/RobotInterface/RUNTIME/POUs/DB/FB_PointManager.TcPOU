<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_PointManager" Id="{0f9a1081-e1ca-4c00-a682-4db28fb9ed2a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PointManager
VAR_INPUT
    // HMI command interface. Bits are edge-triggered (one action per rising edge),
    // so a momentary HMI button press executes exactly one operation.
    {attribute 'OPC.UA.DA' := '1'}
    sCmdName    : STRING(80);
    {attribute 'OPC.UA.DA' := '1'}
    sCmdNewName : STRING(80);
    {attribute 'OPC.UA.DA' := '1'}
    sFilePath   : STRING(255);
    // Current robot TCP, fed each cycle by the owning robot (used by TEACH).
    {attribute 'OPC.UA.DA' := '1'}
    xCurrentTcp : stPoseGeneral;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdNew     : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdLoad    : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdSave    : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdDelete  : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdRename  : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdTeach   : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdSaveFile : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bCmdLoadFile : BOOL;
END_VAR
VAR_OUTPUT
    bBusy : BOOL;
    bDone : BOOL;
    bError : BOOL;
    eResult : E_PointStoreResult := POINTSTORE_IDLE;
    nErrorID : UDINT;
    sLastOperation : STRING(80);
    bFound : BOOL;
    xPoint : ST_Point;
    pPoint : POINTER TO ST_Point;
    aPointNames : ARRAY[0..99] OF STRING(80);
    nPointCount : UINT;
    nPointNameCount : UINT;
    nSelectedPointIndex : UDINT := 16#FFFFFFFF;
END_VAR
VAR
    aPoints : ARRAY[1..100] OF ST_Point;
    nNextId : DINT := 1;
    sRobotPrefix : STRING(80);

    // Edge detection for the HMI command bits.
    _rNew       : R_TRIG;
    _rLoad      : R_TRIG;
    _rSave      : R_TRIG;
    _rDelete    : R_TRIG;
    _rRename    : R_TRIG;
    _rTeach     : R_TRIG;
    _rSaveFile  : R_TRIG;
    _rLoadFile  : R_TRIG;
    _pose       : stPoseGeneral;
    _nLastSelectedPointIndex : UDINT := 16#FFFFFFFF;

    _fileOpen   : FB_FileOpen;
    _fileWrite  : FB_FileWrite;
    _fileRead   : FB_FileRead;
    _fileClose  : FB_FileClose;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bDone := FALSE;
bBusy := FALSE;

IF NOT bError THEN
    eResult := POINTSTORE_IDLE;
END_IF

// ----------------------------------------------------------
// HMI command interface (one operation per rising edge)
// ----------------------------------------------------------
_rNew(CLK := bCmdNew);
_rLoad(CLK := bCmdLoad);
_rSave(CLK := bCmdSave);
_rDelete(CLK := bCmdDelete);
_rRename(CLK := bCmdRename);
_rTeach(CLK := bCmdTeach);
_rSaveFile(CLK := bCmdSaveFile);
_rLoadFile(CLK := bCmdLoadFile);

IF nSelectedPointIndex <> _nLastSelectedPointIndex THEN
    _nLastSelectedPointIndex := nSelectedPointIndex;
    IF nSelectedPointIndex <= 99 THEN
        IF aPointNames[UDINT_TO_UINT(nSelectedPointIndex)] <> '' THEN
            sCmdName := aPointNames[UDINT_TO_UINT(nSelectedPointIndex)];
            bError := FALSE;
            Load(sName := sCmdName);
        END_IF
    END_IF
END_IF

IF _rLoad.Q THEN
    bError := FALSE;
    Load(sName := sCmdName);
END_IF

IF _rLoadFile.Q THEN
    bError := FALSE;
    LoadAllFromFile();
END_IF

IF _rNew.Q THEN
    bError := FALSE;
    Create3D(sName := sCmdName, pose := xCurrentTcp, frameId := 0);
END_IF

IF _rTeach.Q THEN
    // Copy the current robot TCP into the named point (create if new).
    bError := FALSE;
    IF FindIndex(sName := sCmdName) <> 0 THEN
        Retouch3D(sCurrentName := sCmdName, sNewName := '', pose := xCurrentTcp, frameId := 0);
    ELSE
        Create3D(sName := sCmdName, pose := xCurrentTcp, frameId := 0);
    END_IF
END_IF

IF _rSave.Q THEN
    // Persist the edited buffer (xPoint) into the named point.
    bError := FALSE;
    _pose.x := xPoint.x;
    _pose.y := xPoint.y;
    _pose.z := xPoint.z;
    _pose.rx := xPoint.rx;
    _pose.ry := xPoint.ry;
    _pose.rz := xPoint.rz;
    IF FindIndex(sName := sCmdName) <> 0 THEN
        Retouch3D(sCurrentName := sCmdName, sNewName := '', pose := _pose, frameId := 0);
    ELSE
        Create3D(sName := sCmdName, pose := _pose, frameId := 0);
    END_IF
END_IF

IF _rRename.Q THEN
    bError := FALSE;
    Rename(sOldName := sCmdName, sNewName := sCmdNewName);
END_IF

IF _rDelete.Q THEN
    bError := FALSE;
    Delete(sName := sCmdName);
END_IF

IF _rSaveFile.Q THEN
    bError := FALSE;
    SaveAllToFile();
END_IF
]]></ST>
    </Implementation>
    <Method Name="CheckName" Id="{31a92c55-4048-4436-bde0-9a31231e253b}">
      <Declaration><![CDATA[METHOD CheckName : BOOL
VAR_INPUT
	sInput: STRING;
END_VAR

VAR
	i: DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nNextId<>1 THEN
	FOR i := 1 TO nNextId-1 DO
		IF aPoints[i].short_name = sInput THEN
			CheckName:=FALSE;
			RETURN;
		END_IF
	END_FOR
	CheckName:=TRUE;
ELSE
	CheckName:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{4b1f7eb1-6aef-4d80-a0ba-dd1b9f426f56}">
      <Declaration><![CDATA[METHOD PUBLIC Configure : BOOL
VAR_INPUT
    sPrefix : STRING(80);
    sDatabase : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Configure := FALSE;

IF sPrefix <> '' THEN
    sRobotPrefix := sPrefix;
    bError := FALSE;
    nErrorID := 0;
    eResult := POINTSTORE_DONE;
    bDone := TRUE;
    sLastOperation := 'Memory point store configured';
    Configure := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Create2D" Id="{52d904e0-250d-4ef4-a0fa-4ea46da302f8}">
      <Declaration><![CDATA[METHOD PUBLIC Create2D : BOOL
VAR_INPUT
    sName : STRING(80);
    pose : stPoseGeneral;
    frameId : UINT;
END_VAR
VAR
    nIndex : UINT;
	name: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Create2D := FALSE;

IF nPointCount >= 100 THEN
    bError := TRUE;
    nErrorID := 16#E801;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'Memory point store full';
    RETURN;
END_IF

name := PointName(sName := sName, nId := aPoints[nIndex].id);
IF NOT CheckName(name) THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Name: %s is already used, saving as ...',sName);
	name := PointName(sName := '', nId := aPoints[nIndex].id);
	sName := name;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'... %s',sName);
END_IF


nPointCount := nPointCount + 1;
nIndex := nPointCount;
aPoints[nIndex].id := nNextId;
nNextId := nNextId + 1;
aPoints[nIndex].robot_prefix := sRobotPrefix;
aPoints[nIndex].short_name := PointName(sName := sName, nId := aPoints[nIndex].id);
aPoints[nIndex].pose_kind := 'POSE_2D';
aPoints[nIndex].frame_id := UINT_TO_DINT(frameId);
aPoints[nIndex].x := pose.x;
aPoints[nIndex].y := pose.y;
aPoints[nIndex].rz := pose.rz;
xPoint := aPoints[nIndex];
pPoint := ADR(xPoint);
bFound := TRUE;
bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
sLastOperation := 'Created 2D point';
SyncPointNames();
nSelectedPointIndex := UINT_TO_UDINT(nPointNameCount - 1);
Create2D := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Create2DValues" Id="{ddc1e09c-5338-4ca4-96a0-1b670e990315}">
      <Declaration><![CDATA[METHOD PUBLIC Create2DValues : BOOL
VAR_INPUT
    sName : STRING(80);
    x : LREAL;
    y : LREAL;
    rz : LREAL;
    frameId : UINT;
END_VAR
VAR
    pose : stPoseGeneral;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pose.x := x;
pose.y := y;
pose.rz := rz;
Create2DValues := Create2D(sName := sName, pose := pose, frameId := frameId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Create3D" Id="{25e6fd63-94ca-40b8-a933-89e5e73a3cc4}">
      <Declaration><![CDATA[METHOD PUBLIC Create3D : BOOL
VAR_INPUT
    sName : STRING(80);
    pose : stPoseGeneral;
    frameId : UINT;
END_VAR
VAR
    nIndex : UINT;
	name: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Create3D := FALSE;

IF nPointCount >= 100 THEN
    bError := TRUE;
    nErrorID := 16#E801;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'Memory point store full';
    RETURN;
END_IF

nPointCount := nPointCount + 1;
nIndex := nPointCount;
aPoints[nIndex].id := nNextId;
nNextId := nNextId + 1;

name := PointName(sName := sName, nId := aPoints[nIndex].id);
IF NOT CheckName(name) THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'Name: %s is already used, saving as ...',sName);
	name := PointName(sName := '', nId := aPoints[nIndex].id);
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN,'... %s',name);
END_IF

aPoints[nIndex].robot_prefix := sRobotPrefix;
aPoints[nIndex].short_name := name;
aPoints[nIndex].pose_kind := 'POSE_3D';
aPoints[nIndex].frame_id := UINT_TO_DINT(frameId);
aPoints[nIndex].x := pose.x;
aPoints[nIndex].y := pose.y;
aPoints[nIndex].z := pose.z;
aPoints[nIndex].rx := pose.rx;
aPoints[nIndex].ry := pose.ry;
aPoints[nIndex].rz := pose.rz;
xPoint := aPoints[nIndex];
pPoint := ADR(xPoint);
bFound := TRUE;
bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
sLastOperation := 'Created 3D point';
SyncPointNames();
nSelectedPointIndex := UINT_TO_UDINT(nPointNameCount - 1);
Create3D := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Create3DValues" Id="{548e1623-b640-4f76-a8e4-d31563f1bb19}">
      <Declaration><![CDATA[METHOD PUBLIC Create3DValues : BOOL
VAR_INPUT
    sName : STRING(80);
    x : LREAL;
    y : LREAL;
    z : LREAL;
    rx : LREAL;
    ry : LREAL;
    rz : LREAL;
    frameId : UINT;
END_VAR
VAR
    pose : stPoseGeneral;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pose.x := x;
pose.y := y;
pose.z := z;
pose.rx := rx;
pose.ry := ry;
pose.rz := rz;
Create3DValues := Create3D(sName := sName, pose := pose, frameId := frameId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Delete" Id="{b9bf175a-8f5f-4f04-845a-748134349812}">
      <Declaration><![CDATA[METHOD PUBLIC Delete : BOOL
VAR_INPUT
    sName : STRING(80);
END_VAR
VAR
    nIndex : UINT;
    nShiftIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Delete := FALSE;
nIndex := FindIndex(sName := sName);

IF nIndex = 0 THEN
    bError := TRUE;
    nErrorID := 16#E802;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'Point not found';
    RETURN;
END_IF

FOR nShiftIndex := nIndex TO nPointCount - 1 DO
    aPoints[nShiftIndex] := aPoints[nShiftIndex + 1];
END_FOR
nPointCount := nPointCount - 1;
nSelectedPointIndex := 16#FFFFFFFF;
bFound := FALSE;
pPoint := 0;
bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
sLastOperation := 'Deleted point';
SyncPointNames();
Delete := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindIndex" Id="{ad72fd3e-57ea-4b2a-b260-695ec99cfd7d}">
      <Declaration><![CDATA[METHOD PRIVATE FindIndex : UINT
VAR_INPUT
    sName : STRING(80);
END_VAR
VAR
    nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FindIndex := 0;

FOR nIndex := 1 TO nPointCount DO
    IF (aPoints[nIndex].robot_prefix = sRobotPrefix) AND (aPoints[nIndex].short_name = sName) THEN
        FindIndex := nIndex;
        RETURN;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Load" Id="{0f9f4e59-e2f1-4493-9ce7-02d86f51f918}">
      <Declaration><![CDATA[METHOD PUBLIC Load : BOOL
VAR_INPUT
    sName : STRING(80);
END_VAR
VAR
    nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Load := FALSE;
nIndex := FindIndex(sName := sName);
bFound := nIndex <> 0;

IF bFound THEN
    xPoint := aPoints[nIndex];
    pPoint := ADR(xPoint);
    bError := FALSE;
    eResult := POINTSTORE_DONE;
    bDone := TRUE;
    sLastOperation := 'Loaded point';
ELSE
    pPoint := 0;
    bError := FALSE;
    eResult := POINTSTORE_DONE;
    bDone := TRUE;
    sLastOperation := 'Point not found';
END_IF
Load := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SaveAllToFile" Id="{e1ec9f0d-0dfe-4b72-977d-9abc1cf94517}">
      <Declaration><![CDATA[METHOD PUBLIC SaveAllToFile : BOOL
VAR
    sPath : STRING(255);
    sData : STRING(4096);
    sLine : STRING(255);
    i : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SaveAllToFile := FALSE;

IF sFilePath <> '' THEN
    sPath := sFilePath;
ELSE
    sPath := 'C:\TwinCAT\3.1\Boot\RobotPoints.txt';
END_IF;

sData := 'id;robot_prefix;short_name;pose_kind;frame_id;x;y;z;rx;ry;rz' + '$R$L';

FOR i := 1 TO nPointCount DO
    sLine := DINT_TO_STRING(aPoints[i].id) + ';';
    sLine := CONCAT(sLine, aPoints[i].robot_prefix) + ';';
    sLine := CONCAT(sLine, aPoints[i].short_name) + ';';
    sLine := CONCAT(sLine, aPoints[i].pose_kind) + ';';
    sLine := CONCAT(sLine, DINT_TO_STRING(aPoints[i].frame_id)) + ';';
    sLine := CONCAT(sLine, LREAL_TO_STRING(aPoints[i].x)) + ';';
    sLine := CONCAT(sLine, LREAL_TO_STRING(aPoints[i].y)) + ';';
    sLine := CONCAT(sLine, LREAL_TO_STRING(aPoints[i].z)) + ';';
    sLine := CONCAT(sLine, LREAL_TO_STRING(aPoints[i].rx)) + ';';
    sLine := CONCAT(sLine, LREAL_TO_STRING(aPoints[i].ry)) + ';';
    sLine := CONCAT(sLine, LREAL_TO_STRING(aPoints[i].rz));
    sData := CONCAT(sData, sLine) + '$R$L';
END_FOR

_fileOpen(
    sNetId := '',
    sPathName := sPath,
    nMode := FOPEN_MODEWRITE OR FOPEN_MODETEXT,
    ePath := PATH_GENERIC,
    bExecute := TRUE,
    tTimeout := T#5S
);

IF _fileOpen.bBusy THEN
    RETURN;
END_IF

IF _fileOpen.bError THEN
    bError := TRUE;
    nErrorID := _fileOpen.nErrId;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'File save failed';
    RETURN;
END_IF

_fileWrite(
    sNetId := '',
    hFile := _fileOpen.hFile,
    pWriteBuff := ADR(sData),
    cbWriteLen := LEN(sData),
    bExecute := TRUE,
    tTimeout := T#5S
);

IF _fileWrite.bBusy THEN
    RETURN;
END_IF

IF _fileWrite.bError THEN
    bError := TRUE;
    nErrorID := _fileWrite.nErrId;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'File write failed';
    RETURN;
END_IF

_fileClose(
    sNetId := '',
    hFile := _fileOpen.hFile,
    bExecute := TRUE,
    tTimeout := T#5S
);

IF _fileClose.bBusy THEN
    RETURN;
END_IF

IF _fileClose.bError THEN
    bError := TRUE;
    nErrorID := _fileClose.nErrId;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'File close failed';
    RETURN;
END_IF

bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
SaveAllToFile := TRUE;
sLastOperation := 'Saved points to local file';
]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoadAllFromFile" Id="{d9f73ca1-ec3f-401f-bebb-2eb5d8fd34e7}">
      <Declaration><![CDATA[METHOD PUBLIC LoadAllFromFile : BOOL
VAR
    sPath : STRING(255);
    sData : STRING(4096);
    sLine : STRING(255);
    sRemaining : STRING(4096);
    sField : STRING(255);
    sBuf : STRING(255);
    nPos : INT;
    nIndex : UINT;
    nItems : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LoadAllFromFile := FALSE;

IF sFilePath <> '' THEN
    sPath := sFilePath;
ELSE
    sPath := 'C:\TwinCAT\3.1\Boot\RobotPoints.txt';
END_IF;

nPointCount := 0;
nNextId := 1;

_fileOpen(
    sNetId := '',
    sPathName := sPath,
    nMode := FOPEN_MODEREAD OR FOPEN_MODETEXT,
    ePath := PATH_GENERIC,
    bExecute := TRUE,
    tTimeout := T#5S
);

IF _fileOpen.bBusy THEN
    RETURN;
END_IF

IF _fileOpen.bError THEN
    bError := TRUE;
    nErrorID := _fileOpen.nErrId;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'File load failed';
    RETURN;
END_IF

_fileRead(
    sNetId := '',
    hFile := _fileOpen.hFile,
    pReadBuff := ADR(sData),
    cbReadLen := SIZEOF(sData),
    bExecute := TRUE,
    tTimeout := T#5S
);

IF _fileRead.bBusy THEN
    RETURN;
END_IF

IF _fileRead.bError THEN
    bError := TRUE;
    nErrorID := _fileRead.nErrId;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'File read failed';
    RETURN;
END_IF

_fileClose(
    sNetId := '',
    hFile := _fileOpen.hFile,
    bExecute := TRUE,
    tTimeout := T#5S
);

IF _fileClose.bBusy THEN
    RETURN;
END_IF

IF _fileClose.bError THEN
    bError := TRUE;
    nErrorID := _fileClose.nErrId;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'File close failed';
    RETURN;
END_IF

sRemaining := sData;

nPos := FIND(sRemaining, '$R$L');
WHILE nPos > 0 DO
    sLine := LEFT(sRemaining, nPos - 1);
    sRemaining := DELETE(sRemaining, 1, nPos + 1);
    IF sLine = 'id;robot_prefix;short_name;pose_kind;frame_id;x;y;z;rx;ry;rz' THEN
        CONTINUE;
    END_IF

    IF LEN(sLine) > 0 THEN
        nPointCount := nPointCount + 1;
        nIndex := nPointCount;

        sBuf := sLine;
        nItems := 0;

        WHILE LEN(sBuf) > 0 DO
            nPos := FIND(sBuf, ';');
            IF nPos > 0 THEN
                sField := LEFT(sBuf, nPos - 1);
                sBuf := DELETE(sBuf, 1, nPos);
            ELSE
                sField := sBuf;
                sBuf := '';
            END_IF;

            nItems := nItems + 1;

            CASE nItems OF
                1: aPoints[nIndex].id := STRING_TO_DINT(sField);
                2: aPoints[nIndex].robot_prefix := sField;
                3: aPoints[nIndex].short_name := sField;
                4: aPoints[nIndex].pose_kind := sField;
                5: aPoints[nIndex].frame_id := STRING_TO_DINT(sField);
                6: aPoints[nIndex].x := STRING_TO_LREAL(sField);
                7: aPoints[nIndex].y := STRING_TO_LREAL(sField);
                8: aPoints[nIndex].z := STRING_TO_LREAL(sField);
                9: aPoints[nIndex].rx := STRING_TO_LREAL(sField);
                10: aPoints[nIndex].ry := STRING_TO_LREAL(sField);
                11: aPoints[nIndex].rz := STRING_TO_LREAL(sField);
            END_CASE;
        END_WHILE;

        IF aPoints[nIndex].id >= nNextId THEN
            nNextId := aPoints[nIndex].id + 1;
        END_IF;
    END_IF;

    nPos := FIND(sRemaining, '$R$L');
END_WHILE;

bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
LoadAllFromFile := TRUE;
sLastOperation := 'Loaded points from local file';
SyncPointNames();
IF nPointNameCount > 0 THEN
    nSelectedPointIndex := 0;
    _nLastSelectedPointIndex := 0;
    sCmdName := aPointNames[0];
    Load(sName := sCmdName);
    sLastOperation := 'Loaded points from local file';
ELSE
    nSelectedPointIndex := 16#FFFFFFFF;
    _nLastSelectedPointIndex := 16#FFFFFFFF;
    pPoint := 0;
    bFound := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PointName" Id="{b5b5ae96-26ce-41d2-877e-ca29f7e37f86}">
      <Declaration><![CDATA[METHOD PRIVATE PointName : STRING(80)
VAR_INPUT
    sName : STRING(80);
    nId : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sName <> '' THEN
    PointName := sName;
ELSE
    PointName := CONCAT('Point_', DINT_TO_STRING(nId));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Rename" Id="{cf65fd03-8e99-44d3-a32a-56836dd09382}">
      <Declaration><![CDATA[METHOD PUBLIC Rename : BOOL
VAR_INPUT
    sOldName : STRING(80);
    sNewName : STRING(80);
END_VAR
VAR
    nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Rename := FALSE;
nIndex := FindIndex(sName := sOldName);

IF (nIndex = 0) OR (sNewName = '') THEN
    bError := TRUE;
    nErrorID := 16#E802;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'Point not found or invalid name';
    RETURN;
END_IF

aPoints[nIndex].short_name := sNewName;
xPoint := aPoints[nIndex];
pPoint := ADR(xPoint);
sCmdName := sNewName;
bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
sLastOperation := 'Renamed point';
SyncPointNames();
Rename := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retouch2D" Id="{9fa1d4af-358c-40fd-a3df-13813c79bbce}">
      <Declaration><![CDATA[METHOD PUBLIC Retouch2D : BOOL
VAR_INPUT
    sCurrentName : STRING(80);
    sNewName : STRING(80);
    pose : stPoseGeneral;
    frameId : UINT;
END_VAR
VAR
    nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Retouch2D := FALSE;
nIndex := FindIndex(sName := sCurrentName);

IF nIndex = 0 THEN
    bError := TRUE;
    nErrorID := 16#E802;
    eResult := POINTSTORE_DATABASE_ERROR;
    sLastOperation := 'Point not found';
    RETURN;
END_IF

IF sNewName <> '' THEN
    aPoints[nIndex].short_name := sNewName;
END_IF
aPoints[nIndex].pose_kind := 'POSE_2D';
aPoints[nIndex].frame_id := UINT_TO_DINT(frameId);
aPoints[nIndex].x := pose.x;
aPoints[nIndex].y := pose.y;
aPoints[nIndex].z := 0;
aPoints[nIndex].rx := 0;
aPoints[nIndex].ry := 0;
aPoints[nIndex].rz := 0;
aPoints[nIndex].rz := pose.rz;
xPoint := aPoints[nIndex];
pPoint := ADR(xPoint);
bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
sLastOperation := 'Retouched 2D point';
Retouch2D := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retouch3D" Id="{51acb7cb-a7d1-4233-9d76-1df126a0c6ea}">
      <Declaration><![CDATA[METHOD PUBLIC Retouch3D : BOOL
