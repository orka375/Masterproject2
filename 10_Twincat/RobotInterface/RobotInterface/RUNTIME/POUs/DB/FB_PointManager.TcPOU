END_IF
aPoints[nIndex].pose_kind := 'POSE_3D';
aPoints[nIndex].frame_id := UINT_TO_DINT(frameId);
aPoints[nIndex].x := pose.x;
aPoints[nIndex].y := pose.y;
aPoints[nIndex].z := pose.z;
aPoints[nIndex].rx := pose.rx;
aPoints[nIndex].ry := pose.ry;
aPoints[nIndex].rz := pose.rz;
xPoint := aPoints[nIndex];
pPoint := ADR(xPoint);
bError := FALSE;
eResult := POINTSTORE_DONE;
bDone := TRUE;
sLastOperation := 'Retouched 3D point';
Retouch3D := TRUE;]]></ST>
      </Implementation>
    </Method>
        <Method Name="SyncPointNames" Id="{8a5f8289-b888-4b75-9f49-989f99951e4b}">
            <Declaration><![CDATA[METHOD PRIVATE SyncPointNames
VAR
        nIndex : UINT;
        nOutputIndex : UINT;
END_VAR
]]></Declaration>
            <Implementation>
                <ST><![CDATA[FOR nIndex := 0 TO 99 DO
        aPointNames[nIndex] := '';
    END_FOR

    nPointNameCount := 0;
    FOR nIndex := 1 TO nPointCount DO
        IF aPoints[nIndex].robot_prefix = sRobotPrefix THEN
            nOutputIndex := nPointNameCount;
            aPointNames[nOutputIndex] := aPoints[nIndex].short_name;
            nPointNameCount := nPointNameCount + 1;
        END_IF
END_FOR
]]></ST>
            </Implementation>
        </Method>
  </POU>
</TcPlcObject>