<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Utilities" Id="{dbb2bae3-284e-404d-8af4-4033a808f2cd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Utilities
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	PLCStandardUnits : ST_StandardUnits := (
        Position            := eUnit.m,
        Orientation         := eUnit.rad,
        Joint               := eUnit.rad,
        LinearVelocity      := eUnit.m,
        AngularVelocity     := eUnit.rad,
        JointVelocity       := eUnit.rad,
        LinearAcceleration  := eUnit.m,
        AngularAcceleration := eUnit.rad,
        JointAcceleration   := eUnit.rad
    );

    HMIStandardUnits : ST_StandardUnits := (
        Position            := eUnit.mm,
        Orientation         := eUnit.deg,
        Joint               := eUnit.deg,
        LinearVelocity      := eUnit.mm,
        AngularVelocity     := eUnit.deg,
        JointVelocity       := eUnit.deg,
        LinearAcceleration  := eUnit.mm,
        AngularAcceleration := eUnit.deg,
        JointAcceleration   := eUnit.deg
    );
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Transformations" Id="{0f35416c-425e-4895-8ca7-e79ef5060dff}" />
    <Folder Name="UnitsHandling" Id="{1f9b8cac-4895-49e0-847a-3b08ee3b77fa}" />
    <Method Name="ATAN2" Id="{0055c2f1-7ac2-4dfc-a141-471d222df1fa}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PRIVATE ATAN2 : LREAL
VAR_INPUT
    y : LREAL;
    x : LREAL;
END_VAR
VAR CONSTANT
    PI      : LREAL := 3.14159265358979323846;
    HALF_PI : LREAL := 1.57079632679489661923;
    EPS     : LREAL := 1E-12;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

IF x > EPS THEN

    // Quadrant I or IV
    ATAN2 := ATAN(y / x);


ELSIF x < -EPS THEN

    IF y >= 0.0 THEN
        // Quadrant II
        ATAN2 := ATAN(y / x) + PI;
    ELSE
        // Quadrant III
        ATAN2 := ATAN(y / x) - PI;
    END_IF


ELSE

    // x approximately zero

    IF y > EPS THEN
        ATAN2 := HALF_PI;

    ELSIF y < -EPS THEN
        ATAN2 := -HALF_PI;

    ELSE
        // x = 0 and y = 0:
        // mathematically undefined, but 0 is practical here.
        ATAN2 := 0.0;

    END_IF

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ChangePointFromHMIStandard" Id="{d0a3c073-2878-4daa-958b-46413eb7c001}" FolderPath="UnitsHandling\">
