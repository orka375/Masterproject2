    <Method Name="ChangePointUnits" Id="{a642afa2-480c-4f17-a884-44fd555fb170}" FolderPath="UnitsHandling\">
      <Declaration><![CDATA[METHOD PUBLIC ChangePointUnits : ST_Point
VAR_INPUT
    Point     : ST_Point;
    FromUnits : ST_StandardUnits;
    ToUnits   : ST_StandardUnits;
END_VAR
VAR
    Result : ST_Point;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Result.x := ChangeValueUnit(Value := Point.x, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);
Result.y := ChangeValueUnit(Value := Point.y, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);
Result.z := ChangeValueUnit(Value := Point.z, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);

ChangePointUnits := Result;
]]></ST>
      </Implementation>
    </Method>
