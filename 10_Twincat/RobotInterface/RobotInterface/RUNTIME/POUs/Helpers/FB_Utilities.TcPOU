    <Method Name="ChangeValueUnit" Id="{8dc1db31-058d-41e3-8c60-f262cc93663c}" FolderPath="UnitsHandling\">
      <Declaration><![CDATA[METHOD PUBLIC ChangeValueUnit : LREAL
VAR_INPUT
    Value    : LREAL;
    FromUnit : eUnit;
    ToUnit   : eUnit;
END_VAR
VAR CONSTANT
    PI : LREAL := 3.14159265358979323846;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF FromUnit = ToUnit THEN
    ChangeValueUnit := Value;
    RETURN;
END_IF;

IF (FromUnit = eUnit.m) AND (ToUnit = eUnit.mm) THEN
    ChangeValueUnit := Value * 1000.0;
    RETURN;
END_IF;

IF (FromUnit = eUnit.mm) AND (ToUnit = eUnit.m) THEN
    ChangeValueUnit := Value / 1000.0;
    RETURN;
END_IF;

IF (FromUnit = eUnit.rad) AND (ToUnit = eUnit.deg) THEN
    ChangeValueUnit := Value * 180.0 / PI;
    RETURN;
END_IF;

IF (FromUnit = eUnit.deg) AND (ToUnit = eUnit.rad) THEN
    ChangeValueUnit := Value * PI / 180.0;
    RETURN;
END_IF;

ChangeValueUnit := Value;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CombineResults" Id="{49654499-5a32-4770-953e-524c6c42196d}">
      <Declaration><![CDATA[METHOD CombineResults : eResult
VAR_INPUT
	r1,r2: eResult := NONE;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Precedence: ERROR > FAILURE > SUCCESS > NONE (an ERROR must never be swallowed).
IF r1 = ERROR OR r2 = ERROR THEN
	CombineResults := ERROR;
ELSIF r1 = FAILURE OR r2 = FAILURE THEN
	CombineResults := FAILURE;
ELSIF r1 = SUCCESS AND r2 = SUCCESS THEN
	CombineResults := SUCCESS;
ELSE
	CombineResults := NONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromPose" Id="{6efa89f2-d704-47c1-801f-9ae91ceec8e7}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC FromPose : ST_TransformMatrix
VAR_INPUT
    Pose : ST_Pose;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromPose := FromXYZRPY(
    x     := Pose.x,
    y     := Pose.y,
    z     := Pose.z,
    roll  := Pose.roll,
    pitch := Pose.pitch,
    yaw   := Pose.yaw
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromXYZRPY" Id="{5fbcc109-d897-4d16-8641-3cd9cc831b6b}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC FromXYZRPY : ST_TransformMatrix
VAR_INPUT
    x     : LREAL;
    y     : LREAL;
    z     : LREAL;
    roll  : LREAL;
    pitch : LREAL;
    yaw   : LREAL;
END_VAR
VAR
    cr : LREAL;
    sr : LREAL;
    cp : LREAL;
    sp : LREAL;
    cy : LREAL;
    sy : LREAL;
    T  : ST_TransformMatrix;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[cr := COS(roll);
sr := SIN(roll);
cp := COS(pitch);
sp := SIN(pitch);
cy := COS(yaw);
sy := SIN(yaw);

// R = Rz(yaw) * Ry(pitch) * Rx(roll)
T.r11 := cy * cp;
T.r12 := cy * sp * sr - sy * cr;
T.r13 := cy * sp * cr + sy * sr;

T.r21 := sy * cp;
T.r22 := sy * sp * sr + cy * cr;
T.r23 := sy * sp * cr - cy * sr;

T.r31 := -sp;
T.r32 := cp * sr;
T.r33 := cp * cr;

T.x := x;
T.y := y;
T.z := z;

FromXYZRPY := T;]]></ST>
      </Implementation>
    </Method>
    <Method Name="HealthRank" Id="{7aa2f37d-3bc5-465a-8b0b-206f6885d608}">
      <Declaration><![CDATA[// Severity order (worst -> best): Dead < Offline < Sick < Unkown < Healty.
METHOD HealthRank : INT
VAR_INPUT
	H : eHealth;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE H OF
	eHealth.Dead:    HealthRank := 0;
	eHealth.Offline: HealthRank := 1;
	eHealth.Sick:    HealthRank := 2;
	eHealth.Unkown:  HealthRank := 3;
	eHealth.Healty:  HealthRank := 4;
ELSE
	HealthRank := 3;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Identity" Id="{082c5415-02f0-465a-8f38-47846cdb81bf}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC Identity : ST_TransformMatrix
VAR
    T : ST_TransformMatrix;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[T.r11 := 1.0;
T.r12 := 0.0;
T.r13 := 0.0;
T.r21 := 0.0;
T.r22 := 1.0;
T.r23 := 0.0;
T.r31 := 0.0;
T.r32 := 0.0;
T.r33 := 1.0;

T.x := 0.0;
T.y := 0.0;
T.z := 0.0;

Identity := T;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Inverse" Id="{8ef26d85-a00a-4547-bcac-ea1d7f67b03b}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC Inverse : ST_TransformMatrix
VAR_INPUT
    T : ST_TransformMatrix;
END_VAR
VAR
    Inv : ST_TransformMatrix;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// For a rigid transform:
// inv(T) = [ R^T  -R^T*t ]

Inv.r11 := T.r11;
Inv.r12 := T.r21;
Inv.r13 := T.r31;

Inv.r21 := T.r12;
Inv.r22 := T.r22;
Inv.r23 := T.r32;

Inv.r31 := T.r13;
Inv.r32 := T.r23;
Inv.r33 := T.r33;

Inv.x := -(Inv.r11*T.x + Inv.r12*T.y + Inv.r13*T.z);
Inv.y := -(Inv.r21*T.x + Inv.r22*T.y + Inv.r23*T.z);
Inv.z := -(Inv.r31*T.x + Inv.r32*T.y + Inv.r33*T.z);

Inverse := Inv;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Multiply" Id="{558458a2-628c-49fe-b7a6-bfe7a802f29e}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC Multiply : ST_TransformMatrix
VAR_INPUT
    A : ST_TransformMatrix;
    B : ST_TransformMatrix;
END_VAR
VAR
    C : ST_TransformMatrix;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Rotation: C.R = A.R * B.R
C.r11 := A.r11*B.r11 + A.r12*B.r21 + A.r13*B.r31;
C.r12 := A.r11*B.r12 + A.r12*B.r22 + A.r13*B.r32;
C.r13 := A.r11*B.r13 + A.r12*B.r23 + A.r13*B.r33;

C.r21 := A.r21*B.r11 + A.r22*B.r21 + A.r23*B.r31;
C.r22 := A.r21*B.r12 + A.r22*B.r22 + A.r23*B.r32;
C.r23 := A.r21*B.r13 + A.r22*B.r23 + A.r23*B.r33;

C.r31 := A.r31*B.r11 + A.r32*B.r21 + A.r33*B.r31;
C.r32 := A.r31*B.r12 + A.r32*B.r22 + A.r33*B.r32;
C.r33 := A.r31*B.r13 + A.r32*B.r23 + A.r33*B.r33;

// Translation: C.t = A.R * B.t + A.t
C.x := A.r11*B.x + A.r12*B.y + A.r13*B.z + A.x;
C.y := A.r21*B.x + A.r22*B.y + A.r23*B.z + A.y;
C.z := A.r31*B.x + A.r32*B.y + A.r33*B.z + A.z;

Multiply := C;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProposeHealth" Id="{7aa2f37d-3bc5-465a-8b0b-206f6885d607}">
      <Declaration><![CDATA[// Returns the worse of two health levels (by severity rank, not raw enum value).
METHOD ProposeHealth : eHealth
VAR_INPUT
	current  : eHealth;
	proposed : eHealth;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF HealthRank(proposed) < HealthRank(current) THEN
	ProposeHealth := proposed;
ELSE
	ProposeHealth := current;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToPose" Id="{a2361769-a73b-4c79-8aed-d424bd5ba8f9}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC ToPose : ST_Pose
VAR_INPUT
    T : ST_TransformMatrix;
END_VAR
VAR
    P  : ST_Pose;
    cp : LREAL;
    v  : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[P.x := T.x;
P.y := T.y;
P.z := T.z;

// Clamp before ASIN to protect against small floating-point errors.
v := -T.r31;
IF v > 1.0 THEN
    v := 1.0;
ELSIF v < -1.0 THEN
    v := -1.0;
END_IF

P.pitch := ASIN(v);
cp := COS(P.pitch);

IF ABS(cp) > 1E-9 THEN
    P.roll := ATAN2(T.r32, T.r33);
    P.yaw  := ATAN2(T.r21, T.r11);
ELSE
    // Gimbal lock: choose roll = 0 and solve yaw from remaining terms.
    P.roll := 0.0;
    P.yaw  := ATAN2(-T.r12, T.r22);
END_IF

ToPose := P;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TransformPoint" Id="{c02f9720-fd79-4af6-85ea-fc0de5935a7b}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC TransformPoint : ST_Vector3
VAR_INPUT
    T : ST_TransformMatrix;
    P : ST_Vector3;
END_VAR
VAR
    Result : ST_Vector3;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Point: p_out = R*p_in + t
Result.x := T.r11*P.x + T.r12*P.y + T.r13*P.z + T.x;
Result.y := T.r21*P.x + T.r22*P.y + T.r23*P.z + T.y;
Result.z := T.r31*P.x + T.r32*P.y + T.r33*P.z + T.z;

TransformPoint := Result;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TransformVector" Id="{6c8293cf-c388-4d1c-8aab-fc0dcd16a6d5}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC TransformVector : ST_Vector3
VAR_INPUT
    T : ST_TransformMatrix;
    V : ST_Vector3;
END_VAR
VAR
    Result : ST_Vector3;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Direction/vector: translation is intentionally ignored.
Result.x := T.r11*V.x + T.r12*V.y + T.r13*V.z;
Result.y := T.r21*V.x + T.r22*V.y + T.r23*V.z;
Result.z := T.r31*V.x + T.r32*V.y + T.r33*V.z;

TransformVector := Result;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>