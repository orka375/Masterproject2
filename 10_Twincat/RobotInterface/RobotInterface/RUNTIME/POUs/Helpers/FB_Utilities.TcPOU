    <Method Name="ChangeRealUnits" Id="{c330b571-1640-40b5-9dcc-76859d662808}" FolderPath="UnitsHandling\">
      <Declaration><![CDATA[METHOD PUBLIC ChangeRealUnits : LREAL
VAR_INPUT
    Value     : LREAL;
    Category  : eUnitCategory;
    FromUnits : ST_StandardUnits;
    ToUnits   : ST_StandardUnits;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Category OF
    eUnitCategory.Position:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.Position,
            ToUnit := ToUnits.Position
        );

    eUnitCategory.Orientation:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.Orientation,
            ToUnit := ToUnits.Orientation
        );

    eUnitCategory.Joint:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.Joint,
            ToUnit := ToUnits.Joint
        );

    eUnitCategory.LinearVelocity:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.LinearVelocity,
            ToUnit := ToUnits.LinearVelocity
        );

    eUnitCategory.AngularVelocity:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.AngularVelocity,
            ToUnit := ToUnits.AngularVelocity
        );

    eUnitCategory.JointVelocity:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.JointVelocity,
            ToUnit := ToUnits.JointVelocity
        );

    eUnitCategory.LinearAcceleration:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.LinearAcceleration,
            ToUnit := ToUnits.LinearAcceleration
        );

    eUnitCategory.AngularAcceleration:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.AngularAcceleration,
            ToUnit := ToUnits.AngularAcceleration
        );

    eUnitCategory.JointAcceleration:
        ChangeRealUnits := ChangeValueUnit(
            Value := Value,
            FromUnit := FromUnits.JointAcceleration,
            ToUnit := ToUnits.JointAcceleration
        );

    ELSE
        ChangeRealUnits := Value;
END_CASE
]]></ST>
      </Implementation>
    </Method>
