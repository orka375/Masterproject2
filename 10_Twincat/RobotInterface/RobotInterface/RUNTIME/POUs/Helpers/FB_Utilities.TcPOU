    <Method Name="ChangePoseUnits" Id="{0fa847d3-0245-4e07-9dd4-030c493801af}" FolderPath="UnitsHandling\">
      <Declaration><![CDATA[METHOD PUBLIC ChangePoseUnits : ST_Pose
VAR_INPUT
    Pose      : ST_Pose;
    FromUnits : ST_StandardUnits;
    ToUnits   : ST_StandardUnits;
END_VAR
VAR
    Result : ST_Pose;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Result.x := ChangeValueUnit(Value := Pose.x, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);
Result.y := ChangeValueUnit(Value := Pose.y, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);
Result.z := ChangeValueUnit(Value := Pose.z, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);

Result.roll := ChangeValueUnit(Value := Pose.roll, FromUnit := FromUnits.Orientation, ToUnit := ToUnits.Orientation);
Result.pitch := ChangeValueUnit(Value := Pose.pitch, FromUnit := FromUnits.Orientation, ToUnit := ToUnits.Orientation);
Result.yaw := ChangeValueUnit(Value := Pose.yaw, FromUnit := FromUnits.Orientation, ToUnit := ToUnits.Orientation);

ChangePoseUnits := Result;
]]></ST>
      </Implementation>
    </Method>
