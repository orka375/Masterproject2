    <Method Name="ChangeTransformMatrixUnits" Id="{54c16076-24ff-4451-8acb-5f1592079cf3}" FolderPath="UnitsHandling\">
      <Declaration><![CDATA[METHOD PUBLIC ChangeTransformMatrixUnits : ST_TransformMatrix
VAR_INPUT
    Transform : ST_TransformMatrix;
    FromUnits : ST_StandardUnits;
    ToUnits   : ST_StandardUnits;
END_VAR
VAR
    Result : ST_TransformMatrix;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Rotation matrix elements r11..r33 are dimensionless and must never be scaled.
Result := Transform;

Result.x := ChangeValueUnit(Value := Transform.x, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);
Result.y := ChangeValueUnit(Value := Transform.y, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);
Result.z := ChangeValueUnit(Value := Transform.z, FromUnit := FromUnits.Position, ToUnit := ToUnits.Position);

ChangeTransformMatrixUnits := Result;
]]></ST>
      </Implementation>
    </Method>
