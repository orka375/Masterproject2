<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Messenger" Id="{83b10ff9-5df7-47f5-bb58-80d01c25214b}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_Messenger
VAR_INPUT
	bExecuteQuittieren: BOOL;
END_VAR
VAR_OUTPUT
	xMyTime		: TIME;

	HMI_MESSENGER: stHMI_MESSENGER;
END_VAR
VAR
	sMyTime		: STRING;
	
	MList	: ARRAY [1..SETUP.MaxNrOfMessages] OF MessageDescription;
	emptyMsg: MessageDescription;
	
	IndexShownM 	: INT := 0;
	
	
	
	fbTime   	: FB_LocalSystemTime:=(bEnable:=TRUE, dwCycle:=1);
	i: INT;
// 	unread: BOOL;
	_unreadError: BOOL;
	nactivErrorIndex: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbTime();
IF fbTime.bValid THEN
	sMyTime := SYSTEMTIME_TO_STRING(fbTime.systemTime);
	xMyTime:= DINT_TO_TIME(
		WORD_TO_DINT(fbTime.systemTime.wHour) * 3600000 +
		WORD_TO_DINT(fbTime.systemTime.wMinute) * 60000 +
		WORD_TO_DINT(fbTime.systemTime.wSecond) * 1000 +
    	WORD_TO_DINT(fbTime.systemTime.wMilliseconds));
END_IF



// Carousel through the currently active messages for the single-line HMI display.
IF HMI_MESSENGER.MsgCount > 0 THEN
	IndexShownM := IndexShownM + 1;
	IF IndexShownM > HMI_MESSENGER.MsgCount THEN
		IndexShownM := 1;
	END_IF
ELSE
	IndexShownM := 0;
END_IF

// Reporting layer: surface the first unacknowledged error + whether any warning is live. Detection stays in the components.
HMI_MESSENGER.bErrorActiv := FALSE;
HMI_MESSENGER.bWarnActiv := FALSE;
nactivErrorIndex := 0;
FOR i := 1 TO HMI_MESSENGER.MsgCount DO
	IF NOT MList[i].bQuit THEN
		IF MList[i].Severity = eSeverity.Error OR MList[i].Severity = eSeverity.Critical THEN
			IF NOT HMI_MESSENGER.bErrorActiv THEN
				HMI_MESSENGER.bErrorActiv := TRUE;
				HMI_MESSENGER.activError := ADR(MList[i]);
				nactivErrorIndex := i;
			END_IF
		ELSIF MList[i].Severity = eSeverity.Warning THEN
			HMI_MESSENGER.bWarnActiv := TRUE;
		END_IF
	END_IF
END_FOR

IF HMI_MESSENGER.MsgCount > 0 AND IndexShownM >= 1 THEN
	HMI_MESSENGER.currentMsg := ADR(MList[IndexShownM]);
ELSE
	HMI_MESSENGER.currentMsg := ADR(emptyMsg);
END_IF

IF bExecuteQuittieren THEN
	bExecuteQuittieren := FALSE;
	IF nactivErrorIndex >= 1 THEN
		Quittieren(nactivErrorIndex);
	END_IF
END_IF
]]></ST>
    </Implementation>
    <Method Name="AddError" Id="{037ddfe7-b312-4cbd-8fc4-eb84b0d4e5f3}">
      <Declaration><![CDATA[METHOD AddError : MessageDescription
VAR_INPUT
	Category: eMessageCategories;
	sSender: STRING;
	sMessage: STRING := '';
END_VAR

VAR
	rng : DRAND;         // Random number generator function block
    seed : INT := 12345;    // Seed value (can also be set using system time)
    randomValue : LINT;        // Output random integer
	index: INT;
	ss: STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// De-duplicate: refresh an identical live message instead of appending (safe for cyclic callers).
index := FindActive(sSender, sMessage, eSeverity.Error);
IF index = 0 THEN
	IF HMI_MESSENGER.MsgCount >= SETUP.MaxNrOfMessages THEN
		// Buffer full: drop message to avoid MList overrun. Clear via ClearMsgs/Clear.
		RETURN;
	END_IF
	index := HMI_MESSENGER.MsgCount + 1;
	HMI_MESSENGER.MsgCount := index;

	MList[index].bQuit := FALSE;
	MList[index].Severity := eSeverity.Error;
	MList[index].Category := Category;
	MList[index].sSender := sSender;
	MList[index].sMessage := sMessage;
	MList[index].ID := ComputeId(sSender, sMessage, eSeverity.Error);

	ss := CONCAT(sMessage, ' : %s');
	ADSLOGSTR(msgCtrlMask := ADSLOG_MSGTYPE_ERROR, msgFmtStr := ss, strArg := sSender);
END_IF

MList[index].tTime := DT_TO_TIME(SYSTEMTIME_TO_DT(fbTime.systemTime));
AddError := MList[index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddHint" Id="{8902f9a6-54f8-4c1a-a645-2f7e5ef010fc}">
      <Declaration><![CDATA[METHOD AddHint : MessageDescription
VAR_INPUT
