<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_2_ROB_MANIP" Id="{21b924b4-0fb6-46ff-9fb7-f679235d19bb}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_2_ROB_MANIP EXTENDS FB_1_ROB 
// IMPLEMENTS ITF_2_Manip

VAR_INPUT
	TOOL: POINTER TO FB_1_Tool;
	JOG: FB_Jog_Manipulator;
END_VAR

VAR_OUTPUT
	HMI_ROB_MANIP: stHMI_ROB_MANIP;
END_VAR
VAR


	
	//TODO What is this for?
	_commandState : E_RobotCommandState := E_RobotCommandState.Idle;
	
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="MotionControl" Id="{fc8c0aca-629b-4848-a20d-78e9ce6e9fda}" />
    <Folder Name="StateControl" Id="{4f99cba4-d44f-4086-b21c-31fe1a3d2978}" />
    <Method Name="AlignTcpZToBrfZ" Id="{bc2132e6-39c8-42b1-8dcb-1b232e67fc01}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD PUBLIC AlignTcpZToBrfZ : UINT
  VAR_INPUT
    Velocity : REAL;
  END_VAR
  VAR
	Target : stTarget;
    CurrentMatrix : ST_TransformMatrix;
    TargetMatrix : ST_TransformMatrix;
    TargetPose : ST_Pose;
    XLength : LREAL;
    YLength : LREAL;
    Xx : LREAL;
    Xy : LREAL;
    Yx : LREAL;
    Yy : LREAL;
    Zx : LREAL;
    Zy : LREAL;
  END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AlignTcpZToBrfZ := 0;

  IF NOT IsReady THEN
    RETURN;
  END_IF

  CurrentMatrix := FromPose(Pose := HMI_ROB._tcppos);

  // Project the current TCP X axis onto the BRF XY plane.
  Xx := CurrentMatrix.r11;
  Xy := CurrentMatrix.r21;
  XLength := SQRT(Xx * Xx + Xy * Xy);

  IF XLength > 1E-9 THEN
    Xx := Xx / XLength;
    Xy := Xy / XLength;
  ELSE
    // Singular X projection: use the current TCP Y axis instead.
    Yx := CurrentMatrix.r12;
    Yy := CurrentMatrix.r22;
    YLength := SQRT(Yx * Yx + Yy * Yy);
    IF YLength <= 1E-9 THEN
      RETURN;
    END_IF
    Xx := -Yy / YLength;
    Xy := Yx / YLength;
  END_IF

  // Znew = BRF +Z; Ynew = Znew x Xnew; Xnew = Ynew x Znew.
  Zx := 0.0;
  Zy := 0.0;
  Yx := -Xy;
  Yy := Xx;

  TargetMatrix := CurrentMatrix;
  TargetMatrix.r11 := Xx;
  TargetMatrix.r21 := Xy;
  TargetMatrix.r31 := 0.0;
  TargetMatrix.r12 := Yx;
  TargetMatrix.r22 := Yy;
  TargetMatrix.r32 := 0.0;
  TargetMatrix.r13 := Zx;
  TargetMatrix.r23 := Zy;
  TargetMatrix.r33 := 1.0;

  TargetPose := ToPose(T := TargetMatrix);
  
  Target.frame_id:= eRefFrame.BRF;
  Target.pose := TargetPose;

  AlignTcpZToBrfZ := MoveJoint(Target,Velocity);
  ]]></ST>
      </Implementation>
    </Method>
    <Action Name="CYCLIC_MANIP" Id="{c5ea77dd-14da-4015-9108-0744e50afbab}">
      <Implementation>
        <ST><![CDATA[CYCLIC_ROB();

IF TOOL <> 0 THEN
  TOOL^.CYCLIC_TOOL();
END_IF


JOG(pRobot:=THIS);



]]></ST>
      </Implementation>
    </Action>
    <Method Name="FB_Init" Id="{59b2ccf3-d1a8-4248-bdb8-48f7cd1360d5}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
  VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
  END_VAR
  VAR
    iManip : UINT;
  END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.FB_Init(bInitRetains := bInitRetains, bInCopyCode := bInCopyCode);

  FOR iManip := 1 TO SETUP.nManipCount DO
    IF SETUP.apManip[iManip] = THIS THEN
      FB_Init := TRUE;
      RETURN;
    END_IF
  END_FOR

  IF SETUP.nManipCount < SETUP.MaxNrofManipulators THEN
    SETUP.nManipCount := SETUP.nManipCount + 1;
    SETUP.apManip[SETUP.nManipCount] := THIS;
    FB_Init := TRUE;
  END_IF]]></ST>
      </Implementation>
    </Method>
