    <Method Name="MoveLinear" Id="{af96fe73-c0fb-4331-8a41-58ccd3cdc293}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD MoveLinear : UINT
VAR_INPUT
	Target	: stTarget;
	Velocity: REAL;
END_VAR

VAR
	Config: stBA_Settings;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity:=Velocity;
Config.Target:=Target;


MoveLinear:= BA_Handler(Cmd:=eBA.MoveL,Settings:=Config);]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveLinearRelative" Id="{bc2132e6-39c8-42b1-8dcb-1b232e67fc7a}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD MoveLinearRelative : UINT
VAR_INPUT
    Offset : stPoseGeneral;
	Velocity: REAL;
END_VAR

VAR
	Config: stBA_Settings;
END_VAR

VAR
    Target : stTarget;
	apos : stPoseGeneral;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity:=Velocity;
Config.Pose:=Offset;

MEMCPY(ADR(apos),ADR(HMI_ROB._tcppos),SIZEOF(apos));


Target.pose.x  := apos.x  + Offset.x;
Target.pose.y  := apos.y  + Offset.y;
Target.pose.z  := apos.z  + Offset.z;
Target.pose.rx := apos.rx + Offset.rx;
Target.pose.ry := apos.ry + Offset.ry;
Target.pose.rz := apos.rz + Offset.rz;

MoveLinearRelative := MoveLinear(
    Target   := Target,
    Velocity := Velocity
);

]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnActivate" Id="{8545c31c-13d9-413d-a788-5dc93d08af33}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------


IF TOOL.LastTransitionType = eTransitions.Activate THEN
	IF TOOL.LastTransitionResult = SUCCESS THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	TOOL.Activate();
END_IF




// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
