    <Method Name="MoveJoint" Id="{9e0f1a2b-3c4d-4e5f-8a6b-7c8d9e0f1a2b}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD MoveJoint : UINT
VAR_INPUT
    Target : stTarget;
	Velocity: REAL;
END_VAR

VAR
	Config: stBA_Settings;
	Resolved: ST_Pose;
	IdentityCustom : ST_TransformMatrix;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity := Velocity;

// Resolve absolute target into BRF; adapters see only BRF targets in PLC standard units.
IdentityCustom := Identity();
IF NOT ResolveAbsoluteTarget(
        TargetIn := Target.pose,
        Frame := Target.frame_id,
        T_W_B := T_W_B,
        T_B_Custom := IdentityCustom,
        Target => Resolved) THEN
    MoveJoint := 0;
    RETURN;
END_IF

Config.Target.frame_id := eRefFrame.BRF;
Config.Target.pose := Resolved;

MoveJoint := BA_Handler(Cmd:=eBA.MoveJ, Settings:=Config);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveJointAbsolute" Id="{5b7e2c11-0d34-4f8a-9c62-7a1e4d90b3f2}" FolderPath="MotionControl\">
      <Declaration><![CDATA[// Move to an absolute joint configuration (joint space).
// Used by the hold-to-run joint jog. The concrete robot FB
// decides how the joint target is transported (e.g. UR movej).
METHOD MoveJointAbsolute : UINT
VAR_INPUT
    Joints   : stJoint6;
    Velocity : REAL;
END_VAR

VAR
	Config: stBA_Settings;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity := Velocity;
Config.Joints := Joints;

MoveJointAbsolute := BA_Handler(Cmd:=eBA.MoveJJoints, Settings:=Config);]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveJointRelative" Id="{d4d7d377-1aa7-4fc3-9e59-f55d00fe8d35}" FolderPath="MotionControl\">
      <Declaration><![CDATA[
METHOD MoveJointRelative : UINT
VAR_INPUT
    Offset   : ST_Pose;
    Frame    : eRefFrame := eRefFrame.TRF;
    Velocity : REAL;
END_VAR

VAR
	Config: stBA_Settings;
	Resolved: ST_Pose;
	IdentityCustom : ST_TransformMatrix;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity := Velocity;

IdentityCustom := Identity();
IF NOT ResolveRelativeTarget(
        Delta := Offset,
        Frame := Frame,
//         T_B_Custom := IdentityCustom,
        Target => Resolved,) THEN
    MoveJointRelative := 0;
    RETURN;
END_IF

Config.Target.frame_id := eRefFrame.BRF;
Config.Target.pose := Resolved;

MoveJointRelative := BA_Handler(Cmd:=eBA.MoveJ, Settings:=Config);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveLinear" Id="{af96fe73-c0fb-4331-8a41-58ccd3cdc293}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD MoveLinear : UINT
VAR_INPUT
	Target	: stTarget;
	Velocity: REAL;
END_VAR

VAR
	Config: stBA_Settings;
	Resolved: ST_Pose;
	IdentityCustom : ST_TransformMatrix;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity := Velocity;

IdentityCustom := Identity();
IF NOT ResolveAbsoluteTarget(
        TargetIn := Target.pose,
        Frame := Target.frame_id,
        T_W_B := T_W_B,
        T_B_Custom := IdentityCustom,
        Target => Resolved) THEN
    MoveLinear := 0;
    RETURN;
END_IF

Config.Target.frame_id := eRefFrame.BRF;
Config.Target.pose := Resolved;

MoveLinear := BA_Handler(Cmd:=eBA.MoveL, Settings:=Config);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveLinearRelative" Id="{bc2132e6-39c8-42b1-8dcb-1b232e67fc7a}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD MoveLinearRelative : UINT
VAR_INPUT
    Offset     : ST_Pose;
    Frame      : eRefFrame := eRefFrame.TRF;
    // Only meaningful when Frame = eRefFrame.CRF. Custom frame expressed in BRF.
    T_B_Custom : ST_TransformMatrix;
    Velocity   : REAL;
END_VAR

VAR
	Config: stBA_Settings;
	Resolved: ST_Pose;
	IdentityCustom : ST_TransformMatrix;
	CustomFrame : ST_TransformMatrix;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity := Velocity;
Config.Pose := Offset;

// If caller left T_B_Custom zeroed, fall back to identity so BRF/WRF/TRF paths still work.
IF (T_B_Custom.r11 = 0.0) AND (T_B_Custom.r22 = 0.0) AND (T_B_Custom.r33 = 0.0) THEN
    CustomFrame := Identity();
ELSE
    CustomFrame := T_B_Custom;
END_IF

IF NOT ResolveRelativeTarget(
        Delta := Offset,
        Frame := Frame,
//         T_B_Custom := CustomFrame,
        Target => Resolved) THEN
    MoveLinearRelative := 0;
    RETURN;
END_IF

Config.Target.frame_id := eRefFrame.BRF;
Config.Target.pose := Resolved;

MoveLinearRelative := BA_Handler(Cmd:=eBA.MoveL, Settings:=Config);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnActivate" Id="{8545c31c-13d9-413d-a788-5dc93d08af33}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------


IF TOOL = 0 THEN
  myResult := SUCCESS;
ELSIF TOOL^.LastTransitionType = eTransitions.Activate THEN
	IF TOOL^.LastTransitionResult = SUCCESS THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	TOOL^.Activate();
END_IF


IF SIMMODE THEN
		myResult:=SUCCESS;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
