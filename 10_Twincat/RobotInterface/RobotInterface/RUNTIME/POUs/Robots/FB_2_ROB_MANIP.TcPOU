  <POU Name="FB_2_ROB_MANIP" Id="{21b924b4-0fb6-46ff-9fb7-f679235d19bb}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_2_ROB_MANIP EXTENDS FB_1_ROB 
// IMPLEMENTS ITF_2_Manip

VAR_INPUT
	TOOL: FB_1_Tool;
	JOG: FB_Jog_Manipulator;
END_VAR

VAR_OUTPUT
	HMI_ROB_MANIP: stHMI_ROB_MANIP;
END_VAR
VAR


	
	//TODO What is this for?
	_command : ST_RobotCommand;
	_commandState : E_RobotCommandState := E_RobotCommandState.Idle;
	_commandErrorId : UDINT;
	_nextExecuteId : UDINT := 1;		
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="MotionControl" Id="{fc8c0aca-629b-4848-a20d-78e9ce6e9fda}" />
