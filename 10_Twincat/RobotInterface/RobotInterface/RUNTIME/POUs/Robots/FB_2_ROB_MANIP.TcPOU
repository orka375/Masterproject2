    <Method Name="MoveJoint" Id="{9e0f1a2b-3c4d-4e5f-8a6b-7c8d9e0f1a2b}" FolderPath="MotionControl\">
      <Declaration><![CDATA[METHOD MoveJoint : UINT
VAR_INPUT
    Target : stTarget;
	Velocity: REAL;
END_VAR

VAR
	Config: stBA_Settings;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Config.Velocity:=Velocity;
Config.Target:=Target;


