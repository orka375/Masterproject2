    <Method Name="OnConfigure" Id="{c4c1f796-20a8-4791-af0e-0e2d378d2ded}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

PM.Configure(sPrefix:=Name,sDatabase:=CONCAT('db_',Name)); //TODO


IF TOOL.LastTransitionType = eTransitions.Configure THEN
	IF TOOL.LastTransitionResult = SUCCESS AND COMM^.CommunicationReady  THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	TOOL.Configure();
END_IF





// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnConfigure := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
