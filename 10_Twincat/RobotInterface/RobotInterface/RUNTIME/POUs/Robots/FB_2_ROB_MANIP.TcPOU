    <Action Name="CYCLIC_MANIP" Id="{c5ea77dd-14da-4015-9108-0744e50afbab}">
      <Implementation>
        <ST><![CDATA[CYCLIC_ROB();
TOOL.CYCLIC_TOOL();
JOG(pRobot:=THIS);



]]></ST>
      </Implementation>
    </Action>
