    <Method Name="MoveToSafePosition" Id="{1460c5aa-e9ef-4e0e-a2bc-5ac3c6af9cb6}" FolderPath="Generic Control\">
      <Declaration><![CDATA[METHOD MoveToSafePosition : UINT
VAR_INPUT
    Velocity : LREAL;
END_VAR
VAR
    settings : stBA_Settings;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[settings.Velocity := Velocity;
settings.Joints := SafePosition;
MoveToSafePosition := CommandHandler(Cmd := eBA.MoveJJoints, Settings := settings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnActivate" Id="{c53d2e09-95f6-4470-b92a-1736ae881f81}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

SetOperationMode(mode:=eMode.Automatic);

IF Comm^.LastTransitionType = eTransitions.Activate THEN
	IF Comm^.LastTransitionResult = SUCCESS THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	COMM^.Activate();
END_IF

IF SIMMODE THEN
		myResult:=SUCCESS;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{734e8874-f49e-492d-ae48-dcfbab1bde00}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnCleanup();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

IF Comm^.LastTransitionType = eTransitions.Cleanup THEN
	IF Comm^.LastTransitionResult = SUCCESS THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	COMM^.Cleanup();
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnCleanup := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCommandCancelled" Id="{91234baa-4c31-4086-8ac7-29bfb64ae053}" FolderPath="Command\">
      <Declaration><![CDATA[METHOD PROTECTED OnCommandCancelled
VAR_INPUT
    CommandID : UINT;
END_VAR

// Default: nothing to do.
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{405f6b01-72da-4ba1-a9bb-82f8cc48639e}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

PM.LoadAllFromFile();

IF Comm^.LastTransitionType = eTransitions.Configure THEN
	
	IF Comm^.LastTransitionResult = SUCCESS AND COMM^.Connected  THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	COMM^.Configure();
END_IF

IF SIMMODE THEN
		myResult:=SUCCESS;
END_IF

IF NOT PM.Initalising(sName := Name) = SUCCESS THEN
	myResult:=NONE;
END_IF


// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnConfigure := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{0745a082-7014-41b6-ad3f-f3e98871c693}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnDeactivate();

IF (eCommandStatus = INIT) OR (eCommandStatus = ACKNOWLEDGE) OR (eCommandStatus = RUNNING) THEN
    StopMotion();
END_IF
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

IF Comm^.LastTransitionType = eTransitions.Deactivate THEN
	IF Comm^.LastTransitionResult = SUCCESS THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	COMM^.Deactivate();
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{241d30dc-f0b7-4588-8953-d135c03fba6b}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();
myResult := NONE;

// Stop the physical capability through the generic robot API. Vendor-specific
// implementations decide how this is done. The interrupted command is terminal.
IF (eCommandStatus = INIT) OR (eCommandStatus = ACKNOWLEDGE) OR (eCommandStatus = RUNNING) THEN
    StopMotion();
    eCommandStatus := ABORTED;
    eCommandResult := ERROR;
END_IF

// Communication recovery owns its own policy. The robot only waits for it and
// propagates a more restrictive recovery mode upward.
IF (COMM = 0) OR (COMM = ADR(emptyCOMM)) THEN
    myResult := SUCCESS;
ELSIF COMM^.State = eState.ErrorProcessing THEN
    SetRecoveryMode(Mode := COMM^.RecoveryMode);
    myResult := NONE;
ELSIF COMM^.MESSENGER.HasActivError THEN
    SetRecoveryMode(Mode := COMM^.RecoveryMode);
    myResult := NONE;
ELSE
    myResult := SUCCESS;
END_IF

OnError := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{b65c468a-c599-4af9-bafe-bb502871193c}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();

IF (eCommandStatus = INIT) OR (eCommandStatus = ACKNOWLEDGE) OR (eCommandStatus = RUNNING) THEN
    StopMotion();
END_IF
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

IF Comm^.LastTransitionType = eTransitions.Shutdown THEN
	IF Comm^.LastTransitionResult = SUCCESS THEN
		myResult:=SUCCESS;
	END_IF
ELSE
	COMM^.Shutdown();
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnShutdown := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Ready" Id="{86371d66-1578-41a3-b04b-51033c28cb3d}" FolderPath="Generic Status\">
      <Declaration><![CDATA[PROPERTY Ready : BOOL]]></Declaration>
      <Get Name="Get" Id="{6a7426b3-2bd8-4baa-a45a-ec986519b549}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Ready := CanAcceptCommand;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{2c7d1a90-4e33-4b71-9a02-8f1a2b3c4d50}" FolderPath="StateControl\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD PUBLIC Reset : eResult
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := SUPER^.Reset();

// A robot acknowledgement is propagated only to a communication child that is
// itself waiting in ErrorProcessing. It is still only permission to recover.
IF (COMM <> 0) AND (COMM <> ADR(emptyCOMM)) AND (COMM^.State = eState.ErrorProcessing) THEN
    COMM^.Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResolveAbsoluteTarget" Id="{b77bfcd9-1d5b-42ab-9650-d1a07eb2b312}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC ResolveAbsoluteTarget : BOOL
VAR_INPUT
    TargetIn : ST_Pose;
    Frame    : eRefFrame;

    // Transformation of robot BRF expressed in WRF
    T_W_B    : ST_TransformMatrix;

    // Custom user frame expressed in BRF (only used for eRefFrame.CRF).
    T_B_Custom : ST_TransformMatrix;
END_VAR

VAR_OUTPUT
    Target : ST_Pose;
END_VAR

VAR
    T_W_Target : ST_TransformMatrix;
    T_B_Target : ST_TransformMatrix;
    T_B_W      : ST_TransformMatrix;
    T_C_Target : ST_TransformMatrix;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResolveAbsoluteTarget := FALSE;


//--------------------------------------------------
// Resolve absolute Cartesian target into BRF.
// Output is ALWAYS in PLC standard units (m, rad).
//--------------------------------------------------

CASE Frame OF


    eRefFrame.BRF:

        Target := TargetIn;


    eRefFrame.WRF:

        // T_B_Target = inv(T_W_B) * T_W_Target
        T_W_Target := FromPose(Pose := TargetIn);
        T_B_W := Inverse(T := T_W_B);
        T_B_Target := Multiply(A := T_B_W, B := T_W_Target);
        Target := ToPose(T := T_B_Target);


//     eRefFrame.CRF:
// 
//         // Target expressed in custom frame; T_B_Custom is that frame in BRF.
//         // T_B_Target = T_B_Custom * T_C_Target
//         T_C_Target := FromPose(Pose := TargetIn);
//         T_B_Target := Multiply(A := T_B_Custom, B := T_C_Target);
//         Target := ToPose(T := T_B_Target);


    eRefFrame.TRF:

        // Absolute TRF is intentionally undefined; use ResolveRelativeTarget instead.
        RETURN;


    ELSE

        RETURN;

END_CASE


ResolveAbsoluteTarget := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResolveRelativeTarget" Id="{7316aa83-122c-4f87-a413-cdf614e4c220}" FolderPath="Transformations\">
      <Declaration><![CDATA[METHOD PUBLIC ResolveRelativeTarget : BOOL
VAR_INPUT
    Delta      : ST_Pose;		//Offset expressed in the selected Frame
    Frame      : eRefFrame;

   
//     T_B_Custom : ST_TransformMatrix;  // Custom user frame expressed in BRF (only used for eRefFrame.CRF).
END_VAR

VAR_OUTPUT
    Target : ST_Pose;
END_VAR

VAR
    TCurrent    : ST_TransformMatrix;
    TDelta      : ST_TransformMatrix;
    TResult     : ST_TransformMatrix;

    T_W_Current : ST_TransformMatrix;
    T_W_Target  : ST_TransformMatrix;
    T_B_W       : ST_TransformMatrix;

    T_C_B       : ST_TransformMatrix;
    T_C_Current : ST_TransformMatrix;
    T_C_Target  : ST_TransformMatrix;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResolveRelativeTarget := FALSE;


// CurrentTCP is always expected in BRF (PLC standard units).
TCurrent := FromPose(Pose := CurrentTCP);
TDelta   := FromPose(Pose := Delta);


CASE Frame OF


    eRefFrame.BRF:

        // T_B_Target = T_B_Delta * T_B_Current
        TResult := Multiply(A := TDelta, B := TCurrent);


    eRefFrame.WRF:

        // T_W_Current = T_W_B * T_B_Current
        T_W_Current := Multiply(A := T_W_B, B := TCurrent);

        // T_W_Target = T_W_Delta * T_W_Current
        T_W_Target := Multiply(A := TDelta, B := T_W_Current);

        // T_B_Target = inv(T_W_B) * T_W_Target
        T_B_W := Inverse(T := T_W_B);
        TResult := Multiply(A := T_B_W, B := T_W_Target);


    eRefFrame.TRF:

        // Delta in current tool frame: T_B_Target = T_B_Current * T_T_Delta
        TResult := Multiply(A := TCurrent, B := TDelta);

// 
//     eRefFrame.CRF:
// 
//         // Delta expressed in a custom frame given by T_B_Custom.
//         // T_C_Current = inv(T_B_Custom) * T_B_Current
//         // T_C_Target  = T_C_Delta * T_C_Current
//         // T_B_Target  = T_B_Custom * T_C_Target
//         T_C_B := Inverse(T := T_B_Custom);
//         T_C_Current := Multiply(A := T_C_B, B := TCurrent);
//         T_C_Target  := Multiply(A := TDelta, B := T_C_Current);
//         TResult := Multiply(A := T_B_Custom, B := T_C_Target);
// 

    ELSE

        RETURN;

END_CASE


// Result is ALWAYS expressed in BRF, in PLC standard units.
Target := ToPose(T := TResult);


ResolveRelativeTarget := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOperationMode" Id="{a36cbff6-922e-4670-8cae-63446b6e1765}" FolderPath="Generic Control\">
      <Declaration><![CDATA[{warning 'OVERRIDE'}
METHOD SetOperationMode : eResult
VAR_INPUT
    mode : eMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetOperationMode := NONE;
IF State <> eState.Active AND NOT Busy THEN
	HMI_ROB.eModus := mode;
END_IF


// depend on Robot Type //TODO
//check

SetOperationMode:= SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSpeedOverride" Id="{a5e39256-a687-447d-8a2a-a95ea9e40d2e}" FolderPath="Generic Control\">
      <Declaration><![CDATA[{warning 'OVERRIDE'}
METHOD SetSpeedOverride : BOOL
VAR_INPUT
    prozent : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (prozent < 0.001) OR (prozent > 100.0) THEN
    SetSpeedOverride := FALSE;
    RETURN;
END_IF
HMI_ROB._speedOverride := prozent; // depend on Robot Type //TODO
SetSpeedOverride := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Action Name="SETUP_ROB" Id="{a4cb3038-46c5-4081-b870-1e91e16123a5}">
      <Implementation>
        <ST><![CDATA[FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO //fb_init??
	IF pA_Skills[j]<>0 THEN
		pA_Skills[j]^.pOwner:=THIS;
	END_IF
END_FOR

]]></ST>
      </Implementation>
    </Action>
    <Method Name="StopMotion" Id="{2a9ef1f1-bebf-42b7-9028-b416fb72a19e}">
      <Declaration><![CDATA[METHOD PUBLIC StopMotion : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StopMotion := FALSE;

// Communication layer must exist.
IF (COMM = 0) OR (COMM = ADR(emptyCOMM)) THEN
    RETURN;
END_IF

// Functional stop only.
// No safety reset / no safety bypass.
StopMotion := COMM^.StopMotion();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>