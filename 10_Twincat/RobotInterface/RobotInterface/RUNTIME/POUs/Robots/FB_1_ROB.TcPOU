    <Action Name="CYCLIC_ROB" Id="{ebf16c89-c511-406b-9426-1ade99c4f730}">
      <Implementation>
        <ST><![CDATA[CYCLIC_BASE();
COMM.CYCLIC_COMM();


FOR j:= TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO //fb_init??
	IF pA_Skills[j]<>0 THEN
		pA_Skills[j]^.pROB:=THIS;
	END_IF
END_FOR


FOR index := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[index] <> 0 THEN
        pA_Skills[index]^.CYCLIC_SKILL();
    END_IF
END_FOR


PM();



// --------------PROPS------------

//ActualJointPosition: DONE
//ActualJointVelocity DONE
//ActualTCPPosition: DONE
//ActualTCPVelocity: DONE

//InCollision: depend on Robot Type //TODO
//Mode: depend on RobotType	//TODO

//RobotMoving:
bMoving :=
    (ABS(_tcpvel.X)  > fOffset) OR
    (ABS(_tcpvel.Y)  > fOffset) OR
    (ABS(_tcpvel.Z)  > fOffset) OR
    (ABS(_tcpvel.Rx) > fOffset) OR
    (ABS(_tcpvel.Ry) > fOffset) OR
    (ABS(_tcpvel.Rz) > fOffset);
	
//RobotReady
bReady := ((State=eState.Active) AND (NOT Busy));

]]></ST>
      </Implementation>
    </Action>
