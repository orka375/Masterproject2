    <Method Name="SetOperationMode" Id="{a36cbff6-922e-4670-8cae-63446b6e1765}" FolderPath="Generic Control\">
      <Declaration><![CDATA[{warning 'OVERRIDE'}
METHOD SetOperationMode : eResult
VAR_INPUT
    mode : eMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetOperationMode := NONE;
IF State <> eState.Active AND NOT Busy THEN
	eModus := mode;
END_IF


// depend on Robot Type //TODO
//check

SetOperationMode:= SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSpeedOverride" Id="{a5e39256-a687-447d-8a2a-a95ea9e40d2e}" FolderPath="Generic Control\">
      <Declaration><![CDATA[{warning 'OVERRIDE'}
METHOD SetSpeedOverride : BOOL
VAR_INPUT
    prozent : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (prozent < 0.001) OR (prozent > 100.0) THEN
    SetSpeedOverride := FALSE;
    RETURN;
END_IF
_speedOverride := prozent; // depend on Robot Type //TODO
SetSpeedOverride := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>