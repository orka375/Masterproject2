    <Method Name="AllocateCommandID" Id="{4de8c731-a286-4ca0-9f0f-d43282496255}" FolderPath="Command\">
      <Declaration><![CDATA[METHOD PROTECTED AllocateCommandID : UINT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Idcounter >= 65534 THEN
  Idcounter := 1001;
ELSE
	Idcounter := Idcounter + 1;
END_IF

AllocateCommandID := Idcounter;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="CanAcceptCommand" Id="{ecdb9c1a-5dfb-4d8b-9dc8-7992c493eb98}" FolderPath="Command\">
      <Declaration><![CDATA[PROPERTY CanAcceptCommand : BOOL]]></Declaration>
      <Get Name="Get" Id="{5ce2868b-d6c9-486f-9f2d-1ce0bec46b73}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CanAcceptCommand :=
    (State = eState.Active)
    AND NOT RecoveryPending
    AND NOT ((nCommandID <> 0) AND ((eCommandStatus = INIT) OR (eCommandStatus = ACKNOWLEDGE) OR (eCommandStatus = RUNNING)));

IF CanAcceptCommand AND (COMM <> 0) AND (COMM <> ADR(emptyCOMM)) THEN
    CanAcceptCommand := COMM^.CanAcceptCommand;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CancelCommand" Id="{b57e3248-65a9-4f87-b25a-fbc0300c26f8}" FolderPath="Command\">
      <Declaration><![CDATA[METHOD PUBLIC CancelCommand : BOOL
VAR_INPUT
	CommandID : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CancelCommand := FALSE;

// Invalid command ID.
IF (CommandID = 0) OR (CommandID <> nCommandID) THEN
    RETURN;
END_IF

// Already terminal.
IF (CommandState = eProgress.FINALIZED)
    OR (CommandState = eProgress.ABORTED) THEN
    RETURN;
END_IF

// Communication layer must exist.
IF (COMM = 0) OR (COMM = ADR(emptyCOMM)) THEN
    RETURN;
END_IF

// COMM performs the technical cancellation.
IF NOT COMM^.CancelCommand(
    CommandID := CommandID
) THEN
    RETURN;
END_IF

// Generic command lifecycle.
eCommandStatus := eProgress.ABORTED;
eCommandResult := eResult.FAILURE;

// Allow the concrete robot to clear adapter-specific tracking.
OnCommandCancelled(
    CommandID := CommandID
);

CancelCommand := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CommandHandler" Id="{83e2d403-4d26-4906-9c94-3843f0c8311a}" FolderPath="Command\">
      <Declaration><![CDATA[{warning 'Override with your own Method in final FB'}
METHOD CommandHandler : UINT
VAR_INPUT
    Cmd      : eBA;
    Settings : stBA_Settings;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Base implementation: unsupported. Final robot FB overrides this method. *)
CommandHandler := 0;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="CommandID" Id="{d97dbde2-fb4a-4a46-80b5-95e72bfb597d}" FolderPath="Command\">
      <Declaration><![CDATA[PROPERTY CommandID : UINT]]></Declaration>
      <Get Name="Get" Id="{f42bf0bc-af24-437d-951f-342952505cbf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CommandID := nCommandID;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CommandResult" Id="{2743123b-b65d-4f7b-9069-9ec61dd72659}" FolderPath="Command\">
      <Declaration><![CDATA[PROPERTY CommandResult : eResult]]></Declaration>
      <Get Name="Get" Id="{9324d1a7-b98e-458b-8e19-2f6253d717cd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CommandResult := eCommandResult;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CommandState" Id="{6c07ca32-53d2-4833-85fe-587d61a168d6}" FolderPath="Command\">
      <Declaration><![CDATA[PROPERTY CommandState : eProgress]]></Declaration>
      <Get Name="Get" Id="{f225aadd-c904-4018-87ed-75348f6fbad4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CommandState := eCommandStatus;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Action Name="CYCLIC_ROB" Id="{ebf16c89-c511-406b-9426-1ade99c4f730}">
      <Implementation>
        <ST><![CDATA[IF NOT _INIT_ROB THEN
	_INIT_ROB:=TRUE;
	SETUP_ROB();
END_IF

CYCLIC_BASE();
PM.HMI_PM.xCurrentTcp := ActualTcpPose;
PM(pRobot := THIS);



// HMI display mirrors: native _tcppos/_jointpos stay in PLC standard (m/rad); display in mm/deg.
HMI_ROB._tcppos_display := ChangePoseToHMIStandard(Pose := HMI_ROB._tcppos);

HMI_ROB._jointpos_display.joint1 := ChangeRealToHMIStandard(
    Value := HMI_ROB._jointpos.joint1, Category := eUnitCategory.Joint);
HMI_ROB._jointpos_display.joint2 := ChangeRealToHMIStandard(
    Value := HMI_ROB._jointpos.joint2, Category := eUnitCategory.Joint);
HMI_ROB._jointpos_display.joint3 := ChangeRealToHMIStandard(
    Value := HMI_ROB._jointpos.joint3, Category := eUnitCategory.Joint);
HMI_ROB._jointpos_display.joint4 := ChangeRealToHMIStandard(
    Value := HMI_ROB._jointpos.joint4, Category := eUnitCategory.Joint);
HMI_ROB._jointpos_display.joint5 := ChangeRealToHMIStandard(
    Value := HMI_ROB._jointpos.joint5, Category := eUnitCategory.Joint);
HMI_ROB._jointpos_display.joint6 := ChangeRealToHMIStandard(
    Value := HMI_ROB._jointpos.joint6, Category := eUnitCategory.Joint);

// Adopt communication faults + health so the robot reflects its comm child.
IF COMM <> 0 AND COMM <> ADR(emptyCOMM) THEN
  COMM^.MESSENGER.ParentMessenger := ADR(MESSENGER);
	IF COMM^.State = eState.ErrorProcessing OR COMM^.MESSENGER.HasActivError THEN
        SetRecoveryMode(Mode := COMM^.RecoveryMode);
		Messenger.AddError(eMessageCategories.ParentFailed,Path,'Communication module in error');
	ELSE
		Messenger.Clear(Path,'Communication module in error');
	END_IF
	HMI_BASE.MyHealth := ProposeHealth(HMI_BASE.MyHealth, COMM^.HMI_BASE.MyHealth);
END_IF




FOR index := TO_INT(LOWER_BOUND(pA_Skills, 1)) TO TO_INT(UPPER_BOUND(pA_Skills, 1)) DO
    IF pA_Skills[index] <> 0 THEN
        pA_Skills[index]^.CYCLIC_SKILL();
    END_IF
END_FOR






// --------------PROPS------------

//ActualJointPosition: DONE
//ActualJointVelocity DONE
//ActualTCPPosition: DONE
//ActualTCPVelocity: DONE
//InCollision: depend on Robot Type //TODO
//Mode: depend on RobotType	//TODO

//RobotMoving:
HMI_ROB.bMoving :=
    (ABS(_tcpvel.X)  > StandStillLimit) OR
    (ABS(_tcpvel.Y)  > StandStillLimit) OR
    (ABS(_tcpvel.Z)  > StandStillLimit) OR
    (ABS(_tcpvel.roll) > StandStillLimit) OR
    (ABS(_tcpvel.pitch) > StandStillLimit) OR
    (ABS(_tcpvel.yaw) > StandStillLimit);
	
// Generic robot command contributes to FB_0_Base.Busy. Terminal command values remain latched,
// therefore only non-terminal phases make the robot busy.
HMI_BASE.bBusy := (nCommandID <> 0)
    AND ((eCommandStatus = INIT) OR (eCommandStatus = ACKNOWLEDGE) OR (eCommandStatus = RUNNING));

// Ready means: the robot can accept a NEW semantic command now.
HMI_ROB.bReady := CanAcceptCommand;

]]></ST>
      </Implementation>
    </Action>
    <Method Name="EStop" Id="{ff1c583d-626a-4142-b727-591a7a8cf9e6}" FolderPath="Generic Control\">
      <Declaration><![CDATA[{warning 'OVERRIDE'}
METHOD EStop : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[HMI_ROB.bEStop := TRUE; //depend on Robot Type //TODO
EStop := FALSE;

IF (COMM = 0) OR (COMM = ADR(emptyCOMM)) THEN
    RETURN;
END_IF

EStop := COMM^.EStop();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{7b302bc2-af12-4e54-8aa2-dca07a2dd5cc}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
  VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
  END_VAR
  VAR
    iRobot : UINT;
  END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.FB_Init(bInitRetains := bInitRetains, bInCopyCode := bInCopyCode);

CurrentTCP REF= HMI_ROB._tcppos;
T_W_B := FromPose(Installationpose);

IF NOT RegisterAsTopLevelRobot THEN
	FB_Init := TRUE;
	RETURN;
END_IF

FOR iRobot := 1 TO SETUP.nRobCount DO
	IF SETUP.apRobot[iRobot] = THIS THEN
		FB_Init := TRUE;
		RETURN;
	END_IF
END_FOR

IF SETUP.nRobCount < SETUP.MaxNrofRobots THEN
	SETUP.nRobCount := SETUP.nRobCount + 1;
	SETUP.apRobot[SETUP.nRobCount] := THIS;
	FB_Init := TRUE;
END_IF





]]></ST>
      </Implementation>
    </Method>
    <Property Name="InSavePosition" Id="{0b1ac6ae-f2f1-4986-8684-c6891da4f895}" FolderPath="Generic Status\">
      <Declaration><![CDATA[PROPERTY InSavePosition : BOOL]]></Declaration>
      <Get Name="Get" Id="{f07a4056-55e2-4a4d-b3fa-f23e3592a78e}">
        <Declaration><![CDATA[VAR
    joints : stJoint6;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[joints := ActualJointPosition;

InSavePosition :=
    (ABS(joints.joint1 - SafePosition.joint1) <= SafePositionTolerance) AND
    (ABS(joints.joint2 - SafePosition.joint2) <= SafePositionTolerance) AND
    (ABS(joints.joint3 - SafePosition.joint3) <= SafePositionTolerance) AND
    (ABS(joints.joint4 - SafePosition.joint4) <= SafePositionTolerance) AND
    (ABS(joints.joint5 - SafePosition.joint5) <= SafePositionTolerance) AND
    (ABS(joints.joint6 - SafePosition.joint6) <= SafePositionTolerance);]]></ST>
        </Implementation>
      </Get>
    </Property>
