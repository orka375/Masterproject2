<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_1_ROB" Id="{7ce28b50-28f8-4d4c-bb25-1006bf064637}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_1_ROB EXTENDS FB_0_Base 
// IMPLEMENTS ITF_1_Robot

VAR_INPUT
	PM: FB_PointManager;
	COMM: POINTER TO FB_1_CommunicationModul := ADR(emptyCOMM);

	StandStillLimit: REAL := 0.001;
	SafePosition: stJoint6;
	SafePositionTolerance: LREAL := 0.001;
	RegisterAsTopLevelRobot: BOOL := TRUE;
	

	InstallationPose : ST_Pose; // BRF expressed in WRF : stVector3d
END_VAR


VAR_OUTPUT
	HMI_ROB: stHMI_ROB;

	nCommandID: UINT;
	eCommandStatus: eProgress;
	eCommandResult: eResult := NONE;
	
	 _jointvel: stJoint6;
     _tcpvel : ST_Pose;
END_VAR

VAR
	CurrentTCP : REFERENCE TO ST_Pose;		//Set Reference in ROB fb_Init
    T_W_B      : ST_TransformMatrix;		//Set in fb_Init
	index: INT;
	
	//BAHANDLER
	Idcounter: UINT:=1000;

	// Native unit standard of THIS robot. Subclasses overwrite in their declaration/FB_Init.
	// Base default = PLC standard so generic conversions are a no-op if not overridden.
	StandardUnits : ST_StandardUnits := (
		Position            := eUnit.m,
		Orientation         := eUnit.rad,
		Joint               := eUnit.rad,
		LinearVelocity      := eUnit.m,
		AngularVelocity     := eUnit.rad,
		JointVelocity       := eUnit.rad,
		LinearAcceleration  := eUnit.m,
		AngularAcceleration := eUnit.rad,
		JointAcceleration   := eUnit.rad
	);
	
	_INIT_ROB: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Command" Id="{dbd57985-4d16-4bc8-859d-d7e9147003e9}" />
    <Folder Name="Generic Control" Id="{d269719e-4481-455b-8abd-a0a346547cd3}" />
    <Folder Name="Generic Status" Id="{c1e8e35a-1828-4d72-a2cb-3aa1cc7ab721}" />
