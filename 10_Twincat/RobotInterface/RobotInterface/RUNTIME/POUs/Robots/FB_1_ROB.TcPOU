  <POU Name="FB_1_ROB" Id="{7ce28b50-28f8-4d4c-bb25-1006bf064637}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_1_ROB EXTENDS FB_0_Base 
// IMPLEMENTS ITF_1_Robot

VAR_INPUT
	PM: FB_PointManager;
	COMM: FB_1_CommunicationModul;
	fOffset: REAL := 0.1;
	
// 	FILESERVER: FB_FileServer;
END_VAR


VAR_OUTPUT
	BA_ID: UINT;
	BA_STATUS: eProgress;
    bReady : BOOL;
    bMoving : BOOL;
   	bEStop : BOOL;
    bInCollision : BOOL;
    eModus : eMode;
    
END_VAR

VAR
	_tcppos, _tcpvel : stPoseGeneral;
	_jointpos, _jointvel: stJoint6;
	_speedOverride : LREAL := 100.0;
	index: INT;
	
	//BAHANDLER
	Idcounter: UINT:=1000;
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
