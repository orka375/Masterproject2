<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="ROBOT_MECA500" Id="{c3aebb32-8fd7-4db3-b325-72217b951a63}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ROBOT_MECA500 EXTENDS FB_2_ROB_MANIP

VAR_INPUT
    MECA_COMM : FB_2_COMM_MECA;
END_VAR

VAR
	configure_process: INT;
	_mecaRawPose      : ST_Pose;
	_mecaFeedbackPose : ST_Pose;
	_mecaRPY          : ST_Pose;

    // Completion monitor for discrete BA motions.
    // No checkpoint is inserted automatically; this keeps jogging responsive.
    nTrackedMoveId      : UINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Skills Pointer
SETUP.R2_PP.pRob:=THIS;


// Meca500 native units: mm / deg / mm-s^-1 / deg-s^-1 / mm-s^-2 / deg-s^-2.
StandardUnits.Position            := eUnit.mm;
StandardUnits.Orientation         := eUnit.deg;
StandardUnits.Joint               := eUnit.deg;
StandardUnits.LinearVelocity      := eUnit.mm;
StandardUnits.AngularVelocity     := eUnit.deg;
StandardUnits.JointVelocity       := eUnit.deg;
StandardUnits.LinearAcceleration  := eUnit.mm;
StandardUnits.AngularAcceleration := eUnit.deg;
StandardUnits.JointAcceleration   := eUnit.deg;

COMM := ADR(MECA_COMM);
MECA_COMM.CYCLIC_COMM_MECA();

// Controller/safety-related conditions are not silently recovered. A physical
// stop/collision requires the cause to be removed and a fresh acknowledgement.
IF MECA_COMM.bInEStop OR MECA_COMM.bInPStop2 OR MECA_COMM.bInCollision THEN
    SetRecoveryMode(Mode := eRecoveryMode.ManualActionRequired);
    Messenger.AddError(eMessageCategories.HardwareFailure, Name,
        'Meca physical/protective stop condition active');
ELSIF MECA_COMM.nInErrorCode <> 0 THEN
    SetRecoveryMode(Mode := eRecoveryMode.AcknowledgeRequired);
    Messenger.AddError(eMessageCategories.HardwareFailure, Name,
        'Meca controller error requires acknowledgement');
ELSE
    Messenger.Clear(Name, 'Meca physical/protective stop condition active');
    Messenger.Clear(Name, 'Meca controller error requires acknowledgement');
END_IF

// Map the adapter-independent COMM lifecycle to the robot lifecycle.
// The robot owns the semantic ID; COMM owns transport/ack/running/done detection.
IF (nTrackedMoveId <> 0) AND (eCommandStatus <> FINALIZED) AND (eCommandStatus <> ABORTED) THEN
    eCommandStatus := MECA_COMM.CommandState;
    eCommandResult := MECA_COMM.CommandResult;

    IF (eCommandStatus = FINALIZED) OR (eCommandStatus = ABORTED) THEN
        nTrackedMoveId := 0;
    END_IF
END_IF

// Joint feedback: deg -> rad through central helper.
HMI_ROB._jointpos.joint1 := ChangeRealFromRobotStandard(
    Value := REAL_TO_LREAL(MECA_COMM.rInJoint1), Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
HMI_ROB._jointpos.joint2 := ChangeRealFromRobotStandard(
    Value := REAL_TO_LREAL(MECA_COMM.rInJoint2), Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
HMI_ROB._jointpos.joint3 := ChangeRealFromRobotStandard(
    Value := REAL_TO_LREAL(MECA_COMM.rInJoint3), Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
HMI_ROB._jointpos.joint4 := ChangeRealFromRobotStandard(
    Value := REAL_TO_LREAL(MECA_COMM.rInJoint4), Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
HMI_ROB._jointpos.joint5 := ChangeRealFromRobotStandard(
    Value := REAL_TO_LREAL(MECA_COMM.rInJoint5), Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
HMI_ROB._jointpos.joint6 := ChangeRealFromRobotStandard(
    Value := REAL_TO_LREAL(MECA_COMM.rInJoint6), Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);

// TCP feedback: MECA native (mm, deg, MECA Euler) -> PLC standard (m, rad, RPY).
_mecaRawPose.x    := REAL_TO_LREAL(MECA_COMM.rInTcpX);
_mecaRawPose.y    := REAL_TO_LREAL(MECA_COMM.rInTcpY);
_mecaRawPose.z    := REAL_TO_LREAL(MECA_COMM.rInTcpZ);
_mecaRawPose.roll := REAL_TO_LREAL(MECA_COMM.rInTcpRx);
_mecaRawPose.pitch:= REAL_TO_LREAL(MECA_COMM.rInTcpRy);
_mecaRawPose.yaw  := REAL_TO_LREAL(MECA_COMM.rInTcpRz);

// Unit conversion first (mm/deg -> m/rad), then representation (MECA Euler -> RPY).
_mecaFeedbackPose := ChangePoseFromRobotStandard(
    Pose := _mecaRawPose, RobotStandardUnits := StandardUnits);

_mecaRPY := MECAEulerToRPY(
    ex := _mecaFeedbackPose.roll,
    ey := _mecaFeedbackPose.pitch,
    ez := _mecaFeedbackPose.yaw);

HMI_ROB._tcppos.x     := _mecaFeedbackPose.x;
HMI_ROB._tcppos.y     := _mecaFeedbackPose.y;
HMI_ROB._tcppos.z     := _mecaFeedbackPose.z;
HMI_ROB._tcppos.roll  := _mecaRPY.roll;
HMI_ROB._tcppos.pitch := _mecaRPY.pitch;
HMI_ROB._tcppos.yaw   := _mecaRPY.yaw;

HMI_ROB.bEStop := MECA_COMM.bInEStop;
HMI_ROB.bInCollision := MECA_COMM.bInCollision;
HMI_ROB.bReady := MECA_COMM.HMI_COMM._CommunicationReady
    AND MECA_COMM.bInActivated
    AND MECA_COMM.bInHomed
    AND NOT MECA_COMM.bInPaused
    AND (MECA_COMM.nInErrorCode = 0)
    AND NOT MECA_COMM.bInBusy;

CYCLIC_MANIP();
]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{dc5e676b-6d2e-4f78-98e2-7555bc30d8c3}" />
    <Folder Name="Transformations" Id="{8e8b8b58-e61e-4756-891b-bcb478f79745}" />
    <Method Name="CommandHandler" Id="{6b7375b8-b338-41ba-b16d-a1e5607dd647}">
      <Declaration><![CDATA[METHOD CommandHandler : UINT
VAR_INPUT
    Cmd : eBA;
    Settings : stBA_Settings;
END_VAR
VAR
    nCommand : UDINT;
    rArgument1 : REAL;
    rArgument2 : REAL;
    rArgument3 : REAL;
    rArgument4 : REAL;
    rArgument5 : REAL;
    rArgument6 : REAL;
    NewCommandID : UINT;
    MECAEuler : ST_Pose;
    NativePose : ST_Pose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CommandHandler := 0;

IF NOT CanAcceptCommand THEN
    RETURN;
END_IF
    nCommand := 0;

    IF (nTrackedMoveId <> 0) AND (eCommandStatus <> FINALIZED) AND (eCommandStatus <> ABORTED) THEN
        RETURN;
    END_IF

CASE Cmd OF
    eBA.MoveJ:
        IF Settings.Target.frame_id <> eRefFrame.BRF THEN
            RETURN;
        END_IF
        nCommand := 2;
        // Representation: generic RPY -> MECA Euler (currently pass-through).
        MECAEuler := RPYToMECAEuler(
            roll := Settings.Target.pose.roll,
            pitch := Settings.Target.pose.pitch,
            yaw := Settings.Target.pose.yaw);
        NativePose.x := Settings.Target.pose.x;
        NativePose.y := Settings.Target.pose.y;
        NativePose.z := Settings.Target.pose.z;
        NativePose.roll  := MECAEuler.roll;
        NativePose.pitch := MECAEuler.pitch;
        NativePose.yaw   := MECAEuler.yaw;
        // Units: PLC standard -> MECA native (mm, deg).
        NativePose := ChangePoseToRobotStandard(
            Pose := NativePose,
            RobotStandardUnits := StandardUnits);
        rArgument1 := LREAL_TO_REAL(NativePose.x);
        rArgument2 := LREAL_TO_REAL(NativePose.y);
        rArgument3 := LREAL_TO_REAL(NativePose.z);
        rArgument4 := LREAL_TO_REAL(NativePose.roll);
        rArgument5 := LREAL_TO_REAL(NativePose.pitch);
        rArgument6 := LREAL_TO_REAL(NativePose.yaw);

    eBA.MoveL:
        IF Settings.Target.frame_id <> eRefFrame.BRF THEN
            RETURN;
        END_IF
        nCommand := 3;
        MECAEuler := RPYToMECAEuler(
            roll := Settings.Target.pose.roll,
            pitch := Settings.Target.pose.pitch,
            yaw := Settings.Target.pose.yaw);
        NativePose.x := Settings.Target.pose.x;
        NativePose.y := Settings.Target.pose.y;
        NativePose.z := Settings.Target.pose.z;
        NativePose.roll  := MECAEuler.roll;
        NativePose.pitch := MECAEuler.pitch;
        NativePose.yaw   := MECAEuler.yaw;
        NativePose := ChangePoseToRobotStandard(
            Pose := NativePose,
            RobotStandardUnits := StandardUnits);
        rArgument1 := LREAL_TO_REAL(NativePose.x);
        rArgument2 := LREAL_TO_REAL(NativePose.y);
        rArgument3 := LREAL_TO_REAL(NativePose.z);
        rArgument4 := LREAL_TO_REAL(NativePose.roll);
        rArgument5 := LREAL_TO_REAL(NativePose.pitch);
        rArgument6 := LREAL_TO_REAL(NativePose.yaw);

    eBA.MoveJJoints:
        nCommand := 1;
        rArgument1 := LREAL_TO_REAL(ChangeRealToRobotStandard(
            Value := Settings.Joints.joint1, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits));
        rArgument2 := LREAL_TO_REAL(ChangeRealToRobotStandard(
            Value := Settings.Joints.joint2, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits));
        rArgument3 := LREAL_TO_REAL(ChangeRealToRobotStandard(
            Value := Settings.Joints.joint3, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits));
        rArgument4 := LREAL_TO_REAL(ChangeRealToRobotStandard(
            Value := Settings.Joints.joint4, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits));
        rArgument5 := LREAL_TO_REAL(ChangeRealToRobotStandard(
            Value := Settings.Joints.joint5, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits));
        rArgument6 := LREAL_TO_REAL(ChangeRealToRobotStandard(
            Value := Settings.Joints.joint6, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits));

    eBA.Home:
        IF NOT MECA_COMM.CommunicationReady
            OR NOT MECA_COMM.bInActivated
            OR MECA_COMM.bInPaused
            OR MECA_COMM.bInBusy
            OR (MECA_COMM.nInErrorCode <> 0)
            OR MECA_COMM.bInHomed THEN
            RETURN;
        END_IF

        NewCommandID := AllocateCommandID();
        IF NOT MECA_COMM.SendHome(CommandID := NewCommandID) THEN
            RETURN;
        END_IF

        nCommandID := NewCommandID;
        eCommandStatus := INIT;
        eCommandResult := NONE;
        nTrackedMoveId := NewCommandID;
        CommandHandler := NewCommandID;
        RETURN;
	
	
    ELSE
        RETURN;
END_CASE

NewCommandID := AllocateCommandID();
IF NOT MECA_COMM.SendCommand(
    CommandID := NewCommandID,
    nCommand := nCommand,
    rArgument1 := rArgument1,
    rArgument2 := rArgument2,
    rArgument3 := rArgument3,
    rArgument4 := rArgument4,
    rArgument5 := rArgument5,
    rArgument6 := rArgument6
) THEN
    RETURN;
END_IF

nCommandID := NewCommandID;
eCommandStatus := INIT;
eCommandResult := NONE;
nTrackedMoveId := NewCommandID;
CommandHandler := NewCommandID;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="MECAEulerToRPY" Id="{8d0654bd-b80c-447b-87ad-4760774a7534}" FolderPath="Transformations\">
      <Declaration><![CDATA[// TODO verify Meca500 Euler convention. Pass-through until confirmed against manufacturer docs.
METHOD PUBLIC MECAEulerToRPY : ST_Pose
VAR_INPUT
    ex : LREAL;
    ey : LREAL;
    ez : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MECAEulerToRPY.x := 0.0;
MECAEulerToRPY.y := 0.0;
MECAEulerToRPY.z := 0.0;
MECAEulerToRPY.roll  := ex;
MECAEulerToRPY.pitch := ey;
MECAEulerToRPY.yaw   := ez;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnActivate" Id="{b364b99e-dbf0-4040-8423-a20fd6a66988}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

IF NOT MECA_COMM.bInActivated THEN
    MECA_COMM.RequestActivate();
ELSE
    myResult := SUCCESS;
END_IF


// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{f660392d-3a49-4302-94ef-fdc40b7fa7a3}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnCleanup();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

myResult := SUCCESS;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnCleanup := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCommandCancelled" Id="{13e8209e-5c45-4452-9213-b3ab26f73c2a}">
      <Declaration><![CDATA[METHOD PROTECTED OnCommandCancelled
VAR_INPUT
    CommandID : UINT;
END_VAR

// Default: nothing to do.
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nTrackedMoveId := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{0feda703-7699-45f8-8f76-44c854c951e2}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------



IF configure_process=0 THEN
	MECA_COMM.bOutActivate:=TRUE;

	IF MECA_COMM.bInActivated THEN
		configure_process:=1;
		MECA_COMM.bOutActivate:=FALSE;
	END_IF
END_IF

IF configure_process=1 THEN
	MECA_COMM.bOutHome:=TRUE;

	IF MECA_COMM.bInHomed THEN
		configure_process:=2;
		MECA_COMM.bOutHome:=FALSE;
	END_IF
END_IF

IF configure_process=2 THEN
	MECA_COMM.bOutDeactivate:=TRUE;

	IF NOT MECA_COMM.bInActivated THEN
		configure_process:=0;
		MECA_COMM.bOutDeactivate:=FALSE;
		myResult:=SUCCESS;
	END_IF
END_IF


// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnConfigure := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{30cb0293-fc7f-4cd5-adf7-0ee993d71213}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnDeactivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

IF MECA_COMM.bInActivated THEN
    MECA_COMM.RequestDeactivate();
ELSE
    myResult := SUCCESS;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{261bad01-0f06-46db-9176-4060c0d897de}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();
myResult := NONE;

// Keep Robot result ABORTED/ERROR from FB_1_ROB, but cancel the concrete COMM job
// so transport recovery never waits on an interrupted motion indefinitely.
IF nTrackedMoveId <> 0 THEN
    MECA_COMM.CancelCommand(CommandID := nTrackedMoveId);
    nTrackedMoveId := 0;
END_IF

IF MECA_COMM.bInEStop OR MECA_COMM.bInPStop2 OR MECA_COMM.bInCollision THEN
    SetRecoveryMode(Mode := eRecoveryMode.ManualActionRequired);
    // A reset while the physical condition still exists must not remain latched.
    RequireNewAcknowledgement();

ELSIF MECA_COMM.nInErrorCode <> 0 THEN
    // The user has authorized recovery. Reset the controller error only now.
    IF MECA_COMM.bInResetReady THEN
        MECA_COMM.ResetError();
    END_IF

ELSE
    nTrackedMoveId := 0;
    configure_process := 0;
    IF NOT MECA_COMM.CommandBusy THEN
        myResult := SUCCESS;
    END_IF
END_IF

OnError := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{075e8a25-3518-4a19-a48c-95cb7b6d607e}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

    VAR
    	eParentResult: eResult;
    	myResult: ERESULT;
    END_VAR

    VAR //YOUR CODE
    	succ : BOOL;
    END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();
myResult := NONE;

// Best effort: stop motion first, then request controller deactivation. Communication
// shutdown is coordinated by FB_1_ROB through the generic COMM child.
StopMotion();

IF MECA_COMM.bInActivated THEN
    MECA_COMM.RequestDeactivate();
ELSE
    myResult := SUCCESS;
END_IF

OnShutdown := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RPYToMECAEuler" Id="{ffda5a15-9305-4ff9-98bb-020166ec8fd0}" FolderPath="Transformations\">
      <Declaration><![CDATA[// TODO verify Meca500 Euler convention. Pass-through until confirmed against manufacturer docs.
METHOD PUBLIC RPYToMECAEuler : ST_Pose
VAR_INPUT
    roll  : LREAL;
    pitch : LREAL;
    yaw   : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RPYToMECAEuler.x := 0.0;
RPYToMECAEuler.y := 0.0;
RPYToMECAEuler.z := 0.0;
RPYToMECAEuler.roll  := roll;
RPYToMECAEuler.pitch := pitch;
RPYToMECAEuler.yaw   := yaw;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>