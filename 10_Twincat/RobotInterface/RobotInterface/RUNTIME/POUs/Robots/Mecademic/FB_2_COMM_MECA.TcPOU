<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_2_COMM_MECA" Id="{1bdf4dfd-4ef8-47df-b08c-596707625c3d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_2_COMM_MECA EXTENDS FB_1_CommunicationModul
VAR_OUTPUT
    bInProcessDataValid AT %I*: BOOL := TRUE; //NOT CONNECTED
    bInBusy AT %I*: BOOL;
    bInActivated AT %I*: BOOL;
    bInHomed AT %I*: BOOL;
    bInCollision AT %I*: BOOL;
    bInWorkZone AT %I*: BOOL;
    bInMonitoringMode AT %I*: BOOL;
    nInErrorCode AT %I*: UINT;
    nInCheckpointReached AT %I*: UINT;
    nInCheckpointDiscarded AT %I*: UINT;
    nInMoveId AT %I*: UINT;
    nInFifoSpace AT %I*: UINT;
    bInPaused AT %I*: BOOL;
    bInEob AT %I*: BOOL;
    bInEom AT %I*: BOOL;
    bInCleared AT %I*: BOOL;
    bInExcessiveTorque AT %I*: BOOL;
    rInJoint1 AT %I*: REAL;
    rInJoint2 AT %I*: REAL;
    rInJoint3 AT %I*: REAL;
    rInJoint4 AT %I*: REAL;
    rInJoint5 AT %I*: REAL;
    rInJoint6 AT %I*: REAL;
    rInTcpX AT %I*: REAL;
    rInTcpY AT %I*: REAL;
    rInTcpZ AT %I*: REAL;
    rInTcpRx AT %I*: REAL;
    rInTcpRy AT %I*: REAL;
    rInTcpRz AT %I*: REAL;
    bInEStop AT %I*: BOOL;
    bInPStop2 AT %I*: BOOL;
    bInConnectionDropped AT %I*: BOOL;
    bInResetReady AT %I*: BOOL;
    bInVMotorOn AT %I*: BOOL;
    nInDynamicType0 AT %I*: UDINT;
    nInDynamicType1 AT %I*: UDINT;
    nInDynamicType2 AT %I*: UDINT;
    nInDynamicType3 AT %I*: UDINT;
END_VAR
VAR_INPUT
    bOutDeactivate AT %Q*: BOOL;
    bOutActivate AT %Q*: BOOL;
    bOutHome AT %Q*: BOOL;
    bOutResetError AT %Q*: BOOL;
    bOutSimMode AT %Q*: BOOL;
    bOutRecoveryMode AT %Q*: BOOL;
    bOutDisableEtherCAT AT %Q*: BOOL;
    nOutMoveId AT %Q*: UINT;
    bOutSetPoint AT %Q*: BOOL;
    bOutPause AT %Q*: BOOL;
    bOutClearMove AT %Q*: BOOL;
    bOutResume AT %Q*: BOOL;
    bOutUseVariables AT %Q*: BOOL;
    nOutMotionCommand AT %Q*: UDINT;
    rOutArgument1 AT %Q*: REAL;
    rOutArgument2 AT %Q*: REAL;
    rOutArgument3 AT %Q*: REAL;
    rOutArgument4 AT %Q*: REAL;
    rOutArgument5 AT %Q*: REAL;
    rOutArgument6 AT %Q*: REAL;
    nOutHostTime AT %Q*: UDINT;
    bOutBrakesControlAllowed AT %Q*: BOOL;
    bOutBrakesEngaged AT %Q*: BOOL;
    nOutDynamicType0 AT %Q*: UDINT := 42;
    nOutDynamicType1 AT %Q*: UDINT := 44;
    nOutDynamicType2 AT %Q*: UDINT := 40;
    nOutDynamicType3 AT %Q*: UDINT := 41;
END_VAR
VAR
    bFeedbackValid : BOOL;
    bDynamicDataValid : BOOL;
    bCommandPending : BOOL;
    bCommandAccepted : BOOL;
    bRequestDeactivate : BOOL;
    bRequestActivate : BOOL;
    bRequestHome : BOOL;
    bRequestResetError : BOOL;
    bRequestPause : BOOL;
    bRequestClearMove : BOOL;
    bRequestResume : BOOL;
    nPendingMoveId : UINT;
    nPendingCommand : UDINT;
    rPendingArgument1 : REAL;
    rPendingArgument2 : REAL;
    rPendingArgument3 : REAL;
    rPendingArgument4 : REAL;
    rPendingArgument5 : REAL;
    rPendingArgument6 : REAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="AcceptedMoveID" Id="{cd29aabe-d41b-4539-8287-763315ddb793}">
      <Declaration><![CDATA[PROPERTY AcceptedMoveID : UINT]]></Declaration>
      <Get Name="Get" Id="{366c6523-6181-4830-852e-c50a632f7dd2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[AcceptedMoveID := AcceptedCommandID;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AcceptedCommandID" Id="{c0130030-627a-4279-9d72-c026a40ed59d}">
      <Declaration><![CDATA[PROPERTY AcceptedCommandID : UINT]]></Declaration>
      <Get Name="Get" Id="{64e919e5-0c8d-42f6-b3b6-7a72863b4fd1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[AcceptedCommandID := nInMoveId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ActiveCommandID" Id="{75d7614c-4eeb-466f-830b-54dd42a7be56}">
      <Declaration><![CDATA[PROPERTY ActiveCommandID : UINT]]></Declaration>
      <Get Name="Get" Id="{02f18ead-bc92-43b4-832e-b4ac776227bd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF bInBusy OR NOT bInEom THEN
    ActiveCommandID := nInMoveId;
ELSE
    ActiveCommandID := 0;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CanAcceptCommand" Id="{d54d0d39-e639-4357-855e-b93132e6f045}">
      <Declaration><![CDATA[PROPERTY CanAcceptCommand : BOOL]]></Declaration>
      <Get Name="Get" Id="{91be3ccb-9a5b-4fc6-89ca-5937333760c9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CanAcceptCommand := CommunicationReady AND NOT bCommandPending AND (nInFifoSpace > 0);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ClearMotion" Id="{4e27c0e3-b74a-440c-bebc-156c0921230b}">
      <Declaration><![CDATA[METHOD ClearMotion : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestClearMove := TRUE;
ClearMotion := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="CommandBusy" Id="{15b9b354-bf2f-4af8-b059-ee2daf68e421}">
      <Declaration><![CDATA[PROPERTY CommandBusy : BOOL]]></Declaration>
      <Get Name="Get" Id="{bb36b79d-9311-432a-8bd6-acd21b5d3b67}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[CommandBusy := bCommandPending OR bInBusy OR NOT bInEom;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Action Name="CYCLIC_COMM_MECA" Id="{d47624df-4e5c-4e1a-b885-310e1f830615}">
      <Implementation>
        <ST><![CDATA[CYCLIC_COMM();

bFeedbackValid := bInProcessDataValid AND NOT bInConnectionDropped;
bDynamicDataValid :=
    (nInDynamicType0 = nOutDynamicType0) OR
    (nInDynamicType1 = nOutDynamicType1) OR
    (nInDynamicType2 = nOutDynamicType2) OR
    (nInDynamicType3 = nOutDynamicType3);

HMI_COMM._CommunicationConnected := bFeedbackValid;
HMI_COMM._CommunicationReady := bFeedbackValid AND bDynamicDataValid AND NOT bInMonitoringMode;

bOutDisableEtherCAT := FALSE;
bOutBrakesControlAllowed := FALSE;
bOutBrakesEngaged := FALSE;
bOutDeactivate := bRequestDeactivate;
bOutActivate := bRequestActivate;
bOutHome := bRequestHome;
bOutResetError := bRequestResetError;
bOutPause := bRequestPause;
bOutClearMove := bRequestClearMove;
bOutResume := bRequestResume;

IF bRequestActivate AND bInActivated THEN
    bRequestActivate := FALSE;
END_IF
IF bRequestDeactivate AND NOT bInActivated AND NOT bInBusy THEN
    bRequestDeactivate := FALSE;
END_IF
IF bRequestHome AND bInHomed THEN
    bRequestHome := FALSE;
END_IF
IF bRequestResetError AND (nInErrorCode = 0) THEN
    bRequestResetError := FALSE;
END_IF
IF bRequestPause AND bInPaused THEN
    bRequestPause := FALSE;
END_IF
IF bRequestClearMove AND bInCleared THEN
    bRequestClearMove := FALSE;
END_IF
IF bRequestResume AND NOT bInPaused THEN
    bRequestResume := FALSE;
END_IF

IF NOT bCommandPending THEN
    bOutSetPoint := FALSE;
    nOutMoveId := 0;
    nOutMotionCommand := 0;
    rOutArgument1 := 0.0;
    rOutArgument2 := 0.0;
    rOutArgument3 := 0.0;
    rOutArgument4 := 0.0;
    rOutArgument5 := 0.0;
    rOutArgument6 := 0.0;
ELSE
    bOutSetPoint := TRUE;
    nOutMoveId := nPendingMoveId;
    nOutMotionCommand := nPendingCommand;
    rOutArgument1 := rPendingArgument1;
    rOutArgument2 := rPendingArgument2;
    rOutArgument3 := rPendingArgument3;
    rOutArgument4 := rPendingArgument4;
    rOutArgument5 := rPendingArgument5;
    rOutArgument6 := rPendingArgument6;

    IF nInMoveId = nPendingMoveId THEN
        bCommandPending := FALSE;
        bCommandAccepted := TRUE;
    END_IF
	
	
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="Home" Id="{bde77e6a-1735-404c-a869-5ff38ebb95c0}">
      <Declaration><![CDATA[METHOD Home : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestHome := TRUE;
Home := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PauseMotion" Id="{4e156774-4bf7-4537-a8b6-5e645b460a3c}">
      <Declaration><![CDATA[METHOD PauseMotion : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestPause := TRUE;
PauseMotion := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="QueueMotion" Id="{9de68a94-33d3-4af2-a210-56c01ae0dec8}">
      <Declaration><![CDATA[METHOD QueueMotion : BOOL
VAR_INPUT
    CommandID : UINT;
    nCommand : UDINT;
    rArgument1 : REAL;
    rArgument2 : REAL;
    rArgument3 : REAL;
    rArgument4 : REAL;
    rArgument5 : REAL;
    rArgument6 : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[QueueMotion := FALSE;
bCommandAccepted := FALSE;

    IF (CommandID = 0) OR NOT CanAcceptCommand THEN
    RETURN;
END_IF

    nPendingMoveId := CommandID;
nPendingCommand := nCommand;
rPendingArgument1 := rArgument1;
rPendingArgument2 := rArgument2;
rPendingArgument3 := rArgument3;
rPendingArgument4 := rArgument4;
rPendingArgument5 := rArgument5;
rPendingArgument6 := rArgument6;
bCommandPending := TRUE;
QueueMotion := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestActivate" Id="{c66231e6-4afe-48ad-b0fa-fca18b028ed5}">
      <Declaration><![CDATA[METHOD RequestActivate : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestActivate := TRUE;
RequestActivate := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestDeactivate" Id="{e6fd8b1a-5efc-44e8-9ca2-4d9f4c10ec0a}">
      <Declaration><![CDATA[METHOD RequestDeactivate : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestDeactivate := TRUE;
RequestDeactivate := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetError" Id="{c82fc398-7e3e-42b0-b4d2-9c64fac0e508}">
      <Declaration><![CDATA[METHOD ResetError : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestResetError := TRUE;
ResetError := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResumeMotion" Id="{d3f84a4e-3b2f-440a-9e4d-24f7197092f0}">
      <Declaration><![CDATA[METHOD ResumeMotion : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestResume := TRUE;
ResumeMotion := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetCheckpoint" Id="{e73dd7f8-b149-4b46-8569-64a2b7626342}">
      <Declaration><![CDATA[METHOD SetCheckpoint : UINT
VAR_INPUT
	id: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetCheckpoint := 0;

// Meca500 checkpoint IDs are 1..8000.
IF (id < 1) OR (id > 8000) THEN
    RETURN;
END_IF

// Legacy protocol helper: the checkpoint ID is also used for the transport handshake.
IF QueueMotion(
  CommandID := id,
    nCommand := 17,
    rArgument1 := UINT_TO_REAL(id),
    rArgument2 := 0.0,
    rArgument3 := 0.0,
    rArgument4 := 0.0,
    rArgument5 := 0.0,
    rArgument6 := 0.0
  ) THEN
    SetCheckpoint := id;
  END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>