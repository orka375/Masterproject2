<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="ROBOT_UR" Id="{7138b06d-6984-4953-8124-68042278758b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ROBOT_UR EXTENDS FB_2_ROB_MANIP 

VAR_INPUT
    sRobotIp          : T_IPv4Addr := '192.168.250.2';
END_VAR
  
  
VAR_OUTPUT
    UR_COMM       : FB_2_COMM_UR;

    (* Raw UR Basic Action handshake. BA_STATUS mapping is left to your eProgress definition. *)
    BA_Active     : BOOL;
    BA_Command    : DINT;
    UR_BA_ResultRaw : DINT;
END_VAR

VAR
    _baActive     : BOOL;
    _baStartSeen      : BOOL;
    _baTransportSent  : BOOL;
    _baActiveID       : UINT;
    _baActiveCmd  : eBA;
    _tonBAStart   : TON;
    _baStopPending : BOOL;

    _urFeedbackPose : ST_Pose;
    _urFeedbackRPY  : ST_Pose;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[// UR native units: SI throughout (m, rad, m/s, rad/s, m/s^2, rad/s^2).
StandardUnits.Position            := eUnit.m;
StandardUnits.Orientation         := eUnit.rad;
StandardUnits.Joint               := eUnit.rad;
StandardUnits.LinearVelocity      := eUnit.m;
StandardUnits.AngularVelocity     := eUnit.rad;
StandardUnits.JointVelocity       := eUnit.rad;
StandardUnits.LinearAcceleration  := eUnit.m;
StandardUnits.AngularAcceleration := eUnit.rad;
StandardUnits.JointAcceleration   := eUnit.rad;

UR_COMM.Config.sIpAddress := sRobotIp;
UR_COMM();

COMM := ADR(UR_COMM);

(* EStop is queued until the script transport is idle so a quick release cannot
    be lost while the original motion script is still being transmitted. *)
IF _baStopPending AND NOT UR_COMM.Script.bBusy THEN
    IF UR_COMM.Script.ClearScript()
         AND UR_COMM.Script.AppendLine(sLine := 'def plc_estop():')
       AND UR_COMM.Script.AppendLine(sLine := '  stopj(2.0)')
       AND UR_COMM.Script.AppendLine(sLine := 'end')
       AND UR_COMM.Script.SendBuffered() THEN

          _baStopPending := FALSE;
    END_IF
END_IF

(* Map the RTDE Cartesian feedback into the generic robot abstraction.
   UR native pose = (m, rotation-vector rad); PLC standard = (m, RPY rad). *)
IF UR_COMM.RTDE.bNewData THEN
    // Rotation-vector -> RPY. Position stays in metres (UR native == PLC standard).
    _urFeedbackRPY := URRotVecToRPY(
        rx := UR_COMM.RTDE.aActualTCPPose[3],
        ry := UR_COMM.RTDE.aActualTCPPose[4],
        rz := UR_COMM.RTDE.aActualTCPPose[5]);

    _urFeedbackPose.x := UR_COMM.RTDE.aActualTCPPose[0];
    _urFeedbackPose.y := UR_COMM.RTDE.aActualTCPPose[1];
    _urFeedbackPose.z := UR_COMM.RTDE.aActualTCPPose[2];
    _urFeedbackPose.roll  := _urFeedbackRPY.roll;
    _urFeedbackPose.pitch := _urFeedbackRPY.pitch;
    _urFeedbackPose.yaw   := _urFeedbackRPY.yaw;

    // UR native == PLC standard numerically; explicit for symmetry with other adapters.
    HMI_ROB._tcppos := ChangePoseFromRobotStandard(
        Pose := _urFeedbackPose,
        RobotStandardUnits := StandardUnits);

    HMI_ROB._jointpos.joint1 := ChangeRealFromRobotStandard(
        Value := UR_COMM.RTDE.aActualQ[0], Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    HMI_ROB._jointpos.joint2 := ChangeRealFromRobotStandard(
        Value := UR_COMM.RTDE.aActualQ[1], Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    HMI_ROB._jointpos.joint3 := ChangeRealFromRobotStandard(
        Value := UR_COMM.RTDE.aActualQ[2], Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    HMI_ROB._jointpos.joint4 := ChangeRealFromRobotStandard(
        Value := UR_COMM.RTDE.aActualQ[3], Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    HMI_ROB._jointpos.joint5 := ChangeRealFromRobotStandard(
        Value := UR_COMM.RTDE.aActualQ[4], Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    HMI_ROB._jointpos.joint6 := ChangeRealFromRobotStandard(
        Value := UR_COMM.RTDE.aActualQ[5], Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
END_IF

(* Basic Action feedback. The generated URScript writes registers 24..27. *)
BA_Active  := _baActive;
BA_Command := UR_COMM.RTDE.nBACommand;
UR_BA_ResultRaw := UR_COMM.RTDE.nBAResult;

IF _baActive AND UR_COMM.Script.bScriptSent THEN
    _baTransportSent := TRUE;
END_IF

_tonBAStart(
    IN := _baActive AND _baTransportSent AND NOT _baStartSeen,
    PT := T#5S
);

IF _baActive THEN

    IF UR_COMM.Script.bError THEN
        _baActive := FALSE;
        BA_Active := FALSE;
        UR_BA_ResultRaw := -513;
        BA_STATUS := FINALIZED;
        BA_RESULT := ERROR;
        Messenger.AddError(eMessageCategories.External, Name, 'UR Basic Action script error');

    ELSIF UR_COMM.RTDE.nBAExecuteID = UINT_TO_DINT(_baActiveID) THEN

        CASE UR_COMM.RTDE.nBAStatus OF
            1: // preparing / accepted
                _baStartSeen := TRUE;
                BA_STATUS := ACKNOWLEDGE;

            2: // running
                _baStartSeen := TRUE;
                BA_STATUS := RUNNING;

            3: // done
                _baStartSeen := TRUE;
                _baActive := FALSE;
                BA_Active := FALSE;
                BA_STATUS := FINALIZED;
                BA_RESULT := SUCCESS;

            4: // robot-side error (reserved for future generated scripts)
                _baStartSeen := TRUE;
                _baActive := FALSE;
                BA_Active := FALSE;
                BA_STATUS := FINALIZED;
                BA_RESULT := ERROR;
                Messenger.AddError(eMessageCategories.HardwareFailure, Name, 'UR Basic Action robot-side error');
        END_CASE

    ELSIF _tonBAStart.Q THEN
        (* TCP send succeeded or is no longer busy, but the robot never published this BA ID. *)
        _baActive := FALSE;
        BA_Active := FALSE;
        UR_BA_ResultRaw := -514;
        BA_STATUS := FINALIZED;
        BA_RESULT := ERROR;
        Messenger.AddError(eMessageCategories.TimeoutFailure, Name, 'UR Basic Action start timeout');
    END_IF
END_IF

CYCLIC_MANIP();
]]></ST>
    </Implementation>
    <Method Name="BA_Annulate" Id="{dd616886-0923-4987-bf7f-514faf86324b}">
      <Declaration><![CDATA[METHOD BA_Annulate : BOOL
VAR_INPUT
        ExecuteId : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[BA_Annulate := FALSE;

IF (ExecuteId = 0)
     OR NOT _baActive
     OR (ExecuteId <> _baActiveID) THEN
        RETURN;
END_IF

_baActive := FALSE;
_baStartSeen := FALSE;
_baTransportSent := FALSE;
_baActiveID := 0;
BA_Active := FALSE;
UR_BA_ResultRaw := 0;
BA_STATUS := ABORTED;
BA_RESULT := FAILURE;
BA_Annulate := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="BA_Handler" Id="{d7ca35aa-fd04-4db2-bc8f-94c9161e0ebc}">
      <Declaration><![CDATA[METHOD BA_Handler : UINT
VAR_INPUT
    Cmd      : eBA;
    Settings : stBA_Settings;
END_VAR
VAR
    bOk      : BOOL;
    bSupported : BOOL;
    NewCommandID : UINT;
    sLine    : STRING(255);
    fVelocity : LREAL;
    fAcceleration : LREAL;
    nCommand : DINT;
    NativePose : ST_Pose;
    NativeJoints : stJoint6;
    UR_RV : ST_Vector3;
    LinVelCat : eUnitCategory;
    LinAccCat : eUnitCategory;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
    UR-specific Basic Action dispatcher.

    Command transport : dynamically generated URScript over TCP 30002
    Completion/status : RTDE output_int_register_24..27

    Incoming Settings are in PLC standard (m, rad, m/s, rad/s, m/s^2, rad/s^2).
    This method converts orientation (generic RPY -> UR rotation vector) and units
    (PLC standard -> UR native = SI, no-op numerically) before emitting URScript.
*)
BA_Handler := 0;
bSupported := FALSE;
nCommand := -1;

IF _baActive OR NOT UR_COMM.CanAcceptCommand THEN
    RETURN;
END_IF

CASE Cmd OF
    eBA.MoveL:
        bSupported := TRUE;
        nCommand := 0;
        LinVelCat := eUnitCategory.LinearVelocity;
        LinAccCat := eUnitCategory.LinearAcceleration;

    eBA.MoveJ:
        bSupported := TRUE;
        nCommand := 1;
        LinVelCat := eUnitCategory.JointVelocity;
        LinAccCat := eUnitCategory.JointAcceleration;

    eBA.MoveJJoints:
        bSupported := TRUE;
        nCommand := 1;
        LinVelCat := eUnitCategory.JointVelocity;
        LinAccCat := eUnitCategory.JointAcceleration;

    eBA.SetDO:
        IF Settings.Pin <= 7 THEN
            bSupported := TRUE;
            nCommand := 4;
        END_IF

    eBA.ReadDI:
        IF Settings.Pin <= 7 THEN
            bSupported := TRUE;
            nCommand := 5;
        END_IF

    (*
        Deliberately not guessed yet:
        - MoveLRelativ / MoveJRelativ: FB_2_ROB_MANIP now pre-resolves relative moves.
        - Home: no home target was supplied.
    *)
END_CASE

IF NOT bSupported THEN
    RETURN;
END_IF

(* Cartesian targets must arrive already resolved into BRF by FB_2_ROB_MANIP. *)
IF ((Cmd = eBA.MoveL) OR (Cmd = eBA.MoveJ)) AND (Settings.Target.frame_id <> eRefFrame.BRF) THEN
    RETURN;
END_IF

(* --- Orientation representation: generic RPY -> UR axis-angle rotation vector. --- *)
IF (Cmd = eBA.MoveL) OR (Cmd = eBA.MoveJ) THEN
    UR_RV := RPYToURRotVec(
        roll  := Settings.Target.pose.roll,
        pitch := Settings.Target.pose.pitch,
        yaw   := Settings.Target.pose.yaw);

    NativePose.x := Settings.Target.pose.x;
    NativePose.y := Settings.Target.pose.y;
    NativePose.z := Settings.Target.pose.z;
    NativePose.roll  := UR_RV.x;
    NativePose.pitch := UR_RV.y;
    NativePose.yaw   := UR_RV.z;

    // Unit conversion PLC standard -> UR native (numerical no-op for UR, explicit and safe).
    NativePose := ChangePoseToRobotStandard(
        Pose := NativePose,
        RobotStandardUnits := StandardUnits);
END_IF

IF Cmd = eBA.MoveJJoints THEN
    NativeJoints.joint1 := ChangeRealToRobotStandard(
        Value := Settings.Joints.joint1, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    NativeJoints.joint2 := ChangeRealToRobotStandard(
        Value := Settings.Joints.joint2, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    NativeJoints.joint3 := ChangeRealToRobotStandard(
        Value := Settings.Joints.joint3, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    NativeJoints.joint4 := ChangeRealToRobotStandard(
        Value := Settings.Joints.joint4, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    NativeJoints.joint5 := ChangeRealToRobotStandard(
        Value := Settings.Joints.joint5, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
    NativeJoints.joint6 := ChangeRealToRobotStandard(
        Value := Settings.Joints.joint6, Category := eUnitCategory.Joint, RobotStandardUnits := StandardUnits);
END_IF

NewCommandID := AllocateCommandID();

IF NOT UR_COMM.Script.ClearScript() THEN
    RETURN;
END_IF

bOk := UR_COMM.Script.AppendLine(sLine := 'def plc_ba():');

sLine := '  write_output_integer_register(26,1)';
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := CONCAT('  write_output_integer_register(25,', DINT_TO_STRING(nCommand));
sLine := CONCAT(sLine, ')');
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := '  write_output_integer_register(27,0)';
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := CONCAT('  write_output_integer_register(24,', UINT_TO_STRING(NewCommandID));
sLine := CONCAT(sLine, ')');
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := '  write_output_integer_register(26,2)';
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

CASE Cmd OF

    eBA.MoveL:
        fVelocity := ChangeRealToRobotStandard(
            Value := Settings.Velocity, Category := LinVelCat, RobotStandardUnits := StandardUnits);
        IF fVelocity <= 0.0 THEN fVelocity := 0.25; END_IF
        fAcceleration := ChangeRealToRobotStandard(
            Value := Settings.Acceleration, Category := LinAccCat, RobotStandardUnits := StandardUnits);
        IF fAcceleration <= 0.0 THEN fAcceleration := 1.2; END_IF

        sLine := '  movel(p[';
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.x));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.y));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.z));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.roll));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.pitch));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.yaw));
        sLine := CONCAT(sLine, '],a=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fAcceleration));
        sLine := CONCAT(sLine, ',v=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fVelocity));
        sLine := CONCAT(sLine, ')');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.MoveJ:
        fVelocity := ChangeRealToRobotStandard(
            Value := Settings.Velocity, Category := LinVelCat, RobotStandardUnits := StandardUnits);
        IF fVelocity <= 0.0 THEN fVelocity := 1.05; END_IF
        fAcceleration := ChangeRealToRobotStandard(
            Value := Settings.Acceleration, Category := LinAccCat, RobotStandardUnits := StandardUnits);
        IF fAcceleration <= 0.0 THEN fAcceleration := 1.4; END_IF

        (* URScript movej accepts a pose; UR performs inverse kinematics for it. *)
        sLine := '  movej(p[';
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.x));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.y));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.z));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.roll));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.pitch));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativePose.yaw));
        sLine := CONCAT(sLine, '],a=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fAcceleration));
        sLine := CONCAT(sLine, ',v=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fVelocity));
        sLine := CONCAT(sLine, ')');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.MoveJJoints:
        fVelocity := ChangeRealToRobotStandard(
            Value := Settings.Velocity, Category := LinVelCat, RobotStandardUnits := StandardUnits);
        IF fVelocity <= 0.0 THEN fVelocity := 1.05; END_IF
        fAcceleration := ChangeRealToRobotStandard(
            Value := Settings.Acceleration, Category := LinAccCat, RobotStandardUnits := StandardUnits);
        IF fAcceleration <= 0.0 THEN fAcceleration := 1.4; END_IF

        (* Joint-space movej: joint angles in UR native units (rad). *)
        sLine := '  movej([';
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativeJoints.joint1));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativeJoints.joint2));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativeJoints.joint3));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativeJoints.joint4));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativeJoints.joint5));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(NativeJoints.joint6));
        sLine := CONCAT(sLine, '],a=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fAcceleration));
        sLine := CONCAT(sLine, ',v=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fVelocity));
        sLine := CONCAT(sLine, ')');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.SetDO:
        sLine := CONCAT('  set_standard_digital_out(', UINT_TO_STRING(Settings.Pin));
        sLine := CONCAT(sLine, ',');
        IF Settings.bValue THEN
            sLine := CONCAT(sLine, 'True)');
        ELSE
            sLine := CONCAT(sLine, 'False)');
        END_IF
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.ReadDI:
        sLine := CONCAT('  if get_standard_digital_in(', UINT_TO_STRING(Settings.Pin));
        sLine := CONCAT(sLine, '):');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '    write_output_integer_register(27,1)');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '  else:');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '    write_output_integer_register(27,0)');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '  end');

END_CASE

(* A motion call is blocking in URScript, so DONE is written only after the action returns. *)
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '  write_output_integer_register(26,3)');
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := 'end');

IF NOT bOk THEN
    UR_COMM.Script.ClearScript();
    RETURN;
END_IF

IF NOT UR_COMM.Script.SendBuffered() THEN
    UR_COMM.Script.ClearScript();
    RETURN;
END_IF

BA_ID := NewCommandID;
BA_STATUS := INIT;
BA_RESULT := NONE;
_baActive := TRUE;
_baStartSeen := FALSE;
_baTransportSent := FALSE;
_baActiveID := NewCommandID;
_baActiveCmd := Cmd;
BA_Active := TRUE;
UR_BA_ResultRaw := 0;

BA_Handler := NewCommandID;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EStop" Id="{6df22b90-0226-4a6b-8edb-494cabd2419d}">
      <Declaration><![CDATA[METHOD EStop : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[HMI_ROB.bEStop := TRUE;
_baStopPending := TRUE;
EStop := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RPYToURRotVec" Id="{7f000001-1111-2222-3333-000000000001}">
      <Declaration><![CDATA[// Convert generic RPY (Rz*Ry*Rx composition, rad) to a UR axis-angle rotation vector (rad).
METHOD PUBLIC RPYToURRotVec : ST_Vector3
VAR_INPUT
    roll  : LREAL;
    pitch : LREAL;
    yaw   : LREAL;
END_VAR
VAR
    T      : ST_TransformMatrix;
    trace  : LREAL;
    cosT   : LREAL;
    theta  : LREAL;
    ss      : LREAL;
    twoSin : LREAL;
    ax, ay, az : LREAL;
    RV     : ST_Vector3;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[T := FromXYZRPY(x := 0.0, y := 0.0, z := 0.0, roll := roll, pitch := pitch, yaw := yaw);

trace := T.r11 + T.r22 + T.r33;
cosT := 0.5 * (trace - 1.0);
IF cosT > 1.0 THEN
    cosT := 1.0;
ELSIF cosT < -1.0 THEN
    cosT := -1.0;
END_IF
theta := ACOS(cosT);

IF theta < 1E-9 THEN
    // Zero rotation.
    RV.x := 0.0;
    RV.y := 0.0;
    RV.z := 0.0;

ELSIF ABS(theta - 3.14159265358979323846) < 1E-6 THEN
    // theta ~ pi: pick axis from largest diagonal to avoid divide-by-zero.
    IF (T.r11 >= T.r22) AND (T.r11 >= T.r33) THEN
        ss := SQRT(T.r11 - T.r22 - T.r33 + 1.0);
        ax := 0.5 * ss;
        ay := (T.r12 + T.r21) / (2.0 * ss);
        az := (T.r13 + T.r31) / (2.0 * ss);
    ELSIF T.r22 >= T.r33 THEN
        ss := SQRT(T.r22 - T.r11 - T.r33 + 1.0);
        ay := 0.5 * ss;
        ax := (T.r12 + T.r21) / (2.0 * ss);
        az := (T.r23 + T.r32) / (2.0 * ss);
    ELSE
        ss := SQRT(T.r33 - T.r11 - T.r22 + 1.0);
        az := 0.5 * ss;
        ax := (T.r13 + T.r31) / (2.0 * ss);
        ay := (T.r23 + T.r32) / (2.0 * ss);
    END_IF
    RV.x := theta * ax;
    RV.y := theta * ay;
    RV.z := theta * az;

ELSE
    twoSin := 2.0 * SIN(theta);
    RV.x := theta * (T.r32 - T.r23) / twoSin;
    RV.y := theta * (T.r13 - T.r31) / twoSin;
    RV.z := theta * (T.r21 - T.r12) / twoSin;
END_IF

RPYToURRotVec := RV;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="URRotVecToRPY" Id="{7f000001-1111-2222-3333-000000000002}">
      <Declaration><![CDATA[// Convert a UR axis-angle rotation vector (rad) into generic RPY (Rz*Ry*Rx composition, rad).
METHOD PUBLIC URRotVecToRPY : ST_Pose
VAR_INPUT
    rx : LREAL;
    ry : LREAL;
    rz : LREAL;
END_VAR
VAR
    theta : LREAL;
    kx, ky, kz : LREAL;
    c, si, oneC : LREAL;
    T : ST_TransformMatrix;
    P : ST_Pose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[theta := SQRT(rx*rx + ry*ry + rz*rz);

IF theta < 1E-12 THEN
    // Identity rotation.
    T := Identity();
ELSE
    kx := rx / theta;
    ky := ry / theta;
    kz := rz / theta;

    c := COS(theta);
    si := SIN(theta);
    oneC := 1.0 - c;

    // Rodrigues -> rotation matrix (only rotation part; translation stays zero).
    T.r11 := c + kx*kx*oneC;
    T.r12 := kx*ky*oneC - kz*si;
    T.r13 := kx*kz*oneC + ky*si;

    T.r21 := ky*kx*oneC + kz*si;
    T.r22 := c + ky*ky*oneC;
    T.r23 := ky*kz*oneC - kx*si;

    T.r31 := kz*kx*oneC - ky*si;
    T.r32 := kz*ky*oneC + kx*si;
    T.r33 := c + kz*kz*oneC;

    T.x := 0.0;
    T.y := 0.0;
    T.z := 0.0;
END_IF

P := ToPose(T := T);
URRotVecToRPY := P;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>