<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="ROBOT_UR" Id="{7138b06d-6984-4953-8124-68042278758b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ROBOT_UR EXTENDS FB_2_ROB_MANIP 

VAR_INPUT
    sRobotIp          : T_IPv4Addr := '192.168.250.2';
END_VAR
  
  
VAR_OUTPUT
    UR_COMM       : FB_2_COMM_UR;

    (* Raw UR Basic Action handshake. BA_STATUS mapping is left to your eProgress definition. *)
    BA_Active     : BOOL;
    BA_Command    : DINT;
    BA_Result     : DINT;
END_VAR

VAR
    _baActive     : BOOL;
    _baStartSeen      : BOOL;
    _baTransportSent  : BOOL;
    _baActiveID       : UINT;
    _baActiveCmd  : eBA;
    _tonBAStart   : TON;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[UR_COMM.Config.sIpAddress := sRobotIp;
UR_COMM();

COMM := ADR(UR_COMM);

(* Map the RTDE Cartesian feedback into the generic robot abstraction. *)
IF UR_COMM.RTDE.bNewData THEN
    HMI_ROB._tcppos.x  := UR_COMM.RTDE.aActualTCPPose[0];
    HMI_ROB._tcppos.y  := UR_COMM.RTDE.aActualTCPPose[1];
    HMI_ROB._tcppos.z  := UR_COMM.RTDE.aActualTCPPose[2];
    HMI_ROB._tcppos.rx := UR_COMM.RTDE.aActualTCPPose[3];
    HMI_ROB._tcppos.ry := UR_COMM.RTDE.aActualTCPPose[4];
    HMI_ROB._tcppos.rz := UR_COMM.RTDE.aActualTCPPose[5];

    (* Actual joint angles (rad) for HMI joint display and joint jog. *)
    HMI_ROB._jointpos.joint1 := UR_COMM.RTDE.aActualQ[0];
    HMI_ROB._jointpos.joint2 := UR_COMM.RTDE.aActualQ[1];
    HMI_ROB._jointpos.joint3 := UR_COMM.RTDE.aActualQ[2];
    HMI_ROB._jointpos.joint4 := UR_COMM.RTDE.aActualQ[3];
    HMI_ROB._jointpos.joint5 := UR_COMM.RTDE.aActualQ[4];
    HMI_ROB._jointpos.joint6 := UR_COMM.RTDE.aActualQ[5];
END_IF

(* Basic Action feedback. The generated URScript writes registers 24..27. *)
BA_Active  := _baActive;
BA_Command := UR_COMM.RTDE.nBACommand;
BA_Result  := UR_COMM.RTDE.nBAResult;

IF _baActive AND UR_COMM.Script.bScriptSent THEN
    _baTransportSent := TRUE;
END_IF

_tonBAStart(
    IN := _baActive AND _baTransportSent AND NOT _baStartSeen,
    PT := T#5S
);

IF _baActive THEN

    IF UR_COMM.Script.bError THEN
        _baActive := FALSE;
        BA_Active := FALSE;
        BA_Result := -513;
        _commandState := E_RobotCommandState.Idle;
        Messenger.AddError(eMessageCategories.External, Name, 'UR Basic Action script error');

    ELSIF UR_COMM.RTDE.nBAExecuteID = UINT_TO_DINT(_baActiveID) THEN

        CASE UR_COMM.RTDE.nBAStatus OF
            1: // preparing / accepted
                _baStartSeen := TRUE;

            2: // running
                _baStartSeen := TRUE;

            3: // done
                _baStartSeen := TRUE;
                _baActive := FALSE;
                BA_Active := FALSE;
                _commandState := E_RobotCommandState.Done;

            4: // robot-side error (reserved for future generated scripts)
                _baStartSeen := TRUE;
                _baActive := FALSE;
                BA_Active := FALSE;
                _commandState := E_RobotCommandState.Idle;
                Messenger.AddError(eMessageCategories.HardwareFailure, Name, 'UR Basic Action robot-side error');
        END_CASE

    ELSIF _tonBAStart.Q THEN
        (* TCP send succeeded or is no longer busy, but the robot never published this BA ID. *)
        _baActive := FALSE;
        BA_Active := FALSE;
        BA_Result := -514;
        _commandState := E_RobotCommandState.Idle;
        Messenger.AddError(eMessageCategories.TimeoutFailure, Name, 'UR Basic Action start timeout');
    END_IF
END_IF

(* BA_STATUS is intentionally not assigned here because the eProgress DUT was not supplied. *)

CYCLIC_MANIP();
]]></ST>
    </Implementation>
    <Method Name="BA_Handler" Id="{d7ca35aa-fd04-4db2-bc8f-94c9161e0ebc}">
      <Declaration><![CDATA[METHOD BA_Handler : UINT
VAR_INPUT
    Cmd      : eBA;
    Settings : stBA_Settings;
END_VAR
VAR
    bOk      : BOOL;
    bSupported : BOOL;
    sLine    : STRING(255);
    fVelocity : LREAL;
    fAcceleration : LREAL;
    nCommand : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
    UR-specific Basic Action dispatcher.

    Command transport : dynamically generated URScript over TCP 30002
    Completion/status : RTDE output_int_register_24..27

    One BA is allowed at a time. A successful return value is the generated BA/Execute ID.
    0 means the request was not accepted.
*)
BA_Handler := 0;
bSupported := FALSE;
nCommand := -1;

IF _baActive OR UR_COMM.Script.bBusy THEN
    RETURN;
END_IF

(* The RTDE stream is required for the completion handshake. *)
IF NOT UR_COMM.RTDE.bStreaming THEN
    RETURN;
END_IF

(* Decide which generic actions have an unambiguous UR implementation today. *)
CASE Cmd OF
    eBA.MoveL:
        bSupported := TRUE;
        nCommand := 0;

    eBA.MoveJ:
        bSupported := TRUE;
        nCommand := 1;

    eBA.MoveJJoints:
        bSupported := TRUE;
        nCommand := 1;

    eBA.SetDO:
        IF Settings.Pin <= 7 THEN
            bSupported := TRUE;
            nCommand := 4;
        END_IF

    eBA.ReadDI:
        IF Settings.Pin <= 7 THEN
            bSupported := TRUE;
            nCommand := 5;
        END_IF

    (*
        Deliberately not guessed yet:
        - MoveLRelativ: base-frame relative or TCP-frame relative?
        - MoveJRelativ: stTarget contains a pose, not six joint deltas.
        - Home: no home target was supplied.
    *)
END_CASE

IF NOT bSupported THEN
    RETURN;
END_IF

(* stTarget.frameId cannot yet be transformed by the UR adapter. 0 is treated as UR base. *)
IF ((Cmd = eBA.MoveL) OR (Cmd = eBA.MoveJ)) AND (Settings.Target.frameId <> 0) THEN
    RETURN;
END_IF

(* Allocate a non-zero 16-bit ExecuteID. *)
IF Idcounter >= 65534 THEN
    Idcounter := 1000;
ELSE
    Idcounter := Idcounter + 1;
END_IF
BA_ID := Idcounter;

IF NOT UR_COMM.Script.ClearScript() THEN
    BA_ID := 0;
    RETURN;
END_IF

bOk := UR_COMM.Script.AppendLine(sLine := 'def plc_ba():');

(*
    Write status before changing ExecuteID. This prevents a new ID from being sampled together
    with the previous command's DONE status.
*)
sLine := '  write_output_integer_register(26,1)';
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := CONCAT('  write_output_integer_register(25,', DINT_TO_STRING(nCommand));
sLine := CONCAT(sLine, ')');
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := '  write_output_integer_register(27,0)';
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := CONCAT('  write_output_integer_register(24,', UINT_TO_STRING(BA_ID));
sLine := CONCAT(sLine, ')');
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

sLine := '  write_output_integer_register(26,2)';
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

CASE Cmd OF

    eBA.MoveL:
        fVelocity := Settings.Velocity;
        IF fVelocity <= 0.0 THEN fVelocity := 0.25; END_IF
        fAcceleration := Settings.Acceleration;
        IF fAcceleration <= 0.0 THEN fAcceleration := 1.2; END_IF

        sLine := '  movel(p[';
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.x));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.y));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.z));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.rx));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.ry));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.rz));
        sLine := CONCAT(sLine, '],a=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fAcceleration));
        sLine := CONCAT(sLine, ',v=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fVelocity));
        sLine := CONCAT(sLine, ')');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.MoveJ:
        fVelocity := Settings.Velocity;
        IF fVelocity <= 0.0 THEN fVelocity := 1.05; END_IF
        fAcceleration := Settings.Acceleration;
        IF fAcceleration <= 0.0 THEN fAcceleration := 1.4; END_IF

        (* URScript movej accepts a pose; UR performs inverse kinematics for it. *)
        sLine := '  movej(p[';
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.x));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.y));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.z));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.rx));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.ry));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Target.pose.rz));
        sLine := CONCAT(sLine, '],a=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fAcceleration));
        sLine := CONCAT(sLine, ',v=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fVelocity));
        sLine := CONCAT(sLine, ')');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.MoveJJoints:
        fVelocity := Settings.Velocity;
        IF fVelocity <= 0.0 THEN fVelocity := 1.05; END_IF
        fAcceleration := Settings.Acceleration;
        IF fAcceleration <= 0.0 THEN fAcceleration := 1.4; END_IF

        (* Joint-space movej: joint angles in radians. *)
        sLine := '  movej([';
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Joints.joint1));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Joints.joint2));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Joints.joint3));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Joints.joint4));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Joints.joint5));
        sLine := CONCAT(sLine, ',');
        sLine := CONCAT(sLine, LREAL_TO_STRING(Settings.Joints.joint6));
        sLine := CONCAT(sLine, '],a=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fAcceleration));
        sLine := CONCAT(sLine, ',v=');
        sLine := CONCAT(sLine, LREAL_TO_STRING(fVelocity));
        sLine := CONCAT(sLine, ')');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.SetDO:
        sLine := CONCAT('  set_standard_digital_out(', UINT_TO_STRING(Settings.Pin));
        sLine := CONCAT(sLine, ',');
        IF Settings.bValue THEN
            sLine := CONCAT(sLine, 'True)');
        ELSE
            sLine := CONCAT(sLine, 'False)');
        END_IF
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);

    eBA.ReadDI:
        sLine := CONCAT('  if get_standard_digital_in(', UINT_TO_STRING(Settings.Pin));
        sLine := CONCAT(sLine, '):');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := sLine);
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '    write_output_integer_register(27,1)');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '  else:');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '    write_output_integer_register(27,0)');
        bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '  end');

END_CASE

(* A motion call is blocking in URScript, so DONE is written only after the action returns. *)
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := '  write_output_integer_register(26,3)');
bOk := bOk AND UR_COMM.Script.AppendLine(sLine := 'end');

IF NOT bOk THEN
    UR_COMM.Script.ClearScript();
    BA_ID := 0;
    RETURN;
END_IF

IF NOT UR_COMM.Script.SendBuffered() THEN
    UR_COMM.Script.ClearScript();
    BA_ID := 0;
    RETURN;
END_IF

_baActive := TRUE;
_baStartSeen := FALSE;
_baTransportSent := FALSE;
_baActiveID := BA_ID;
_baActiveCmd := Cmd;
BA_Active := TRUE;
BA_Result := 0;
_commandState := E_RobotCommandState.Idle;

BA_Handler := BA_ID;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>