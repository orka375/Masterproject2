<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_2_COMM_UR" Id="{e695efdc-e187-4f84-8c3d-4878e12ff71c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_2_COMM_UR EXTENDS FB_1_COMM
VAR_INPUT
    SET_R_M_UR : stComm_UR_Config;
    Dashboard : FB_UR_Dashboard;
    Script    : FB_UR_Script;
    RTDE      : FB_UR_RTDE;
END_VAR
VAR_OUTPUT
  
END_VAR
VAR


    _DashboardConnected : BOOL;
    _ScriptOperational        : BOOL;

    _RTDEConnected : BOOL;
    _RTDEOperational     : BOOL;
    _RTDEStreaming : BOOL;
    _EnableDashboard : BOOL;
    _EnableRTDE      : BOOL;
	_EnableScript	: BOOL;
	
	_nRobotStartupState : UINT := 0;

    _urPreparedCommandID : UINT;
    _urSubmittedCommandID : UINT;
    _urTransportSent : BOOL;
    _urStartSeen : BOOL;
    _urStopMotionPending : BOOL;
    _tonCommandStart : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_COMM();

_EnableDashboard := RequestConnection
    AND ((HMI_BASE.eStatus = eState.Configuring) OR _DashboardConnected OR (HMI_BASE.eStatus = eState.ErrorProcessing));

_EnableRTDE := RequestConnection
    AND ((HMI_BASE.eStatus = eState.Configuring) OR _RTDEConnected OR (HMI_BASE.eStatus = eState.ErrorProcessing));


// ==================================================
// 2. UR Dashboard :29999
// ==================================================

Dashboard(
    sRobotIP         := SET_R_M_UR.sIpAddress,
    tResponseTimeout := SET_R_M_UR.tTimeout,
  bConnect         := _EnableDashboard,

    bConnected       => _DashboardConnected
);


// ==================================================
// 3. URScript Secondary interface :30002
//    The FB connects only while submitting a script.
// ==================================================

Script(
    sRobotIP := SET_R_M_UR.sIpAddress,
    bEnable  := RequestConnection
);

_ScriptOperational := RequestConnection AND NOT Script.bError;


// ==================================================
// 4. UR RTDE :30004
// ==================================================

RTDE(
    sRobotIP   := SET_R_M_UR.sIpAddress,
  bEnable    := _EnableRTDE,
    fFrequency := 10.0,

    bConnected => _RTDEConnected,
    bOperational     => _RTDEOperational,
    bStreaming => _RTDEStreaming
);


// ==================================================
// 5. Generate feedback for FB_1
// ==================================================

HMI_COMM._CommunicationConnected := Connected;





// ==================================================
// 6. Generic command lifecycle (UR protocol -> eProgress/eResult)
// ==================================================
CanAcceptCommand := NOT Script.bBusy
    AND NOT Script.bError
    AND (_urPreparedCommandID = 0)
    AND NOT _urStopMotionPending;

IF (_urSubmittedCommandID <> 0) AND Script.bScriptSent THEN
    _urTransportSent := TRUE;
END_IF

_tonCommandStart(
    IN := (_urSubmittedCommandID <> 0) AND _urTransportSent AND NOT _urStartSeen,
    PT := T#5S);

IF _urSubmittedCommandID <> 0 THEN
    IF Script.bError OR NOT FB_1_COMM.Operational THEN
        ActiveCommandID := 0;
        CommandState := FINALIZED;
        CommandResult :=ERROR;
        FB_1_COMM.Busy := FALSE;
        _urSubmittedCommandID := 0;

    ELSIF RTDE.nBAExecuteID = UINT_TO_DINT(_urSubmittedCommandID) THEN
        CASE RTDE.nBAStatus OF
            1:
                _urStartSeen := TRUE;
                AcceptedCommandID := _urSubmittedCommandID;
                ActiveCommandID := _urSubmittedCommandID;
                CommandState := ACKNOWLEDGE;
                CommandResult :=NONE;
                FB_1_COMM.Busy := TRUE;

            2:
                _urStartSeen := TRUE;
                AcceptedCommandID := _urSubmittedCommandID;
                ActiveCommandID := _urSubmittedCommandID;
                CommandState := RUNNING;
                CommandResult :=NONE;
                FB_1_COMM.Busy := TRUE;

            3:
                _urStartSeen := TRUE;
                AcceptedCommandID := _urSubmittedCommandID;
                ActiveCommandID := 0;
                CommandState := FINALIZED;
                CommandResult :=SUCCESS;
                FB_1_COMM.Busy := FALSE;
                _urSubmittedCommandID := 0;

            4:
                _urStartSeen := TRUE;
                AcceptedCommandID := _urSubmittedCommandID;
                ActiveCommandID := 0;
                CommandState := FINALIZED;
                CommandResult :=ERROR;
                FB_1_COMM.Busy := FALSE;
                _urSubmittedCommandID := 0;
        END_CASE

    ELSIF _tonCommandStart.Q THEN
        ActiveCommandID := 0;
        CommandState := FINALIZED;
        CommandResult :=ERROR;
        FB_1_COMM.Busy := FALSE;
        _urSubmittedCommandID := 0;
    END_IF
END_IF

// A functional stop uses its own short URScript. Do not replay the interrupted command.
IF _urStopMotionPending AND NOT Script.bBusy THEN
    IF Script.ClearScript()
       AND Script.AppendLine(sLine := 'def plc_stop_motion():')
       AND Script.AppendLine(sLine := '  stopj(2.0)')
       AND Script.AppendLine(sLine := 'end')
       AND Script.SendBuffered() THEN
        _urStopMotionPending := FALSE;
    END_IF
END_IF

IF (_commCommandState = FINALIZED) OR (_commCommandState = ABORTED) THEN
    FB_1_COMM.Busy := _urStopMotionPending OR Script.bBusy;
END_IF


// ==================================================
// 7. Communication diagnostics
// ==================================================

// Interface diagnostics are owned here (the UR comm component). De-dup + Clear
// give a self-healing lifecycle: a message clears when the interface recovers.


IF Script.bError THEN
    SetRecoveryMode(Mode := eRecoveryMode.AcknowledgeRequired);
    Messenger.AddError(eMessageCategories.HardwareFailure, Name, 'UR Script interface error');
END_IF

]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{76d61647-738d-4b23-8853-f6e5794603cd}" />
    <Method Name="AppendCommandLine" Id="{a95394b7-2851-4773-bec7-fd729638b9de}">
      <Declaration><![CDATA[METHOD PUBLIC AppendCommandLine : BOOL
VAR_INPUT
    sLine : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AppendCommandLine := FALSE;
IF _urPreparedCommandID = 0 THEN
    RETURN;
END_IF
AppendCommandLine := Script.AppendLine(sLine := sLine);]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeginCommand" Id="{e26fab62-8c08-4661-a60a-ea2ba7912175}">
      <Declaration><![CDATA[METHOD PUBLIC BeginCommand : BOOL
VAR_INPUT
    CommandID : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[BeginCommand := FALSE;
IF (CommandID = 0) OR NOT CanAcceptCommand THEN
    RETURN;
END_IF
IF NOT Script.ClearScript() THEN
    RETURN;
END_IF
_urPreparedCommandID := CommandID;
BeginCommand := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CancelCommand" Id="{8442ea28-9ac3-4603-9729-cbc01e8341af}">
      <Declaration><![CDATA[METHOD PUBLIC CancelCommand : BOOL
VAR_INPUT
    CommandID : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CancelCommand := FALSE;
IF (CommandID = 0)
   OR (CommandID <> _urSubmittedCommandID)
   OR ((_commCommandState <> INIT) AND (_commCommandState <> ACKNOWLEDGE) AND (_commCommandState <> RUNNING)) THEN
    RETURN;
END_IF

IF NOT StopMotion() THEN
    RETURN;
END_IF

_urSubmittedCommandID := 0;
ActiveCommandID := 0;
CommandState := ABORTED;
CommandResult :=FAILURE;
// Keep busy until the queued functional stop has been handed to the transport.
FB_1_COMM.Busy := TRUE;
CancelCommand := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearCommandBuffer" Id="{1a7241e9-68c7-492e-9051-fd39a397af77}">
      <Declaration><![CDATA[METHOD PUBLIC ClearCommandBuffer : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ClearCommandBuffer := Script.ClearScript();
IF ClearCommandBuffer THEN
    _urPreparedCommandID := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Connected" Id="{ccf627c2-212e-408f-a53e-19108de964de}">
      <Declaration><![CDATA[PROPERTY Connected : BOOL]]></Declaration>
      <Get Name="Get" Id="{6cfe16d9-c3dc-4922-8c44-77eb86a26e92}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Connected:=
   _DashboardConnected
    AND _RTDEConnected;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnActivate" Id="{0ed4d272-2017-43c8-8627-328b7fa74b51}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnActivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnActivate();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------


myResult:=SUCCESS;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnActivate := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCleanup" Id="{67356389-b773-4afe-aa41-40842006ed91}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnCleanup : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnCleanup();
//--------------------------------------------------
myResult := NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

_nRobotStartupState := 0;

myResult := SUCCESS;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnCleanup := CombineResults(
    eParentResult,
    myResult
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{fe1e62cc-b3f4-4da7-9fa1-851d69b6c7d8}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnConfigure : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
	    // Robot power-on during configuration

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnConfigure();
//--------------------------------------------------
myResult := NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

// ==================================================
// Basic configuration / communication errors
// ==================================================

IF LEN(SET_R_M_UR.sIpAddress) = 0 THEN

    SetRecoveryMode(Mode := eRecoveryMode.ManualActionRequired);
    Messenger.AddError(
        eMessageCategories.Undefined,
        sSender := Name,
        sMessage := 'TCP/IP configuration is invalid'
    );

    myResult := ERROR;


ELSIF _EnableDashboard AND Dashboard.bError THEN

    SetRecoveryMode(Mode := eRecoveryMode.Automatic);
    Messenger.AddError(
        eMessageCategories.HardwareFailure,
        Name,
        'UR Dashboard interface error'
    );

    myResult := ERROR;


ELSIF _EnableRTDE AND RTDE.bError THEN

    SetRecoveryMode(Mode := eRecoveryMode.Automatic);
    Messenger.AddError(
        eMessageCategories.HardwareFailure,
        Name,
        'UR RTDE interface error'
    );

    myResult := ERROR;


ELSE

    // ==================================================
    // UR ROBOT STARTUP STATE MACHINE
    //
    // 0   Wait for Dashboard
    // 10  Wait for "power on" response
    // 20  Request robotmode
    // 30  Wait until robotmode = IDLE
    // 40  Send brake release
    // 50  Wait for brake release response
    // 60  Request robotmode
    // 70  Wait until robotmode = RUNNING
    // 100 Startup complete
    // ==================================================

    CASE _nRobotStartupState OF


        // --------------------------------------------------
        // 0 = Dashboard connected -> POWER ON
        // --------------------------------------------------
        0:

            IF _DashboardConnected THEN

                IF Dashboard.PowerOn() THEN
                    _nRobotStartupState := 10;
                END_IF

            END_IF


        // --------------------------------------------------
        // 10 = Wait for POWER ON response
        // --------------------------------------------------
        10:

            IF Dashboard.bResponseValid
               AND (Dashboard.sLastCommand = 'power on') THEN

                // Command was received by the UR.
                // Now wait for robot to reach IDLE.
                _nRobotStartupState := 20;

            END_IF


        // --------------------------------------------------
        // 20 = Ask robot mode
        // --------------------------------------------------
        20:

            IF Dashboard.RobotMode() THEN
                _nRobotStartupState := 30;
            END_IF


        // --------------------------------------------------
        // 30 = Wait for robotmode response
        //      POWER_ON/BOOTING -> keep checking
        //      IDLE             -> release brakes
        // --------------------------------------------------
        30:

            IF Dashboard.bResponseValid
               AND (Dashboard.sLastCommand = 'robotmode') THEN

                IF Dashboard.LastResponseIncludes('IDLE') THEN

                    // Robot electronics are powered.
                    // We can now release the brakes.
                    _nRobotStartupState := 40;

                ELSE

                    // Robot is still booting / powering on.
                    // Ask robotmode again.
                    _nRobotStartupState := 20;

                END_IF

            END_IF


        // --------------------------------------------------
        // 40 = BRAKE RELEASE
        // --------------------------------------------------
        40:

            IF Dashboard.BrakeRelease() THEN
                _nRobotStartupState := 50;
            END_IF


        // --------------------------------------------------
        // 50 = Wait for BRAKE RELEASE response
        // --------------------------------------------------
        50:

            IF Dashboard.bResponseValid
               AND (Dashboard.sLastCommand = 'brake release') THEN

                // Brake release command accepted.
                // Now verify that the robot actually
                // reaches RUNNING.
                _nRobotStartupState := 60;

            END_IF


        // --------------------------------------------------
        // 60 = Ask robot mode
        // --------------------------------------------------
        60:

            IF Dashboard.RobotMode() THEN
                _nRobotStartupState := 70;
            END_IF


        // --------------------------------------------------
        // 70 = Wait until robotmode = RUNNING
        // --------------------------------------------------
        70:

            IF Dashboard.bResponseValid
               AND (Dashboard.sLastCommand = 'robotmode') THEN

                IF Dashboard.LastResponseIncludes('RUNNING') THEN

                    // Robot is powered and brakes released.
                    _nRobotStartupState := 100;

                ELSE

                    // Still releasing brakes / initializing.
                    // Query again.
                    _nRobotStartupState := 60;

                END_IF

            END_IF


        // --------------------------------------------------
        // 100 = Robot startup finished
        // --------------------------------------------------
        100:

            IF FB_1_COMM.Operational THEN

                Messenger.Clear(
                    Name,
                    'UR Dashboard interface error'
                );

                Messenger.Clear(
                    Name,
                    'UR RTDE interface error'
                );

                myResult := SUCCESS;

            ELSE
                myResult := NONE;
            END_IF


    END_CASE

END_IF


// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnConfigure := CombineResults(
    eParentResult,
    myResult
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDeactivate" Id="{98b9db24-dd3c-4d2b-a2df-a4c02bc21178}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnDeactivate : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnDeactivate();
//--------------------------------------------------
myResult := NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------

_nRobotStartupState := 0;

myResult := SUCCESS;

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnDeactivate := CombineResults(
    eParentResult,
    myResult
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{cbca3eb3-1f59-4132-8cb6-1ba90593b065}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnError : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnError();
myResult := NONE;

// UR-specific recovery resets only transport/startup state. It never issues a
// protective-stop unlock, brake release, move, Home, or previous URScript again.
_nRobotStartupState := 0;

IF NOT _DashboardConnected AND NOT _RTDEConnected AND NOT Script.bBusy THEN
    myResult := SUCCESS;
END_IF

OnError := CombineResults(eParentResult, myResult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnShutdown" Id="{f085909e-b37c-4b4c-a9a3-f41132b1f91f}" FolderPath="StateControl\">
      <Declaration><![CDATA[METHOD PROTECTED OnShutdown : eResult
VAR_INPUT
END_VAR

VAR
	eParentResult: eResult;
	myResult: ERESULT;
END_VAR

VAR //YOUR CODE
	succ : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eParentResult := SUPER^.OnShutdown();
//--------------------------------------------------
myResult:=NONE;
// ----- YOUR CODE HERE (incl. Alarms) -------------



IF Connected THEN
	Disconnect();
	myResult := None;
ELSE
	myResult := SUCCESS;
END_IF

// ----- END YOUR CODE -----------------------------
//--------------------------------------------------
OnShutdown := CombineResults(eParentResult,myResult);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Operational" Id="{cfb9706d-eeda-43d9-85a8-165b8ef67193}">
      <Declaration><![CDATA[PROPERTY Operational : BOOL]]></Declaration>
      <Set Name="Set" Id="{9e1af3a5-e848-4201-b592-085ce8e1d93a}">
        <Declaration><![CDATA[
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SUPER^.Operational :=
    _DashboardConnected
    AND _RTDEConnected
    AND _RTDEOperational
    AND _RTDEStreaming
	AND _ScriptOperational;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="ResetCommunication" Id="{d48ecd8e-ffe3-41a9-ac70-bd6cf13a1941}">
      <Declaration><![CDATA[METHOD PUBLIC ResetCommunication : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset transport bookkeeping only. Safety/controller recovery is intentionally outside this method.
IF NOT Script.bBusy THEN
    Script.ClearScript();
END_IF
_urPreparedCommandID := 0;
_urSubmittedCommandID := 0;
_urTransportSent := FALSE;
_urStartSeen := FALSE;
_urStopMotionPending := FALSE;
CanAcceptCommand := TRUE;
AcceptedCommandID := 0;
ActiveCommandID := 0;
FB_1_COMM.Busy := FALSE;
CommandState := INIT;
CommandResult :=NONE;
Reconnect();
ResetCommunication := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendCommand" Id="{5e0a4b41-b77d-489f-86a0-ad4d66f0cd18}">
      <Declaration><![CDATA[METHOD PUBLIC SendCommand : BOOL
VAR_INPUT
    CommandID : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// TRUE means only: COMM accepted the prepared command for transport.
// Physical completion is reported through CommandState/CommandResult.
SendCommand := FALSE;
IF (CommandID = 0) OR (CommandID <> _urPreparedCommandID) OR NOT CanAcceptCommand THEN
    RETURN;
END_IF
IF NOT Script.SendBuffered() THEN
    RETURN;
END_IF

AcceptedCommandID := 0;
ActiveCommandID := CommandID;
CommandState := INIT;
CommandResult :=NONE;
FB_1_COMM.Busy := TRUE;
_urSubmittedCommandID := CommandID;
_urPreparedCommandID := 0;
_urTransportSent := FALSE;
_urStartSeen := FALSE;
_tonCommandStart(IN := FALSE);
SendCommand := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopMotion" Id="{6c944b84-e449-4e6e-ac8a-47dfa56f2ca8}">
      <Declaration><![CDATA[METHOD PUBLIC StopMotion : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Functional, non-safety-rated stop. It never releases a protective/safety stop.
StopMotion := FALSE;
IF NOT FB_1_COMM.Operational THEN
    RETURN;
END_IF
_urStopMotionPending := TRUE;
FB_1_COMM.Busy := TRUE;
StopMotion := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>