<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_2_COMM_UR" Id="{e695efdc-e187-4f84-8c3d-4878e12ff71c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_2_COMM_UR EXTENDS FB_1_CommunicationModul
VAR_INPUT
    Config : stComm_UR_Config;
    Dashboard : FB_UR_Dashboard;
    Script    : FB_UR_Script;
    RTDE      : FB_UR_RTDE;
END_VAR
VAR_OUTPUT
  
END_VAR
VAR


    _DashboardConnected : BOOL;
    _ScriptReady        : BOOL;

    _RTDEConnected : BOOL;
    _RTDEReady     : BOOL;
    _RTDEStreaming : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_COMM_UR();


// ==================================================
// 2. UR Dashboard :29999
// ==================================================

Dashboard(
    sRobotIP         := Config.sIpAddress,
    tResponseTimeout := Config.tTimeout,
    bConnect         := bRequestConnection,

    bConnected       => _DashboardConnected
);


// ==================================================
// 3. URScript Secondary interface :30002
//    The FB connects only while submitting a script.
// ==================================================

Script(
    sRobotIP := Config.sIpAddress,
    bEnable  := bRequestConnection
);

_ScriptReady := bRequestConnection AND NOT Script.bError;


// ==================================================
// 4. UR RTDE :30004
// ==================================================

RTDE(
    sRobotIP   := Config.sIpAddress,
    bEnable    := bRequestConnection,
    fFrequency := 10.0,

    bConnected => _RTDEConnected,
    bReady     => _RTDEReady,
    bStreaming => _RTDEStreaming
);


// ==================================================
// 5. Generate feedback for FB_1
// ==================================================

HMI_COMM._CommunicationConnected :=
    _DashboardConnected
    AND _RTDEConnected;


HMI_COMM._CommunicationReady :=
    _DashboardConnected
    AND _RTDEConnected
    AND _RTDEReady
    AND _RTDEStreaming;


// ==================================================
// 6. Communication diagnostics
// ==================================================

// Interface diagnostics are owned here (the UR comm component). De-dup + Clear
// give a self-healing lifecycle: a message clears when the interface recovers.
IF Dashboard.bError THEN
    Messenger.AddError(eMessageCategories.HardwareFailure, Name, 'UR Dashboard interface error');
ELSE
    Messenger.Clear(Name, 'UR Dashboard interface error');
END_IF

IF Script.bError THEN
    Messenger.AddError(eMessageCategories.HardwareFailure, Name, 'UR Script interface error');
ELSE
    Messenger.Clear(Name, 'UR Script interface error');
END_IF

IF RTDE.bError THEN
    Messenger.AddError(eMessageCategories.HardwareFailure, Name, 'UR RTDE interface error');
ELSE
    Messenger.Clear(Name, 'UR RTDE interface error');
END_IF]]></ST>
    </Implementation>
    <Folder Name="StateControl" Id="{76d61647-738d-4b23-8853-f6e5794603cd}" />
    <Action Name="CYCLIC_COMM_UR" Id="{e079c791-bd51-481e-8c49-3586c05afcb2}">
      <Implementation>
        <ST><![CDATA[ // ==================================================
// 1. Generic communication state machine
// ==================================================

CYCLIC_COMM();

]]></ST>
      </Implementation>
    </Action>
