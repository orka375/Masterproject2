    </Method>
    <Method Name="ProgramState" Id="{35578bdf-fd87-49da-a49c-7e7ea1bb36f7}">
      <Declaration><![CDATA[METHOD PUBLIC ProgramState : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[ProgramState := QueueCommand(
    sCmd := 'programState',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="QueueCommand" Id="{bed94683-7338-49e6-88f0-c5e66c70dc69}">
      <Declaration><![CDATA[METHOD PRIVATE QueueCommand : BOOL
VAR_INPUT
    sCmd  : STRING(511);
    tWait : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bConnected AND (nState = 20) AND NOT bCommandPending THEN
    sQueuedCommand := sCmd;
    tQueuedResponseTimeout := tWait;
    bCommandPending := TRUE;
    QueueCommand := TRUE;
ELSE
    QueueCommand := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Quit" Id="{123b2b86-7559-45d6-ad7b-d242e8ebc341}">
      <Declaration><![CDATA[METHOD PUBLIC Quit : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[Quit := QueueCommand(
    sCmd := 'quit',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RobotMode" Id="{8cab2b8a-bd17-49bf-a5a8-bdae9524cfb4}">
      <Declaration><![CDATA[METHOD PUBLIC RobotMode : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[RobotMode := QueueCommand(
    sCmd := 'robotmode',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Running" Id="{e80e043d-3e7b-4d58-b5c1-63a5dd82b3ce}">
