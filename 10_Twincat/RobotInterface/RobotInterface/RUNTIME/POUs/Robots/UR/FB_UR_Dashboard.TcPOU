<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_UR_Dashboard" Id="{2600063d-0ffc-4725-a472-aa7d4f758b5d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_UR_Dashboard
VAR_INPUT
    sRobotIP   : STRING(15) := '192.168.250.6';
    tResponseTimeout : TIME := T#10S;

    (* Connection *)
    bConnect   : BOOL;

    (* Dashboard commands - rising edge triggers one command *)
    bLoadProgram          : BOOL;
    sProgramPath          : STRING(255) := '/FNA/skill_3p.urp';

    bPlay                 : BOOL;
    bStop                 : BOOL;
    bPause                : BOOL;
    bQuit                 : BOOL;
    bShutdown             : BOOL;
    bRunning              : BOOL;
    bRobotMode            : BOOL;
    bGetLoadedProgram     : BOOL;

    bIsProgramSaved       : BOOL;
    bProgramState         : BOOL;

    bSetOperationalMode   : BOOL;
    sOperationalMode      : STRING(20) := 'automatic';
    bGetOperationalMode   : BOOL;
    bClearOperationalMode : BOOL;

    bPowerOn              : BOOL;
    bPowerOff             : BOOL;
    bBrakeRelease         : BOOL;

 
END_VAR

VAR_OUTPUT
    bConnected     : BOOL;
    bBusy          : BOOL;
    bError         : BOOL;
    nErrorID       : UDINT;

    (* One-cycle pulse when a Dashboard reply has been received *)
    bResponseValid : BOOL;

    (* Last transmitted command without LF *)
    sLastCommand   : STRING(511);

    (* Last Dashboard response received *)
    sLastResponse  : STRING(1023);

    (* Greeting received immediately after connection *)
    sGreeting      : STRING(1023);
END_VAR

VAR
    fbConnect : FB_SocketConnect;
    fbSend    : FB_SocketSend;
    fbReceive : FB_SocketReceive;
    fbClose   : FB_SocketClose;

    hSocket   : T_HSOCKET;

    nState    : INT := 0;

    rConnect  : R_TRIG;
    rLoadProgram : R_TRIG;
    rPlay : R_TRIG;
    rStopProgram : R_TRIG;
    rPause : R_TRIG;
    rQuit : R_TRIG;
    rShutdown : R_TRIG;
    rRunning : R_TRIG;
    rRobotMode : R_TRIG;
    rGetLoadedProgram : R_TRIG;

    rIsProgramSaved : R_TRIG;
    rProgramState : R_TRIG;

    rSetOperationalMode : R_TRIG;
    rGetOperationalMode : R_TRIG;
    rClearOperationalMode : R_TRIG;
    rPowerOn : R_TRIG;
    rPowerOff : R_TRIG;
    rBrakeRelease : R_TRIG;


    bConnectRequest : BOOL;
    bCommandPending : BOOL;

    sQueuedCommand : STRING(511);
    sTx            : STRING(512);
    sRx            : STRING(1023);

    tQueuedResponseTimeout : TIME := T#10S;
    tActiveResponseTimeout : TIME := T#10S;

    bConnectExecute : BOOL;
    bSendExecute    : BOOL;
    bReceiveExecute : BOOL;
    bCloseExecute   : BOOL;

    tonResponse : TON;

    pRxByte : POINTER TO BYTE;
    nRxLen  : UDINT;

    bWaitingForGreeting : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* FB_UR_Dashboard
   Universal Robots Dashboard Server client for TCP port 29999.
   Requires Tc2_TcpIp.
   All Dashboard commands are sent with LF ($N).
*)

bResponseValid := FALSE;

(* Edge detection *)
rConnect(CLK := bConnect);
rLoadProgram(CLK := bLoadProgram);
rPlay(CLK := bPlay);
rStopProgram(CLK := bStop);
rPause(CLK := bPause);
rQuit(CLK := bQuit);
rShutdown(CLK := bShutdown);
rRunning(CLK := bRunning);
rRobotMode(CLK := bRobotMode);
rGetLoadedProgram(CLK := bGetLoadedProgram);
rIsProgramSaved(CLK := bIsProgramSaved);
rProgramState(CLK := bProgramState);
rSetOperationalMode(CLK := bSetOperationalMode);
rGetOperationalMode(CLK := bGetOperationalMode);
rClearOperationalMode(CLK := bClearOperationalMode);
rPowerOn(CLK := bPowerOn);
rPowerOff(CLK := bPowerOff);
rBrakeRelease(CLK := bBrakeRelease);


(* Response watchdog. Long-running report/support commands set a longer timeout. *)
tonResponse(
    IN := (nState = 36) OR (nState = 13),
    PT := tActiveResponseTimeout
);

CASE nState OF

    // --------------------------------------------------
    // 0 = Idle / disconnected
    // --------------------------------------------------
    0:
        bConnected := FALSE;
        bBusy := FALSE;

        IF rConnect.Q OR bConnectRequest THEN
            bConnectRequest := FALSE;
            bError := FALSE;
            nErrorID := 0;
            bConnectExecute := TRUE;
            bBusy := TRUE;
            nState := 10;
        END_IF


    // --------------------------------------------------
    // 10 = Connect to UR Dashboard port 29999
    // --------------------------------------------------
    10:
        fbConnect(
            sSrvNetId   := '',
            sRemoteHost := sRobotIP,
            nRemotePort := 29999,
            bExecute    := bConnectExecute,
            tTimeout    := T#10S
        );

        IF fbConnect.bBusy THEN
            bConnectExecute := FALSE;
        END_IF

        IF NOT fbConnect.bBusy AND NOT bConnectExecute THEN
            IF fbConnect.bError THEN
                bError := TRUE;
                nErrorID := fbConnect.nErrId;
                bBusy := FALSE;
                nState := 0;
            ELSE
                hSocket := fbConnect.hSocket;
                bConnected := TRUE;

                (* Dashboard sends a greeting immediately after connection.
                   Read it first so it cannot be mistaken for a command reply. *)
                sRx := '';
                bReceiveExecute := TRUE;
                bWaitingForGreeting := TRUE;
                tActiveResponseTimeout := T#3S;
                nState := 13;
            END_IF
        END_IF


    // --------------------------------------------------
    // 13 = Receive connection greeting
    // --------------------------------------------------
    13:
        fbReceive(
            sSrvNetId := '',
            hSocket   := hSocket,
            cbLen     := SIZEOF(sRx) - 1,
            pDest     := ADR(sRx),
            bExecute  := bReceiveExecute,
            tTimeout  := T#1S
        );

        IF fbReceive.bBusy THEN
            bReceiveExecute := FALSE;
        END_IF

        IF NOT fbReceive.bBusy AND NOT bReceiveExecute THEN
            IF fbReceive.bError THEN
                (* Greeting is useful but not required for command operation. *)
                bError := TRUE;
                nErrorID := fbReceive.nErrId;
                bBusy := FALSE;
                nState := 20;

            ELSIF fbReceive.nRecBytes > 0 THEN
                nRxLen := fbReceive.nRecBytes;
                pRxByte := ADR(sRx);
                IF nRxLen < SIZEOF(sRx) THEN
                    pRxByte[nRxLen] := 0;
                END_IF
                sGreeting := sRx;
                bWaitingForGreeting := FALSE;
                bBusy := FALSE;
                nState := 20;

            ELSIF tonResponse.Q THEN
                (* Continue even if greeting was not captured. *)
                bWaitingForGreeting := FALSE;
                bBusy := FALSE;
                nState := 20;

            ELSE
                (* Poll again on the next PLC cycle. *)
                sRx := '';
                bReceiveExecute := TRUE;
            END_IF
        END_IF


    // --------------------------------------------------
    // 20 = Connected / accept input-variable commands
    // --------------------------------------------------
    20:
        bConnected := TRUE;
        bBusy := FALSE;

    IF rLoadProgram.Q THEN
        QueueCommand(sCmd := CONCAT('load ', sProgramPath), tWait := tResponseTimeout);
    ELSIF rPlay.Q THEN
        QueueCommand(sCmd := 'play', tWait := tResponseTimeout);
    ELSIF rStopProgram.Q THEN
        QueueCommand(sCmd := 'stop', tWait := tResponseTimeout);
    ELSIF rPause.Q THEN
        QueueCommand(sCmd := 'pause', tWait := tResponseTimeout);
    ELSIF rQuit.Q THEN
        QueueCommand(sCmd := 'quit', tWait := tResponseTimeout);
    ELSIF rShutdown.Q THEN
        QueueCommand(sCmd := 'shutdown', tWait := tResponseTimeout);
    ELSIF rRunning.Q THEN
        QueueCommand(sCmd := 'running', tWait := tResponseTimeout);
    ELSIF rRobotMode.Q THEN
        QueueCommand(sCmd := 'robotmode', tWait := tResponseTimeout);
    ELSIF rGetLoadedProgram.Q THEN
        QueueCommand(sCmd := 'get loaded program', tWait := tResponseTimeout);
    ELSIF rIsProgramSaved.Q THEN
        QueueCommand(sCmd := 'isProgramSaved', tWait := tResponseTimeout);
    ELSIF rProgramState.Q THEN
        QueueCommand(sCmd := 'programState', tWait := tResponseTimeout);
    ELSIF rSetOperationalMode.Q THEN
        QueueCommand(sCmd := CONCAT('set operational mode ', sOperationalMode), tWait := tResponseTimeout);
    ELSIF rGetOperationalMode.Q THEN
        QueueCommand(sCmd := 'get operational mode', tWait := tResponseTimeout);
    ELSIF rClearOperationalMode.Q THEN
        QueueCommand(sCmd := 'clear operational mode', tWait := tResponseTimeout);
    ELSIF rPowerOn.Q THEN
        QueueCommand(sCmd := 'power on', tWait := tResponseTimeout);
    ELSIF rPowerOff.Q THEN
        QueueCommand(sCmd := 'power off', tWait := tResponseTimeout);
    ELSIF rBrakeRelease.Q THEN
        QueueCommand(sCmd := 'brake release', tWait := tResponseTimeout);
    END_IF

        IF bCommandPending THEN
            sLastCommand := sQueuedCommand;
            sTx := CONCAT(sQueuedCommand, '$N');

            tActiveResponseTimeout := tQueuedResponseTimeout;
            bCommandPending := FALSE;
            bSendExecute := TRUE;
            bBusy := TRUE;
            nState := 30;

        ELSIF NOT bConnect THEN
            (* Local disconnect if maintained bConnect is dropped. *)
            bCloseExecute := TRUE;
            bBusy := TRUE;
            nState := 40;
        END_IF


    // --------------------------------------------------
    // 30 = Send Dashboard command
    // --------------------------------------------------
    30:
        fbSend(
            sSrvNetId := '',
            hSocket   := hSocket,
            cbLen     := LEN(sTx),
            pSrc      := ADR(sTx),
            bExecute  := bSendExecute,
            tTimeout  := T#5S
        );

        IF fbSend.bBusy THEN
            bSendExecute := FALSE;
        END_IF

        IF NOT fbSend.bBusy AND NOT bSendExecute THEN
            IF fbSend.bError THEN
                bError := TRUE;
                nErrorID := fbSend.nErrId;
                bConnected := FALSE;
                bBusy := FALSE;
                nState := 0;
            ELSE
                (* Every Dashboard command has a reply. *)
                sRx := '';
                bReceiveExecute := TRUE;
                bBusy := TRUE;
                nState := 36;
            END_IF
        END_IF


    // --------------------------------------------------
    // 36 = Poll for Dashboard response
    // --------------------------------------------------
    36:
        fbReceive(
            sSrvNetId := '',
            hSocket   := hSocket,
            cbLen     := SIZEOF(sRx) - 1,
            pDest     := ADR(sRx),
            bExecute  := bReceiveExecute,
            tTimeout  := T#1S
        );

        IF fbReceive.bBusy THEN
            bReceiveExecute := FALSE;
        END_IF

        IF NOT fbReceive.bBusy AND NOT bReceiveExecute THEN
            IF fbReceive.bError THEN
                bError := TRUE;
                nErrorID := fbReceive.nErrId;
                bBusy := FALSE;
                nState := 20;

            ELSIF fbReceive.nRecBytes > 0 THEN
                nRxLen := fbReceive.nRecBytes;
                pRxByte := ADR(sRx);

                (* Ensure TwinCAT STRING termination after raw socket receive. *)
                IF nRxLen < SIZEOF(sRx) THEN
                    pRxByte[nRxLen] := 0;
                END_IF

                sLastResponse := sRx;
                bResponseValid := TRUE;
                bBusy := FALSE;

                (* quit/shutdown normally terminate the Dashboard connection. *)
                IF (sLastCommand = 'quit') OR (sLastCommand = 'shutdown') THEN
                    bConnected := FALSE;
                    nState := 0;
                ELSE
                    nState := 20;
                END_IF

            ELSIF tonResponse.Q THEN
                (* Application-level reply timeout. *)
                bError := TRUE;
                nErrorID := 16#FFFF0001;
                sLastResponse := 'Dashboard response timeout';
                bResponseValid := TRUE;
                bBusy := FALSE;
                nState := 20;

            ELSE
                (* No bytes yet: generate a new positive edge for FB_SocketReceive. *)
                sRx := '';
                bReceiveExecute := TRUE;
            END_IF
        END_IF


    // --------------------------------------------------
    // 40 = Close local socket
    // --------------------------------------------------
    40:
        fbClose(
            sSrvNetId := '',
            hSocket   := hSocket,
            bExecute  := bCloseExecute,
            tTimeout  := T#5S
        );

        IF fbClose.bBusy THEN
            bCloseExecute := FALSE;
        END_IF

        IF NOT fbClose.bBusy AND NOT bCloseExecute THEN
            IF fbClose.bError THEN
                bError := TRUE;
                nErrorID := fbClose.nErrId;
            END_IF

            bConnected := FALSE;
            bBusy := FALSE;
            nState := 0;
        END_IF

END_CASE]]></ST>
    </Implementation>
    <Method Name="BrakeRelease" Id="{299fa4e4-07b9-41b1-bd32-71002da8afdc}">
      <Declaration><![CDATA[METHOD PUBLIC BrakeRelease : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[BrakeRelease := QueueCommand(
    sCmd := 'brake release',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearOperationalMode" Id="{883de148-6a25-4ce2-87f4-9195983f5cbb}">
      <Declaration><![CDATA[METHOD PUBLIC ClearOperationalMode : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[ClearOperationalMode := QueueCommand(
    sCmd := 'clear operational mode',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Connect" Id="{0e69200d-c84d-42e8-87b5-ae1307111b65}">
      <Declaration><![CDATA[METHOD PUBLIC Connect : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bConnected AND (nState = 0) THEN
    bConnectRequest := TRUE;
    Connect := TRUE;
ELSE
    Connect := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Disconnect" Id="{e96d68c1-de65-4359-a32a-cffa213cf050}">
      <Declaration><![CDATA[METHOD PUBLIC Disconnect : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bConnected AND (nState = 20) THEN
    bCloseExecute := TRUE;
    bBusy := TRUE;
    nState := 40;
    Disconnect := TRUE;
ELSE
    Disconnect := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetLoadedProgram" Id="{dfc3ceb7-3d1f-4567-b1af-68a3581addfa}">
      <Declaration><![CDATA[METHOD PUBLIC GetLoadedProgram : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetLoadedProgram := QueueCommand(
    sCmd := 'get loaded program',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetOperationalMode" Id="{a8d2747d-efb8-43f2-a8b5-975c050d2062}">
      <Declaration><![CDATA[METHOD PUBLIC GetOperationalMode : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetOperationalMode := QueueCommand(
    sCmd := 'get operational mode',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsInRemoteControl" Id="{c7334ea5-71c7-4928-a1c7-3e19c367b56b}">
      <Declaration><![CDATA[METHOD PUBLIC IsInRemoteControl : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsInRemoteControl := QueueCommand(
    sCmd := 'is in remote control',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsProgramSaved" Id="{67ed81ed-7abf-4b5d-8caf-1633f21db0da}">
      <Declaration><![CDATA[METHOD PUBLIC IsProgramSaved : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsProgramSaved := QueueCommand(
    sCmd := 'isProgramSaved',
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="LastResponse" Id="{18ea81e5-8ea1-4170-9f6f-c6af1ee83ab0}">
      <Declaration><![CDATA[PROPERTY LastResponse : STRING(1023)]]></Declaration>
      <Get Name="Get" Id="{384ed8e0-9872-4770-9d1d-5461a45a838d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LastResponse:=sLastResponse;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="LastResponseIncludes" Id="{2d94ffe6-dee2-4976-9140-e415790175de}">
      <Declaration><![CDATA[METHOD LastResponseIncludes : BOOL
VAR_INPUT
	str: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF FIND(sLastResponse,str) >0 THEN
	LastResponseIncludes:=TRUE;
ELSE
	LastResponseIncludes:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoadInstallation" Id="{13d2b7d2-2cc4-4f2d-a875-eda5debde05d}">
      <Declaration><![CDATA[METHOD PUBLIC LoadInstallation : BOOL
VAR_INPUT
    sPath : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[LoadInstallation := QueueCommand(
    sCmd := CONCAT('load installation ', sPath),
    tWait := tResponseTimeout
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoadProgram" Id="{de4b5aef-29f0-4651-bae5-0c16534920c8}">
      <Declaration><![CDATA[METHOD PUBLIC LoadProgram : BOOL
VAR_INPUT
