    <Property Name="POS_BALL" Id="{2952c0a8-552d-4730-8f39-75e6ef74a6cd}">
      <Declaration><![CDATA[PROPERTY POS_BALL : ARRAY[1..2] OF INT
]]></Declaration>
      <Get Name="Get" Id="{970582cf-e6eb-493f-9e2c-da7fc7b15f3a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[POS_BALL[1] := TO_INT(aCenter[0]);
POS_BALL[2] := TO_INT(aCenter[1]);]]></ST>
        </Implementation>
