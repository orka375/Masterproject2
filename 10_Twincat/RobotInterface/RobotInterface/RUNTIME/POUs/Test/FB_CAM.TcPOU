    aColorGreen : TcVnVector4_LREAL := [0, 255, 0];
    aColorRed   : TcVnVector4_LREAL := [200, 0, 0];

    stEllipse : TcVnRotatedRectangle;
    aCenter : TcVnPoint2_REAL := [650, 400];

    sText : STRING(255);
    cxy : ARRAY [1..2] OF REAL;
    cx, cy : REAL;
	ipImageResDisp: Tc3_Vision.ITcVnDisplayableImage;
	ipImageWorkColDisp: Tc3_Vision.ITcVnDisplayableImage;
	eOperator: Tc3_Vision.ETcVnMorphologicalOperator := TCVN_MO_CLOSING;
	ipElement: Tc3_Vision.ITcVnImage;
	eSEShape: Tc3_Vision.ETcVnStructuringElementShape;
	aSESize     :  ARRAY [0..1] OF UDINT := [30, 30]; 
	THRESHOLD: LREAL := 150;
END_VAR
]]></Declaration>
