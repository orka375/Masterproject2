<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_3_COMM_AXIS_JSC_XENAX" Id="{8abd6177-0114-4a15-8bc8-4afff152259e}" SpecialFunc="None">
    <Declaration><![CDATA[
FUNCTION_BLOCK FB_3_COMM_AXIS_JSC_XENAX EXTENDS FB_1_COMM
VAR_INPUT
    ReferenceMode : INT := gcJS_MC.jsmcREFERENCE_MODE_DONT_CHANGE;
    PowerOverride : LREAL := 100.0;
	instJS_MC_Init : JS_MC_Init;
END_VAR
VAR_OUTPUT
  
  Powered : BOOL;
  Homed : BOOL;
  ActualPosition : LREAL;
  ActualVelocity : LREAL;
END_VAR
VAR
    instJS_MC_CyclicIn : JS_MC_CyclicIn;
    instJS_MC_CyclicOut : JS_MC_CyclicOut;
    instJS_MC_Power : JS_MC_Power;
    instJS_MC_Reference : JS_MC_Reference;
    instJS_MC_Stop : JS_MC_Stop;
    instJS_MC_Reset : JS_MC_Reset;
    instJS_MC_ReadAxisError : JS_MC_ReadAxisError;
    instJS_MC_AxisErrorCollector : JS_MC_AxisErrorCollector;

    // In CSP mode the supplied example drives pstAxis^.AxisRef with Beckhoff MC blocks.
    _fbMoveAbsolute : MC_MoveAbsolute;
    _fbMoveRelative : MC_MoveRelative;

    _powerRequest : BOOL;
    _moveAbsExecute : BOOL;
    _moveRelExecute : BOOL;
    _homeExecute : BOOL;
    _stopExecute : BOOL;
    _resetExecute : BOOL;
    _commandAccepted : BOOL;
    _startupResetDone : BOOL;
    _cyclicWasValid : BOOL;
	NCAxis: AXIS_REF;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ------ CALL CYCLIC -----------------
instJS_MC_Init();
CYCLIC_COMM();
instJS_MC_Init.pstAxis^.AxisRef:=NCAxis;

// ------ WRITE HMI -------------------
// NO HMI STRUCT


// ------ READ FROM HMI ---------------
// NO HMI STRUCT


// ------ WRITE PROPS/METHODS ---------
	//FINAL
Connected:= instJS_MC_Init.Valid AND instJS_MC_CyclicIn.Valid AND NOT instJS_MC_CyclicIn.Error;
CanAcceptCommand := Operational AND NOT Busy AND NOT _stopExecute AND NOT _resetExecute;

	//OVERRIDE
Operational := _startupResetDone;

// ------ CALL POUS AND ERROR SURVEILLANCE ----------

_fbMoveAbsolute(
    Axis    := instJS_MC_Init.pstAxis^.AxisRef,
    Execute := _moveAbsExecute
);

_fbMoveRelative(
    Axis    := instJS_MC_Init.pstAxis^.AxisRef,
    Execute := _moveRelExecute
);

instJS_MC_Init.pstAxis^.AxisRef.ReadStatus();

instJS_MC_Reference.Execute := _homeExecute;
instJS_MC_Stop.Execute      := _stopExecute;
instJS_MC_Reset.Execute     := _resetExecute;

instJS_MC_Power(
    pstAxis := instJS_MC_Init.pstAxis
);

instJS_MC_Reference(
    pstAxis := instJS_MC_Init.pstAxis
);

instJS_MC_Stop(
    pstAxis := instJS_MC_Init.pstAxis
);

instJS_MC_Reset(
    pstAxis := instJS_MC_Init.pstAxis
);

instJS_MC_ReadAxisError(
    pstAxis := instJS_MC_Init.pstAxis
);

instJS_MC_AxisErrorCollector(
    pstAxis := instJS_MC_Init.pstAxis
);

Powered :=
    instJS_MC_Power.Status
    AND instJS_MC_Power.Valid;

ActualPosition :=
    instJS_MC_Init.pstAxis^.AxisRef.NcToPlc.ActPos;

ActualVelocity :=
    instJS_MC_Init.pstAxis^.AxisRef.NcToPlc.ActVelo;


IF _fbMoveAbsolute.Error THEN
    Messenger.AddError(
        eMessageCategories.HardwareFailure,
        CONCAT(Path, '.MoveAbsolute'),
        'MC_MoveAbsolute error'
    );
END_IF

IF _fbMoveRelative.Error THEN
    Messenger.AddError(
        eMessageCategories.HardwareFailure,
        CONCAT(Path, '.MoveRelative'),
        'MC_MoveRelative error'
    );
END_IF

IF instJS_MC_ReadAxisError.AxisError THEN
    Messenger.AddError(
        eMessageCategories.HardwareFailure,
        CONCAT(Path, '.Axis'),
        'JSC axis error'
    );
END_IF


// ------ CONFIGURATION ----------------

instJS_MC_Power.Enable :=
    _powerRequest
    AND _startupResetDone;

instJS_MC_ReadAxisError.Enable := TRUE;

IF NOT instJS_MC_Init.Valid THEN
    instJS_MC_Init.OperationMode :=
        gcJS_MC.jsmcMODE_CYCLIC_SYNC;

    instJS_MC_Reference.ReferenceMode :=
        INT_TO_USINT(ReferenceMode);

    instJS_MC_Power.Enable_Positive := TRUE;
    instJS_MC_Power.Enable_Negative := TRUE;
    instJS_MC_Power.Override        := PowerOverride;
END_IF


// ------ CYCLIC COMMUNICATION ----------

instJS_MC_CyclicIn.Enable :=
    RequestConnection
    AND instJS_MC_Init.Valid;

IF instJS_MC_Init.Valid THEN
    instJS_MC_CyclicIn(
        pstAxis := instJS_MC_Init.pstAxis
    );

    instJS_MC_CyclicOut(
        pstAxis := instJS_MC_Init.pstAxis
    );
END_IF


// ------ OPERATION ---------------------

IF instJS_MC_Init.Valid
    AND instJS_MC_CyclicIn.Valid
THEN

    // Perform one reset after communication startup.
    IF NOT _startupResetDone THEN
        _resetExecute := TRUE;
    END_IF


    // ----- ACTIVE COMMAND HANDLING -----

    IF Busy THEN

        IF Messenger.HasActivError
            OR NOT FB_1_COMM.Operational
        THEN
            _moveAbsExecute := FALSE;
            _moveRelExecute := FALSE;
            _homeExecute    := FALSE;
            _commandAccepted := FALSE;

            ActiveCommandID := 0;
            CommandState    := eProgress.FINALIZED;
            CommandResult   := eResult.ERROR;
            FB_1_COMM.Busy  := FALSE;

        ELSIF _fbMoveAbsolute.CommandAborted
            OR _fbMoveRelative.CommandAborted
        THEN
            _moveAbsExecute  := FALSE;
            _moveRelExecute  := FALSE;
            _homeExecute     := FALSE;
            _commandAccepted := FALSE;

            ActiveCommandID := 0;
            CommandState    := eProgress.ABORTED;
            CommandResult   := eResult.FAILURE;
            FB_1_COMM.Busy  := FALSE;

        ELSIF _fbMoveAbsolute.Done
            OR _fbMoveRelative.Done
            OR instJS_MC_Reference.Done
        THEN
            IF instJS_MC_Reference.Done THEN
                Homed := TRUE;
            END_IF

            _moveAbsExecute  := FALSE;
            _moveRelExecute  := FALSE;
            _homeExecute     := FALSE;
            _commandAccepted := FALSE;

            ActiveCommandID := 0;
            CommandState    := eProgress.FINALIZED;
            CommandResult   := eResult.SUCCESS;
            FB_1_COMM.Busy  := FALSE;

        ELSIF NOT _commandAccepted
            AND (
                _fbMoveAbsolute.Busy
                OR _fbMoveRelative.Busy
                OR instJS_MC_Reference.Busy
            )
        THEN
            _commandAccepted := TRUE;
            AcceptedCommandID := _commActiveCommandID;
            CommandState      := eProgress.ACKNOWLEDGE;

            // PLCopen motion FBs only require the Execute edge.
            _moveAbsExecute := FALSE;
            _moveRelExecute := FALSE;

        ELSIF _commandAccepted
            AND (
                _fbMoveAbsolute.Busy
                OR _fbMoveRelative.Busy
                OR instJS_MC_Reference.Busy
            )
        THEN
            CommandState := eProgress.RUNNING;
        END_IF

    END_IF


    // ----- STOP/RESET HANDLING ---------

    IF instJS_MC_Stop.Done THEN
        _stopExecute := FALSE;
    END_IF

    IF instJS_MC_Reset.Done THEN
        _resetExecute     := FALSE;
        _startupResetDone := TRUE;
    END_IF

ELSE

    // Initialization or cyclic communication is unavailable.
    Powered        := FALSE;
    Homed          := FALSE;
    ActualVelocity := 0.0;

    _powerRequest   := FALSE;
    _moveAbsExecute := FALSE;
    _moveRelExecute := FALSE;
    _homeExecute    := FALSE;
    _stopExecute    := FALSE;
    _resetExecute   := FALSE;

    _commandAccepted := FALSE;
    _startupResetDone := FALSE;

    IF Busy THEN
        ActiveCommandID := 0;
        CommandState    := eProgress.FINALIZED;
        CommandResult   := eResult.ERROR;
        FB_1_COMM.Busy  := FALSE;
    END_IF

END_IF


// ------ CONNECTION TIMEOUT ------------

IF _tonConnectTimeout.Q
    AND NOT instJS_MC_Init.Valid
THEN
    Messenger.AddWarn(
        eMessageCategories.TimeoutFailure,
        CONCAT(Path, '.Init'),
        'JSC initialization did not become valid'
    );
END_IF


]]></ST>
    </Implementation>
    <Method Name="CancelCommand" Id="{1005bcbc-44f8-4f4b-a931-047ea1c4e83c}">
      <Declaration><![CDATA[METHOD PUBLIC CancelCommand : BOOL
VAR_INPUT CommandID : UINT; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CancelCommand := FALSE;
IF (CommandID = 0) OR (CommandID <> _commActiveCommandID) THEN RETURN; END_IF
IF NOT StopMotion() THEN RETURN; END_IF
_moveAbsExecute := FALSE;
_moveRelExecute := FALSE;
_homeExecute := FALSE;
ActiveCommandID := 0;
CommandState := eProgress.ABORTED;
CommandResult :=eResult.FAILURE;
FB_1_COMM.Busy := FALSE;
CancelCommand := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Operational" Id="{3082dfe5-e7b8-4a72-8bef-7a3622f99406}">
      <Declaration><![CDATA[PROPERTY Operational : BOOL]]></Declaration>
      <Set Name="Set" Id="{171050e5-ca18-45b7-8b14-978ef8b62a9f}">
        <Declaration><![CDATA[
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SUPER^.Operational := Operational;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Power" Id="{d7461d4d-8148-41fa-9691-dbec150a61d6}">
      <Declaration><![CDATA[METHOD PUBLIC Power : BOOL
VAR_INPUT Enable : BOOL; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_powerRequest := Enable;
Power := instJS_MC_Init.Valid;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetAxis" Id="{42c61e6a-83c0-48ee-9640-aaefa94e4fbd}">
      <Declaration><![CDATA[METHOD PUBLIC ResetAxis : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT instJS_MC_Init.Valid THEN ResetAxis := FALSE; RETURN; END_IF
_resetExecute := TRUE;
ResetAxis := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetCommunication" Id="{6f453cd1-37c3-4b2f-8c3c-6f9c0288e8dd}">
      <Declaration><![CDATA[METHOD PUBLIC ResetCommunication : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[instJS_MC_CyclicIn.Enable := FALSE;
_powerRequest := FALSE;
_moveAbsExecute := FALSE;
_moveRelExecute := FALSE;
_homeExecute := FALSE;
_stopExecute := FALSE;
_resetExecute := FALSE;
_commandAccepted := FALSE;
_startupResetDone := FALSE;
_cyclicWasValid := FALSE;
Homed := FALSE;
Powered := FALSE;
ActualVelocity := 0.0;
CanAcceptCommand := FALSE;
AcceptedCommandID := 0;
ActiveCommandID := 0;
FB_1_COMM.Busy := FALSE;
CommandState := eProgress.INIT;
CommandResult :=eResult.NONE;
Reconnect();
ResetCommunication := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendHome" Id="{1e4f418c-0766-423b-9d50-1ba38126266c}">
      <Declaration><![CDATA[METHOD PUBLIC SendHome : BOOL
VAR_INPUT CommandID : UINT; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendHome := FALSE;
IF (CommandID = 0) OR NOT CanAcceptCommand OR NOT instJS_MC_Init.Valid THEN RETURN; END_IF
Homed := FALSE;
_homeExecute := TRUE;
_commandAccepted := FALSE;
AcceptedCommandID := 0;
ActiveCommandID := CommandID;
CommandState := eProgress.INIT;
CommandResult :=eResult.NONE;
FB_1_COMM.Busy := TRUE;
SendHome := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendMoveAbsolute" Id="{aaf3e497-9e5b-490b-a106-e132e12a1588}">
      <Declaration><![CDATA[METHOD PUBLIC SendMoveAbsolute : BOOL
VAR_INPUT CommandID : UINT; Position : LREAL; Velocity : LREAL; Acceleration : LREAL; Deceleration : LREAL; Jerk : LREAL; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendMoveAbsolute := FALSE;
IF (CommandID = 0) OR NOT CanAcceptCommand OR NOT instJS_MC_Init.Valid THEN RETURN; END_IF
_fbMoveAbsolute.Position := Position;
_fbMoveAbsolute.Velocity := Velocity;
_fbMoveAbsolute.Acceleration := Acceleration;
_fbMoveAbsolute.Deceleration := Deceleration;
_fbMoveAbsolute.Jerk := Jerk;
_moveAbsExecute := TRUE;
_commandAccepted := FALSE;
AcceptedCommandID := 0;
ActiveCommandID := CommandID;
CommandState := eProgress.INIT;
CommandResult :=eResult.NONE;
FB_1_COMM.Busy := TRUE;
SendMoveAbsolute := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendMoveRelative" Id="{32c0ffa2-060b-49ea-a4f9-c3cdf1d0e6c9}">
      <Declaration><![CDATA[METHOD PUBLIC SendMoveRelative : BOOL
VAR_INPUT CommandID : UINT; Distance : LREAL; Velocity : LREAL; Acceleration : LREAL; Deceleration : LREAL; Jerk : LREAL; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendMoveRelative := FALSE;
IF (CommandID = 0) OR NOT CanAcceptCommand OR NOT instJS_MC_Init.Valid THEN RETURN; END_IF
_fbMoveRelative.Distance := Distance;
_fbMoveRelative.Velocity := Velocity;
_fbMoveRelative.Acceleration := Acceleration;
_fbMoveRelative.Deceleration := Deceleration;
_fbMoveRelative.Jerk := Jerk;
_moveRelExecute := TRUE;
_commandAccepted := FALSE;
AcceptedCommandID := 0;
ActiveCommandID := CommandID;
CommandState := eProgress.INIT;
CommandResult :=eResult.NONE;
FB_1_COMM.Busy := TRUE;
SendMoveRelative := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopMotion" Id="{32bb82d3-54f6-4f6b-b9d4-38e883063dfe}">
      <Declaration><![CDATA[METHOD PUBLIC StopMotion : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[StopMotion := FALSE;
IF NOT FB_1_COMM.Operational THEN RETURN; END_IF
_moveAbsExecute := FALSE;
_moveRelExecute := FALSE;
_homeExecute := FALSE;
_stopExecute := TRUE;
StopMotion := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>