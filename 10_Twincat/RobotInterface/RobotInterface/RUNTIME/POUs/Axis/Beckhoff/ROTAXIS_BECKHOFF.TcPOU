<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="ROTAXIS_BECKHOFF" Id="{317064f0-d9b0-43a6-b27e-f453e25a795f}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK ROTAXIS_BECKHOFF EXTENDS FB_2_ROB_AXIS
VAR_IN_OUT
    // Physical Beckhoff NC axis. All PLCopen/vendor-specific handling stays in AXIS_COMM.
    NCAxis : AXIS_REF;
END_VAR
VAR_OUTPUT
    // Concrete communication adapter, exposed for diagnostics in the same style as ROBOT_UR.UR_COMM.
    AXIS_COMM : FB_3_COMM_AXIS_BECKHOFF;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Run the manufacturer-specific adapter first.
AXIS_COMM(Axis := NCAxis);

// Wire the generic axis and robot communication boundaries to this adapter.
AxisComm := ADR(AXIS_COMM);
COMM := ADR(AXIS_COMM);

// Execute the complete manufacturer-neutral linear-axis implementation.
SUPER^();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>