<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_2_ROB_AXIS" Id="{7cf866bc-acd8-4ca1-b1b9-cc8d0da034fd}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'hide_all_locals'}
FUNCTION_BLOCK FB_2_ROB_AXIS EXTENDS FB_1_ROB

VAR_INPUT
	SET_A : stSettings_Axis;
END_VAR

VAR_OUTPUT
  HMI_ROB_AXIS : stHMI_ROB_AXIS;
END_VAR
VAR
  _axisPowered : BOOL;
  _axisHomed : BOOL;
  _axisActualPosition : LREAL;
  _axisActualVelocity : LREAL;
  _axisTargetPosition : LREAL;
  _axisTargetValid : BOOL;
    _axisCommandActive : BOOL;
    _activeCommand : eCommands;
	_Init_Axis: BOOL;
	h: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CYCLIC_AXIS();]]></ST>
    </Implementation>
    <Method Name="CommitAxisCommand" Id="{49deea93-5d94-4118-b965-e1ddfb619d08}">
      <Declaration><![CDATA[METHOD PROTECTED CommitAxisCommand : UINT
VAR_INPUT
    Cmd : eCommands;
    NewCommandID : UINT;
    TargetPosition : LREAL;
    TargetValid : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CommitAxisCommand := 0;
IF NewCommandID = 0 THEN RETURN; END_IF

nCommandID := NewCommandID;
eCommandStatus := eProgress.INIT;
eCommandResult := eResult.NONE;
_activeCommand := Cmd;
_axisCommandActive := TRUE;
_axisTargetPosition := TargetPosition;
_axisTargetValid := TargetValid;
CommitAxisCommand := NewCommandID;]]></ST>
      </Implementation>
    </Method>
    <Action Name="CYCLIC_AXIS" Id="{22130f11-3575-4ab1-80b6-a2e493f717bd}">
      <Implementation>
        <ST><![CDATA[// ------ CALL CYCLIC -----------------
IF NOT _Init_Axis THEN
	_Init_Axis:=TRUE;
	SETUP_AXIS();
END_IF

CYCLIC_ROB();

// ------ WRITE HMI -------------------
HMI_ROB_AXIS.AxisPowered := _axisPowered;
HMI_ROB_AXIS.AxisHomed := _axisHomed;
HMI_ROB_AXIS.ActualPosition := _axisActualPosition;
HMI_ROB_AXIS.ActualVelocity := _axisActualVelocity;
HMI_ROB_AXIS.AtMinLimit := _axisActualPosition <= (SET_A.MinPosition + SET_A.PositionTolerance);
HMI_ROB_AXIS.AtMaxLimit := _axisActualPosition >= (SET_A.MaxPosition - SET_A.PositionTolerance);
HMI_ROB_AXIS.InPosition := _axisTargetValid AND (ABS(_axisActualPosition - _axisTargetPosition) <= SET_A.PositionTolerance);


// ------ READ FROM HMI ---------------


// ------ WRITE PROPS/METHODS ---------
  Homed := _axisHomed;
  JointPos_PLCUnit.joint1 := _axisActualPosition;
  JointVel_PLCUnit.joint1 := _axisActualVelocity;
  
  
IF SET_A.RequireHomedForPositioning THEN
	Operational := HMI_ROB_AXIS.ConfigurationValid AND _axisHomed;
ELSE
	Operational := HMI_ROB_AXIS.ConfigurationValid;
END_IF




// ----- CALL POUS AND ERROR SURVEILLANCE ----------


// ----- REST --------------------



    IF _axisCommandActive THEN
      eCommandStatus := COMM^.CommandState;
      eCommandResult := COMM^.CommandResult;

        IF (eCommandStatus = eProgress.FINALIZED)
           OR (eCommandStatus = eProgress.ABORTED) THEN
        IF (eCommandStatus = eProgress.FINALIZED)
           AND (eCommandResult = eResult.SUCCESS)
           AND _axisTargetValid
           AND NOT HMI_ROB_AXIS.InPosition THEN
          eCommandResult := eResult.FAILURE;
        END_IF
            _axisCommandActive := FALSE;
        END_IF
    END_IF
END_IF


]]></ST>
      </Implementation>
    </Action>
    <Method Name="MoveAbsolute" Id="{703f4764-794a-460f-a71a-f3edb4a5692c}">
      <Declaration><![CDATA[METHOD PUBLIC MoveAbsolute : UINT
VAR_INPUT
    Position : LREAL;
    Velocity : LREAL := 0.0;
    Acceleration : LREAL := 0.0;
END_VAR
VAR
    Settings : stCommand_Settings;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Settings.Target.pose.x := Position;
Settings.Velocity := Velocity;
Settings.Acceleration := Acceleration;
MoveAbsolute := CommandHandler(Cmd := eCommands.MoveL, Settings := Settings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveRelative" Id="{3cff1824-2665-4bcb-a77b-94f33ba8001c}">
      <Declaration><![CDATA[METHOD PUBLIC MoveRelative : UINT
VAR_INPUT
    Distance : LREAL;
    Velocity : LREAL := 0.0;
    Acceleration : LREAL := 0.0;
END_VAR
VAR
    Settings : stCommand_Settings;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Settings.Pose.x := Distance;
Settings.Velocity := Velocity;
Settings.Acceleration := Acceleration;
MoveRelative := CommandHandler(Cmd := eCommands.MoveLRelativ, Settings := Settings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCommandCancelled" Id="{c04973a0-7c49-42f7-ac66-1da6b2ca83fa}">
      <Declaration><![CDATA[METHOD PROTECTED OnCommandCancelled
VAR_INPUT
    CommandID : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_axisCommandActive := FALSE;
_axisTargetValid := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Operational" Id="{1d20a798-1110-4d48-b45f-38bf9971ee10}">
      <Declaration><![CDATA[PROPERTY Operational : BOOL]]></Declaration>
      <Set Name="Set" Id="{23cd9c8d-e612-4507-a9f3-7894efcefcf9}">
        <Declaration><![CDATA[
VAR
	h: BOOL;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[

SUPER^.Operational := Operational;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="PrepareAxisCommand" Id="{50fd267e-684c-4f32-aa42-74620d0a5a1e}">
      <Declaration><![CDATA[METHOD PROTECTED PrepareAxisCommand : BOOL
VAR_INPUT
    Cmd : eCommands;
    Settings : stCommand_Settings;
END_VAR
VAR_OUTPUT
    NewCommandID : UINT;
    TargetPosition : LREAL;
    TargetValid : BOOL;
    EffectiveVelocity : LREAL;
    EffectiveAcceleration : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[PrepareAxisCommand := FALSE;
NewCommandID := 0;
TargetPosition := 0.0;
TargetValid := FALSE;
EffectiveVelocity := 0.0;
EffectiveAcceleration := 0.0;

IF (_pSettingsAxis = 0) OR NOT FB_1_ROB.Operational OR _axisCommandActive THEN RETURN; END_IF

CASE Cmd OF
    eCommands.MoveL,
    eCommands.MoveJ:
        TargetPosition := Settings.Target.pose.x;
        TargetValid := TRUE;

    eCommands.MoveJJoints:
        TargetPosition := Settings.Joints.joint1;
        TargetValid := TRUE;

    eCommands.MoveLRelativ,
    eCommands.MoveJRelativ:
        TargetPosition := _axisActualPosition + Settings.Pose.x;
        TargetValid := TRUE;

    eCommands.Home:
        TargetValid := FALSE;

ELSE
    Messenger.AddError(eMessageCategories.NotImplemented, Path, 'Basic action not supported by axis');
    RETURN;
END_CASE

IF TargetValid THEN
    IF (TargetPosition < SET_A.MinPosition) OR (TargetPosition > SET_A.MaxPosition) THEN RETURN; END_IF
    IF NOT ValidateDynamics(Velocity := Settings.Velocity, Acceleration := Settings.Acceleration) THEN RETURN; END_IF

    EffectiveVelocity := Settings.Velocity;
    IF EffectiveVelocity = 0.0 THEN EffectiveVelocity := SET_A.DefaultVelocity; END_IF
    EffectiveAcceleration := Settings.Acceleration;
    IF EffectiveAcceleration = 0.0 THEN EffectiveAcceleration := SET_A.DefaultAcceleration; END_IF
END_IF

NewCommandID := AllocateCommandID();
PrepareAxisCommand := NewCommandID <> 0;]]></ST>
      </Implementation>
    </Method>
    <Action Name="SETUP_AXIS" Id="{2b3b66db-dbf7-4579-b8f6-9d533a2c5b9e}">
      <Implementation>
        <ST><![CDATA[SET_R:=SET_A;

HMI_ROB_AXIS.ConfigurationValid := ValidateConfiguration();]]></ST>
      </Implementation>
    </Action>
    <Method Name="ValidateConfiguration" Id="{8637ddc2-8443-4a23-a124-b1a4ea35a4ec}">
      <Declaration><![CDATA[METHOD PROTECTED ValidateConfiguration : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[ValidateConfiguration := FALSE;
      IF _pSettingsAxis = 0 THEN RETURN; END_IF
      IF SET_A.MinPosition >= SET_A.MaxPosition THEN RETURN; END_IF
      IF SET_A.PositionTolerance <= 0.0 THEN RETURN; END_IF
      IF SET_A.PositionTolerance >= ((SET_A.MaxPosition - SET_A.MinPosition) * 0.5) THEN RETURN; END_IF
      IF (SET_A.DefaultVelocity <= 0.0)
         OR (SET_A.DefaultAcceleration <= 0.0)
         OR (SET_A.DefaultDeceleration <= 0.0)
         OR (SET_A.DefaultJerk <= 0.0) THEN RETURN; END_IF
      IF (SET_A.MaxVelocity > 0.0) AND (SET_A.DefaultVelocity > SET_A.MaxVelocity) THEN RETURN; END_IF
      IF (SET_A.MaxAcceleration > 0.0) AND (SET_A.DefaultAcceleration > SET_A.MaxAcceleration) THEN RETURN; END_IF
      IF (SET_A.MaxDeceleration > 0.0) AND (SET_A.DefaultDeceleration > SET_A.MaxDeceleration) THEN RETURN; END_IF
      IF (SET_A.MaxJerk > 0.0) AND (SET_A.DefaultJerk > SET_A.MaxJerk) THEN RETURN; END_IF
ValidateConfiguration := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ValidateDynamics" Id="{6e84b03d-2a24-42cf-b1db-75dc01483567}">
      <Declaration><![CDATA[METHOD PROTECTED ValidateDynamics : BOOL
VAR_INPUT
    Velocity : LREAL;
    Acceleration : LREAL;
END_VAR
VAR
    EffectiveVelocity : LREAL;
    EffectiveAcceleration : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ValidateDynamics := FALSE;
IF _pSettingsAxis = 0 THEN RETURN; END_IF
IF (Velocity < 0.0) OR (Acceleration < 0.0) THEN RETURN; END_IF

EffectiveVelocity := Velocity;
IF EffectiveVelocity = 0.0 THEN EffectiveVelocity := SET_A.DefaultVelocity; END_IF
EffectiveAcceleration := Acceleration;
IF EffectiveAcceleration = 0.0 THEN EffectiveAcceleration := SET_A.DefaultAcceleration; END_IF

IF (EffectiveVelocity <= 0.0) OR (EffectiveAcceleration <= 0.0) THEN RETURN; END_IF
IF (SET_A.MaxVelocity > 0.0) AND (EffectiveVelocity > SET_A.MaxVelocity) THEN RETURN; END_IF
IF (SET_A.MaxAcceleration > 0.0) AND (EffectiveAcceleration > SET_A.MaxAcceleration) THEN RETURN; END_IF
ValidateDynamics := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>