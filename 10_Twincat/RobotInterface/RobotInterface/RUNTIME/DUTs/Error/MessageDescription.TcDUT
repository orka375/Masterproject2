<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="MessageDescription" Id="{39ffd807-d9e4-4c8b-9d95-0d96aa3e820a}">
    <Declaration><![CDATA[{attribute 'OPC.UA.DA.StructuredType' := '1'}
TYPE MessageDescription :
STRUCT
	Typ: eMessageTypes;				//ERROR, WARN, HINT
	Category: eMessageCategories;	//MissingInfo, NotImplemented etc.
	sSender: STRING;				//Beschreibung von User z.B. FB_Befüllen
	sMessage: STRING;				//Beschreibung von User z.B. "Tank bereits voll"
	tTime: TIME;					//Zeitpunkt wann Message generiert wurde
	bQuit: BOOL;					//Message wurde von User quittiert
	ID: UINT;						//ID von Message
	
END_STRUCT
END_TYPE





]]></Declaration>
  </DUT>
</TcPlcObject>