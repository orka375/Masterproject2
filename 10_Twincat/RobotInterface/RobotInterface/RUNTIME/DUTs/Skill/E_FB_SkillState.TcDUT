  <DUT Name="E_FB_SkillState" Id="{4e4a8c7a-d4a0-4588-b130-e5e3575789b8}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_FB_SkillState :
(
    Idle,
    WaitStartAck,
    WaitRunning,
    Running,

    WaitStopAck,
    WaitStopped,

    WaitAbortAck,
    WaitAborted,

    WaitRestartAck,
    WaitRestartStop,
    WaitRestartRunning,

    Done,
    Error
);
END_TYPE]]></Declaration>
