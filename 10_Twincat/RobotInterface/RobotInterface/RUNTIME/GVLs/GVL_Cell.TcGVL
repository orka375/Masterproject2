<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_Cell" Id="{4c8f2a10-6b21-4d7e-9a3c-2f1e7b9c0011}">
    <Declaration><![CDATA[{attribute 'global_init_slot' := '40800'}
// ==========================================================
// Robot cell instances for the HMI.
// Scalable manipulator collection: extend nRobotCount and the
// array bounds to add more robots. The HMI addresses robots by
// 1-based index (GVL_Cell.aRobot[SelectedRobot]).
// ==========================================================
VAR_GLOBAL CONSTANT
    // Number of manipulators in the cell. Kept in sync with the
    // array bounds below so HMI/PLC can range-check the selection.
    nRobotCount : INT := 2;
END_VAR

VAR_GLOBAL
    // UR5-01 / UR5-02. IP addresses are placeholders for commissioning.
    aRobot : ARRAY[1..2] OF ROBOT_UR := [
        (sRobotIp := '192.168.250.1'),
        (sRobotIp := '192.168.250.2')
    ];

    // One PickPlace skill instance per robot (assigned into aRobot[i].pA_Skills
    // in MAIN). Gives the HMI a stable per-robot skill symbol to bind to.
    aSkillPickPlace : ARRAY[1..2] OF Skill_PickPlace;

    // Cell-wide communication summary for the HMI header/footer.
    Comm : stHMI_COMM;
END_VAR

VAR_GLOBAL PERSISTENT
    // HMI robot selection (1-based index into aRobot). Retained across PLC restart.
    nSelectedRobot : INT := 1;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>