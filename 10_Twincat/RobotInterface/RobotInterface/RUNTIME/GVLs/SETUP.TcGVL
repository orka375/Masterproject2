<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="SETUP" Id="{c749aa94-77ca-4d45-832d-ac09e2bd2780}">
    <Declaration><![CDATA[// --------------- CONSTANTS ----------------------
{attribute 'global_init_slot' := '40500'} 
VAR_GLOBAL CONSTANT
	MaxNrofMessages: 		UINT	:= 30;
	MaxNrofSavedPoints: 	UINT	:= 10;
	MaxNrofSkills: 			UINT	:= 8;
	MaxNrofRobots: 			UINT 	:= 16;
	MaxNrofManipulators: 	UINT 	:= 16;
	MaxNrofAMRs: 			UINT 	:= 16;
	MaxNrofTools: 			UINT 	:= 16;

	emptySkill : 			FB_1_Skill; 			//Dummy Instance of Skill
	emptyCOMM: 				FB_1_COMM; 				//Dummy Instance of Comm
	emptyTool:				FB_1_Tool;				//Dummy Instance of Tool
	emptyManip:				FB_2_ROB_MANIP;
	
	PLCStandardUnits : ST_StandardUnits := (
		Position            := eUnit.mm,
		Orientation         := eUnit.rad,
		Joint               := eUnit.rad,
		LinearVelocity      := eUnit.mm,
		AngularVelocity     := eUnit.rad,
		JointVelocity       := eUnit.rad,
		LinearAcceleration  := eUnit.mm,
		AngularAcceleration := eUnit.rad,
		JointAcceleration   := eUnit.rad
	);
	
	HMIStandardUnits : ST_StandardUnits := (
		Position            := eUnit.mm,
		Orientation         := eUnit.deg,
		Joint               := eUnit.deg,
		LinearVelocity      := eUnit.mm,
		AngularVelocity     := eUnit.deg,
		JointVelocity       := eUnit.deg,
		LinearAcceleration  := eUnit.mm,
		AngularAcceleration := eUnit.deg,
		JointAcceleration   := eUnit.deg
	);
END_VAR

// --------------- PLANT VALUES ----------------------
{attribute 'global_init_slot' := '40400'}
VAR_GLOBAL
	next_ID: UINT:= 100;
	nRobCount: UINT := 0;
	nManipCount: UINT := 0;
	nAMRCount: UINT := 0;
	nSkillCount: UINT := 0;
	nToolCount: UINT := 0;
	
	apRobot: ARRAY[1..MaxNrofRobots] OF POINTER TO FB_1_ROB;
	apRobotNames: ARRAY[1..MaxNrofRobots] OF POINTER TO STRING; 		//TODO
	apManip: ARRAY[1..MaxNrofManipulators] OF POINTER TO FB_2_ROB_MANIP;
	apAMR: ARRAY[1..MaxNrofAMRs] OF POINTER TO FB_2_ROB_AMR;
	apSkill: ARRAY[1..MaxNrofSkills] OF POINTER TO FB_1_Skill;
	apTool: ARRAY[1..MaxNrofTools] OF POINTER TO FB_1_Tool;
	
	CELL_MESSENGER: FB_Messenger;
END_VAR

// --------------- PLANT SETTINGS ----------------------
VAR_GLOBAL
	SIMMODE: BOOL := FALSE;
	SYSTEMAUTOCONFIGURE: BOOL := TRUE;
END_VAR



// --------------- SKILLS ----------------------
{attribute 'global_init_slot' := '40600'}
VAR_GLOBAL
	
	R1_PP_para : stParam_PickPlace:= (MiddlePointName:='Pick'); //INIT
	R1_PP: Skill_PickPlace := (
		Tag:='PICKPLACE',
		Param:=ADR(R1_PP_para),
		pRob:=ADR(emptyManip)
	);
	
	R1_Counter_para: stParam_Counter:= (nMax:= 2);
	R1_Counter: Skill_Counter := (
		Tag:='COUNTER',
		Param:=ADR(R1_Counter_para)
	);
	
	R2_PP_para : stParam_PickPlace := (MiddlePointName:='Pick'); //INIT
	R2_PP: Skill_PickPlace := (
		Tag:='PICKPLACE',
		Param:=ADR(R2_PP_para),
		pRob:=ADR(emptyManip)
	);
	
	R2_Counter_para: stParam_Counter:= (nMax:= 8);
	R2_Counter: Skill_Counter := (
		Tag:='COUNTER',
		Param:=ADR(R2_Counter_para)
		
	);
	
	A3_MoveDemo: Skill_Axis_MoveDemo;
	
	
END_VAR


{attribute 'global_init_slot' := '40700'} 
// ---------------  TOOLS ----------------------
VAR_GLOBAL
// 	GREIFER_ALPHA : GRIPPER_GIMATIC := (pUR := ADR(UR_ALPHA),nToolOutput:= 0,bGripLevel:=TRUE);
	GREIFER_CHARLIE: GRIPPER_BISTABLE := (nToolOutput:=9,bGripLevel:=TRUE);
END_VAR



{attribute 'global_init_slot' := '40800'} 
// ---------------  ROBOTS ----------------------
VAR_GLOBAL
	PositionAlpha: ST_Pose := (
		x	:=1000,
		y	:=500,
		z	:=0,
		roll 	:=0,
		pitch	:=0,
		yaw 	:=0
	);
 		
// 	UR_ALPHA: ROBOT_UR :=(
// 		sRobotIp:='192.168.250.2',
// 		pA_Skills:= [ADR(R1_PP),ADR(R1_Counter)],
// 		Settings.InstallationPose := PositionAlpha
// 		
// 	);
// 
// // 	UR_BRAVO: ROBOT_UR :=(
// // 		sRobotIp:='192.168.250.3',
// // 		pA_Skills:= [ADR(R2_PP),ADR(R2_Counter)]
// // 	);
// 	
	MECA_CHARLIE: ROBOT_MECA500 := (
		Skills:= [ADR(R2_PP),ADR(R2_Counter)],
		Tool := ADR(GREIFER_CHARLIE)
	);
	
// 	nc_axis_delta: AXIS_REF;
	AXIS_DELTA: LINAXIS_BECKHOFF := (
// 		DummyAxis := nc_axis_delta,
		SETTINGS := (
			MinPosition := 0.0,
			MaxPosition := 100.0
// 			DefaultVelocity := 10.0,
// 			DefaultAcceleration := 100.0,
// 			DefaultDeceleration := 100.0,
// 			DefaultJerk := 1000.0,
// 			MaxVelocity := 30.0
			)
	);
	
// 	nc_axis_echo: AXIS_REF;
	AXIS_ECHO: ROTAXIS_BECKHOFF :=(
// 		DummyAxis := nc_axis_echo
	);
	AXIS_FOXTROTT: LINAXIS_JSC_XENAX :=(
		SETTINGS := (
			Direction := eDirections.Xplus,
			MinPosition := 0.0,
			MaxPosition := 100.0,
			DefaultVelocity := 10,
// 			DefaultAcceleration := 100.0,
// 			DefaultDeceleration := 100.0,
// 			DefaultJerk := 1000.0,
			MaxVelocity := 30),
		Skills := [ADR(A3_MoveDemo)]		
	);
	
END_VAR



{attribute 'global_init_slot' := '40900'}

// ---------------  RECIPE SKILL LINKS ----------------------
VAR_GLOBAL
	nRecipeBindingCount: INT := 2;
	aRecipeBinding: ARRAY[1..2] OF stRecipeBinding := [
		(
			sName := 'PickPlace',
			pSource := ADR(LIBRARY.Param_PickPlace),
			cbSize := SIZEOF(LIBRARY.Param_PickPlace),
			pWrittenFor := ADR(LIBRARY.Param_PickPlace.WrittenFor),
			nDestinationCount := 2,
			aDestination := [
				(sRobotName := 'UR_ALPHA', pSkillParameter := ADR(R1_PP.Param^)),
				(sRobotName := 'UR_BRAVO', pSkillParameter := ADR(R2_PP.Param^))
			]
		),
		(
			sName := 'Counter',
			pSource := ADR(LIBRARY.Param_Counter),
			cbSize := SIZEOF(LIBRARY.Param_Counter),
			pWrittenFor := ADR(LIBRARY.Param_Counter.WrittenFor),
			nDestinationCount := 2,
			aDestination := [
				(sRobotName := 'UR_ALPHA', pSkillParameter := ADR(R1_Counter.Param^)),
				(sRobotName := 'UR_BRAVO', pSkillParameter := ADR(R2_Counter.Param^))
			]
		)
	];
END_VAR

]]></Declaration>
  </GVL>
</TcPlcObject>