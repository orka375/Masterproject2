		<DataType>
			<Name GUID="{3035DC67-0682-4C8E-97F8-30598AC69C61}">ETcIoGevAutoInitMode</Name>
			<Comment><![CDATA[Offers camera initialization modes.]]></Comment>
			<BitSize>8</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000001}">BYTE</BaseType>
			<EnumInfo>
				<Text><![CDATA[AUTOINIT_SO]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Writes ForceIP (if existing in InitCameraCommands), reads CtrlChannelInfo and writes camera feature values of InitCameraCommands in the module´s SO-Phase.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[AUTOINIT_AFTER_SO]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Writes ForceIP (if existing in InitCameraCommands), reads CtrlChannelInfo and writes camera feature values of InitCameraCommands when OpenCamera is called.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[NO_AUTOINIT]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Writes ForceIP (if existing in InitCameraCommands), reads CtrlChannelInfo and writes camera feature values of InitCameraCommands when InitializeCamera is called.]]></Comment>
			</EnumInfo>
