				<Name>GetPacketSize</Name>
				<Comment><![CDATA[Get the maximum packet size of this stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>gvspPacketSize</Name>
					<Comment><![CDATA[Returns the maximum packet size]]></Comment>
