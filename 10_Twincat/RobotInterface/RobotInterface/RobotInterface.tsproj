				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>GetChannelId</Name>
				<Comment><![CDATA[Get the ID of this stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>gvspChannelId</Name>
					<Comment><![CDATA[Returns the GVSP stream channel ID]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000005}" ReferenceTo="true">UINT</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>GetLocalPort</Name>
				<Comment><![CDATA[Get the local port that is used for this stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>gvspPort</Name>
					<Comment><![CDATA[Returns the GVSP stream channel port]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000005}" ReferenceTo="true">UINT</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>GetLocalIpAddress</Name>
				<Comment><![CDATA[Get the local IP address that is used for this stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>ipAddress</Name>
					<Comment><![CDATA[Returns the IP address]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000008}" ReferenceTo="true">UDINT</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>GetPacketDelay</Name>
				<Comment><![CDATA[Get the minimum packet delay of this stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>gvspPacketDelay</Name>
					<Comment><![CDATA[Returns the minimum packet delay]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000008}" ReferenceTo="true">UDINT</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
