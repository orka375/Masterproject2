				<Comment TxtId=""><![CDATA[Number of timed out images]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>384</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nInvalidBlocks</Name>
