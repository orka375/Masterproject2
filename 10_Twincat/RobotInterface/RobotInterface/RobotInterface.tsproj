			<Comment><![CDATA[Interface for the GVCP protocol.]]></Comment>
			<BitSize X64="64">32</BitSize>
			<BaseType GUID="{00000001-0000-0000-E000-000000000064}">ITcUnknown</BaseType>
			<Method>
				<Name>CheckReceived</Name>
				<Comment><![CDATA[Check for received data and process it.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>RegisterReceiver</Name>
				<Comment><![CDATA[Register a GVCP receiver.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>ipRecv</Name>
					<Comment><![CDATA[Interface containing the callback methods]]></Comment>
					<Type GUID="{076882E7-F81E-4D85-82E9-92C4E11AEE9A}">ITcIoGvcpProtocolRecv</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>UnregisterReceiver</Name>
				<Comment><![CDATA[Unregister the GVCP receiver.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>OpenControlChannel</Name>
				<Comment><![CDATA[Open the GVCP control channel and start transmitting the heartbeat signal.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>ipDeviceAddr</Name>
					<Comment><![CDATA[IP address of the destination device]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000008}">UDINT</Type>
					<BitSize>32</BitSize>
				</Parameter>
				<Parameter>
					<Name>gvcpPrivileges</Name>
					<Comment><![CDATA[Requested privileges]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000008}">UDINT</Type>
					<BitSize>32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>CloseControlChannel</Name>
				<Comment><![CDATA[Close the GVCP control channel and stop transmitting the heartbeat signal.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>bOmitAcknowledgement</Name>
					<Comment><![CDATA[If true, no acknowledge packet is requested]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
					<BitSize>8</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>OpenStreamChannel</Name>
				<Comment><![CDATA[Open a stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>ipGvspChannelInfo</Name>
					<Comment><![CDATA[Required information, including the local port number and the channel ID]]></Comment>
					<Type GUID="{7C53C9A1-5EBD-4DFF-B561-5213B6EBED4A}">ITcIoGvspStreamChannelInfo</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
				<Parameter>
					<Name>bSplitConcatenatedCommands</Name>
					<Comment><![CDATA[If true, multi-read and multi-write commands are split into sequences of single read and single write commands, respectively. If false, concatenated commands are sent.]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
					<BitSize>8</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>CloseStreamChannel</Name>
				<Comment><![CDATA[Close a stream channel.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>ipGvspChannelInfo</Name>
					<Comment><![CDATA[Required information, including the local port number and the channel ID]]></Comment>
					<Type GUID="{7C53C9A1-5EBD-4DFF-B561-5213B6EBED4A}">ITcIoGvspStreamChannelInfo</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
				<Parameter>
					<Name>bSplitConcatenatedCommands</Name>
					<Comment><![CDATA[If true, multi-read and multi-write commands are split into sequences of single read and single write commands, respectively. If false, concatenated commands are sent.]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
					<BitSize>8</BitSize>
				</Parameter>
				<Parameter>
					<Name>bOmitAcknowledgement</Name>
					<Comment><![CDATA[If true, no acknowledge packet is requested]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
					<BitSize>8</BitSize>
				</Parameter>
			</Method>
