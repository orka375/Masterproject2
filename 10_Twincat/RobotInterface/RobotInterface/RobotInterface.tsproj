											<Min>0</Min>
											<pMax>RegLensDriveDurationMax</pMax>
										</Integer>
										<Float Name="Hue" NameSpace="Custom">
											<ToolTip>Hue turns the color vectors in the U/V plane. It is 1 degree per step.</ToolTip>
											<Description>Hue turns the color vectors in the U/V plane. It is 1 degree per step.</Description>
											<Visibility>Beginner</Visibility>
