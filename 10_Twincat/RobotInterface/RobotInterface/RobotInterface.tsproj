										<Integer Name="Width" NameSpace="Standard">
											<Extension>
												<PvCategory Path="ROI"/>
											</Extension>
											<ToolTip>Width of image, in pixels.</ToolTip>
											<Description>Width of image, in pixels.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegWidth</pValue>
											<pMin>IntWidthMin</pMin>
											<pMax>MaxWidth</pMax>
											<pInc>IntWidthIncrement</pInc>
										</Integer>
										<IntSwissKnife Name="IntWidthMin" NameSpace="Custom">
											<pVariable Name="FORMAT">RegPixelFormat</pVariable>
											<Formula><![CDATA[((FORMAT=35127328) || (FORMAT=34603039) || (FORMAT=34340894) || (FORMAT=6) || (FORMAT=7) || (FORMAT=8)) ? 4 : 1]]></Formula>
										</IntSwissKnife>
										<IntSwissKnife Name="IntWidthIncrement" NameSpace="Custom">
											<pVariable Name="FORMAT">RegPixelFormat</pVariable>
											<Formula>((FORMAT=35127328) || (FORMAT=34603039) || (FORMAT=34340894) || (FORMAT=6) || (FORMAT=7) || (FORMAT=8)) ? 4 : 1</Formula>
										</IntSwissKnife>
										<IntSwissKnife Name="MaxWidth" NameSpace="Custom">
											<pVariable Name="VALUE_MAX">RegMaxWidth</pVariable>
											<pVariable Name="VALUE">RegRegionX</pVariable>
											<Formula>(VALUE_MAX - VALUE)</Formula>
										</IntSwissKnife>
										<Integer Name="Height" NameSpace="Standard">
											<Extension>
												<PvCategory Path="ROI"/>
											</Extension>
											<ToolTip>Height of image, in pixels.</ToolTip>
											<Description>Height of image, in pixels.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegHeight</pValue>
											<Min>1</Min>
											<pMax>MaxHeight</pMax>
										</Integer>
										<IntSwissKnife Name="MaxHeight" NameSpace="Custom">
											<pVariable Name="VALUE_MAX">RegMaxHeight</pVariable>
											<pVariable Name="VALUE">RegRegionY</pVariable>
											<Formula>(VALUE_MAX - VALUE)</Formula>
										</IntSwissKnife>
										<Integer Name="OffsetX" NameSpace="Standard">
											<Extension>
												<PvRename Name="RegionX"/>
												<PvCategory Path="ROI"/>
											</Extension>
											<ToolTip>Starting column of the readout region (relative to the first column of the sensor) in pixels.</ToolTip>
											<Description>Starting column of the readout region (relative to the first column of the sensor) in pixels.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegRegionX</pValue>
											<Min>0</Min>
											<pMax>OffsetXMax</pMax>
										</Integer>
										<IntSwissKnife Name="OffsetXMax" NameSpace="Custom">
											<pVariable Name="VALUE_MAX">RegMaxWidth</pVariable>
											<pVariable Name="VALUE">RegWidth</pVariable>
											<Formula>(VALUE_MAX - VALUE)</Formula>
										</IntSwissKnife>
										<Integer Name="OffsetY" NameSpace="Standard">
											<Extension>
												<PvRename Name="RegionY"/>
												<PvCategory Path="ROI"/>
											</Extension>
											<ToolTip>Starting row of the readout region (relative to the first row of the sensor) in pixels.</ToolTip>
											<Description>Starting row of the readout region (relative to the first row of the sensor) in pixels.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegRegionY</pValue>
											<Min>0</Min>
											<pMax>OffsetYMax</pMax>
										</Integer>
										<IntSwissKnife Name="OffsetYMax" NameSpace="Custom">
											<pVariable Name="VALUE_MAX">RegMaxHeight</pVariable>
											<pVariable Name="VALUE">RegHeight</pVariable>
											<Formula>(VALUE_MAX - VALUE)</Formula>
										</IntSwissKnife>
										<Integer Name="PayloadSize" NameSpace="Standard">
											<ToolTip>Maximum size of image block payload.</ToolTip>
											<Description>Maximum size of image block payload.</Description>
											<pValue>RegPayloadSize</pValue>
										</Integer>
										<Integer Name="NonImagePayloadSize" NameSpace="Custom">
											<ToolTip>Maximum size of chunk data, not including the image chunk, in the image block payload.</ToolTip>
											<Description>Maximum size of chunk data, not including the image chunk, in the image block payload.</Description>
											<pValue>RegNonImagePayloadSize</pValue>
										</Integer>
										<Integer Name="ImageSize" NameSpace="Custom">
											<Extension>
												<PvRename Name="TotalBytesPerFrame"/>
											</Extension>
											<ToolTip>Size of images, in bytes, for the current format and size.</ToolTip>
											<Description>Size of images, in bytes, for the current format and size.</Description>
											<pValue>RegImageSize</pValue>
										</Integer>
										<Command Name="AcquisitionStart" NameSpace="Standard">
											<ToolTip>Start acquisition. Before image acquisition can occur, acquisition must be started, either by a hardware trigger or this software command.</ToolTip>
											<Description>Start acquisition. Before image acquisition can occur, acquisition must be started, either by a hardware trigger or this software command.</Description>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegAcquisitionCommand</pValue>
											<CommandValue>1</CommandValue>
										</Command>
										<Command Name="AcquisitionStop" NameSpace="Standard">
											<ToolTip>Stop acquisition. Acquisition will stop after acquisition of the current frame is complete.</ToolTip>
											<Description>Stop acquisition. Acquisition will stop after acquisition of the current frame is complete.</Description>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegAcquisitionCommand</pValue>
											<CommandValue>0</CommandValue>
										</Command>
										<Command Name="AcquisitionAbort" NameSpace="Standard">
											<ToolTip>Abort acquisition. Acquisition will stop immediately, but a partially transferred image will be completed.</ToolTip>
											<Description>Abort acquisition. Acquisition will stop immediately, but a partially transferred image will be completed.</Description>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegAcquisitionCommand</pValue>
											<CommandValue>2</CommandValue>
										</Command>
										<Enumeration Name="AcquisitionMode" NameSpace="Standard">
											<ToolTip>The acquisition mode determines the behavior of the camera when acquisition start is triggered. "Continuous" mode: the camera will acquire images until acquisition stop is triggered. "SingleFrame" mode: the camera will acquire a single image. "MultiFrame" mode: the camera will acquire the number of images specified by AcquisitionFrameCount. "Recorder" mode: the camera will run continuously, and when the recorder event is triggered, send pre-trigger and post-trigger images to the host.</ToolTip>
											<Description>The acquisition mode determines the behavior of the camera when acquisition start is triggered. "Continuous" mode: the camera will acquire images until acquisition stop is triggered. "SingleFrame" mode: the camera will acquire a single image. "MultiFrame" mode: the camera will acquire the number of images specified by AcquisitionFrameCount. "Recorder" mode: the camera will run continuously, and when the recorder event is triggered, send pre-trigger and post-trigger images to the host.</Description>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Continuous" NameSpace="Standard">
												<pIsImplemented>RegAcquisitionModeInqContinuous</pIsImplemented>
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="SingleFrame" NameSpace="Standard">
												<pIsImplemented>RegAcquisitionModeInqSingleFrame</pIsImplemented>
												<Value>2</Value>
											</EnumEntry>
											<EnumEntry Name="MultiFrame" NameSpace="Standard">
												<pIsImplemented>RegAcquisitionModeInqMultiFrame</pIsImplemented>
												<Value>3</Value>
											</EnumEntry>
											<EnumEntry Name="Recorder" NameSpace="Custom">
												<pIsImplemented>RegAcquisitionModeInqRecorder</pIsImplemented>
												<Value>4</Value>
											</EnumEntry>
											<pValue>RegAcquisitionMode</pValue>
										</Enumeration>
										<Integer Name="AcquisitionFrameCount" NameSpace="Standard">
											<ToolTip>This is the number of images to acquire when in MultiFrame and Recorder acquisition modes.</ToolTip>
											<Description>This is the number of images to acquire when in MultiFrame and Recorder acquisition modes.</Description>
											<pIsImplemented>RegAcquisitionModeInqMultiFrame</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegAcquisitionFrameCount</pValue>
											<Min>1</Min>
											<Max>65535</Max>
										</Integer>
										<Integer Name="RecorderPreEventCount" NameSpace="Custom">
											<ToolTip>This is the number of pre-event images to acquire in the Recorder acquisition mode. This must be less than or equal to AcquisitionFrameCount.</ToolTip>
											<Description>This is the number of pre-event images to acquire in the Recorder acquisition mode. This must be less than or equal to AcquisitionFrameCount.</Description>
											<pIsImplemented>RegAcquisitionModeInqRecorder</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegRecorderPreEventCount</pValue>
											<Min>0</Min>
											<Max>65535</Max>
										</Integer>
										<Converter Name="AcquisitionFrameRateAbs" NameSpace="Standard">
											<Extension>
												<PvRename Name="FrameRate"/>
												<PvCategory Path="Trigger"/>
											</Extension>
											<ToolTip>Frame rate, in frames per second. This is applicable when either the FrameStart trigger mode is disabled, or the FrameStart trigger source is FixedRate. Depending on the exposure duration, the camera may not achieve the frame rate set here.</ToolTip>
											<Description>Frame rate, in frames per second. This is applicable when either the FrameStart trigger mode is disabled, or the FrameStart trigger source is FixedRate. Depending on the exposure duration, the camera may not achieve the frame rate set here.</Description>
											<Streamable>Yes</Streamable>
											<FormulaTo>(1000000 / FROM)</FormulaTo>
											<FormulaFrom>(1000000 / TO)</FormulaFrom>
											<pValue>FixedIntervalValue</pValue>
											<Slope>Decreasing</Slope>
										</Converter>
										<Converter Name="AcquisitionFrameRateLimit" NameSpace="Custom">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>This is the maximum frame rate possible for the current exposure duration and image format.</ToolTip>
											<Description>This is the maximum frame rate possible for the current exposure duration and image format.</Description>
											<FormulaTo>(1000000 / FROM)</FormulaTo>
											<FormulaFrom>(1000000 / TO)</FormulaFrom>
											<pValue>FixedIntervalLimit</pValue>
											<Slope>Decreasing</Slope>
										</Converter>
										<Integer Name="FixedIntervalValue" NameSpace="Custom">
											<pValue>RegFixedIntervalValue</pValue>
											<pMin>RegFixedIntervalMin</pMin>
											<pMax>RegFixedIntervalMax</pMax>
										</Integer>
										<Integer Name="FixedIntervalLimit" NameSpace="Custom">
											<pValue>RegFixedIntervalLimit</pValue>
											<pMin>RegFixedIntervalMin</pMin>
											<pMax>RegFixedIntervalMax</pMax>
										</Integer>
										<Enumeration Name="TriggerSelector" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Select a trigger here, then use the controls {TriggerMode, TriggerSoftware, TriggerSource, TriggerActivation, TriggerOverlap, TriggerDelayAbs} to setup and read the trigger attributes. FrameStart is the trigger which starts each image (when acquisition is running). AcquisitionStart is the trigger which starts the acquisition process.</ToolTip>
											<Description>Select a trigger here, then use the controls {TriggerMode, TriggerSoftware, TriggerSource, TriggerActivation, TriggerOverlap, TriggerDelayAbs} to setup and read the trigger attributes. FrameStart is the trigger which starts each image (when acquisition is running). AcquisitionStart is the trigger which starts the acquisition process.</Description>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="FrameStart" NameSpace="Standard">
												<pIsImplemented>RegTriggerInqFrameStart</pIsImplemented>
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="AcquisitionStart" NameSpace="Standard">
												<pIsImplemented>RegTriggerInqAcquisitionStart</pIsImplemented>
												<Value>3</Value>
											</EnumEntry>
											<EnumEntry Name="AcquisitionEnd" NameSpace="Standard">
												<pIsImplemented>RegTriggerInqAcquisitionEnd</pIsImplemented>
												<Value>4</Value>
											</EnumEntry>
											<EnumEntry Name="AcquisitionRecord" NameSpace="Custom">
												<pIsImplemented>RegTriggerInqAcquisitionRecord</pIsImplemented>
												<Value>6</Value>
											</EnumEntry>
											<pValue>IntTriggerSelector</pValue>
											<pSelected>TriggerMode</pSelected>
											<pSelected>TriggerSoftware</pSelected>
											<pSelected>TriggerSource</pSelected>
											<pSelected>TriggerActivation</pSelected>
											<pSelected>TriggerOverlap</pSelected>
											<pSelected>TriggerDelayAbs</pSelected>
										</Enumeration>
										<Enumeration Name="PvDummyTriggerSelector" NameSpace="Standard">
											<EnumEntry Name="FrameStart" NameSpace="Standard">
												<Extension>
													<PvFlatten Node="PvDummyFrameStartTriggerMode" Name="FrameStartTriggerMode" Category="/Acquisition/Trigger/FrameStart"/>
													<PvFlatten Node="TriggerActivation" Name="FrameStartTriggerEvent" Category="/Acquisition/Trigger/FrameStart"/>
													<PvFlatten Node="TriggerOverlap" Name="FrameStartTriggerOverlap" Category="/Acquisition/Trigger/FrameStart"/>
													<PvFlatten Node="TriggerSoftware" Name="FrameStartTriggerSoftware" Category="/Acquisition/Trigger/FrameStart"/>
												</Extension>
												<pIsImplemented>RegTriggerInqFrameStart</pIsImplemented>
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="AcquisitionStart" NameSpace="Standard">
												<Extension>
													<PvFlatten Node="PvDummyTriggerMode" Name="AcqStartTriggerMode" Category="/Acquisition/Trigger/AcqStart"/>
													<PvFlatten Node="TriggerActivation" Name="AcqStartTriggerEvent" Category="/Acquisition/Trigger/AcqStart"/>
												</Extension>
												<pIsImplemented>RegTriggerInqAcquisitionStart</pIsImplemented>
												<Value>3</Value>
											</EnumEntry>
											<EnumEntry Name="AcquisitionEnd" NameSpace="Standard">
												<Extension>
													<PvFlatten Node="PvDummyTriggerMode" Name="AcqEndTriggerMode" Category="/Acquisition/Trigger/AcqEnd"/>
													<PvFlatten Node="TriggerActivation" Name="AcqEndTriggerEvent" Category="/Acquisition/Trigger/AcqEnd"/>
												</Extension>
												<pIsImplemented>RegTriggerInqAcquisitionEnd</pIsImplemented>
												<Value>4</Value>
											</EnumEntry>
											<EnumEntry Name="AcquisitionRecord" NameSpace="Custom">
												<Extension>
													<PvFlatten Node="PvDummyTriggerMode" Name="AcqRecTriggerMode" Category="/Acquisition/Trigger/AcqRec"/>
													<PvFlatten Node="TriggerActivation" Name="AcqRecTriggerEvent" Category="/Acquisition/Trigger/AcqRec"/>
												</Extension>
												<pIsImplemented>RegTriggerInqAcquisitionRecord</pIsImplemented>
												<Value>6</Value>
											</EnumEntry>
											<pValue>IntTriggerSelector</pValue>
										</Enumeration>
										<Integer Name="IntTriggerSelector" NameSpace="Custom">
											<Value>0</Value>
										</Integer>
										<Enumeration Name="TriggerMode" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Enable or disable this trigger. Note: when the FrameStart trigger is disabled, images are triggered at a fixed rate specified by AcquisitionFrameRateAbs.</ToolTip>
											<Description>Enable or disable this trigger. Note: when the FrameStart trigger is disabled, images are triggered at a fixed rate specified by AcquisitionFrameRateAbs.</Description>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Off" NameSpace="Standard">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="On" NameSpace="Standard">
												<Value>1</Value>
											</EnumEntry>
											<pValue>RegTriggerMode</pValue>
										</Enumeration>
										<Command Name="TriggerSoftware" NameSpace="Standard">
											<ToolTip>This software command effects a trigger.</ToolTip>
											<Description>This software command effects a trigger.</Description>
											<pIsImplemented>RegTriggerSourceInqSoftware</pIsImplemented>
