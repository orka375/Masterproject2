					<BitSize>32</BitSize>
				</Parameter>
				<Parameter>
					<Name>gvspLastPacketId</Name>
					<Comment><![CDATA[Last packet to send]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000008}">UDINT</Type>
					<BitSize>32</BitSize>
				</Parameter>
				<Parameter>
					<Name>bEi</Name>
					<Comment><![CDATA[GVSP extended ID flag]]></Comment>
