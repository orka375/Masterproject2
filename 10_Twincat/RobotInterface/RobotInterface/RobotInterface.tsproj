			<Comment><![CDATA[Contains statistics for GVSP protocol diagnosis.]]></Comment>
			<BitSize>832</BitSize>
			<SubItem>
				<Name>stRecv</Name>
				<Type GUID="{89C621F5-81B0-4DC4-8D0C-514BFD0DC56B}">GEV_RECEIVE_DIAGNOSIS</Type>
				<Comment><![CDATA[Statistics for received packets]]></Comment>
				<BitSize>192</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nResendRequests</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000B}">ULINT</Type>
				<Comment TxtId=""><![CDATA[Number of packet resend requests]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>192</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nCompletedBlocks</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000B}">ULINT</Type>
				<Comment TxtId=""><![CDATA[Number of successfully received images]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>256</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nAbortedBlocks</Name>
