													<PvFlatten Node="SyncInGlitchFilter" Name="SyncIn1GlitchFilter" Category="/IO/SyncIn1"/>
												</Extension>
												<pIsImplemented>RegIoInqSyncIn1</pIsImplemented>
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="SyncIn2">
												<Extension>
													<PvFlatten Node="SyncInGlitchFilter" Name="SyncIn2GlitchFilter" Category="/IO/SyncIn2"/>
												</Extension>
												<pIsImplemented>RegIoInqSyncIn2</pIsImplemented>
