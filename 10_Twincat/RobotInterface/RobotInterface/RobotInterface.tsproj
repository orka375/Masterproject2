												<PvDelete/>
											</Extension>
											<ToolTip>Select the Red or Blue channel to adjust with BalanceRatioAbs.</ToolTip>
											<Description>Select the Red or Blue channel to adjust with BalanceRatioAbs.</Description>
											<pIsImplemented>RegWhitebalInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Red" NameSpace="Standard">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="Blue" NameSpace="Standard">
												<Value>1</Value>
											</EnumEntry>
											<pValue>IntBalanceRatioSelector</pValue>
											<pSelected>BalanceRatioAbs</pSelected>
										</Enumeration>
										<Integer Name="IntBalanceRatioSelector" NameSpace="Custom">
											<Value>0</Value>
										</Integer>
										<Float Name="BalanceRatioAbs" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Adjust the gain of the red or blue channel (see BalanceRatioSelector). The green channel gain is always 1.00.</ToolTip>
											<Description>Adjust the gain of the red or blue channel (see BalanceRatioSelector). The green channel gain is always 1.00.</Description>
											<pIsImplemented>RegWhitebalInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>WhitebalValueXXX</pValue>
											<pMin>WhitebalValueMin</pMin>
											<pMax>WhitebalValueMax</pMax>
										</Float>
										<Converter Name="WhitebalValueXXX" NameSpace="Custom">
											<FormulaTo>(100 * FROM)</FormulaTo>
											<FormulaFrom>(TO / 100)</FormulaFrom>
											<pValue>RegWhitebalValueXXX</pValue>
											<Slope>Increasing</Slope>
										</Converter>
										<SwissKnife Name="WhitebalValueMin" NameSpace="Custom">
											<pVariable Name="VALUE">RegWhitebalValueMin</pVariable>
											<Formula>(VALUE / 100)</Formula>
										</SwissKnife>
										<SwissKnife Name="WhitebalValueMax" NameSpace="Custom">
											<pVariable Name="VALUE">RegWhitebalValueMax</pVariable>
											<Formula>(VALUE / 100)</Formula>
										</SwissKnife>
										<Enumeration Name="BalanceWhiteAuto" NameSpace="Standard">
											<Extension>
												<PvRename Name="WhitebalMode"/>
											</Extension>
											<ToolTip>Automatic whitebalance mode. Off: automatic mode is off. Once: auto-whitebalance occurs until target is achieved, then BalanceWhiteAuto returns to Off. Continuous: auto-whitebalance always runs.</ToolTip>
											<Description>Automatic whitebalance mode. Off: automatic mode is off. Once: auto-whitebalance occurs until target is achieved, then BalanceWhiteAuto returns to Off. Continuous: auto-whitebalance always runs.</Description>
											<pIsImplemented>RegWhitebalInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Off" NameSpace="Standard">
												<Extension>
													<PvRename Name="Manual"/>
												</Extension>
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="Once" NameSpace="Standard">
												<Extension>
													<PvRename Name="AutoOnce"/>
												</Extension>
												<Value>3</Value>
											</EnumEntry>
											<EnumEntry Name="Continuous" NameSpace="Standard">
												<Extension>
													<PvRename Name="Auto"/>
												</Extension>
												<Value>2</Value>
											</EnumEntry>
											<pValue>RegWhitebalMode</pValue>
										</Enumeration>
										<Integer Name="BalanceWhiteAutoRate" NameSpace="Custom">
											<Extension>
												<PvRename Name="WhitebalAutoRate"/>
											</Extension>
											<ToolTip>Rate of white balance adjustments, from 1 (slowest) to 100 (fastest). Use this control to slow down the auto-whitebalance adjustments.</ToolTip>
											<Description>Rate of white balance adjustments, from 1 (slowest) to 100 (fastest). Use this control to slow down the auto-whitebalance adjustments.</Description>
											<pIsImplemented>RegWhitebalInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegWhitebalAutoRate</pValue>
											<Min>1</Min>
											<Max>100</Max>
										</Integer>
										<Integer Name="BalanceWhiteAutoAdjustTol" NameSpace="Custom">
											<Extension>
												<PvRename Name="WhitebalAutoAdjustTol"/>
											</Extension>
											<ToolTip>Tolerance, in percent, allowed from the ideal whitebalance values, within which the auto-whitebalance does not run. This prevents needless small adjustments from occurring each image.</ToolTip>
											<Description>Tolerance, in percent, allowed from the ideal whitebalance values, within which the auto-whitebalance does not run. This prevents needless small adjustments from occurring each image.</Description>
											<pIsImplemented>RegWhitebalInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegWhitebalAutoAdjustTol</pValue>
											<Min>0</Min>
											<Max>50</Max>
										</Integer>
										<Enumeration Name="BlackLevelSelector" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Selects which Black Level is controlled by the various Black Level features.</ToolTip>
											<Description>Selects which Black Level is controlled by the various Black Level features.</Description>
											<EnumEntry Name="All" NameSpace="Standard">
												<Value>0</Value>
											</EnumEntry>
											<Value>0</Value>
										</Enumeration>
										<Float Name="BlackLevel" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Black level (offset) value.</ToolTip>
											<Description>Black level (offset) value.</Description>
											<pIsImplemented>RegOffsetInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegOffsetValueFloat</pValue>
											<pMin>RegOffsetValueMinFloat</pMin>
											<pMax>RegOffsetValueMaxFloat</pMax>
										</Float>
										<Integer Name="OffsetValue" NameSpace="Custom">
											<Extension>
												<PvCategory Path="Controls/Offset"/>
											</Extension>
											<ToolTip>Black level (offset) value.</ToolTip>
											<Description>Black level (offset) value.</Description>
											<pIsImplemented>RegOffsetInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegOffsetValueInt</pValue>
											<pMin>RegOffsetValueMinInt</pMin>
											<pMax>RegOffsetValueMaxInt</pMax>
										</Integer>
										<Enumeration Name="IrisMode" NameSpace="Custom">
											<ToolTip>Set the iris mode. Disabled: no iris control. Video: enable video iris. VideoOpen: fully open a video iris. VideoClose: fully close a video iris.</ToolTip>
											<Description>Set the iris mode. Disabled: no iris control. Video: enable video iris. VideoOpen: fully open a video iris. VideoClose: fully close a video iris.</Description>
											<pIsImplemented>RegIrisInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Disabled" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="Video" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="VideoOpen" NameSpace="Custom">
												<Value>2</Value>
											</EnumEntry>
											<EnumEntry Name="VideoClose" NameSpace="Custom">
												<Value>3</Value>
											</EnumEntry>
											<pValue>RegIrisMode</pValue>
										</Enumeration>
										<Integer Name="IrisAutoTarget" NameSpace="Custom">
											<ToolTip>This is the target image mean value, in percent.</ToolTip>
											<Description>This is the target image mean value, in percent.</Description>
											<pIsImplemented>RegIrisInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegIrisAutoTarget</pValue>
											<Min>0</Min>
											<Max>100</Max>
										</Integer>
										<Integer Name="IrisVideoLevel" NameSpace="Custom">
											<ToolTip>Current video-iris level, in approximately mV pp; read only. When calibrating a video lens, this value should fall between IrisVideoLevelMin and IrisVideoLevelMax.</ToolTip>
											<Description>Current video-iris level, in approximately mV pp; read only. When calibrating a video lens, this value should fall between IrisVideoLevelMin and IrisVideoLevelMax.</Description>
											<pIsImplemented>RegIrisInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegIrisVideoLevel</pValue>
											<Min>0</Min>
											<Max>150</Max>
										</Integer>
										<Integer Name="IrisVideoLevelMin" NameSpace="Custom">
											<ToolTip>Minimum video iris level output by the camera, in approximately mV pp. A higher minimum value slows the adjustment time but prevents excessive overshoot.</ToolTip>
											<Description>Minimum video iris level output by the camera, in approximately mV pp. A higher minimum value slows the adjustment time but prevents excessive overshoot.</Description>
											<pIsImplemented>RegIrisInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegIrisVideoLevelMin</pValue>
											<Min>0</Min>
											<Max>150</Max>
										</Integer>
										<Integer Name="IrisVideoLevelMax" NameSpace="Custom">
											<ToolTip>Maximum video iris level output by the camera, in approximately mV pp. A lower minimum value slows the adjustment time but prevents excessive overshoot.</ToolTip>
											<Description>Maximum video iris level output by the camera, in approximately mV pp. A lower minimum value slows the adjustment time but prevents excessive overshoot.</Description>
											<pIsImplemented>RegIrisInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegIrisVideoLevelMax</pValue>
											<Min>0</Min>
											<Max>150</Max>
										</Integer>
										<Enumeration Name="DefectMaskColumnEnable" NameSpace="Custom">
											<ToolTip>Enable masking of defective columns. Defective columns are detected and recorded at the factory.</ToolTip>
											<Description>Enable masking of defective columns. Defective columns are detected and recorded at the factory.</Description>
											<pIsImplemented>RegDefectMaskColumnInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Disabled" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="Enabled" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<pValue>RegDefectMaskColumnEnable</pValue>
										</Enumeration>
										<Enumeration Name="DefectMaskPixelEnable" NameSpace="Custom">
											<ToolTip>Enable masking of defective pixels. Defective pixels are detected and recorded at the factory.</ToolTip>
											<Description>Enable masking of defective pixels. Defective pixels are detected and recorded at the factory.</Description>
											<pIsImplemented>RegDefectMaskPixelInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Disabled" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="Enabled" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<pValue>RegDefectMaskPixelEnable</pValue>
										</Enumeration>
										<Integer Name="VsubValue" NameSpace="Custom">
											<ToolTip>Substrate voltage in mV.</ToolTip>
											<Description>Substrate voltage in mV.</Description>
											<pIsImplemented>RegVsubInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pValue>RegVsubValue</pValue>
										</Integer>
										<MaskedIntReg Name="RegNirModeInq" NameSpace="Custom">
											<Address>0x14000</Address>
											<Length>4</Length>
											<AccessMode>RO</AccessMode>
											<pPort>Device</pPort>
											<Bit>17</Bit>
											<Endianess>BigEndian</Endianess>
										</MaskedIntReg>
										<Enumeration Name="NirMode" NameSpace="Custom">
											<ToolTip>The NirMode influences NIR-sensitivity (best: On_HighQuality, On_Fast), framerate (best: On_Fast, Off) and anti-blooming protection (best: On_HighQuality).</ToolTip>
											<Description>The NirMode influences NIR-sensitivity (best: On_HighQuality, On_Fast), framerate (best: On_Fast, Off) and anti-blooming protection (best: On_HighQuality). Setting On_HighQuality is best suited for medium length exposure times and light conditions that could cause blooming in parts of the image. The framerate will decrease here, depending on the set exposure time. The quantum efficiency is increased for exposure time portions above 4.3 ms. Setting On_Fast is best suited when you need an improved NIR-response at low exposure times and also when a high framerate is desired. The quantum efficiency is increased during the whole exposure time. Setting Off is best suited for very long exposure times.</Description>
											<pIsImplemented>RegNirModeInq</pIsImplemented>
											<EnumEntry Name="Off" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="On_HighQuality" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="On_Fast" NameSpace="Custom">
												<Value>2</Value>
											</EnumEntry>
											<pValue>RegNirMode</pValue>
										</Enumeration>
										<Integer Name="LensVoltage" NameSpace="Custom">
											<ToolTip>Lens power supply voltage in mV. See LensVoltageControl feature to set value.</ToolTip>
											<Description>Lens power supply voltage in mV. See LensVoltageControl feature to set value.</Description>
											<pIsImplemented>RegLensControlInqVoltage</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegLensVoltage</pValue>
											<Min>0</Min>
											<pMax>RegLensVoltageMax</pMax>
										</Integer>
										<Integer Name="LensVoltageControl" NameSpace="Custom">
											<ToolTip>Lens power supply voltage control. Set value as mV * 100001. If a bad value is written, this control resets to zero.</ToolTip>
											<Description>Lens power supply voltage control. Set value as mV * 100001. If a bad value is written, this control resets to zero.</Description>
											<pIsImplemented>RegLensControlInqVoltage</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegLensVoltageControl</pValue>
										</Integer>
										<Enumeration Name="LensDriveCommand" NameSpace="Custom">
