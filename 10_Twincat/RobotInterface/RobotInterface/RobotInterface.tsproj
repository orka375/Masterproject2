										</Integer>
										<Integer Name="SyncOutLevels" NameSpace="Custom">
											<Extension>
												<PvRename Name="SyncOutGpoLevels"/>
												<PvCategory Path="/IO"/>
											</Extension>
											<ToolTip>Output levels of hardware sync outputs, for output(s) in GPO mode. (Note: SyncOutPolarity can invert these values.)</ToolTip>
											<Description>Output levels of hardware sync outputs, for output(s) in GPO mode. (Note: SyncOutPolarity can invert these values.)</Description>
											<pValue>RegSyncOutLevels</pValue>
										</Integer>
										<Enumeration Name="SyncInSelector" NameSpace="Custom">
											<ToolTip>Select the sync-in line to control with {SyncInGlitchFilter}.</ToolTip>
