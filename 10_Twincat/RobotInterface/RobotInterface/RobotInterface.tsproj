										<Enumeration Name="DeviceScanType" NameSpace="Standard">
											<ImposedAccessMode>RO</ImposedAccessMode>
											<EnumEntry Name="Areascan" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<Value>0</Value>
										</Enumeration>
										<Enumeration Name="SensorType" NameSpace="Custom">
											<Extension>
												<PvCategory Path="/Info/Sensor"/>
											</Extension>
											<ToolTip>Type of image sensor.</ToolTip>
											<Description>Type of image sensor.</Description>
											<EnumEntry Name="Mono" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="Bayer" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<pValue>RegSensorType</pValue>
										</Enumeration>
										<Integer Name="SensorBits" NameSpace="Custom">
											<Extension>
												<PvCategory Path="/Info/Sensor"/>
											</Extension>
											<ToolTip>Maximum bit depth of sensor.</ToolTip>
											<Description>Maximum bit depth of sensor.</Description>
											<pValue>RegSensorBits</pValue>
										</Integer>
										<Integer Name="SensorWidth" NameSpace="Standard">
											<Extension>
												<PvCategory Path="/Info/Sensor"/>
											</Extension>
											<ToolTip>Full width of image sensor.</ToolTip>
											<Description>Full width of image sensor.</Description>
											<pValue>RegSensorWidth</pValue>
										</Integer>
										<Integer Name="SensorHeight" NameSpace="Standard">
											<Extension>
												<PvCategory Path="/Info/Sensor"/>
											</Extension>
											<ToolTip>Full height of image sensor.</ToolTip>
											<Description>Full height of image sensor.</Description>
											<pValue>RegSensorHeight</pValue>
										</Integer>
										<Integer Name="BinningHorizontal" NameSpace="Standard">
											<Extension>
												<PvRename Name="BinningX"/>
											</Extension>
											<ToolTip>Binning in horizontal direction. Binning is the summing of charge of adjacent pixels.</ToolTip>
											<Description>Binning in horizontal direction. Binning is the summing of charge of adjacent pixels.</Description>
											<pIsImplemented>RegImageModeInqBinningX</pIsImplemented>
											<pIsLocked>TLParamsLocked</pIsLocked>
											<Streamable>Yes</Streamable>
											<pValue>BinningHorizontalValue</pValue>
											<Min>1</Min>
											<pMax>BinningHorizontalMax</pMax>
										</Integer>
										<IntConverter Name="BinningHorizontalValue" NameSpace="Custom">
											<FormulaTo>(FROM - 1)</FormulaTo>
											<FormulaFrom>(TO + 1)</FormulaFrom>
											<pValue>RegBinningXValue</pValue>
											<Slope>Increasing</Slope>
										</IntConverter>
										<IntSwissKnife Name="BinningHorizontalMax" NameSpace="Custom">
											<pVariable Name="VALUE">RegBinningXMax</pVariable>
											<Formula>(VALUE + 1)</Formula>
										</IntSwissKnife>
										<Integer Name="BinningVertical" NameSpace="Standard">
											<Extension>
												<PvRename Name="BinningY"/>
											</Extension>
											<ToolTip>Binning in vertical direction. Binning is the summing of charge of adjacent pixels.</ToolTip>
											<Description>Binning in vertical direction. Binning is the summing of charge of adjacent pixels.</Description>
											<pIsImplemented>RegImageModeInqBinningY</pIsImplemented>
											<pIsLocked>TLParamsLocked</pIsLocked>
											<Streamable>Yes</Streamable>
											<pValue>BinningVerticalValue</pValue>
											<Min>1</Min>
											<pMax>BinningVerticalMax</pMax>
										</Integer>
										<IntConverter Name="BinningVerticalValue" NameSpace="Custom">
											<FormulaTo>(FROM - 1)</FormulaTo>
											<FormulaFrom>(TO + 1)</FormulaFrom>
											<pValue>RegBinningYValue</pValue>
											<Slope>Increasing</Slope>
										</IntConverter>
										<IntSwissKnife Name="BinningVerticalMax" NameSpace="Custom">
											<pVariable Name="VALUE">RegBinningYMax</pVariable>
											<Formula>(VALUE + 1)</Formula>
										</IntSwissKnife>
										<Integer Name="StreamBytesPerSecond" NameSpace="Custom">
											<ToolTip>Bandwidth allocation: the camera will consume up to this bandwidth, in bytes per second. You must set this value if multiple cameras share the same ethernet adapter, otherwise data will be lost. The sum of all StreamBytesPerSecond values of all cameras must not exceed the available bandwidth.</ToolTip>
											<Description>Bandwidth allocation: the camera will consume up to this bandwidth, in bytes per second. You must set this value if multiple cameras share the same ethernet adapter, otherwise data will be lost. The sum of all StreamBytesPerSecond values of all cameras must not exceed the available bandwidth.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegStreamBytesPerSec</pValue>
											<Min>1000000</Min>
											<pMax>RegStreamBytesPerSecMax</pMax>
										</Integer>
										<Boolean Name="StreamFrameRateConstrain" NameSpace="Custom">
											<ToolTip>When enabled, the frame rate of the camera is constrained by available bandwidth. When disabled, the camera can image faster than it can send data.</ToolTip>
											<Description>When enabled, the frame rate of the camera is constrained by available bandwidth. When disabled, the camera can image faster than it can send data.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegStreamFrameRateConstrain</pValue>
											<OnValue>1</OnValue>
											<OffValue>0</OffValue>
										</Boolean>
										<Enumeration Name="BandwidthControlMode" NameSpace="Custom">
											<Extension>
												<PvRename Name="BandwidthCtrlMode"/>
											</Extension>
											<ToolTip>Bandwidth allocation can be controlled by StreamBytesPerSecond, or by register SCPD0. If you do not understand SCPD0 and how this driver uses this register, leave this set to "StreamBytesPerSecond".</ToolTip>
											<Description>Bandwidth allocation can be controlled by StreamBytesPerSecond, or by register SCPD0. If you do not understand SCPD0 and how this driver uses this register, leave this set to "StreamBytesPerSecond".</Description>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="StreamBytesPerSecond" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="SCPD" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="Both" NameSpace="Custom">
												<Value>2</Value>
											</EnumEntry>
											<pValue>RegBandwidthCtrlMode</pValue>
										</Enumeration>
										<Enumeration Name="StreamHoldEnable" NameSpace="Custom">
											<ToolTip>Control on-camera image storage; this control is like a "pause" button for the image stream. When enabled, images remain stored on the camera, and are not transmitted to the host. When disabled, the image stream resumes, and any stored images are sent to the host.</ToolTip>
											<Description>Control on-camera image storage; this control is like a "pause" button for the image stream. When enabled, images remain stored on the camera, and are not transmitted to the host. When disabled, the image stream resumes, and any stored images are sent to the host.</Description>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="Off" NameSpace="Custom">
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="On" NameSpace="Custom">
												<Value>1</Value>
											</EnumEntry>
											<pValue>RegStreamHold</pValue>
										</Enumeration>
										<Integer Name="StreamHoldCapacity" NameSpace="Custom">
											<ToolTip>Maximum number of images (for the current size and format) which can be stored on the camera when StreamHold is enabled.</ToolTip>
											<Description>Maximum number of images (for the current size and format) which can be stored on the camera when StreamHold is enabled.</Description>
											<pValue>RegStreamHoldCapacity</pValue>
										</Integer>
										<Integer Name="GevSCPSPacketSize" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<Visibility>Expert</Visibility>
											<pIsLocked>TLParamsLocked</pIsLocked>
											<Streamable>Yes</Streamable>
											<pValue>RegSCPSPacketSize</pValue>
											<Min>500</Min>
											<Max>9973</Max>
										</Integer>
										<Boolean Name="ChunkModeActive" NameSpace="Standard">
											<Visibility>Expert</Visibility>
											<pIsLocked>TLParamsLocked</pIsLocked>
											<Streamable>Yes</Streamable>
											<pValue>RegSCCFGChunk</pValue>
											<OnValue>1</OnValue>
											<OffValue>0</OffValue>
										</Boolean>
										<Integer Name="GevTimestampTickFrequency" NameSpace="Standard">
											<Extension>
												<PvRename Name="TimeStampFrequency"/>
											</Extension>
											<ToolTip>Frequency of image timestamp, in Hertz.</ToolTip>
											<Description>Frequency of image timestamp, in Hertz.</Description>
											<pValue>RegTimestampTickFreqLow</pValue>
										</Integer>
										<Command Name="GevTimestampControlLatch" NameSpace="Standard">
											<Extension>
												<PvRename Name="TimeStampValueLatch"/>
											</Extension>
											<ToolTip>Capture timestamp and store in GevTimestampValue.</ToolTip>
											<Description>Capture timestamp and store in GevTimestampValue.</Description>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegTimestampControl</pValue>
											<CommandValue>2</CommandValue>
										</Command>
										<Command Name="GevTimestampControlReset" NameSpace="Standard">
											<Extension>
												<PvRename Name="TimeStampReset"/>
											</Extension>
											<ToolTip>Reset the timestamp.</ToolTip>
											<Description>Reset the timestamp.</Description>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegTimestampControl</pValue>
											<CommandValue>1</CommandValue>
										</Command>
										<Integer Name="GevTimestampValue" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Value of timestamp, when latched by GevTimestampControlLatch.</ToolTip>
											<Description>Value of timestamp, when latched by GevTimestampControlLatch.</Description>
											<pValue>RegTimestampValue64</pValue>
										</Integer>
										<IntSwissKnife Name="RegTimestampValue64" NameSpace="Custom">
											<pVariable Name="LO">RegTimestampValueLo</pVariable>
											<pVariable Name="HI">RegTimestampValueHi</pVariable>
											<Formula><![CDATA[ (HI << 32) | LO ]]></Formula>
										</IntSwissKnife>
										<Integer Name="TimeStampValueHi" NameSpace="Custom">
											<Extension>
												<PvCategory Path="/GigE/Timestamp"/>
											</Extension>
											<ToolTip>High-word value of timestamp, when latched by GevTimestampControlLatch.</ToolTip>
											<Description>High-word value of timestamp, when latched by GevTimestampControlLatch.</Description>
											<pValue>RegTimestampValueHi</pValue>
										</Integer>
										<Integer Name="TimeStampValueLo" NameSpace="Custom">
											<Extension>
												<PvCategory Path="/GigE/Timestamp"/>
											</Extension>
											<ToolTip>Low-word value of timestamp, when latched by GevTimestampControlLatch.</ToolTip>
											<Description>Low-word value of timestamp, when latched by GevTimestampControlLatch.</Description>
											<pValue>RegTimestampValueLo</pValue>
										</Integer>
										<Integer Name="DecimationHorizontal" NameSpace="Standard">
											<ToolTip>Horizontal decimation (sub-sampling) of the image.</ToolTip>
											<Description>Horizontal decimation (sub-sampling) of the image.</Description>
											<pIsImplemented>RegImageModeInqDecimationHorizontal</pIsImplemented>
											<pIsLocked>TLParamsLocked</pIsLocked>
											<Streamable>Yes</Streamable>
											<pValue>RegDecimationHorizontalValue</pValue>
											<Min>1</Min>
											<pMax>RegDecimationHorizontalMax</pMax>
										</Integer>
										<Integer Name="DecimationVertical" NameSpace="Standard">
											<ToolTip>Vertical decimation (sub-sampling) of the image.</ToolTip>
											<Description>Vertical decimation (sub-sampling) of the image.</Description>
											<pIsImplemented>RegImageModeInqDecimationVertical</pIsImplemented>
											<pIsLocked>TLParamsLocked</pIsLocked>
											<Streamable>Yes</Streamable>
											<pValue>RegDecimationVerticalValue</pValue>
											<Min>1</Min>
											<pMax>RegDecimationVerticalMax</pMax>
										</Integer>
										<Boolean Name="ReverseX" NameSpace="Standard">
											<ToolTip>Flip horizontally the image.</ToolTip>
											<Description>ReverseX is used to flip horizontally the image sent by the device. The AOI is applied after the
flipping.</Description>
											<pIsImplemented>RegMirrorXInq</pIsImplemented>
											<Streamable>Yes</Streamable>
											<pValue>RegMirrorX</pValue>
										</Boolean>
										<Integer Name="WidthMax" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Maximum image width for the current image mode. Horizontal binning, for example, will change this value.</ToolTip>
											<Description>Maximum image width for the current image mode. Horizontal binning, for example, will change this value.</Description>
											<pValue>RegMaxWidth</pValue>
										</Integer>
										<Integer Name="HeightMax" NameSpace="Standard">
											<Extension>
												<PvDelete/>
											</Extension>
											<ToolTip>Maximum image height for the current image mode. Vertical binning, for example, will change this value.</ToolTip>
											<Description>Maximum image height for the current image mode. Vertical binning, for example, will change this value.</Description>
