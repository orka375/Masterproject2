				<Comment TxtId=""><![CDATA[Number of aborted images]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>320</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nTimedOutBlocks</Name>
