			<BaseType GUID="{00000001-0000-0000-E000-000000000064}">ITcUnknown</BaseType>
			<Method>
				<Name>RequestPacketResend</Name>
				<Comment><![CDATA[Send a PACKETRESEND_CMD requesting a sequence of GVSP packets.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>gvspChannelId</Name>
					<Comment><![CDATA[ID of the stream channel on which the packet(s) is/are to be resent]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000005}">UINT</Type>
					<BitSize>16</BitSize>
				</Parameter>
				<Parameter>
					<Name>gvspBlockId</Name>
					<Comment><![CDATA[Block ID of the requested packet(s)]]></Comment>
