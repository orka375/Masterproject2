		<DataType>
			<Name GUID="{D245C557-353A-4D5F-A69A-DDF424681A3C}">ITcIoImageAcquisition</Name>
			<Comment><![CDATA[Interface for image acquisition.]]></Comment>
			<BitSize X64="64">32</BitSize>
			<BaseType GUID="{00000001-0000-0000-E000-000000000064}">ITcUnknown</BaseType>
			<Method>
				<Name>RegisterReceiver</Name>
				<Comment><![CDATA[Register callback interface.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>ipRecv</Name>
					<Comment><![CDATA[Pointer to an interface containing the callback function.]]></Comment>
					<Type GUID="{3404B97C-9B43-42E9-9D95-3DB0DA598A36}">ITcIoImageRecv</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>UnregisterReceiver</Name>
				<Comment><![CDATA[Unregister callback interface.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>OpenCamera</Name>
				<Comment><![CDATA[Open camera (open the control channel, open a stream channel, and activate the GVSP receiver).]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>CloseCamera</Name>
				<Comment><![CDATA[Close camera (deactivate the GVSP receiver, close the stream channel, and close the control channel).]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>StartAcquisition</Name>
				<Comment><![CDATA[Start the image acquisition.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>StopAcquisition</Name>
				<Comment><![CDATA[Stop the image acquisition.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>SoftwareTrigger</Name>
				<Comment><![CDATA[Initialize the software trigger and trigger it. The initialization step is skipped if it was executed before.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>bSplitConcatenatedCommands</Name>
					<Comment><![CDATA[If true, multi-read and multi-write commands are split into sequences of single read and single write commands, respectively.]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
					<BitSize>8</BitSize>
				</Parameter>
				<Parameter>
					<Name>bOmitAcknowledgement</Name>
					<Comment><![CDATA[Indicates that no acknowledge packet should be requested.]]></Comment>
					<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
					<BitSize>8</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>InitializeCamera</Name>
				<Comment><![CDATA[Send initialization commands to the camera.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Properties>
				<Property>
					<Name>docuFolder</Name>
					<Value>Interfaces\Images\Acquisition</Value>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{541D299A-444C-40CE-BD4B-CDD584986D97}"/>
				<Hide GUID="{C4400551-BD6F-4429-8ADD-A40CAF45DB14}"/>
				<Hide GUID="{56761ECC-5890-42CF-9CC1-9158736E2881}"/>
