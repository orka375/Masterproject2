													<PvFlatten Node="SyncInGlitchFilter" Name="SyncIn3GlitchFilter" Category="/IO/SyncIn3"/>
												</Extension>
												<pIsImplemented>RegIoInqSyncIn3</pIsImplemented>
												<Value>2</Value>
											</EnumEntry>
											<EnumEntry Name="SyncIn4">
												<Extension>
													<PvFlatten Node="SyncInGlitchFilter" Name="SyncIn4GlitchFilter" Category="/IO/SyncIn4"/>
												</Extension>
												<pIsImplemented>RegIoInqSyncIn4</pIsImplemented>
												<Value>3</Value>
											</EnumEntry>
											<pValue>IntSyncInSelector</pValue>
											<pSelected>SyncInGlitchFilter</pSelected>
										</Enumeration>
										<Integer Name="IntSyncInSelector" NameSpace="Custom">
											<Value>0</Value>
										</Integer>
										<Integer Name="SyncInGlitchFilter" NameSpace="Custom">
											<ToolTip>Glitch filter on sync-in line, in nanoseconds.</ToolTip>
											<Description>Glitch filter on sync-in line, in nanoseconds.</Description>
											<Streamable>Yes</Streamable>
											<pValue>RegSyncInGlitchFilter</pValue>
											<pMax>RegSyncInGlitchFilterMax</pMax>
										</Integer>
										<Enumeration Name="SyncOutSelector" NameSpace="Custom">
											<ToolTip>Select the sync-out line to control with {SyncOutSource, SyncOutPolarity}.</ToolTip>
											<Description>Select the sync-out line to control with {SyncOutSource, SyncOutPolarity}.</Description>
											<Streamable>Yes</Streamable>
											<EnumEntry Name="SyncOut1">
