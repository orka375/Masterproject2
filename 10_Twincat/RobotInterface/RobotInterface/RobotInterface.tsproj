		<DataType>
			<Name GUID="{B05227C0-7FB6-4EBC-B79C-8DC65E1F5DAA}">ITcVnImageProvider</Name>
			<Comment><![CDATA[Interface for an image provider.]]></Comment>
			<BitSize X64="64">32</BitSize>
			<BaseType GUID="{00000001-0000-0000-E000-000000000064}">ITcUnknown</BaseType>
			<Method>
				<Name>CheckIfBusy</Name>
				<Comment><![CDATA[Check whether the module is busy; i.e, an operation is in progress.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>CheckIfCameraConnected</Name>
				<Comment><![CDATA[Check if the camera is properly connected (Returns S_OK if connected and S_FALSE if not. Can only check software connection, i.e. the check is unable to determine if the cable is connected or not in case that S_FALSE is returned).]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>GetCurrentImage</Name>
				<Comment><![CDATA[Gets the current image by detaching its internal reference.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
				<Parameter>
					<Name>pipImage</Name>
					<Comment><![CDATA[Pointer to the interface pointer to be returned, might be 0 if the image acquisition failed.]]></Comment>
					<Type GUID="{70D42C6D-6F4E-4719-8B29-2883D5D59B1C}" PointerTo="1">ITcVnImage</Type>
					<BitSize X64="64">32</BitSize>
				</Parameter>
			</Method>
			<Method>
				<Name>GetError</Name>
				<Comment><![CDATA[Gets result of the last operation performed.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>OpenCamera</Name>
				<Comment><![CDATA[Open camera (open the control channel, open a stream channel, and activate the GVSP receiver).]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>CloseCamera</Name>
				<Comment><![CDATA[Close camera (deactivate the GVSP receiver, close the stream channel, and close the control channel).]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>StartAcquisition</Name>
				<Comment><![CDATA[Start image acquisition.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>StopAcquisition</Name>
				<Comment><![CDATA[Stop image acquisition.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>SoftwareTrigger</Name>
				<Comment><![CDATA[Initialize the software trigger and trigger it. The initialization step is skipped if it was executed before.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
			<Method>
				<Name>InitializeCamera</Name>
				<Comment><![CDATA[Set camera to initial state.]]></Comment>
				<ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType>
				<ReturnBitSize>32</ReturnBitSize>
			</Method>
