												</Extension>
												<pIsImplemented>RegIoInqSyncOut2</pIsImplemented>
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="SyncOut3">
												<Extension>
													<PvFlatten Node="SyncOutSource" Name="SyncOut3Mode" Category="/IO/SyncOut3"/>
													<PvFlatten Node="SyncOutPolarity" Name="SyncOut3Invert" Category="/IO/SyncOut3"/>
												</Extension>
												<pIsImplemented>RegIoInqSyncOut3</pIsImplemented>
												<Value>2</Value>
											</EnumEntry>
											<EnumEntry Name="SyncOut4">
												<Extension>
													<PvFlatten Node="SyncOutSource" Name="SyncOut4Mode" Category="/IO/SyncOut4"/>
													<PvFlatten Node="SyncOutPolarity" Name="SyncOut4Invert" Category="/IO/SyncOut4"/>
												</Extension>
