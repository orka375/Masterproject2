										<Category Name="LUTControl" NameSpace="Standard">
											<ToolTip>Category that includes the LUT control features.</ToolTip>
											<Description>Category that includes the LUT control features.</Description>
											<DisplayName>LUTControl</DisplayName>
											<Visibility>Expert</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pFeature>LUTSelector</pFeature>
											<pFeature>LUTInfo</pFeature>
											<pFeature>LUTMode</pFeature>
											<pFeature>LUTEnable</pFeature>
											<pFeature>LUTIndex</pFeature>
											<pFeature>LUTValue</pFeature>
											<pFeature>LUTLoad</pFeature>
											<pFeature>LUTSave</pFeature>
										</Category>
										<Enumeration Name="LUTSelector" NameSpace="Standard">
											<ToolTip>Selects which look up table is used.</ToolTip>
											<Description>Selects which look up table is used.</Description>
											<DisplayName>LUTSelector</DisplayName>
											<Visibility>Expert</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RW</ImposedAccessMode>
											<EnumEntry Name="LUT1" NameSpace="Custom">
												<DisplayName>LUT1</DisplayName>
												<pIsImplemented>Lut1Inq</pIsImplemented>
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="LUT2" NameSpace="Custom">
												<DisplayName>LUT2</DisplayName>
												<pIsImplemented>Lut2Inq</pIsImplemented>
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="LUT3" NameSpace="Custom">
												<DisplayName>LUT3</DisplayName>
												<pIsImplemented>Lut3Inq</pIsImplemented>
												<Value>2</Value>
											</EnumEntry>
											<pValue>RegLutSelector</pValue>
											<pSelected>LUTInfo</pSelected>
											<pSelected>LUTMode</pSelected>
											<pSelected>LUTEnable</pSelected>
											<pSelected>LUTIndex</pSelected>
											<pSelected>LUTValue</pSelected>
											<pSelected>LUTLoad</pSelected>
											<pSelected>LUTSave</pSelected>
										</Enumeration>
										<IntSwissKnife Name="Lut1Inq" NameSpace="Custom">
											<pVariable Name="COUNT">RegLutCount</pVariable>
											<Formula><![CDATA[ COUNT >= 1 ]]></Formula>
										</IntSwissKnife>
										<IntSwissKnife Name="Lut2Inq" NameSpace="Custom">
											<pVariable Name="COUNT">RegLutCount</pVariable>
											<Formula><![CDATA[ COUNT >= 2 ]]></Formula>
										</IntSwissKnife>
										<IntSwissKnife Name="Lut3Inq" NameSpace="Custom">
											<pVariable Name="COUNT">RegLutCount</pVariable>
											<Formula><![CDATA[ COUNT >= 3 ]]></Formula>
										</IntSwissKnife>
										<Category Name="LUTInfo" NameSpace="Custom">
											<ToolTip>Category that includes the LUT info features for the look up table.</ToolTip>
											<Description>Category that includes the LUT info features for the look up table.</Description>
											<DisplayName>LUTInfo</DisplayName>
											<Visibility>Expert</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pFeature>LUTBitDepthIn</pFeature>
											<pFeature>LUTBitDepthOut</pFeature>
											<pFeature>LUTAddress</pFeature>
											<pFeature>LUTSizeBytes</pFeature>
										</Category>
										<Integer Name="LUTBitDepthIn" NameSpace="Custom">
											<ToolTip>Bit length of the input value of the look up table block</ToolTip>
											<Description>Bit length of the input value of the look up table block</Description>
											<DisplayName>LUTBitLengthIn</DisplayName>
											<Visibility>Guru</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pValue>RegLutInfoBitDepthIn</pValue>
										</Integer>
										<Integer Name="LUTBitDepthOut" NameSpace="Custom">
											<ToolTip>Bit length of the output value of the look up table block</ToolTip>
											<Description>Bit length of the output value of the look up table block</Description>
											<DisplayName>LUTBitLengthOut</DisplayName>
											<Visibility>Guru</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pValue>RegLutInfoBitDepthOut</pValue>
										</Integer>
										<Integer Name="LUTAddress" NameSpace="Custom">
											<ToolTip>Address of the memory area where the selected LUT is located (for raw memory transfer)</ToolTip>
											<Description>Address of the memory area where the selected LUT is located (for raw memory transfer)</Description>
											<DisplayName>LUTAddress</DisplayName>
											<Visibility>Guru</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pValue>RegLutMemoryAddress</pValue>
										</Integer>
										<Integer Name="LUTSizeBytes" NameSpace="Custom">
											<ToolTip>Size of the memory area where the LUT is located</ToolTip>
											<Description>Size of the memory area where the LUT is located</Description>
											<DisplayName>LUTSize</DisplayName>
											<Visibility>Guru</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RO</ImposedAccessMode>
											<pValue>RegLutMemoryLength</pValue>
										</Integer>
										<Enumeration Name="LUTMode" NameSpace="Custom">
											<ToolTip>Selects which mode is used for the selected look up table.</ToolTip>
											<Description>Selects which mode is used for the selected look up table.</Description>
											<DisplayName>LUTMode</DisplayName>
											<Visibility>Expert</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RW</ImposedAccessMode>
											<EnumEntry Name="Luminance" NameSpace="Custom">
												<DisplayName>Luminance</DisplayName>
												<pIsImplemented>RegLutLuminanceInq</pIsImplemented>
												<Value>0</Value>
											</EnumEntry>
											<EnumEntry Name="Red" NameSpace="Custom">
												<DisplayName>Red</DisplayName>
												<pIsImplemented>RegLutRedInq</pIsImplemented>
												<Value>1</Value>
											</EnumEntry>
											<EnumEntry Name="Green" NameSpace="Custom">
												<DisplayName>Green</DisplayName>
												<pIsImplemented>RegLutGreenInq</pIsImplemented>
												<Value>2</Value>
											</EnumEntry>
											<EnumEntry Name="Blue" NameSpace="Custom">
												<DisplayName>Blue</DisplayName>
												<pIsImplemented>RegLutBlueInq</pIsImplemented>
												<Value>3</Value>
											</EnumEntry>
											<pValue>RegLutMode</pValue>
										</Enumeration>
										<Boolean Name="LUTEnable" NameSpace="Standard">
											<ToolTip>Activates the selected LUT.</ToolTip>
											<Description>Activates the selected LUT.</Description>
											<DisplayName>LUTEnable</DisplayName>
											<Visibility>Expert</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RW</ImposedAccessMode>
											<Streamable>Yes</Streamable>
											<pValue>RegLutEnable</pValue>
										</Boolean>
										<Integer Name="LUTIndex" NameSpace="Standard">
											<ToolTip>Control the index of the coefficient to access in the selected look up table.</ToolTip>
											<Description>Control the index of the coefficient to access in the selected look up table.</Description>
											<DisplayName>LUTIndex</DisplayName>
											<Visibility>Guru</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RW</ImposedAccessMode>
											<pValue>RegLutIndex</pValue>
											<Min>0</Min>
											<pMax>LUTIndexMax</pMax>
											<pSelected>LUTValue</pSelected>
										</Integer>
										<IntSwissKnife Name="LUTIndexMax" NameSpace="Custom">
											<pVariable Name="BITDEPTHIN">RegLutInfoBitDepthIn</pVariable>
											<Formula><![CDATA[(2 ** BITDEPTHIN) - 1]]></Formula>
										</IntSwissKnife>
										<Integer Name="LUTValue" NameSpace="Standard">
											<ToolTip>Returns the Value at entry LUTIndex of the selected look up table</ToolTip>
											<Description>Returns the Value at entry LUTIndex of the selected look up table</Description>
											<DisplayName>LUTValue</DisplayName>
											<Visibility>Guru</Visibility>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>RW</ImposedAccessMode>
											<pValue>RegLutValue</pValue>
											<Min>0</Min>
											<pMax>LUTValueMax</pMax>
										</Integer>
										<IntSwissKnife Name="LUTValueMax" NameSpace="Custom">
											<pVariable Name="BITDEPTHOUT">RegLutInfoBitDepthOut</pVariable>
											<Formula><![CDATA[(2 ** BITDEPTHOUT) - 1]]></Formula>
										</IntSwissKnife>
										<Command Name="LUTLoad" NameSpace="Custom">
											<ToolTip>Load the selected look up table from internal memory.</ToolTip>
											<Description>Load the selected look up table from internal memory.</Description>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegLutMemoryCommand</pValue>
											<CommandValue>1</CommandValue>
										</Command>
										<Command Name="LUTSave" NameSpace="Custom">
											<ToolTip>Save the selected look up table from internal memory.</ToolTip>
											<Description>Save the selected look up table from internal memory.</Description>
											<pIsImplemented>RegLutInq</pIsImplemented>
											<ImposedAccessMode>WO</ImposedAccessMode>
											<pValue>RegLutMemoryCommand</pValue>
											<CommandValue>2</CommandValue>
										</Command>
										<Integer Name="SyncInLevels" NameSpace="Custom">
											<Extension>
												<PvCategory Path="/IO"/>
											</Extension>
											<ToolTip>Momentary logic levels of the hardware line inputs.</ToolTip>
											<Description>Momentary logic levels of the hardware line inputs.</Description>
