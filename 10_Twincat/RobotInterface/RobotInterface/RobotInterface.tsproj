												<Value>2</Value>
											</EnumEntry>
											<EnumEntry Name="FocusTimedNear" NameSpace="Custom">
												<pIsImplemented>RegLensDriveInqFocusTimedNear</pIsImplemented>
												<Value>3</Value>
											</EnumEntry>
											<EnumEntry Name="FocusTimedFar" NameSpace="Custom">
												<pIsImplemented>RegLensDriveInqFocusTimedFar</pIsImplemented>
												<Value>4</Value>
											</EnumEntry>
											<EnumEntry Name="ZoomTimedIn" NameSpace="Custom">
												<pIsImplemented>RegLensDriveInqZoomTimedIn</pIsImplemented>
												<Value>5</Value>
											</EnumEntry>
											<EnumEntry Name="ZoomTimedOut" NameSpace="Custom">
												<pIsImplemented>RegLensDriveInqZoomTimedOut</pIsImplemented>
												<Value>6</Value>
											</EnumEntry>
											<pValue>RegLensDriveCmd</pValue>
										</Enumeration>
										<Integer Name="LensDriveDuration" NameSpace="Custom">
											<ToolTip>Duration of timed lens commands, in milliseconds.</ToolTip>
											<Description>Duration of timed lens commands, in milliseconds.</Description>
											<pIsImplemented>RegLensControlInqDrive</pIsImplemented>
