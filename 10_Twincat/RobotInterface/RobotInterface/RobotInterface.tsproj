				<BitSize>64</BitSize>
				<BitOffs>576</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nMissingBlocks</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000B}">ULINT</Type>
