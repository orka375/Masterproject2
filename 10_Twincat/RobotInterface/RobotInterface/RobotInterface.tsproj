				<Hide GUID="{3F310A52-2BC6-46EB-A227-3DC5C843CC25}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{B0162C95-E9FA-4151-A74F-59489FF2D3A0}">GEV_CAMERA_STATE</Name>
			<Comment><![CDATA[Describes the GigEVision camera connection state.]]></Comment>
			<BitSize>8</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000001}">BYTE</BaseType>
			<EnumInfo>
				<Text><![CDATA[GEV_CAMERA_IDLE]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Camera is idle (no control or stream channel open).]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[GEV_CONTROL_CHANNEL_OPEN_MASK]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[The control channel is open.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[GEV_STREAM_CHANNELS_OPEN_MASK]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[At least 1 stream channel is open.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[GEV_CONTROL_CHANNEL_OPEN]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[The control channel is open, but no stream channel.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[GEV_STREAM_CHANNELS_OPEN]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[At least 1 stream channel and the control channel are open.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcWarning_disable</Name>
					<Value>C0125</Value>
				</Property>
			</Properties>
		</DataType>
		<DataType>
